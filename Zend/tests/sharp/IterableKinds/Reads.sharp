namespace IterableKinds;

import Illuminate.Support.LazyCollection;

public static class Reads
{
    public static int fed(Feed<int> feed)
    {
        let total = 0;
        for (const n of feed) {
            total += n;
        }
        return total + feed.filter(n => n > 1).toList().count();
    }

    public static List<int> counted(Countdown countdown) => countdown.map(n => n * 10).toList();

    // LazyCollection's own filter() and take() win over the lazy operations.
    public static List<int> cursor(LazyCollection<int, int> cursor) => cursor.filter((n, position) => n > 4).take(1).toList();

    public static LazyCollection<int, int> filtered(LazyCollection<int, int> cursor) => cursor.filter((n, position) => n > 4);

    // `[]` is an empty `List`, which an `Iterable` holds.
    public static Iterable<Object> none() => [];

    public static int named(Iterable<string> names = []) => names.toList().count();
}
