namespace Demo;

public enum ChargeError : Error
{
    case Declined(string reason);
    case Expired;

    public string message => match (this) {
        ChargeError.Declined(string reason) => `declined: ${reason}`,
        ChargeError.Expired => "card expired",
    };
}

public enum Lookup<T>
{
    case Found(T value);
    case Missing;
}

public class Receipt
{
    public int total { get; }

    public Receipt(int total) { this.total = total; }
}

public class Gateway
{
    public Result<Receipt, ChargeError> charge(int total)
    {
        if (total > 0) {
            return Result.Ok(new Receipt(total));
        }
        return Result.Err(ChargeError.Declined("empty cart"));
    }

    public Result<int, ChargeError> doubled(int total)
    {
        const receipt = try this.charge(total);
        return Result.Ok(receipt.total * 2);
    }

    public Result<int, ChargeError> total(int total) => Result.Ok((try this.charge(total)).total);

    public Result<int, ChargeError> later(int total)
    {
        Function<Result<int, ChargeError>(int)> charged = amount => Result.Ok((try this.charge(amount)).total + 1);
        return charged(total);
    }

    public static Result<List<T>, ChargeError> listed<T>(Result<T, ChargeError> result) => Result.Ok([try result]);

    public Result<List<Receipt>, ChargeError> receipts(int total) => Gateway.listed(this.charge(total));

    public Result<int, ChargeError> written() => Result<int, ChargeError>.Ok(5);

    public string describe(Result<Receipt, ChargeError> result) => match (result) {
        Result.Ok(Receipt receipt) => `paid ${receipt.total}`,
        Result.Err(ChargeError error) => error.message,
    };

    public bool failed(Result<Receipt, ChargeError> result) => result is Result.Err;

    public string message(Error error) => error.message;

    public bool same(Result<int, ChargeError> a, Result<int, ChargeError> b) => a == b;

    public Lookup<int> missing() => Lookup.Missing;

    public Lookup<string> missingText() => Lookup.Missing;

    public Lookup<int> writtenMissing() => Lookup<int>.Missing;

    public Lookup<int> found(int value) => Lookup.Found(value);
}
