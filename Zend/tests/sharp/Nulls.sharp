namespace Demo;

class Nulls
{
    public static Nulls? none()
    {
        return null;
    }

    public int? same(int? value)
    {
        return value;
    }

    public int either(int? first, int? second)
    {
        return first ?? second ?? 0;
    }

    public int fill(int? value)
    {
        let filled = value;
        filled ??= this.either(7, null);
        value ??= 8;
        return filled + value;
    }

    public int? through(Nulls? other, int? value)
    {
        return other?.same(value) ?? other?.either(7, null);
    }

    public int? size(Box? box)
    {
        return box?.size;
    }

    public int typed(int? value)
    {
        int? found = null;
        found ??= value;
        const int base = 10;
        int total = base;
        total += found ?? 1;
        return total;
    }

    public int countTo(int limit)
    {
        int total = 0;
        for (int step = 1; step <= limit; step++) {
            total += step;
        }
        return total;
    }

    public bool missing(int? value)
    {
        return value == null;
    }

    public bool present(string? value)
    {
        return value != null;
    }

    public bool absent(bool? value)
    {
        return null == value;
    }

    private Function<int(int) uses Clock>? doubler = null;

    public int? local(Function<int(int)>? function, int value) => function?.(value);

    public int? property(Function<int(int) uses Clock>? function, int value)
    {
        this.doubler = function;
        return this.doubler?.(value);
    }

    public int? called(Function<int(int) uses Clock>? function, int value)
    {
        this.doubler = function;
        return this.held()?.(value);
    }

    public Function<int(int) uses Clock>? held() => this.doubler;

    public string greeting(string? name = null) => name ?? "nobody";

    private string? nickname = null;

    public string? currentNickname() => this.nickname;
}
