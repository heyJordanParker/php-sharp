namespace Demo;

import Sharp.Encoding.Base64;
import Sharp.Encoding.Compression;
import Sharp.Encoding.Hex;
import Sharp.Encoding.Json;
import Sharp.IO.Path;
import Sharp.Net.Ip;
import Sharp.Net.MailAddress;
import Sharp.Net.Url;
import Sharp.Security.Hash;
import Sharp.Security.Password;
import Sharp.Text.Html;
import Sharp.Text.Regex;
import Sharp.Time.Instant;
import Sharp.Time.TimeZone;

class Library
{
    public static string initial(int code) => code.toByteString();

    public static bool isNumber(string text) => Regex.matches("/^[0-9]+$/", text);

    public static string escape(string html) => Html.escape(html);

    public static float square(float side) => Math.pow(side, 2.0);

    public static Any? decode(string json) => Json.decode(json);

    public static string digest(string data) => Hash.sha1(data);

    public static string base64(string data) => Base64.encode(data);

    public static string hexadecimal(string data) => Hex.encode(data);

    public static bool checks(string password, string hash) => Password.verify(password, hash);

    public static string compress(string data) => Compression.compress(data);

    public static string extension(string path) => Path.extension(path);

    public static string day(int seconds) => new Instant(seconds).inZone(TimeZone.utc).date.toString();

    public static int zones() => TimeZone.names().count();

    public static string query(Map<string, Any?> values) => Url.buildQuery(values);

    public static bool isEmail(string address) => MailAddress.isValid(address);

    public static bool isIp(string address) => Ip.isValid(address);
}
