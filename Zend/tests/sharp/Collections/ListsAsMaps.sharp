namespace Demo;

import Sharp.Encoding.Json;
import Sharp.Encoding.JsonValue;

public class ListsAsMaps
{
    private static Map<string, Any?>|List<Any?> arrayAt(Any? value)
    {
        if (value is Map<string, Any?> held) {
            return held;
        }

        if (value is List<Any?> items) {
            return items;
        }

        throw new LogicException("not an array");
    }

    public static List<string> children()
    {
        const decoded = Json.parse<Map<string, Any?>>("{\"a\":[1],\"b\":[]}").unwrap();
        List<string> lines = [];
        for (const [key, child] of decoded) {
            lines.add(`${key}: ${Json.encode(ListsAsMaps.arrayAt(child))}`);
        }

        return lines;
    }

    public static List<string> tests()
    {
        Any? one = Json.parse<JsonValue>("[1]").unwrap().value;
        string byText = `[1] is Map<string, Any?>: ${one is Map<string, Any?> ? "true" : "false"}`;
        Any? again = Json.parse<JsonValue>("[1]").unwrap().value;
        string byInt = `[1] is Map<int, Any?>: ${again is Map<int, Any?> ? "true" : "false"}`;
        return [byText, byInt];
    }

    public static string numericKey(Any? value) =>
        `['42' => true] is Map<string, bool>: ${value is Map<string, bool> ? "true" : "false"}`;
}
