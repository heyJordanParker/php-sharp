namespace Demo;

import Lib.Slots;

class Cart
{
    public List<Item> items { get; private set; } = [];
    private Map<string, int> counts = [:];

    public int fill(List<Item> extra)
    {
        this.items = [new Item("tea", 3)];
        this.items.add(extra[0]);
        this.counts["items"] = this.items.count();
        this.counts["extra"] = extra.count();
        let total = this.items[0].cents;
        for (const item of this.items) {
            total += item.cents;
        }
        for (const [name, size] of this.counts) {
            if (name == "items") {
                total += size * 10;
            }
        }
        return total + Slots.fromArray(this.prices()).getSize();
    }

    public List<int> prices()
    {
        List<int> prices = [];
        for (const item of this.items) {
            prices.add(item.cents);
        }
        return prices;
    }

    public int bump(string name)
    {
        this.counts[name] = (this.counts[name] ?? 0) + 1;
        return this.counts[name] ?? 0;
    }

    public bool has(int cents)
    {
        return this.prices().contains(cents);
    }

    public List<int> withPrices(List<int> before, List<int> after)
    {
        return [...before, ...this.prices(), 0, ...after];
    }

    public [int total, int count] totals()
    {
        let total = 0;
        for (const item of this.items) {
            total += item.cents;
        }
        return [total, this.items.count()];
    }

    public string described()
    {
        const totals = this.totals();
        const [total, count] = this.totals();
        let described = `${totals.total}/${totals.count} ${total}/${count}`;
        List<[string, int]> pairs = [["tea", 3], ["pie", 7]];
        for (const [name, cents] of pairs) {
            described = `${described} ${name}:${cents}`;
        }
        return described;
    }
}
