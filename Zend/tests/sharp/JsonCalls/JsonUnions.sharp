namespace Demo;

import Sharp.Encoding.Json;

public class JsonUnions
{
    public static Map<string, (string|int|float|bool)?> scalars(string json) => Json.parse<Map<string, (string|int|float|bool)?>>(json).unwrap();

    public static Map<string, (float|int)?> floatsFirst(string json) => Json.parse<Map<string, (float|int)?>>(json).unwrap();

    public static List<T> all<T>(string json) => Json.parse<List<T>>(json).unwrap();

    public static List<(string|int|float|bool)?> wrapped(string json) => JsonUnions.all<(string|int|float|bool)?>(json);

    public static bool sameType()
    {
        (int|float)? number = 3006;
        List<(int|float)?> numbers = [number];
        return numbers is List<(float|int)?>;
    }
}
