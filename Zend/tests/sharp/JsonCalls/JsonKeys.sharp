namespace Demo;

import Sharp.Encoding.Json;

// Spec section 12: a key read into a `Map<string, TValue>` is a `string`, an all-digit key such as `"4156"` included,
// through `Json.parse<T>`, a struct's generated `parse` and `typeof(T).parse`. Each reads the keys in PHP# code,
// since a Map a plain PHP caller receives is a PHP array, which holds `"4156"` as an int again.
public static class JsonKeys
{
    public static List<string> named(string json) => Json.parse<Map<string, string>>(json).unwrap().keys();

    public static string? label(string json) => Json.parse<Map<string, string>>(json).unwrap().get("4156");

    public static List<string> options(string json) => Json.parse<JsonOptions>(json).unwrap().labels.keys();

    public static List<string> decoded(Any? value) => typeof(JsonOptions).parse(value).unwrap().labels.keys();
}
