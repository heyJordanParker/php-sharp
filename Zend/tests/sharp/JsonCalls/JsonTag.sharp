namespace Demo;

public struct JsonTag : string
{
    public JsonTag(public string name { get; }) { }

    public string value => `#${this.name}`;

    public static Result<JsonTag, ParseError> parse(Any? value)
        => value is string text ? Result.Ok(new JsonTag(text.removePrefix("#"))) : Result.Err(new ParseError(["": "expected string"]));

    public string toString() => this.value;
}
