namespace ReflectedMembers;

// Statics that run accessors, and initial values that are not constant, as reflection reads them.
public class Counter
{
    public static int count { get; private set => field = value; } = 0;

    public static string label => "counter";

    public static int limit { get; set; didSet => Counter.count += 1; } = 3;

    private static int hidden { get => field; set => field = value; } = 1;

    private static int issued = 0;

    public static int serial { get; set => field = value; } = Counter.next();

    public string stamp { get; set; } = Counter.label.uppercase();

    public int ticket { get; set; } = Counter.next();

    public Draft draft { get; set; } = new Draft();

    public int plain { get; set; } = 4;

    public late string later { get; set; }

    public static int next() => ++Counter.issued;
}
