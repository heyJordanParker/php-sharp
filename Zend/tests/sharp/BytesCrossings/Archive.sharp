namespace BytesCrossings;

import Lib.Streams;
import Lib.Streams.Stream;
import Sharp.Encoding.Hex;
import Sharp.Interop.Import;

public static class Archive
{
    [Import("file_put_contents")]
    public static int? write(string path, Bytes data) uses Files;

    public static Bytes held(Bytes data) => data;

    public static string listed(Bytes data) => Streams.described([data, data.slice(0, 1)]);

    public static string mapped(Bytes data) => Streams.described(["whole": data, "first": data.slice(0, 1)]);

    public static string read(Stream stream, int length) => Hex.encode(stream.read(length));

}
