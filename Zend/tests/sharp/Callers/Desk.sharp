namespace Callers;

public class Desk
{
    public static List<Position> calls()
    {
        const reports = new Reports();
        const log = Reports.logSlow;
        const file = new FileLog();
        Logs logs = new FileLog();
        List<Position> positions = [];
        return [
            Reports.logSlow("a static call"),
            Reports.logSlow("a named argument", caller: new Position("Given.sharp", 1, 1, "Callers.given")),
            reports.seen(1),
            new Note().made,
            log("through a function value"),
            new Note.stamped("a named constructor").made,
            new Note.blank().made,
            new Copy().made,
            Reports.pick<int>(1),
            file.log("an interface's default body"),
            logs.log("through the interface"),
            "text".at(),
            Reports.logSlow(...["a spread that holds no position"]),
            Reports.logSlow("a spread that may hold one", ...positions),
        ];
    }
}
