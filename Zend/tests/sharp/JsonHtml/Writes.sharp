namespace JsonHtml;

import Sharp.Encoding.Json;

// JSON text of a string that holds every character `escapeHtml` writes as its code.
public static class Writes
{
    public static string escaped() => Json.encode(["note": "</script><b a='1'>&\"x\""]);

    public static string kept() => Json.encode(["note": "</script><b a='1'>&\"x\""], escapeHtml: false);
}
