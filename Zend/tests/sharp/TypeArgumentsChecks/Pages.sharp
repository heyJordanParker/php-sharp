namespace Checks;

import App.Box;
import App.DatabaseEntity;
import App.Order;
import App.PaginatedList;
import Lib.Holder;

public class Pages
{
    public static PaginatedList<Customer> customers() => new PaginatedList<Customer>([]);

    public static string take(PaginatedList<Order> page) => "took";

    public static string open(Box<Any?> box) => "opened";

    public static string keep(Holder<Order> holder) => "kept";

    public static string relay(List<PaginatedList<Order>> pages) => Pages.take(pages[0]);

    public static Cell<float> floats() => new Cell<float>(0.5);

    public static Cell<float?> nullableFloats() => new Cell<float?>(null);

    public static Cell<float|string> floatsOrStrings() => new Cell<float|string>("none");

    public static bool two(Cell<float> cell) => cell.get() == 2.0;

    public static Page<Box<Order>> boxedOrders() => new Page<Box<Order>>();

    public static int count<T>(Page<Box<T>> page) => 1;

    public static Function<string(PaginatedList<Order>)> taker() => (PaginatedList<Order> page) => "took";

    public static string read(Feed<DatabaseEntity> feed) => "read";

    public static string nested(Feed<Feed<DatabaseEntity>> feeds) => "nested";

    public static string drain(Sink<Order> sink) => "drained";

    public static bool fed(Any value) => value is Feed<DatabaseEntity>;

    public static Stream<Order> orders() => new Stream<Order>();

    public static Stream<Customer> customerStream() => new Stream<Customer>();

    public static Stream<Feed<Order>> streams() => new Stream<Feed<Order>>();

    public static Drain<DatabaseEntity> entities() => new Drain<DatabaseEntity>();

    public static Drain<Customer> customerDrain() => new Drain<Customer>();
}
