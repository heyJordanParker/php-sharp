namespace HomeZones;

import Sharp.Encoding.Json;
import Sharp.Time.DateTime;
import Sharp.Time.Instant;
import Sharp.Time.TimeZone;

public static class Zones
{
    public static int? offsetMinutes(string name) => new TimeZone(name).fixedOffset?.minutes;

    public static string home(string name) => new HomeZone(new TimeZone(name)).zone.name;

    public static string encoded(string name) => Json.encode(new TimeZone(name));

    public static bool roundTrips(string name)
    {
        const zone = new TimeZone(name);
        const shown = Instant.parse("2026-10-22T18:30:00Z").unwrap().inZone(zone);

        return new TimeZone(zone.toString()) == zone && DateTime.parse(shown.toString()).unwrap() == shown && Json.parse<TimeZone>(Json.encode(zone)).unwrap() == zone;
    }
}
