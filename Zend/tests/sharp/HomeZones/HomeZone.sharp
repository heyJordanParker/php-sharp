namespace HomeZones;

import Sharp.Time.Duration;
import Sharp.Time.TimeZone;

// A user's home zone follows its region's daylight saving, so it takes no zone whose clocks never change.
public struct HomeZone
{
    public HomeZone(public TimeZone zone { get; })
    {
        if (zone.fixedOffset is Duration offset) {
            throw new ValueError(`A home zone follows its region's daylight saving, and the clocks of "${zone.name}" stay ${offset.minutes} minutes from UTC.`);
        }
    }
}
