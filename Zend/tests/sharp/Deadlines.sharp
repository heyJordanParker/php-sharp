namespace Demo;

class Deadlines
{
    public static List<int?> byDay(List<int?> days) => days.sortedBy(day => day);

    public static List<string?> byOwner(List<string?> owners) => owners.sortedBy(owner => owner);

    public static List<int?> byDue(Map<string, int?> tasks) => tasks.sortedBy(day => day);

    public static List<int> bySlot(Set<int> slots) => slots.sortedBy(slot => slot == 5 ? null : slot);
}
