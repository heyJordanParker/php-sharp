namespace AttributeObjects;

import Lib.Route;
import Lib.Throttle;

// An attribute on a machine case's field creates objects, as one on a constructor's parameter does.
public machine LinkStatus : string
{
    case Draft = "draft"
    {
        public LinkStatus.Forward forward(string? redirectUrl) => LinkStatus.Forward(redirectUrl);
    }

    final case Forward([Route("/forward", middleware: [new Throttle(perMinute: 20)])] string? redirectUrl) = "forward";

    public static LinkStatus.Draft open() => LinkStatus.Draft;
}
