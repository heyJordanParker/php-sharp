namespace Arrivals;

import Illuminate.Container.Attributes.Give;
import Illuminate.Contracts.Support.Arrayable;
import Illuminate.Database.UniqueConstraintViolationException;
import Illuminate.Support.Collection;

// Give declares a bare array $params, and UniqueConstraintViolationException a $columns its PHPDoc types list<string>.
public class Reader
{
    public bool records(Give give) => give.params as Map<int|string, Any?> != null;

    public bool heldRecords(Give give)
    {
        const records = give.params;
        return records as Map<int|string, Any?> != null;
    }

    public bool heldRecordsValues(Give give)
    {
        const records = give.params;
        List<Any?> rows = records.values();
        return rows.count() == 1;
    }

    public bool recordsMap(Give give) => give.params is Map<int|string, Any?>;

    public bool listed(UniqueConstraintViolationException violation) => violation.columns as List<string> != null;

    public bool heldListed(UniqueConstraintViolationException violation)
    {
        const listed = violation.columns;
        return listed as List<string> != null;
    }

    public string? status(Source source) => source.status().get("status");

    public string? heldStatus(Source source)
    {
        const status = source.status();
        return status.get("status");
    }

    public string? typedStatus(Source source)
    {
        Map<string, string> status = source.status();
        return status.get("status");
    }

    public string? argument(Source source) => this.first(source.status());

    public string? constructed(Source source) => new Holder(source.status()).status();

    public string? element(Source source)
    {
        List<Map<string, string>> all = [source.status()];
        return all[0].get("status");
    }

    public string? spread(Source source)
    {
        Map<string, string> all = [...source.status()];
        return all.get("status");
    }

    public string? late(Source source) => source.madeBySelf().get("status");

    // Only the run-time class is known, so its static runs through reflection, spec section 25. An invoker states the
    // effects the static may have, so a plain PHP override no `extern` line declares, which may have every effect, is
    // refused.
    public string? ofClass(Source source)
    {
        try {
            return (Class.of(source).methods()
                .first(method => method.name == "made")
                .createInvoker<Function<Any?(List<Any?>)>>()([]) as Map<string, string>)
                ?.get("status");
        } catch (ValueError refused) {
            return refused.getMessage();
        }
    }

    public string? maybe(Source? source) => source?.status().get("status");

    // Arrayable::toArray() and Collection::all() document array<TKey, TValue>.
    public string? fed(Arrayable<string, string> feed)
    {
        Map<int|string, Any?> payload = [...feed.toArray(), "extra": "kept"];
        return payload.get("status") as string;
    }

    public int named(Collection<int, string> feed)
    {
        List<string> names = [...feed.all(), "third"];
        return names.count();
    }

    private string? first(Map<string, string> status) => status.get("status");
}
