namespace Arrivals;

import Sharp.Encoding.Json;
import Sharp.Encoding.JsonValue;

// `[]` is the empty `List`, spec section 12, so an `is` test of it against a `Map` of string keys is false, while a
// typed boundary takes plain PHP's `[]` as the empty `Map` it declares.
public static class EmptyTests
{
    public static string run()
    {
        const empty = Json.parse<JsonValue>("[]").unwrap().value;
        const braces = Json.parse<JsonValue>("{}").unwrap().value;
        List<int> made = [];
        Any? held = made;
        return `json[]:${EmptyTests.bound(empty)} json{}:${EmptyTests.bound(braces)} json{}isList:${braces is List<Any?>} made[]:${EmptyTests.bound(held)}`;
    }

    private static string bound(Any? value)
    {
        if (value is Map<string, Any?> entries) {
            return `map ${Json.encode(entries)}`;
        }

        return "not a map";
    }

    public static int count(Map<string, int> counts) => counts.count();
}
