namespace Demo;

public class Payments
{
    public PaymentResult decline(string reason) => PaymentResult.Declined(reason: reason);

    public PaymentResult pay(string id) => PaymentResult.Paid(id);

    public string settle(PaymentResult.Paid paid) => paid.transactionId;

    public CheckoutState open() => CheckoutState.Open;

    public CheckoutState paying() => CheckoutState.Paying(gateway: "stripe");

    public string describe(PaymentResult result) => match (result) {
        PaymentResult.Paid(string transactionId) => `Paid ${transactionId}`,
        PaymentResult.Declined { reason: "card expired" } => "Expired",
        PaymentResult.Declined declined => `Declined: ${declined.reason}`,
        default => "Redirect",
    };

    public bool waiting(CheckoutState state) => state is CheckoutState.Open;

    public string outcome(PaymentResult result) => match (result) {
        PaymentResult.Paid p => "paid",
        PaymentResult.Declined(string reason) => reason,
        PaymentResult.RequiresAction(string redirect) => redirect,
    };

    public string interacted(Interaction interaction) => match (interaction) {
        PopupInteraction popup => popup.name(),
        ScrollInteraction scroll => `${scroll.name()} ${scroll.depth}`,
    };
}
