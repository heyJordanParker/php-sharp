namespace Demo;

import RuntimeException;

class Leave
{
    private int finished = 0;

    public int charge(string order, int price) => price * 2;

    public int price(Map<string, int> prices, string plan)
    {
        try {
            return this.charge(`order ${plan}`, prices[plan] ?? return -1);
        } finally {
            this.finished = this.finished + 1;
        }
    }

    public int finishedCount() => this.finished;

    public string upper(string text) => `<${text}>`;

    public string label(Map<string, string> names, string key) =>
        `${this.upper(key)} is ${names[key] ?? return `${this.upper(key)} is missing`}`;

    public Circle? circle(float? radius) => new Circle(radius ?? return null);

    public int total(List<int?> values)
    {
        let total = 0;
        for (const value of values) {
            total += this.charge(`${total}`, value ?? continue);
        }
        return total;
    }

    public int upTo(List<int?> values)
    {
        let total = 0;
        for (const value of values) {
            try {
                total += this.charge(`${total}`, value ?? break);
            } finally {
                this.finished = this.finished + 1;
            }
        }
        return total;
    }

    public int fail(string plan)
    {
        throw new RuntimeException(`no ${plan}`);
    }

    public int recovered(Map<string, int> prices, string plan)
    {
        try {
            return this.charge(`order ${plan}`, prices[plan] ?? return this.fail(plan));
        } catch (RuntimeException failure) {
            return -2;
        }
    }

    public int nested(Map<string, int> prices, string plan, string fallback) =>
        this.charge(plan, prices[plan] ?? return this.charge(fallback, prices[fallback] ?? return -3));

    public int counted(List<List<int?>> rows)
    {
        let total = 0;
        for (const values of rows) {
            for (let i = 0; i < 10 && (values[i] ?? break) > 0; i += 1) {
                total += 1;
            }
            total += 100;
        }
        return total;
    }

    public int skipped(List<int?> values)
    {
        let seen = 0;
        for (let i = 0; i < values.count() && (values[i] ?? continue) > 0; i += 1) {
            seen += 1;
        }
        return seen;
    }

    public int stepped(List<int?> values)
    {
        let i = 0;
        let steps = 0;
        for (; i < 3; i = values[i] ?? break) {
            steps += 1;
        }
        return steps;
    }

    public int after(List<int?> values)
    {
        let i = 0;
        do {
            i += 1;
        } while ((values[i] ?? break) > 0);
        return i;
    }
}
