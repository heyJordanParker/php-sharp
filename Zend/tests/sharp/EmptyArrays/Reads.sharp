namespace EmptyArrays;

import Sharp.Encoding.Json;
import Sharp.Encoding.JsonValue;

// What `as` and `is` give a plain PHP array. An empty one is a list, as PHP's `array_is_list([])` is, so it holds no `Map` of string keys.
public static class Reads
{
    public static List<Any?> of(Any? value)
    {
        const map = value as Map<string, Any?>;
        const list = value as List<int>;
        return [
            map != null,
            map?.count(),
            list != null,
            list?.count(),
            value is Map<string, Any?>,
            value is List<int>,
        ];
    }

    // An empty JSON object and an empty JSON array, read back as what `encode` writes them from.
    public static List<bool> parsed()
        => [
            Json.parse<JsonValue>("{}").unwrap().value is Map<string, Any?>,
            Json.parse<JsonValue>("{}").unwrap().value is List<Any?>,
            Json.parse<JsonValue>("[]").unwrap().value is List<Any?>,
            Json.parse<JsonValue>("[]").unwrap().value is Map<string, Any?>,
            Json.encode(Json.parse<JsonValue>("{}").unwrap().value) == "{}",
            Json.encode(Json.parse<JsonValue>("[]").unwrap().value) == "[]",
        ];
}
