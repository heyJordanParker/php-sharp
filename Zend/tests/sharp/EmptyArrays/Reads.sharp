namespace EmptyArrays;

import Sharp.Encoding.Json;

// What `as` and `is` give a plain PHP array, which holds no element that tells a `Map` from a `List` when it is empty.
public static class Reads
{
    public static List<Any?> of(Any? value)
    {
        const map = value as Map<string, Any?>;
        const list = value as List<int>;
        return [
            map != null,
            map?.count(),
            list != null,
            list?.count(),
            value is Map<string, Any?>,
            value is List<int>,
        ];
    }

    // An empty JSON object and an empty JSON array, read back as what `encode` writes them from.
    public static List<bool> parsed()
        => [
            Json.parse("{}").value is Map<string, Any?>,
            Json.parse("{}").value is List<Any?>,
            Json.parse("[]").value is List<Any?>,
            Json.parse("[]").value is Map<string, Any?>,
            Json.encode(Json.parse("{}").value) == "{}",
            Json.encode(Json.parse("[]").value) == "[]",
        ];
}
