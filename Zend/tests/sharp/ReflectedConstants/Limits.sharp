namespace ReflectedConstants;

import Lib.Field;

public class Limits
{
    [Field("max")]
    public const int MAX = 10;
    public const Map<string, int> PER_SIZE = ["small": 2, "large": 5];
    private const string CODE = "lim";

    public static string code() => typeof(Limits).constants()[2].value() as string ?? "";
}
