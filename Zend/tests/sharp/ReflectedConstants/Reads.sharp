namespace ReflectedConstants;

import Lib.Field;

public static class Reads
{
    // Each constant's name, type and value, the class's own first, as `constants()` gives them.
    public static List<string> listed(Class<Limits> kind)
        => kind.constants().map(
            constant => `${constant.name}: ${constant.type.name()} of ${constant.declaringClass.name()}`
        );

    public static List<Any?> values()
    {
        const constants = typeof(Limits).constants();

        return [
            constants[0].value(),
            constants[1].value() is Map<string, int> map ? map.get("large") : null,
            constants[1].value() == Limits.PER_SIZE,
            constants[0].attributes<Field>().count(),
            constants[0] == typeof(Limits).constants()[0],
            constants[0].hash() == typeof(Limits).constants()[0].hash(),
            Limits.code(),
        ];
    }

    public static string refused()
    {
        try {
            typeof(Limits).constants()[2].value();
        } catch (Throwable error) {
            return error.getMessage();
        }

        return "read";
    }
}
