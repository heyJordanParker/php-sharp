namespace Demo;

public struct Wristband
{
    public Wristband(public Map<string, int> counts { get; }) { }
}

public class Shared
{
    private static Map<string, int> counts = [:];

    public static List<Map<string, int>> write()
    {
        Shared.counts = ["a": 1];
        const kept = Shared.counts;
        Shared.counts["a"] = 2;
        Shared.counts["b"] = 3;
        return [kept, Shared.counts];
    }
}

public class Guarded
{
    public Map<string, int> getOnly { get; } = ["a": 1];
    public Map<string, int> initOnly { get; init; } = ["a": 1];
    public Map<string, int> hooked
    {
        get => field;
        set => field = value;
    } = ["a": 1];
    public Map<string, int> setHooked { get; set => field = value; } = ["a": 1];
}
