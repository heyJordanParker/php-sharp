namespace Demo;

import Lib.RowSet;

public class Grid
{
    public List<List<int>> rows { get; set; } = [[1, 2], [3]];
    public int writes { get; private set; } = 0;
    public List<Map<string, int>> tallies
    {
        get => field;
        set {
            field = value;
            this.writes = this.writes + 1;
        }
    } = [["a": 1]];
    public Map<string, int> totals
    {
        get => field;
        set {
            field = value;
            this.writes = this.writes + 1;
        }
    } = ["a": 1];
    public List<List<int>> table
    {
        get => field;
        set {
            field = value;
            this.writes = this.writes + 1;
        }
    } = [[1, 2], [3]];
    public List<List<int>?> spare { get; set; } = [[1], null];
    public List<List<int>?> lines
    {
        get => field;
        set {
            field = value;
            this.writes = this.writes + 1;
        }
    } = [[1], null];
    private int calls = 0;

    public static List<List<int>> changed(List<List<int>> grid)
    {
        let rows = grid;
        rows[0].add(5);
        rows[1].insert(0, 7);
        rows[0].remove(1);
        rows[1][0] = 8;
        return rows;
    }

    public static List<List<int>> cleared(List<List<int>> grid, int row)
    {
        let rows = grid;
        rows[row].clear();
        return rows;
    }

    public static List<List<int>> kept(List<List<int>> grid)
    {
        List<List<int>> copy = grid;
        let grown = grid;
        grown[0].add(grown[0].count());
        return [copy[0], grown[0]];
    }

    public static List<List<List<int>>> deep(List<List<List<int>>> cube)
    {
        let layers = cube;
        layers[1][0].add(3);
        return layers;
    }

    public static List<Set<int>> sets(List<Set<int>> sets)
    {
        let changed = sets;
        changed[0].add(4);
        changed[1].remove(2);
        return changed;
    }

    public static List<Map<string, int>> maps(List<Map<string, int>> maps)
    {
        let changed = maps;
        changed[0].remove("a");
        changed[1]["c"] = 3;
        changed[1]["b"] ??= 9;
        changed[0]["d"] ??= 4;
        return changed;
    }

    public List<List<int>> held()
    {
        this.rows[0].add(9);
        this.rows[1].clear();
        return this.rows;
    }

    public List<Map<string, int>> hooked()
    {
        this.tallies[0]["b"] = 2;
        this.tallies[0].remove("a");
        return this.tallies;
    }

    public Map<string, int> totalled()
    {
        this.totals["c"] = 3;
        this.totals["a"] ??= 9;
        this.totals["d"] ??= 4;
        return this.totals;
    }

    public List<List<int>> once(List<List<int>> grid)
    {
        let rows = grid;
        rows[this.next()].remove(2);
        return rows;
    }

    public static List<List<int>> missing(List<List<int>> grid, int row)
    {
        let rows = grid;
        rows[row].add(1);
        return rows;
    }

    public static List<Map<string, int>> missingWrite(List<Map<string, int>> maps, int row)
    {
        let changed = maps;
        changed[row]["c"] = 3;
        return changed;
    }

    public List<List<int>> emptied()
    {
        this.table[0].clear();
        return this.table;
    }

    public static List<Any?> skipped(List<List<int>?> grid)
    {
        let rows = grid;
        rows[0]?.add(5);
        rows[1]?.add(6);
        rows[1]?.clear();
        return [rows, rows[1]?.remove(1), rows[1]?.contains(1), rows[1]?.count()];
    }

    public List<Any?> spareSkipped()
    {
        this.spare[0]?.add(5);
        this.spare[1]?.add(6);
        this.spare[1]?.clear();
        return [this.spare, this.spare[1]?.remove(1), this.spare[1]?.contains(1), this.spare[1]?.count()];
    }

    public List<Any?> linesSkipped()
    {
        this.lines[0]?.add(5);
        this.lines[1]?.add(6);
        this.lines[1]?.clear();
        return [this.lines, this.lines[1]?.remove(1), this.lines[1]?.contains(1), this.lines[1]?.count()];
    }

    public static List<Any?> otherSkips(List<List<int>?> grid, List<Map<string, int>?> maps, List<Set<int>?> sets)
    {
        let rows = grid;
        let tables = maps;
        let groups = sets;
        rows[0]?.insert(0, 1);
        groups[0]?.add(1);
        groups[0]?.clear();
        return [
            rows, rows[0]?.indexOf(1), rows[0]?.last(), rows[0]?.entries(),
            tables, tables[0]?.remove("a"), tables[0]?.has("a"),
            groups, groups[0]?.remove(1), groups[0]?.contains(1),
        ];
    }

    public static List<List<int>?> pastAdd(List<List<int>?> grid)
    {
        let rows = grid;
        rows[9]?.add(1);
        return rows;
    }

    public static List<List<int>?> pastClear(List<List<int>?> grid)
    {
        let rows = grid;
        rows[9]?.clear();
        return rows;
    }

    public static List<List<int>?> pastRemove(List<List<int>?> grid)
    {
        let rows = grid;
        rows[9]?.remove(1);
        return rows;
    }

    public static int? pastCount(List<List<int>?> grid) => grid[9]?.count();

    public static bool? pastContains(List<List<int>?> grid) => grid[9]?.contains(1);

    public static Any? pastEntries(List<List<int>?> grid) => grid[9]?.entries();

    public int? spareMissing() => this.spare[9]?.count();

    public static bool tested(List<int?> sizes, int at) => sizes[at] is int;

    public static int? cast(List<int?> sizes, int at) => sizes[at] as int;

    public static string matched(List<int?> sizes, int at) => match (sizes[at]) {
        int size => `size ${size}`,
        default => "none",
    };

    public void linesMissing()
    {
        this.lines[9]?.add(7);
    }

    public List<List<int>> rowsMissing(int row)
    {
        this.rows[row].add(7);
        return this.rows;
    }

    public List<List<int>> tableMissing(int row)
    {
        this.table[row].add(7);
        return this.table;
    }

    public static List<int> doubled(RowSet rows) => rows[0].map(n => n * 2);

    public static List<int> replaced(List<int> sizes, int at, int value)
    {
        let changed = sizes;
        changed[at] = value;
        return changed;
    }

    public static List<int> stepped(List<int> sizes)
    {
        let steps = sizes;
        steps[0] += 10;
        steps[1] -= 1;
        steps[1] *= 3;
        steps[2] /= 2;
        ++steps[0];
        --steps[1];
        const before = steps[0]++;
        const after = steps[1]--;
        const given = steps[2] = 40;
        return [before, after, given, steps[0], steps[1], steps[2]];
    }

    public static List<Any> joined(List<string> names, List<float> ratios)
    {
        let marked = names;
        let raised = ratios;
        marked[0] += "!";
        raised[0] += 0.5;
        const before = raised[0]++;
        return [marked, raised, before];
    }

    public static int stepPast(List<int> sizes)
    {
        let steps = sizes;
        return steps[5]++;
    }

    public List<List<int>> rowsReplaced()
    {
        this.rows[0][1] = 9;
        this.rows[1] = [4, 5];
        this.rows[1][0] += 1;
        return this.rows;
    }

    public List<List<int>> tableReplaced()
    {
        this.table[1] = [7];
        this.table[0][0] += 5;
        return this.table;
    }

    public List<List<int>> stepOnce(List<List<int>> grid)
    {
        let rows = grid;
        rows[this.next()][this.next()] += 10;
        return rows;
    }

    private int next()
    {
        this.calls = this.calls + 1;
        return this.calls - 1;
    }
}
