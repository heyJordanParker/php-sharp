namespace Demo;

import Sharp.Interop.Import;

// An `[Import]` result takes a native closure under its stated function type, as an `extern` result does, since PHP
// never declares a closure's types: `set_error_handler` gives back whatever handler plain PHP installed before.
public static class Errors
{
    [Import("set_error_handler")]
    public static Function<bool?(int, string, string, int)>? swap(Function<bool?(int, string, string, int)>? handler) uses PhpGlobals;

    [Import("array_values")]
    public static List<int> values(List<int> items);
}
