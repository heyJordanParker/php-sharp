namespace Demo;

import Billing.Money;

public class CollectionQueries
{
    public static int? firstEven(List<int> values) => values.firstOrNull(value => value % 2 == 0);

    public static string? firstLong(Map<string, string> names) => names.firstOrNull(name => name.length() > 3);

    public static string? firstTag(Set<string> tags) => tags.firstOrNull(tag => tag.startsWith("v"));

    public static int? firstNegative(List<int> values) => values.indexOfFirst(value => value < 0);

    public static string shortest(List<string> words) => words.minBy(word => word.length());

    public static string longest(List<string> words) => words.maxBy(word => word.length());

    public static List<string> longestFirst(List<string> words) => words.sortedByDescending(word => word.length());

    public static List<string> byLastLetter(List<string> words)
        => words.sortedWith((a, b) => a.substring(a.length() - 1) <=> b.substring(b.length() - 1));

    public static List<string> byLengthThenText(List<string> words) => words.sortedBy(word => [word.length(), word]);

    public static List<int> byPriceThenCount(List<int> counts, List<Money> prices)
        => counts.sortedBy(count => [prices[count], -count]);

    public static List<int> byOptionalNameThenCount(Map<int, string?> names)
        => names.keys().sortedBy(count => [names.get(count), count]);

    public static List<[int, string]> zipped(List<int> numbers, List<string> words) => numbers.zip(words);

    public static List<List<int>> windows(List<int> values, int size) => values.windowed(size);

    public static [List<int>, List<int>] evensFirst(List<int> values) => values.partition(value => value % 2 == 0);

    public static int? find(List<int> sorted, int sought) => sorted.binarySearch(value => value <=> sought);

    public static int insertionPoint(List<int> sorted, int sought) => sorted.partitionPoint(value => value < sought);

    public static [bool, List<int>] withoutNegatives(List<int> values)
    {
        let kept = values;
        const removed = kept.removeAll(value => value < 0);
        return [removed, kept];
    }

    public static [int, int, Map<string, int>, int] counted(Map<string, int> counts)
    {
        let calls = 0;
        let filled = counts;
        const held = filled.getOrPut("tea", () => { calls += 1; return 9; });
        const added = filled.getOrPut("jam", () => { calls += 1; return 4; });
        return [held, added, filled, calls];
    }

    public static Set<string> union(Set<string> first, Set<string> second) => first.union(second);

    public static Set<string> intersect(Set<string> first, Set<string> second) => first.intersect(second);

    public static Set<string> subtract(Set<string> first, Set<string> second) => first.subtract(second);

    public static bool isSubset(Set<string> first, Set<string> second) => first.isSubsetOf(second);
}
