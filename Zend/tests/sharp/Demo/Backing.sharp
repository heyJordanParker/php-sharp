namespace Demo;

import Sharp.BigInteger;
import Sharp.Bytes;
import Sharp.Decimal;
import Sharp.Encoding.Base64;
import Sharp.Encoding.Json;
import Sharp.Net.IpAddress;
import Sharp.Net.Url;
import Sharp.Time.Date;
import Sharp.Time.DateTime;
import Sharp.Time.Duration;
import Sharp.Time.Instant;
import Sharp.Time.TimeOfDay;

// Spec section 10: a backed struct is stored as its value, which its `parse` reads back through its constructor. The
// ten standard library types stored as text round-trip through `Json.encode` and `Json.parse` to the text 0.7.6 writes.
public static class Backing
{
    public static List<string> answers()
    {
        const signup = new Signup(new Email("a@b.c"), new UserId(7));
        const encoded = Json.encode(signup);
        const decoded = Json.parse<Signup>(encoded).unwrap();
        List<string> lines = [
            `encoded: ${encoded}`,
            `decoded: ${decoded.email.value} ${decoded.id.value}`,
            `equal: ${Backing.shown(decoded == signup)}`,
            `parsed: ${Email.parse("x@y.z").unwrap().value}`,
            `same value: ${Backing.shown(new UserId(7) == new UserId(7))}, other value: ${Backing.shown(new UserId(7) == new UserId(8))}`,
            `map: ${Json.encode([new UserId(3): "three"])}`,
            `decimal: ${Json.encode(Decimal.parse("1.50").unwrap())}`,
            Json.encode(Json.parse<Decimal>(Json.encode(Decimal.parse("1.50").unwrap())).unwrap()),
            Json.encode(Json.parse<BigInteger>(Json.encode(BigInteger.parse("9223372036854775808").unwrap())).unwrap()),
            Json.encode(Json.parse<Instant>(Json.encode(Instant.parse("2026-10-22T18:30:00Z").unwrap())).unwrap()),
            Json.encode(Json.parse<Date>(Json.encode(Date.parse("2026-01-31").unwrap())).unwrap()),
            Json.encode(Json.parse<Duration>(Json.encode(Duration.parse("PT1H30M").unwrap())).unwrap()),
            Json.encode(Json.parse<IpAddress>(Json.encode(IpAddress.parse("2001:db8::1").unwrap())).unwrap()),
            Json.encode(Json.parse<Bytes>(Json.encode(Base64.decode("aGk="))).unwrap()),
            Json.encode(Json.parse<Url>(Json.encode(Url.parse("https://example.com/a").unwrap())).unwrap()),
            Json.encode(Json.parse<DateTime>(Json.encode(DateTime.parse("2026-10-22T20:30:00+02:00[Europe/Paris]").unwrap())).unwrap()),
            Json.encode(Json.parse<TimeOfDay>(Json.encode(TimeOfDay.parse("18:30:00").unwrap())).unwrap()),
        ];
        const kitchen = new Reading(20, "kitchen");
        const hall = new Reading(20, "hall");
        Map<Reading, string> seen = [:];
        seen[kitchen] = "kitchen";
        seen[hall] = "hall";
        lines.add(`readings ==: ${Backing.shown(kitchen == hall)}, keys: ${seen.count()}`);
        lines.add(match (Json.parse<Signup>("{\"email\":\"not-an-email\",\"id\":1}")) {
            Result.Ok(Signup read) => "bad email: read",
            Result.Err(ParseError error) => `bad email: ${error.message}`,
        });

        return lines;
    }

    private static string shown(bool value) => value ? "true" : "false";
}
