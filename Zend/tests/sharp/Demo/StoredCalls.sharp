namespace Demo;

import Sharp.Encoding.Json;
import StoredValues.Parcel;
import StoredValues.RecordedEvent;

// A storage layer outside the namespace of RecordedEvent, which can't read its internal sequence itself.
public static class StoredCalls
{
    public static RecordedEvent recorded() => new RecordedEvent("shipped", 7);

    public static bool recordedFormIsMap(RecordedEvent recorded)
        => typeof(RecordedEvent).encode(recorded) is Map<string, Any?>;

    public static Any? recordedForm(RecordedEvent recorded) => typeof(RecordedEvent).encode(recorded);

    public static bool recordedReadsBack(RecordedEvent recorded)
        => typeof(RecordedEvent).parse(typeof(RecordedEvent).encode(recorded)).unwrap() == recorded;

    public static Parcel parcel() => new Parcel([7: "top", 8: "floor"], ["fragile", "dry"]);

    public static bool parcelReadsBack(Parcel parcel) => typeof(Parcel).parse(typeof(Parcel).encode(parcel)).unwrap() == parcel;

    // Whether json_encode, with Json.encode's flags, writes the stored form of `value` as Json.encode writes `value`.
    // Json.encode reads `stored` in the engine, where a Map stays one, as plain PHP's json_encode never sees it.
    private static bool writesAlike(Any? value, Any? stored) => Json.encode(stored) == Json.encode(value);

    // The JSON text of each value library_json.phpt encodes, keyed to whether its stored form writes alike.
    public static Map<string, bool> written()
    {
        Map<string, int> none = [:];
        List<int> empty = [];
        Map<string, Any> loose = ["counts": none, "lines": empty];
        Map<int, string> numbered = [0: "a", 1: "b"];
        Map<JsonTag, int> tagged = [new JsonTag("red"): 1];
        const order = new JsonOrder(7, ["new", "vip"], new JsonPoint(2));
        const parcel = StoredCalls.parcel();

        return [
            Json.encode(none): StoredCalls.writesAlike(none, typeof(Map<string, int>).encode(none)),
            Json.encode(empty): StoredCalls.writesAlike(empty, typeof(List<int>).encode(empty)),
            Json.encode(loose): StoredCalls.writesAlike(loose, typeof(Map<string, Any>).encode(loose)),
            Json.encode(numbered): StoredCalls.writesAlike(numbered, typeof(Map<int, string>).encode(numbered)),
            Json.encode(tagged): StoredCalls.writesAlike(tagged, typeof(Map<JsonTag, int>).encode(tagged)),
            Json.encode(order): StoredCalls.writesAlike(order, typeof(JsonOrder).encode(order)),
            Json.encode(parcel): StoredCalls.writesAlike(parcel, typeof(Parcel).encode(parcel)),
            Json.encode(1.0): StoredCalls.writesAlike(1.0, typeof(float).encode(1.0)),
            Json.encode("a/é <b>"): StoredCalls.writesAlike("a/é <b>", typeof(string).encode("a/é <b>")),
        ];
    }
}
