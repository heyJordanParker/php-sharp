namespace Demo;

public class MathQueries
{
    public static List<float> logs(float x) => [Math.log10(x), Math.exp(x)];

    public static List<float> trigonometry(float x) => [Math.sin(x), Math.cos(x), Math.tan(x), Math.asin(x), Math.acos(x), Math.atan(x)];

    public static float angle(float y, float x) => Math.atan2(y, x);

    public static List<float> constants() => [Math.PI, Math.E];

    public static bool isNaN(float x) => x.isNaN();

    public static List<int?> checked(int a, int b) => [a.checkedAdd(b), a.checkedSubtract(b), a.checkedMultiply(b)];

    public static List<int> saturating(int a, int b) => [a.saturatingAdd(b), a.saturatingSubtract(b), a.saturatingMultiply(b)];

    public static int parsed(string text, int radix) => Int.parse(text, radix).unwrap();

    public static int? tryParse(string text, int radix) => Int.parse(text, radix).ok();
}
