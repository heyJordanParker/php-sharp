namespace Demo;

import Sharp.Encoding.Json;

public class Pick
{
    public static Iterable<Any?> of(bool list) => list ? [1] : ["a": 1];

    public static Iterable<Any?> decoded(string json) => Json.parse<Map<string, Any?>>(json).unwrap();

    public static List<string> looped(Iterable<Any?> value)
    {
        List<string> seen = [];
        for (const element of value) {
            seen.add(Json.encode(element));
        }

        return seen;
    }

    public static string entries(Iterable<[string, int]> pairs)
    {
        List<string> seen = [];
        for (const [key, number] of pairs) {
            seen.add(`${key}=${number}`);
        }

        return `${pairs is Map<string, int> ? "a Map" : "no Map"}: ${seen.join(", ")}`;
    }

    private static string shown(bool holds) => holds ? "true" : "false";

    public static List<string> answers() => [
        `list is List: ${Pick.shown(Pick.of(true) is List<Any?>)}`,
        `map is Map: ${Pick.shown(Pick.of(false) is Map<string, Any?>)}`,
        `map is List: ${Pick.shown(Pick.of(false) is List<Any?>)}`,
        `list loop: ${Pick.looped(Pick.of(true)).join(" ")}`,
        `map loop: ${Pick.looped(Pick.of(false)).join(" ")}`,
        `parameter: ${Pick.entries(["a": 1, "b": 2])}`,
        `decoded is Map: ${Pick.shown(Pick.decoded("{\"a\":1}") is Map<string, Any?>)}`,
    ];
}
