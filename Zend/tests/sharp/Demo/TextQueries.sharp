namespace Demo;

import Sharp.Text.NormalizationForm;

class TextQueries
{
    public static List<int> compared(string text, string other)
        => [text.compareTo(other), text.compareTo(other, ignoreCase: true)];

    public static List<bool> equal(string text, string other) => [text.equals(other), text.equals(other, true)];

    public static List<int?> found(string text, string other)
        => [text.indexOf(other), text.indexOf(other, 0, true), text.lastIndexOf(other), text.lastIndexOf(other, true)];

    public static List<bool> held(string text, string other)
        => [
            text.contains(other),
            text.contains(other, true),
            text.startsWith(other),
            text.startsWith(other, true),
            text.endsWith(other),
            text.endsWith(other, true),
        ];

    public static List<bool> emptiness(string text) => [text.isEmpty(), text.isNotEmpty()];

    public static string titled(string text) => text.titlecase();

    public static string replaced(string text, string old, string @new, int? limit) => text.replace(old, @new, limit);

    public static string replacedAll(string text, string old, string @new) => text.replace(old, @new);

    public static string character(int codePoint) => codePoint.toCharacter();

    public static string bytes(List<int> values) => values.toBytes().toText();

    public static List<bool> classes(string text)
        => [text.isLetter(), text.isDigit(), text.isLetterOrDigit(), text.isWhitespace(), text.isUppercase(), text.isLowercase()];

    public static string composed(string text) => text.normalized();

    public static string decomposed(string text) => text.normalized(NormalizationForm.D);

    public static string compatible(string text) => text.normalized(NormalizationForm.KC);

    public static string compatibleDecomposed(string text) => text.normalized(NormalizationForm.KD);
}
