namespace Demo;

// A temperature stored as its degrees, with the sensor that read it, which its stored value leaves out.
public struct Reading : int
{
    public Reading(public int celsius { get; }, public string sensor { get; }) { }

    public int value => this.celsius;

    public static Result<Reading, ParseError> parse(Any? value)
        => value is int celsius ? Result.Ok(new Reading(celsius, "")) : Result.Err(new ParseError(["": "expected int"]));
}
