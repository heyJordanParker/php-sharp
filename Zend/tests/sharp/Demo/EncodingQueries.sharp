namespace Demo;

import Sharp.Encoding.Base64;
import Sharp.Encoding.Hex;

class EncodingQueries
{
    public static string encode(Bytes data, bool urlSafe) => Base64.encode(data, urlSafe);

    public static string decode(string text, bool urlSafe) => Hex.encode(Base64.decode(text, urlSafe));

    public static string toBytes(int value, ByteOrder order) => Hex.encode(value.toBytes(order));

    public static string bigEndian(int value) => Hex.encode(value.toBytes());

    public static int fromBytes(Bytes bytes, ByteOrder order) => Int.fromBytes(bytes, order);

    public static int fromBigEndian(Bytes bytes) => Int.fromBytes(bytes);

    public static string toCsv(List<string> fields) => fields.toCsv();

    public static List<string> parseCsv(string text) => text.parseCsv();
}
