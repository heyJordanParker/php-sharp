namespace Demo;

import Sharp.Net.IpAddress;
import Sharp.Net.IpFamily;

public class NetworkQueries
{
    public static string? normalized(string text) => IpAddress.parse(text).ok()?.toString();

    public static string parsed(string text) => IpAddress.parse(text).unwrap().toString();

    public static IpFamily family(string text) => IpAddress.parse(text).unwrap().family;

    public static List<bool> facts(string text)
    {
        const address = IpAddress.parse(text).unwrap();

        return [address.isLoopback(), address.isPrivate()];
    }

    public static bool same(string a, string b) => IpAddress.parse(a).unwrap() == IpAddress.parse(b).unwrap();
}
