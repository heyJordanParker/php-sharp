namespace Demo;

import Sharp.Net.IpAddress;
import Sharp.Net.IpFamily;

public class NetworkQueries
{
    public static string? normalized(string text) => IpAddress.tryParse(text)?.toString();

    public static string parsed(string text) => IpAddress.parse(text).toString();

    public static IpFamily family(string text) => IpAddress.parse(text).family;

    public static List<bool> facts(string text)
    {
        const address = IpAddress.parse(text);

        return [address.isLoopback(), address.isPrivate()];
    }

    public static bool same(string a, string b) => IpAddress.parse(a) == IpAddress.parse(b);
}
