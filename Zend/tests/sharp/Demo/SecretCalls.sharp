namespace Demo;

import Sharp.Encoding.Json;
import Sharp.Security.Hashed;
import Sharp.Security.Secret;

public static class SecretCalls
{
    public static List<Any?> secret()
    {
        const account = Json.decode<SmtpAccount>("{\"host\":\"smtp.example.com\",\"password\":\"hunter2\"}");
        const stored = Json.encode(account);

        return [
            account.password.value,
            `password: ${account.password}`,
            stored,
            Json.decode<SmtpAccount>(stored).password.value,
            new SmtpAccount("smtp.example.com", new Secret<string>("hunter2")).password.value,
        ];
    }

    public static List<Any?> hashed()
    {
        const user = Json.decode<User>("{\"email\":\"ada@example.com\",\"password\":\"hunter2\"}");
        const stored = Json.encode(user);

        return [
            user.password.verify("hunter2"),
            `password: ${user.password}`,
            stored,
            Json.decode<User>(stored).password.verify("hunter2"),
            new User("ada@example.com", new Hashed<string>("hunter2")).password.verify("hunter2"),
            new Hashed<int>(4821).verify(4821),
        ];
    }

    public static string encoded(string password) => Json.encode(new SmtpAccount("smtp.example.com", new Secret<string>(password)));

    public static string decoded(string stored) => Json.decode<SmtpAccount>(stored).password.value;

    public static string relayed(string stored) => Json.decode<Relay>(stored).token.value;

    public static string alone() => Json.encode(new Secret<string>("hunter2"));

    public static Secret<string> held() => new Secret<string>("hunter2");
}
