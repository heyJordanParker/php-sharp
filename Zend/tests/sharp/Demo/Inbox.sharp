namespace Demo;

import Illuminate.Database.Eloquent.Casts.Json;
import Illuminate.Support.Arr;

// Arr::get() and Json::encode() take and give mixed.
public class Inbox
{
    private Any first = "none";
    private Map<string, Any?> saved = [:];

    public Inbox(private Map<string, Any?> settings) { }

    public Any? read(string key) => Arr.get(this.settings, key);

    public Any? raw(string key)
    {
        Any? value = Arr.get(this.settings, key);
        return value;
    }

    public Any keep(Any value)
    {
        this.first = value;
        return this.first;
    }

    public string show(string key) => Json.encode(this.read(key)) as string ?? "";

    public bool isPlan(string plan) => this.read("plan") == plan;

    public void save(string key)
    {
        this.saved[key] = Arr.get(this.settings, key);
    }

    public Any? load(string key) => this.saved[key] ?? null;

    public string showSaved(string key) => Json.encode(this.saved[key] ?? null) as string ?? "";
}
