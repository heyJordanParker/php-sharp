namespace Demo;

import Sharp.IO.ZipArchive;

public static class ZipQueries
{
    // Creates `folder`/notes.zip with an entry from text and one from `folder`/report.csv, then reopens it, lists and
    // reads it, adds an entry, and extracts every entry to `folder`/out. Opening runs through a function whose type
    // lists `Files`, which holds ZipArchive's effect.
    public static List<string?> roundTrip(string folder)
    {
        Function<ZipArchive(string) uses Files> open = ZipArchive.open;
        const path = `${folder}/notes.zip`;
        ZipQueries.pack(path, `${folder}/report.csv`);

        using opened = open(path);
        List<string?> seen = [...opened.list(), opened.read("readme.txt"), opened.read("missing.txt")];
        opened.write("later.txt", "Later");
        opened.extractTo(`${folder}/out`);

        return seen;
    }

    // Writes `data` as the entry data.bin of a new archive at `path`, then reopens it and reads the entry back as
    // bytes, as text, and a missing entry as bytes.
    public static List<Any?> bytesRoundTrip(string path, Bytes data)
    {
        ZipQueries.packBytes(path, data);

        using opened = ZipArchive.open(path);

        return [opened.readBytes("data.bin")?.toList(), opened.read("data.bin"), opened.readBytes("missing.bin")];
    }

    // How many entries an archive created and disposed with none holds once reopened.
    public static int emptyCount(string path)
    {
        ZipQueries.packNothing(path);

        using opened = ZipArchive.open(path);

        return opened.list().count();
    }

    public static void openArchive(string path)
    {
        using archive = ZipArchive.open(path);
    }

    public static void disposeUnwritable(string path)
    {
        using archive = ZipArchive.create(path);
        archive.write("readme.txt", "Read me");
    }

    public static void addMissing(string path, string file)
    {
        using archive = ZipArchive.create(path);
        archive.addFile(file, "missing.txt");
    }

    private static void pack(string path, string report)
    {
        using created = ZipArchive.create(path);
        created.write("readme.txt", "Read me");
        created.addFile(report, "data/report.csv");
    }

    private static void packBytes(string path, Bytes data)
    {
        using created = ZipArchive.create(path);
        created.writeBytes("data.bin", data);
    }

    private static void packNothing(string path)
    {
        using created = ZipArchive.create(path);
    }
}
