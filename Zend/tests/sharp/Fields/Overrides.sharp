namespace Fields;

// The storage `fields()` gives of each override, spec section 25.
public static class Overrides
{
    public static List<string> listed()
        => [
            `OpenLeaf: [${typeof(OpenLeaf).fields().map(field => field.name).join(", ")}]`,
            `OpenBranch: [${typeof(OpenBranch).fields().map(field => field.name).join(", ")}]`,
            `Shelf: [${typeof(Shelf).fields().map(field => field.name).join(", ")}]`,
        ];
}
