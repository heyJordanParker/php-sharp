namespace Shop;

public class Shipping
{
    public static List<Shipping> made { get; set; } = [];

    public void ship(OrderPaid e) on OrderPaid
    {
        Shipping.made.add(this);
        OrderNotices.heard.add(`ship ${e.orderId}`);
    }

    public void restock(OrderRefunded e) on OrderRefunded
    {
        OrderNotices.heard.add(`restock ${e.orderId}`);
    }
}
