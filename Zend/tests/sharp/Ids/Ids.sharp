namespace Holders;

import Lib.Probe;

public class Ids
{
    public static int identity(Object value) => Probe.id(value);

    public static Object either(Object? first, Object fallback) => first ?? fallback;

    public static string describe(Object source)
    {
        if (source is Ticket ticket) {
            return ticket.code();
        }
        return "other";
    }
}
