namespace Observed;

import Lib.Probe;
import Lib.Witness;
import Lib.Words;

public class Account
{
    public int balance { get; set; willSet => Witness.say(`will ${value} from ${field}\n`); didSet => Witness.say(`did ${field}\n`); } = 1;
    public string name { get; set { Witness.say(`set [${value}]\n`); field = value.trim(); } didSet => Witness.say(`named ${field}\n`); } = "  start  ";
    public string note { get; set { Witness.say("set note\n"); field = value; } } = Words.repeated(" ", 2);
    public static int opened { get; set; didSet => Witness.say(`opened ${field}\n`); } = Probe.length("ab");

    public Account(string name)
    {
        Witness.say(`constructor [${this.name}] [${this.note}]\n`);
        this.name = name;
        this.balance = 2;
        this.audit();
    }

    public Account.opening(string name) : this(name)
    {
        this.balance = 7;
    }

    public void audit()
    {
        this.balance = this.balance + 1;
    }

    public void deposit(int amount)
    {
        this.balance = this.balance + amount;
    }

    public Account copied() => this with { balance: 9, name: "  copy  " };

    public static int reopen()
    {
        Account.opened = Account.opened + 1;
        return Account.opened;
    }
}
