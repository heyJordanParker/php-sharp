namespace Classes;

public abstract class Entity
{
    public required Entity(public string row { get; }) { }

    public static Self fromSchema(string row) => new Self(row);

    public static virtual string kind() => "entity";

    public static string kindOfSelf() => Self.kind();
}

public class Ledger : Entity
{
    public Ledger(string row, int pages = 1) : super(row) { }

    public static override string kind() => "ledger";
}

public class Archive : Ledger
{
}
