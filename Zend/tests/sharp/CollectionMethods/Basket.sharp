namespace Demo;

/** A class whose List property the fixtures change through a set hook that counts its writes. */
public class Basket
{
    public int writes { get; private set; } = 0;

    public List<int> lines { get; set { this.writes += 1; field = value; } } = [];

    public List<int> totals { get => [this.lines.sumOf(line => line)]; }

    public int size() => this.lines.count();
}
