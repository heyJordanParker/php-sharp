namespace Demo;

import Lib.Basket;

class Pantry
{
    public List<int> sizes { get; private set; } = [];
    private Map<string, int> stock = ["tea": 3, "pie": 7];

    public Pantry(public Basket basket { get; })
    {
    }

    public static List<int> grow(List<int> sizes)
    {
        sizes.add(4);
        sizes[0] = 9;
        return sizes;
    }

    public static Map<string, int> drop(Map<string, int> stock, string name)
    {
        stock.remove(name);
        return stock;
    }

    public static int? at(List<int> sizes, int index)
    {
        return sizes.getOrNull(index);
    }

    public static int? price(Map<string, int> stock, string name)
    {
        return stock.get(name);
    }

    public static Map<int, int> entries(List<int> sizes)
    {
        return sizes.entries();
    }

    public static List<int>? first(List<List<int>> rows)
    {
        return rows.getOrNull(0);
    }

    public static Map<int, List<int>> rows(List<List<int>> rows)
    {
        return rows.entries();
    }

    public static void setPast(List<int> sizes)
    {
        sizes[2] = 1;
    }

    public Map<string, int> restock(string name)
    {
        this.sizes.add(global.count(this.sizes));
        this.stock.remove(name);
        return this.stock;
    }

    public static List<int> stack(Pantry pantry, int size)
    {
        pantry.sizes.add(size);
        return pantry.sizes;
    }

    public static List<int> fill(Basket basket, int size)
    {
        basket.lines.add(size);
        return basket.lines;
    }

    public static void share(Basket basket, int size, int parts)
    {
        basket.lines.add(size % parts);
    }

    public static int? total(Basket basket)
    {
        return basket.totals.getOrNull(0);
    }

    public static int size(Pantry pantry)
    {
        return pantry.basket.size();
    }

    public static int lineCount(Basket basket)
    {
        return basket.size();
    }

    public static List<int> made()
    {
        List<int> sizes = [1];
        sizes.add(2);
        return sizes;
    }

    public static int sizeCount(List<int> sizes)
    {
        return sizes.count();
    }

    public static int stockCount(Map<string, int> stock)
    {
        return stock.count();
    }

    public int heldCount()
    {
        return this.sizes.count();
    }

    public static List<int> inserted(List<int> sizes, int index, int size)
    {
        sizes.insert(index, size);
        return sizes;
    }

    public static bool removes(List<int> sizes, int size)
    {
        return sizes.remove(size);
    }

    public static List<int> removed(List<int> sizes, int size)
    {
        sizes.remove(size);
        return sizes;
    }

    public static List<int> cleared(List<int> sizes)
    {
        sizes.clear();
        return sizes;
    }

    public static List<int> reordered()
    {
        List<int> sizes = [1, 2, 3];
        sizes.insert(1, 9);
        sizes.remove(2);
        return sizes;
    }

    public static void front(Basket basket, int size)
    {
        basket.lines.insert(0, size);
    }

    public static bool take(Basket basket, int size)
    {
        return basket.lines.remove(size);
    }

    public static void empty(Basket basket)
    {
        basket.lines.clear();
    }

    public static int last(List<int> sizes)
    {
        return sizes.last();
    }

    public static int? position(List<int> sizes, int size)
    {
        return sizes.indexOf(size);
    }

    public static bool holds(List<int> sizes, int size)
    {
        return sizes.contains(size);
    }

    public static bool has(Map<string, int?> limits, string name)
    {
        return limits.has(name);
    }

    public static List<string> names(Map<string, int> stock)
    {
        return stock.keys();
    }

    public static List<int> amounts(Map<string, int> stock)
    {
        return stock.values();
    }

    public static Set<int> unique(List<int> sizes)
    {
        return sizes.toSet();
    }

    public static List<Any> keyedByCollections()
    {
        Map<List<int>, string> named = [[1, 2]: "a"];
        named[[1, 2]] = "b";
        named[[3]] = "c";
        Set<string> first = ["x", "y"];
        Set<string> second = ["y", "x"];
        Set<Set<string>> groups = [first, second];
        return [named.count(), named[[1, 2]] ?? "none", named[[2, 1]] ?? "none", groups.count()];
    }

    public static Map<string, int> cheap(Map<string, int> prices)
    {
        return prices.filter(price => price < 100);
    }

    public static bool sold(Map<string, int> stock, string name)
    {
        return stock.remove(name);
    }
}
