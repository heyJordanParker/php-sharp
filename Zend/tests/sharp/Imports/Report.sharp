namespace Imports;

import Illuminate.Support.Arr;

public static class Report
{
    public static int distance() => Words.between("kitten", "sitting");

    public static List<string> unique() => Words.unique(["a", "b", "a", "c"]);

    public static int position(string word) => Words.positions(["x", "y", "z"]).get(word) ?? -1;

    public static List<string> keys() => Words.keys(["tea": 3, "milk": 1]);

    public static int repeated() => Words.repeated("ab", 2);

    public static List<string|bool> heldMaps() => [
        Words.serialized([["id": "a"]]),
        Words.printed([["id": "a"]], true),
        Words.column([["id": "a"]], "id")[0],
    ];

    // Arr::wrap documents mixed, and gives back an array it takes as it is.
    public static List<Any?> passedMaps()
    {
        Any? held = [["id": "a"]];
        List<Any?> rows = [["id": "a"]];
        List<Map<string, string>>|Map<string, string> either = [["id": "a"]];
        return [Arr.wrap(held), Arr.wrap(rows), Arr.wrap(either), Report.send(["id": "a"])];
    }

    private static Any? send<T>(T value) => Arr.wrap(value);

    public static void missing()
    {
        Words.missing();
    }
}
