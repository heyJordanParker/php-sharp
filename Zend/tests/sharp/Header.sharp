namespace Demo;

import Lib.Named;
import Lib.Record;
import Lib.Shelf;

public interface Linkable : Named
{
    string link();
}

public class Article : Linkable, Record
{
    public string link()
    {
        return "/article";
    }

    public string name()
    {
        return "article";
    }

    public int number()
    {
        return this.id();
    }
}

public class Post : Record
{
}

public class Tag : Named
{
    public string name()
    {
        return "tag";
    }
}

public class Card : Named, Shelf, Linkable
{
    public override Card copy()
    {
        return new Card();
    }

    public string name()
    {
        return "card";
    }

    public string link()
    {
        return "/card";
    }
}

public class Image
{
    public virtual int size()
    {
        return 10;
    }
}

public class Thumbnail : Image
{
    public override int size()
    {
        return super.size() + 1;
    }
}
