namespace MagicProperties;

import Lib.Guest;
import Lib.Lodging;

// A PHP# class whose plain PHP parent defines `__get` reaches the properties it serves through its parent's
// `@property-read` lines and its own `extern` properties, ahead of its own method of a property's name.
public class Stay : Lodging
{
    public extern Guest? host { get; }

    public Stay() : super() { }

    public Guest guest() => new Guest("the guest relation");

    public Guest host() => new Guest("the host relation");

    public string typed() => this.guest.name;

    public string declared() => this.host?.name ?? "nobody";

    public string taken()
    {
        Function<Guest()> host = this.host;

        return host().name;
    }

    public string called() => this.host().name;
}
