namespace ParameterDefaults;

import Lib.Words;
import LogicException;

public class Ledger
{
    public Ledger(public Stamp made { get; } = new Stamp(Stamp.seed())) { }

    public int seeded(int a = Stamp.seed(), int b = 2) => a + b;

    public int stamped(Stamp stamp = new Stamp(7)) => stamp.value;

    public int sized(int size = new Stamp(8).value) => size;

    public int counted(string text = Words.repeated("ab", 2)) => text.length();

    public int issued(int count = Stamp.seeds) => count;

    public bool plain(Shade shade = Shade.Plain) => shade == Shade.Plain;

    public int failing(int value = Ledger.fail()) => value;

    private static int fail() => throw new LogicException("no default");
}
