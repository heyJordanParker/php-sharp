namespace Lib;

/** A test helper with the string work the fixtures call. */
public static class Words
{
    /** How many single-byte inserts, deletes and replacements turn `from` into `to`, as PHP's levenshtein() counts. */
    public static int distance(string from, string to)
    {
        const fromBytes = from.toBytes().toList();
        const toBytes = to.toBytes().toList();
        List<int> previous = [];
        for (let column = 0; column <= toBytes.count(); column++) {
            previous.add(column);
        }
        for (let row = 1; row <= fromBytes.count(); row++) {
            List<int> current = [row];
            for (let column = 1; column <= toBytes.count(); column++) {
                const replaced = fromBytes[row - 1] == toBytes[column - 1] ? 0 : 1;
                current.add(Math.min(previous[column] + 1, current[column - 1] + 1, previous[column - 1] + replaced));
            }
            previous = current;
        }

        return previous[toBytes.count()];
    }

    public static string capitalized(string text) => text.capitalized();

    public static string repeated(string text, int times) => text.repeat(times);
}
