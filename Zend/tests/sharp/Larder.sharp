namespace Demo;

public enum Ripeness : string
{
    case Green = "green";
    case Ripe = "ripe";
}

public enum Aisle : int
{
    case First = 1;
}

public class Larder
{
    public Larder(public Set<string> bins { get; set; }) { }

    public Map<string, int> stock { get; set; } = [:];
    public Set<string> labels { get; set; } = [];
    public Map<Ripeness, int> ripeness { get; set; } = [:];
    public Map<string, Set<int>> shelves { get; set; } = [:];
    public Map<string, List<Map<Ripeness, int>>> crates { get; set; } = [:];
    public Map<Aisle, int> aisles { get; set; } = [:];
    public Map<string, int>? spare { get; set; }
    public Map<string, int> counted { get; set => field = value.filter(n => n > 0); } = [:];
    public static Map<string, int> shared { get; set; } = [:];
    public static Set<string> tags { get; set; } = [];

    // What PHP# reads back from each property plain PHP wrote: "5" finds the key only as a string, Ripeness.Ripe
    // only as the case, and a nested Set counts only as a Set.
    public List<string> read() => [
        `${this.stock["5"] ?? -1}`,
        `${this.labels.contains("5")}`,
        `${this.ripeness[Ripeness.Ripe] ?? -1}`,
        `${this.shelves["top"]?.count() ?? -1}`,
        `${this.spare?.get("5") ?? -1}`,
        `${this.counted.count()}:${this.counted["5"] ?? -1}`,
        `${Larder.shared["5"] ?? -1}`,
        `${Larder.tags.contains("5")}`,
        `${this.bins.contains("5")}`,
        `${this.crated()}`,
        `${this.aisles[Aisle.First] ?? -1}`,
    ];

    // The Ripe count of the first Map in the "box" List, which reads only a case key.
    public int crated()
    {
        const box = this.crates["box"] ?? [];
        return box.count() == 0 ? -1 : box[0][Ripeness.Ripe] ?? -1;
    }
}
