namespace TypeStatics;

public class Builds
{
    // A generic method's type parameter reaches the statics of its call's type argument.
    public static string made<TItem : Maker>() => TItem.make();

    public static string sized<TItem : Maker>() => TItem.size;

    public static List<string> ofClasses() => [
        new Builder<Fancy>().build(),
        new Builder<Fancy>().size(),
        new Builder<Plain>().build(),
        new Builder<Plain>().size(),
        new Builder<Maker>().build(),
        Builds.made<Fancy>(),
        Builds.sized<Fancy>(),
        Builds.made<Plain>(),
        Builds.sized<Plain>(),
    ];
}
