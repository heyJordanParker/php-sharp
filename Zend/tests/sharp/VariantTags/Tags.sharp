namespace VariantTags;

public static class Tags
{
    public static string? completed() => typeof(JourneyStatus.Completed).tag();

    public static bool completedByTag() => typeof(JourneyStatus).withTag("completed") == typeof(JourneyStatus.Completed);

    public static string? card() => typeof(Card).tag();

    public static string? machine() => typeof(JourneyStatus).tag();

    public static bool casesRoundTrip()
        => typeof(JourneyStatus).withTag(Tags.named(typeof(JourneyStatus.Open))) == typeof(JourneyStatus.Open)
            && typeof(JourneyStatus).withTag(Tags.named(typeof(JourneyStatus.Completed))) == typeof(JourneyStatus.Completed);

    public static string? low() => typeof(Priority.Low).tag();

    public static bool numberedCasesRoundTrip()
        => typeof(Priority).withTag(Tags.named(typeof(Priority.Low))) == typeof(Priority.Low)
            && typeof(Priority).withTag(Tags.named(typeof(Priority.High))) == typeof(Priority.High);

    public static bool variantsRoundTrip()
        => typeof(Tender).withTag(Tags.named(typeof(Card))) == typeof(Card)
            && typeof(Tender).withTag(Tags.named(typeof(Bank))) == typeof(Bank);

    public static string voucherCode() => Tender.parse(["type": "1", "code": "V-7"]).unwrap() is Voucher voucher ? voucher.code : "none";

    public static Tender unknown() => Tender.parse(["type": "cash"]).unwrap();

    private static string named(Class<Object> variant)
        => variant.tag() ?? throw new ValueError("The class is no variant of a family.");
}
