namespace Store;

import Lib.Model;

public class Order : Model
{
    protected override string table { get; set; } = "orders";
    protected override List<string> fillable { get; set; } = ["number", "total"];
    public override List<string> with { get; set; } = ["customer"];
    public override bool timestamps { get; set; } = false;
    public override int perPage { get; set; } = 20;

    public string tableName()
    {
        return this.table;
    }

    public int pageSize()
    {
        return this.perPage;
    }

    public override string labelled(List<string> parts) => `${parts.count()} parts`;
}
