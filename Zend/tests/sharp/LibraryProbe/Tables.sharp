namespace Sharp.Probe;

// A standard library file's calls of PHP's built-ins, which alone may call them: each takes a Map as the PHP array it
// crosses into, a backed enum's key as its value, as plain PHP's own code does.
public static class Tables
{
    public static List<Any?> crossed()
    {
        Map<Stage, int> counts = [Stage.Open: 1];
        Map<string, int> named = ["open": 1];
        Map<string, List<int>> rows = ["a": [1, 2], "b": [3]];
        return [
            global.http_build_query(counts),
            global.iterator_to_array(named),
            global.iterator_to_array(counts),
            global.count(rows, global.COUNT_RECURSIVE),
        ];
    }

    // The PHP array iterator_to_array gives back for a Map<string, int>, which holds the key "5" as 5, crosses into a
    // Map<string, int> with each int key back as its string.
    public static string restored()
    {
        Map<string, int> counts = ["5": 1, "tea": 2];
        Map<string, int> back = global.iterator_to_array(counts);
        let keys = "";
        for (const [key, n] of back) {
            keys = `${keys}${global.get_debug_type(key)} ${key}=${n}, `;
        }
        return `${keys}has "5": ${back.has("5")}`;
    }
}
