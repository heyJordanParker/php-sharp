namespace ExternProperties;

import Lib.Columns;

public class Invoice : Columns
{
    [Key("total_cents")]
    public extern int totalCents { get; set; }

    public string currency => "EUR";

    public extern string? note { get; set; }

    public static List<string> externs() => typeof(Invoice).properties().filter(property => property.isExtern).map(property => property.name);

    public static List<string> others() => typeof(Invoice).properties().filter(property => !property.isExtern).map(property => property.name);
}
