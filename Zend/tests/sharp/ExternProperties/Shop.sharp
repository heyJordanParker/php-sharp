namespace ExternProperties;

import Lib.Catalog;
import Lib.Item;

// An `extern` property is the one the plain PHP parent's `__get` gives, of the type the class states, beside a method
// of its name. PHP declares no property for it, so a read reaches `__get`.
public class Shop : Catalog
{
    public extern Item featured { get; }

    public extern Item wrong { get; }

    public Item featured() => new Item("the featured relation");

    public string name() => this.featured.name;

    public string relation() => this.featured().name;

    public string misread() => this.wrong.name;
}
