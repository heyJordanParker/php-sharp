namespace ExternProperties;

import Lib.Entries;

extern Entries uses any;

// An `extern` property is a property of its class, which `properties()` lists with its type, access and `[Key]`, and
// each PHP# read and write of it calls the plain PHP parent's `__get` or `__set` with its key, so a member named like
// the key never takes it. PHP declares no property for it.
public class Entry : Entries
{
    [Key("a")]
    internal extern string? stored { get; set; }

    internal string? a => this.stored;

    [Key("total_cents")]
    public extern int totalCents { get; private set; }

    public extern string? note { get; set; }

    private int calls = 0;

    private Entry next()
    {
        this.calls += 1;

        return this;
    }

    // Each read-and-write runs its receiver once.
    public int held()
    {
        this.next().totalCents += 5;
        this.next().totalCents++;
        ++this.next().totalCents;
        this.next().note ??= "unused";

        return this.calls;
    }

    public string? store(string value)
    {
        this.stored = value;

        return this.a;
    }

    public List<int> charge(int cents)
    {
        this.totalCents = 0;
        this.totalCents += cents;
        const before = this.totalCents++;

        return [before, ++this.totalCents, this.totalCents--, this.totalCents];
    }

    public List<string?> noted(string value) => [this.note ??= value, this.note ??= "unused"];

    private static Property property(string name) => typeof(Entry).properties().filter(property => property.name == name)[0];

    public List<Any?> reflected()
    {
        const stored = Entry.property("stored");
        const totalCents = Entry.property("totalCents");
        stored.set(this, "set by reflection");

        return [
            typeof(Entry).properties().map(property => property.name),
            typeof(Entry).fields().map(field => field.name),
            stored.type == typeof(string?),
            stored.visibility == Visibility.Internal,
            stored.setVisibility == Visibility.Internal,
            stored.attributes<Key>().map(key => key.name),
            totalCents.type == typeof(int),
            totalCents.visibility == Visibility.Public,
            totalCents.setVisibility == Visibility.Private,
            totalCents.attributes<Key>().map(key => key.name),
            Entry.property("note").attributes<Key>().count(),
            stored.getter(),
            stored.setter(),
            stored.isInitialized(this),
            stored.get(this),
            this.a,
        ];
    }
}
