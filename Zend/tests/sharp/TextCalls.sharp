namespace Demo;

import Sharp.Text.Text;

class TextCalls
{
    public static string slug(string title) => Text.slug(title);

    public static string fromByte(int byte) => Text.fromByte(byte);

    public static List<string> fields(string line) => line.parseCsv();

    public static bool contains(string text, string other) => text.contains(other);

    public static string lowercase(string text) => text.lowercase();

    public static string uppercase(string text) => text.uppercase();

    public static bool startsWith(string text, string prefix) => text.startsWith(prefix);

    public static bool endsWith(string text, string suffix) => text.endsWith(suffix);

    public static string replace(string text, string old, string @new) => text.replace(old, @new);

    public static List<string> split(string text, string delimiter) => text.split(delimiter);

    public static List<string> splitAtMost(string text, string delimiter, int limit) => text.split(delimiter, limit);

    public static string join(List<string> parts, string separator) => parts.join(separator);
}
