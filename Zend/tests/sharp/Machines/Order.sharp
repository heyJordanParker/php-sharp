namespace Machines;

import Sharp.Encoding.Json;

public class Order
{
    public Order(public int id { get; }) { }

    public OrderStatus status { get; private set; } = OrderStatus.open();

    public bool pay(int cents)
    {
        if (this.status is OrderStatus.Draft draft) {
            this.status = draft.pay(cents);
            return true;
        }

        return false;
    }

    public bool ship()
    {
        if (this.status is not OrderStatus.Paid paid) {
            return false;
        }

        this.status = paid.ship();
        return true;
    }

    public static string encode(OrderStatus status) => Json.encode(status);

    public static OrderStatus decode(string json) => Json.parse<OrderStatus>(json).unwrap();
}
