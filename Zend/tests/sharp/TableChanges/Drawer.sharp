namespace TableChanges;

// A change to a Map or a Set a property holds reaches it while plain PHP holds a reference to the property.
public class Drawer
{
    public Set<int> numbers { get; set; } = [1];
    public Map<string, int> prices { get; set; } = ["tea": 2, "milk": 1];

    public bool addNumber(int number) => this.numbers.add(number);

    public bool removePrice(string name) => this.prices.remove(name);
}
