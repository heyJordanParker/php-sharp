namespace InterfaceMembers;

public interface Priced
{
    const string CURRENCY = "USD";
    const List<string> CODES = [Priced.CURRENCY, "EUR"];
    const string LAST = Priced.CODES[1];
    const string LOCAL = Priced.LAST == "EUR" ? "euro" : "dollar";
    const string SIZE = match (Priced.LAST) { "EUR" => "near", default => "far" };
    const string SIZED = `${Priced.SIZE} ${(int) 9.7}`;
    const string SMALL = Size.Small.name;
    const Function<int(int)> DOUBLE = (int n) => n * 2;
    int cents { get; }
    string label => `${this.cents} ${Priced.CURRENCY}`;
    static int operator <=>(Priced a, Priced b) => a.cents <=> b.cents;
}
