namespace SelfResults;

// The result type of each method a class declares, read through reflection, but the `parse` and `tryParse` every class
// gets.
public static class Report
{
    public static List<string> results(Class<Object> type)
        => type.methods()
            .filter(method => method.name != "parse" && method.name != "tryParse")
            .map(method => `${method.name}(): ${method.type.name()}`);

    public static List<string> all() => [...Report.results(typeof(Base)), ...Report.results(typeof(Sub))];

    // A generic class's `Self` keeps the class value's type arguments, which a class value's `name()` leaves out.
    public static List<bool> generic()
        => [
            typeof(Box<int>).methods().first(method => method.name == "copy").type == typeof(Box<int>),
            typeof(Box<string>).methods().first(method => method.name == "copy").type == typeof(Box<string>),
        ];
}
