namespace Demo;

import Lib.Copies;
import Lib.Document;
import Lib.HasSlug;

public interface Linked
{
    string name();
}

public class Essay : Document, HasSlug, Linked
{
    public string link()
    {
        return this.path();
    }

    public string name()
    {
        return this.slug;
    }
}

public class Guide : Essay
{
    public Guide()
    {
        this.slug = "setup";
    }

    public string topic()
    {
        return this.slug;
    }
}

public class Draft : Copies
{
}

public enum Shade : Copies
{
    case Light;
}
