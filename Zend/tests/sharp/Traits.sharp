namespace Demo;

import Lib.Aligned;
import Lib.Copies;
import Lib.Document;
import Lib.HasSlug;
import Lib.HasUniqueStringIds;
import Lib.Persisted;
import Lib.SoftDeletes;

public interface Linked
{
    string name();
}

public class Essay : Document, HasSlug, Linked
{
    public string link()
    {
        return this.path();
    }

    public string name()
    {
        return this.slug;
    }
}

public class Guide : Essay
{
    public Guide()
    {
        this.slug = "setup";
    }

    public string topic()
    {
        return this.slug;
    }
}

public class Draft : Copies
{
}

public enum Shade : Copies
{
    case Light;
}

public enum Align : string, Aligned
{
    case Left = "left";
    case Right = "right";

    public string label() => "align";
}

public enum Tier : int, Aligned
{
    case Low = 1;
    case High = 2;

    public string label() => "level";
}

public class Posting : Persisted, SoftDeletes, HasUniqueStringIds
{
}
