namespace Demo;

import Lib.Shipping;

class Interop
{
    public static string shipping(int cents)
    {
        return global.shipping_label(cents);
    }

    public static string shippingIn(string currency, int cents)
    {
        return global.shipping_label(cents * 2, currency: currency);
    }

    public static int freeAbove() => Shipping.FREE_ABOVE;

    public static int largest() => Int.MAX;
}
