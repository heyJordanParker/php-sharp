<?php

function native_generator_copy(string $copy): void
{
    $root = dirname(__DIR__, 3);
    foreach (['sharp/bin/native', 'sharp/composer/library', 'ext/sharp/src', 'ext/sharp/Cargo.lock'] as $path) {
        $files = is_dir("$root/$path")
            ? new RecursiveIteratorIterator(new RecursiveDirectoryIterator("$root/$path", FilesystemIterator::SKIP_DOTS))
            : [new SplFileInfo("$root/$path")];
        foreach ($files as $file) {
            $target = $copy . substr($file->getPathname(), strlen($root));
            @mkdir(dirname($target), 0777, true);
            copy($file->getPathname(), $target);
        }
    }
}

function native_generator_run(string $copy): int
{
    exec(escapeshellarg(getenv('TEST_PHP_EXECUTABLE')) . ' -n ' . escapeshellarg("$copy/sharp/bin/native") . ' 2>&1', $output, $status);
    echo implode("\n", $output), $output === [] ? '' : "\n";

    return $status;
}

function native_generator_fingerprint(string $copy): string
{
    preg_match("/^return '([0-9a-f]{32})';$/m", file_get_contents("$copy/sharp/composer/native.php"), $returned);

    return $returned[1];
}

function native_generator_lock(string $copy, string $deunicode, string $tables, string $rev, string $syntax): void
{
    $checksum = hash('sha256', "deunicode $deunicode");
    file_put_contents("$copy/ext/sharp/Cargo.lock", <<<LOCK
        # This file is automatically @generated by Cargo.
        # It is not intended for manual editing.
        version = 4

        [[package]]
        name = "deunicode"
        version = "$deunicode"
        source = "registry+https://github.com/rust-lang/crates.io-index"
        checksum = "$checksum"

        [[package]]
        name = "mago-sharp-bridge"
        version = "1.53.0"
        source = "git+https://github.com/heyJordanParker/mago-sharp?rev=$rev#$rev"
        dependencies = [
         "mago-syntax",
        ]

        [[package]]
        name = "mago-syntax"
        version = "$syntax"
        source = "git+https://github.com/heyJordanParker/mago-sharp?rev=$rev#$rev"

        [[package]]
        name = "sharp"
        version = "0.0.0"
        dependencies = [
         "deunicode",
         "mago-sharp-bridge",
         "unicode-tables",
        ]

        [[package]]
        name = "unicode-tables"
        version = "0.1.0"
        source = "git+https://github.com/heyJordanParker/unicode-tables?rev=$tables#$tables"

        LOCK);
}

function native_generator_remove(string $path): void
{
    if (!is_dir($path)) {
        return;
    }
    $files = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS), RecursiveIteratorIterator::CHILD_FIRST);
    foreach ($files as $file) {
        $file->isDir() ? rmdir($file->getPathname()) : unlink($file->getPathname());
    }
    rmdir($path);
}
