namespace ReflectedTypes;

// Reads each type the Story names through `properties()`, `methods()` and `parameters()`, and takes it apart with the
// members of `Class<T>` alone, spec section 25.
public static class Report
{
    // The type as its parts spell it, each kind through its own members.
    public static string spell(Class<Any?> type)
    {
        const whole = type.nonNullable();
        const text = match (whole.kind()) {
            TypeKind.Named => whole.typeArguments().isEmpty()
                ? whole.name()
                : `${whole.genericDefinition()?.name() ?? "?"}<${whole.typeArguments().map(argument => Report.spell(argument)).join(", ")}>`,
            TypeKind.Union => whole.unionMembers().map(member => Report.spell(member)).join("|"),
            TypeKind.Intersection => whole.intersectionMembers().map(member => Report.spell(member)).join(" & "),
            TypeKind.Tuple => `[${whole.tupleElements().map(element => Report.element(element)).join(", ")}]`,
            TypeKind.Function => `Function<${Report.spell(whole.returnType())}(${whole.parameterTypes().map(parameter => Report.spell(parameter)).join(", ")})>`,
            TypeKind.TypeParameter => `${whole.name()} : ${Report.spell(whole.bound())}`,
        };
        return type.isNullable() ? `(${text})?` : text;
    }

    private static string element(TupleElement element)
        => element.name is string name ? `${Report.spell(element.type)} ${name}` : Report.spell(element.type);

    // Each property of the class, then each method's result and parameters, spelled.
    public static List<string> members(Class<Object> type)
    {
        List<string> lines = [];
        for (const property of type.properties()) {
            lines.add(`${property.name}: ${Report.spell(property.type)}`);
        }
        for (const method of type.methods()) {
            const parameters = method.parameters().map(parameter => `${parameter.name}: ${Report.spell(parameter.type)}`);
            lines.add(`${method.name}(${parameters.join(", ")}): ${Report.spell(method.type)}`);
        }
        return lines;
    }

    // Each fact a Story line asks of a member's type, read through `properties()`, and of `typeof(Crate)`.
    public static List<Any?> facts()
    {
        const holder = typeof(Holder).properties();
        const toneClass = holder.first(property => property.name == "toneClass").type;
        const reader = holder.first(property => property.name == "reader").type;
        const mixed = holder.first(property => property.name == "mixed").type;
        const boxes = holder.first(property => property.name == "boxes").type;
        const pair = holder.first(property => property.name == "pair").type;
        const item = typeof(Crate).properties()[0].type.nonNullable();
        const box = boxes.typeArguments()[0];
        return [
            toneClass.kind() == TypeKind.Named,
            toneClass.genericDefinition()?.name(),
            toneClass.typeArguments() == [typeof(Tone)],
            reader.isNullable(),
            reader.nonNullable().kind() == TypeKind.Function,
            reader.parameterTypes() == [typeof(string), typeof(Box<int>)],
            reader.returnType() == typeof(int),
            mixed.kind() == TypeKind.Union,
            mixed.unionMembers() == [typeof(Box<Tone>), typeof(Tone)],
            box.isNullable(),
            box.nonNullable() == typeof(Box<Tone>),
            box.typeArguments() == [typeof(Tone)],
            pair.tupleElements().map(element => element.name),
            pair.tupleElements().map(element => element.type) == [typeof(string), typeof(int)],
            item.kind() == TypeKind.TypeParameter,
            item.name(),
            item.bound() == typeof(Mark),
            typeof(Crate).typeParameters().map(parameter => parameter.name()),
            typeof(Crate).typeParameters()[0].bound() == typeof(Mark),
            typeof(Crate<Mark>).properties()[0].type == typeof(Mark?),
            typeof(Crate).typeArguments() == [],
            typeof(Mark & Labeled).kind() == TypeKind.Intersection,
            typeof(Mark & Labeled).intersectionMembers() == [typeof(Labeled), typeof(Mark)],
            typeof(Mark & Labeled).unionMembers() == [],
            typeof(Mark).intersectionMembers() == [],
        ];
    }

    // Story line 7: a class value of a built-in generic answers `is` as a user generic's does.
    public static List<bool> builtIns()
    {
        Any? list = typeof(List<string>);
        Any? map = typeof(Map<string, int>);
        Any? set = typeof(Set<string>);
        Any? crate = typeof(Crate<Mark>);
        return [
            list is Class<List>,
            list is Class<List<Any?>>,
            list is Class<Iterable<Any?>>,
            map is Class<Map>,
            map is Class<Map<string, Any?>>,
            map is Class<Iterable<Any?>>,
            set is Class<Set>,
            set is Class<Iterable<Any?>>,
            crate is Class<Crate>,
            list is Class<Set>,
            list is Class<List<int>>,
        ];
    }
}
