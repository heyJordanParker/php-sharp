namespace Demo;

class Grid
{
    public List<List<int>> rows { get; set; } = [[1, 2], [3]];
    public int writes { get; private set; } = 0;
    public List<Map<string, int>> tallies
    {
        get => field;
        set {
            field = value;
            this.writes = this.writes + 1;
        }
    } = [["a": 1]];
    private int calls = 0;

    public static List<List<int>> changed(List<List<int>> grid)
    {
        grid[0].add(5);
        grid[1].insert(0, 7);
        grid[0].remove(1);
        grid[1].set(0, 8);
        return grid;
    }

    public static List<List<int>> cleared(List<List<int>> grid, int row)
    {
        grid[row].clear();
        return grid;
    }

    public static List<List<int>> kept(List<List<int>> grid)
    {
        List<List<int>> copy = grid;
        grid[0].add(grid[0].count());
        return [copy[0], grid[0]];
    }

    public static List<List<List<int>>> deep(List<List<List<int>>> cube)
    {
        cube[1][0].add(3);
        return cube;
    }

    public static List<Set<int>> sets(List<Set<int>> sets)
    {
        sets[0].add(4);
        sets[1].remove(2);
        return sets;
    }

    public static List<Map<string, int>> maps(List<Map<string, int>> maps)
    {
        maps[0].remove("a");
        maps[1]["c"] = 3;
        maps[1]["b"] ??= 9;
        maps[0]["d"] ??= 4;
        return maps;
    }

    public List<List<int>> held()
    {
        this.rows[0].add(9);
        this.rows[1].clear();
        return this.rows;
    }

    public List<Map<string, int>> hooked()
    {
        this.tallies[0]["b"] = 2;
        this.tallies[0].remove("a");
        return this.tallies;
    }

    public List<List<int>> once(List<List<int>> grid)
    {
        grid[this.next()].remove(2);
        return grid;
    }

    public static List<List<int>> missing(List<List<int>> grid, int row)
    {
        grid[row].add(1);
        return grid;
    }

    public static List<Map<string, int>> missingWrite(List<Map<string, int>> maps, int row)
    {
        maps[row]["c"] = 3;
        return maps;
    }

    private int next()
    {
        this.calls = this.calls + 1;
        return this.calls - 1;
    }
}
