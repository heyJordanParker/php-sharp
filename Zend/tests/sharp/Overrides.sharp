namespace Overrides;

import Lib.Model;
import RuntimeException;

public abstract class Shape
{
    public abstract string kind { get; }
    public virtual string label => "shape";
    public virtual int sides { get; set; } = 0;
    protected int corners = 0;

    public string describe() => `${this.kind} ${this.label} ${this.sides}`;
}

public class Square : Shape
{
    public override string kind => "square";
    public override string label => "four sides";
    public override int sides { get => field; set => field = value < 0 ? 0 : value; } = 4;
    protected override int corners { get; set; } = 4;

    public int cornerCount() => this.corners;
}

public class Order : Model
{
    protected override string table { get; set => field = value.trim(); } = "orders";

    public string tableName() => this.table;
}

public interface Named
{
    string name { get; }
}

public class Person : Named
{
    public Person(public string name { get; }) { }
}

public class Account : Named
{
    public string name { get; private set; } = "new";

    public void rename(string name)
    {
        this.name = name;
    }
}

public interface Sized
{
    int size { get; set; }
}

public class Box : Sized
{
    public int size { get; set; } = 1;

    public static int grow(Sized sized)
    {
        sized.size = sized.size * 2;
        return sized.size;
    }
}

public class Registry
{
    public static int size { get; } = 3;
    public static string label { get; } = global.strtoupper("ready");
    private static int started = global.strlen("four");

    public static int total() => Registry.size + Registry.started;
}

public class Faulty
{
    private static int code = Faulty.fail();

    public static int fail()
    {
        throw new RuntimeException("no code");
    }

    public static int read() => Faulty.code;
}

public class Figure
{
    protected string title { get; set; } = "figure";

    public string name() => this.title;
}

public class Tally
{
    private static int hits = 0;
    public static int doubled => Tally.hits * 2;
    public static int total { get => field; set { field = value; Tally.hits = Tally.hits + 1; } } = 0;
    public static string label { get; private set; didSet => global.printf("label %s\n", field); } = "start";
    public static int squared { get { return 2 * 2; } }

    public static void rename(string text)
    {
        Tally.label = text;
    }

    public static int run()
    {
        Tally.total = 5;
        Tally.total += 2;
        Tally.total++;
        let old = Tally.total--;
        return old + Tally.doubled;
    }

    public static int current() => Tally.total;

    public static int square() => Tally.squared;
}

public class Member
{
    public string? note { get; }
    public int level { get; set; }
    public string? nickname { get; set; } = null;

    public Member(string? note, bool claimed)
    {
        if (claimed) {
            this.note = note;
            this.level = 2;
        } else {
            this.note = null;
            this.level = 1;
        }
    }
}
