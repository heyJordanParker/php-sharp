namespace InheritedFields;

import Sharp.Encoding.Json;

public static class Reads
{
    private static DecodeChild child() => typeof(DecodeChild).decode(["key": "a", "label": "b"]);

    public static string decoded() => "label=" + Reads.child().label + " key=" + Reads.child().key;

    public static string encoded() => Json.encode(Reads.child());

    public static string roundTripped()
    {
        DecodeChild read = typeof(DecodeChild).decode(typeof(DecodeChild).encode(Reads.child()));

        return "label=" + read.label + " key=" + read.key;
    }
}
