namespace InheritedFields;

import Sharp.Encoding.Json;

public static class Reads
{
    private static DecodeChild child() => typeof(DecodeChild).parse(["key": "a", "label": "b"]).unwrap();

    public static string decoded() => "label=" + Reads.child().label + " key=" + Reads.child().key;

    public static string encoded() => Json.encode(Reads.child());

    public static string roundTripped()
    {
        DecodeChild read = typeof(DecodeChild).parse(typeof(DecodeChild).encode(Reads.child())).unwrap();

        return "label=" + read.label + " key=" + read.key;
    }

    public static string secretRoundTripped()
        => Json.encode(typeof(Child).parse(typeof(Child).encode(typeof(Child).parse(["secret": "s"]).unwrap())).unwrap());
}
