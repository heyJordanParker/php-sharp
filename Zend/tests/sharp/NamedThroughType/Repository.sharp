namespace NamedThroughType;

public class Repository<TItem : Record>
{
    public Repository() { }

    public TItem load(Map<string, string> json) => new TItem.fromJson(json);

    public static string run()
    {
        const invoice = new Repository<Invoice>().load(["id": "7"]);
        const record = new Repository<Record>().load(["id": "8"]);
        return `${invoice.kind()} ${invoice.id}, ${record.kind()} ${record.id}`;
    }

    // A bound below `Record`, an abstract one included, accepts `new TDocument.fromJson(…)`.
    public static TDocument document<TDocument : Document>(Map<string, string> json) => new TDocument.fromJson(json);

    public static string below()
    {
        const receipt = new Repository<Receipt>().load(["id": "3"]);
        const document = Repository<Record>.document<Receipt>(["id": "4"]);
        return `${receipt.kind()} ${receipt.id}, ${document.kind()} ${document.id}`;
    }
}
