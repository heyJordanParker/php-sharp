namespace Demo.InternalReach.Below;

import Demo.InternalReach.Ledger;

// Each direct use of an internal member from a namespace below its own.
public final class Audit
{
    public static List<int> uses()
    {
        const ledger = new Ledger();
        ledger.balance = 7;
        ledger.views = 2;

        return [ledger.total(), ledger.balance, ledger.views, Ledger.LIMIT, Ledger.doubled(4)];
    }
}
