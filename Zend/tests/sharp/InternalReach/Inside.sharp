namespace Demo.InternalReach;

// Each direct use of an internal member from its own namespace.
public final class Inside
{
    public static List<int> uses()
    {
        const ledger = new Ledger();
        ledger.balance = 6;
        ledger.views = 1;

        return [ledger.total(), ledger.balance, ledger.views, Ledger.LIMIT, Ledger.doubled(2), new Till().counted()];
    }
}
