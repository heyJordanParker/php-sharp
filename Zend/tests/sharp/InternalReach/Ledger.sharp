namespace Demo.InternalReach;

// An internal member of each kind the engine holds: a constructor, a property, a constant, a method and a static
// method, with a public way in to create one, and a property whose `set` is internal.
public class Ledger
{
    internal const int LIMIT = 10;

    internal int balance { get; set; } = 5;

    public int views { get; internal set; } = 0;

    internal Ledger() { }

    public static Ledger open() => new Ledger();

    public static Labeled till() => new Till();

    internal int total() => this.balance * 2;

    internal static int doubled(int cents) => cents * 2;
}
