namespace Demo.InternalReach;

// An internal class, so `new` of it and each public member it declares reach no further than its namespace. It
// declares no constructor, so only the class itself stops `new` from outside. `label()` implements the public
// `Labeled`'s member, so code of any namespace reaches it.
final class Till : Labeled
{
    public int count { get; set; } = 3;

    public int counted() => this.count;

    public string label() => "till";
}
