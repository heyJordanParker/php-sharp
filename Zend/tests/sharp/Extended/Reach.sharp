namespace Extended;

public static class Reach
{
    extension<T>(Class<T> type)
    {
        public string label() => `<${type.name()}>`;

        public string name() => "never";
    }

    extension(ref List<int> counts)
    {
        public void bump() => counts.add(counts.count());
    }

    extension(Ticket ticket)
    {
        public int codeOf() => ticket.code;
    }
}
