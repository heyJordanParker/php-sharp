namespace Demo;

import Lib.Code;
import Lib.Size;
import Lib.Status;

class Headcount
{
    private Map<Status, int> counts = [:];
    private Map<Status, int> seeded = [Status.Active: 0];

    public Map<Status, int> seededCounts()
    {
        return this.seeded;
    }

    public Map<Status, int> add(Status status)
    {
        this.counts[status] = (this.counts[status] ?? 0) + 1;
        return this.counts;
    }

    public static Map<Status, int> count(Map<Status, int> counts, Status status)
    {
        counts[status] = (counts[status] ?? 0) + 1;
        return counts;
    }

    public static Map<Status, int> ensure(Map<Status, int> counts, Status status)
    {
        counts[status] ??= 0;
        return counts;
    }

    public static Map<Size, string> sizes(Size small, Size large)
    {
        return [small: "small", large: "large"];
    }

    public static Map<Code, int> codes(Code code)
    {
        Map<Code, int> codes = [:];
        codes[code] = 5;
        return codes;
    }

    public static int read(Map<Status, int> counts, Status status)
    {
        return counts[status];
    }

    public static int? lookup(Map<Status, int> counts, Status status)
    {
        return counts.get(status);
    }

    public static Map<Status, int> without(Map<Status, int> counts, Status status)
    {
        counts.delete(status);
        return counts;
    }

    public static Map<Status, Map<Size, int>> nest(Status status, Size size)
    {
        Map<Status, Map<Size, int>> nested = [:];
        nested[status] = [:];
        nested[status][size] = 1;
        return nested;
    }

    public static Map<string, int> byName(Map<Status, int> counts)
    {
        Map<string, int> named = [:];
        for (const [Status status, int n] of counts) {
            named[status.name] = n;
        }
        return named;
    }

    public static List<string> skus(Map<string, int> stock)
    {
        List<string> skus = [];
        for (const [string sku, int n] of stock) {
            if (n > 0) {
                skus.add(sku);
            }
        }
        return skus;
    }
}
