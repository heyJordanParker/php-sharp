namespace Demo;

class Shipment
{
    public Status status { get; private set; }

    public Shipment(Status status)
    {
        this.status = status;
    }

    public string code()
    {
        return this.status.value;
    }

    public string state()
    {
        return this.status.name;
    }

    public string describe()
    {
        return this.status.label();
    }

    public Status close()
    {
        this.status = Status.from("c");
        return this.status;
    }

    public static Status? find(string code)
    {
        return Status.tryFrom(code);
    }

    public static int kinds()
    {
        return count(Status.cases());
    }
}
