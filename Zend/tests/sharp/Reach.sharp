namespace Reach;

class Shop
{
    public int views { get; internal set; } = 0;
    internal int stock { get; set; } = 0;
    public int id { get; internal init; } = 0;

    public Shop(int id)
    {
        this.id = id;
    }

    internal int secret() => 7;
}

public class Till
{
    public int run(Shop shop)
    {
        shop.views = 2;
        shop.stock = 3;
        return shop.views + shop.stock + shop.secret() + shop.id;
    }
}
