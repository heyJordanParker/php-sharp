{
    "name": "php-sharp/engine-tests",
    "description": "The PHP# fixtures of the engine tests, loaded through Composer as an application loads its classes. A library, since each fixture's code is called by the tests that load it, not by an application.",
    "type": "library",
    "license": "PHP-3.01",
    "repositories": [
        {
            "type": "path",
            "url": "../../../sharp/composer",
            "options": {
                "symlink": false,
                "versions": {
                    "heyjordanparker/php-sharp-composer": "dev-master"
                }
            }
        }
    ],
    "require": {
        "heyjordanparker/php-sharp-composer": "*",
        "illuminate/collections": "^13.43",
        "illuminate/database": "^13.43",
        "nesbot/carbon": "^3.15",
        "symfony/clock": "^8.1",
        "symfony/event-dispatcher": "^8.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Aliased\\": "TypeArgumentsAlias/",
            "App\\": "TypeArguments/",
            "App\\Calls\\": "ReflectionCalls/",
            "App\\Casts\\": "Casts/",
            "App\\Delegates\\": "Delegates/",
            "App\\Elsewhere\\": "Elsewhere/",
            "App\\Facts\\": "MemberFacts/",
            "App\\Linking\\": "Linking/",
            "App\\PlainClosures\\": "PlainClosures/",
            "App\\Probe\\": "Probe/",
            "App\\Rest\\": "VariadicMethods/",
            "App\\Shop\\": "Methods/",
            "App\\TraitOverride\\": "TraitOverride/",
            "Arrivals\\": "Arrivals/",
            "AttributeObjects\\": "AttributeObjects/",
            "AttributePlaces\\": "AttributePlaces/",
            "AttributeTargets\\": "AttributeTargets/",
            "BackedKeys\\": "BackedKeys/",
            "Bags\\": "Bags/",
            "Behaviors\\": "Behaviors/",
            "Billing\\": "Operators/",
            "BoundExtensions\\": "BoundExtensions/",
            "BuiltInClassValues\\": "BuiltInClassValues/",
            "CallerChecked\\": "CallerChecked/",
            "CallerLines\\": "CallerLines/",
            "Callers\\": "Callers/",
            "Calls\\": "TypeArgumentsCalls/",
            "Checks\\": "TypeArgumentsChecks/",
            "ClassKeys\\": "ClassKeys/",
            "Classes\\": [
                "ClassValues/",
                "SelfReturn/"
            ],
            "ConstantValues\\": "ConstantValues/",
            "Crossed\\": "Unverified/",
            "DataInOut\\": "DataInOut/",
            "Declared\\": "Declared/",
            "Defaults\\": "Defaults/",
            "Demo\\": [
                "CollectionMethods/",
                "Collections/",
                "Constructors/",
                "Crossings/",
                "Demo/",
                "EnumKeys/",
                "FunctionTypes/",
                "FunctionValues/",
                "Guarded/",
                "Header/",
                "Import/",
                "Inheritance/",
                "Inventory/",
                "JsonCalls/",
                "Larder/",
                "Order/",
                "Results/",
                "Sets/",
                "ShapedLists/",
                "Shapes/",
                "Sorted/",
                "SortedKeys/",
                "StaticCollections/",
                "Structs/",
