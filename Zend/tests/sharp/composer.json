            "ReflectedMembers\\": "ReflectedMembers/",
            "ReflectedTypes\\": "ReflectedTypes/",
            "RootBound\\": "RootBound/",
            "Rush\\": "RushOrders/",
            "SelfMembers\\": "SelfMembers/",
            "SelfResults\\": "SelfResults/",
            "SetValues\\": "SetValues/",
            "SharedNames\\": "SharedNames/",
            "Sharp\\Probe\\": "LibraryProbe/",
            "Shelf\\": "TypeArgumentsSets/",
            "Shelves\\": "Shelves/",
            "Shop\\": "Shop/",
            "Shown\\": "Shown/",
            "Site\\": "Site/",
            "StaticConstructors\\": "StaticConstructors/",
            "Store\\": [
