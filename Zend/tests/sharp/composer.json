            "Demo\\Audits\\": "Audits/",
            "Demo\\InternalStructs\\": "InternalStructs/",
            "Demo\\Labels\\": "UnionLabels/",
            "Demo\\ReadonlyValues\\": "ReadonlyValues/",
            "Demo\\Wallets\\": "Wallets/",
            "Departures\\": "Departures/",
            "DomPages\\": "DomPages/",
            "EmptyArrays\\": "EmptyArrays/",
            "Equalities\\": "Unchecked/",
            "Equatables\\": "EquatableBound/",
