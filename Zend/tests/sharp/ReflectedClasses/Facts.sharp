namespace ReflectedClasses;

import Lib.Field;

// Reads every fact a class declaration states through its class value, spec section 25.
public static class Facts
{
    // Its base and interfaces, applied, and what kind of class it is.
    public static List<Any?> shape()
        => [
            typeof(Dictionary).baseType()?.name(),
            typeof(Dictionary).interfaces().map(type => type.name()),
            typeof(ValueList).baseType(),
            [typeof(ValueList).isAbstract(), typeof(ValueList).isInterface(), typeof(ValueList).isStruct(), typeof(ValueList).isEnum()],
            [typeof(Labeled).isAbstract(), typeof(Labeled).isInterface()],
            [typeof(Point).isStruct(), typeof(Point).isAbstract()],
            [typeof(Level).isEnum(), typeof(Dictionary).isEnum()],
        ];

    // An enum's backing type and cases.
    public static List<Any?> cases()
        => [
            typeof(Level).enumBackingType() == typeof(int),
            typeof(Dictionary).enumBackingType(),
            typeof(Level).enumCases().map(found => found.name),
            typeof(Level).enumCases().map(found => found.backingValue),
            typeof(Level).enumCases()[1].value as Level == Level.High,
            typeof(Level).enumCases().map(found => found.attributes<Field>().count()),
        ];

    // A generic type made from its definition, and the arguments it refuses.
    public static List<Any?> made()
    {
        List<Any?> facts = [
            typeof(List).makeGenericType([typeof(Level)]) == typeof(List<Level>),
            typeof(List).makeGenericType([typeof(int)]) == typeof(List<int>),
            typeof(ValueList).makeGenericType([typeof(int)]).name(),
        ];
        try {
            typeof(List).makeGenericType([typeof(int), typeof(int)]);
        } catch (InvalidArgumentException failure) {
            facts.add(failure.getMessage());
        }
        return facts;
    }

    // The constructor, kept apart from the methods, with its parameters, promoted or not.
    public static List<Any?> constructed()
    {
        const constructor = typeof(Dictionary).constructor() ?? throw new ValueError("none");
        return [
            constructor.visibility == Visibility.Public,
            constructor.parameters().map(parameter => parameter.name),
            constructor.parameters().map(parameter => parameter.isOptional),
            constructor.parameters()[1].attributes<Field>().count(),
            typeof(Dictionary).methods().any(method => method.name == "__construct"),
            typeof(Labeled).constructor(),
        ];
    }

    // What writes each property: its set visibility, null for a get-only one, and whether it has an `init`.
    public static List<string> writers()
        => typeof(Dictionary).properties().map(
            property => `${property.name}: ${Facts.reach(property.setVisibility)} init=${property.isInitOnly ? "yes" : "no"}`
        );

    private static string reach(Visibility? visibility) => match (visibility)
    {
        Visibility.Public => "public",
        Visibility.Internal => "internal",
        Visibility.Protected => "protected",
        Visibility.Private => "private",
        null => "none",
    };

    // A void and a never method's result type, which a local holds and a Map keys as any class value.
    public static List<bool> results()
    {
        const methods = typeof(Dictionary).methods();
        Class<void> nothing = typeof(void);
        Map<Class<Any?>, string> results = [nothing: "void", typeof(never): "never"];
        return [
            methods.first(method => method.name == "touch").type == typeof(void),
            methods.first(method => method.name == "fail").type == typeof(never),
            results.get(methods.first(method => method.name == "touch").type) == "void",
            results.get(methods.first(method => method.name == "fail").type) == "never",
        ];
    }

    // A class value keys a Map by its whole type.
    public static List<Any?> keys()
    {
        Map<Class<Any?>, int> counts = [:];
        counts[typeof(ValueList<int>)] = 1;
        counts[typeof(ValueList<string>)] = 2;
        counts[typeof(ValueList<int>)] = 3;
        return [counts.count(), counts[typeof(ValueList<int>)] ?? 0];
    }

    // A static method invoked through the class value it was read from, and an instance method given no receiver.
    public static List<Any?> statics()
    {
        const which = typeof(Dictionary).methods().first(method => method.name == "which");
        List<Any?> facts = [which.isStatic, which.invoke(null, []), which.declaringClass.name()];
        try {
            typeof(Dictionary).methods().first(method => method.name == "label").invoke(null, []);
        } catch (InvalidArgumentException failure) {
            facts.add(failure.getMessage());
        }
        return facts;
    }
}
