namespace Demo;

import Sharp.Net.Url;

class UrlCalls
{
    public static string encode(string text) => Url.encode(text);

    public static string encodeForm(string text) => Url.encodeForm(text);

    public static string decode(string text) => Url.decode(text);

    public static string buildQuery(Map<string, Any?> values) => Url.buildQuery(values);

    public static bool isValid(string url) => Url.isValid(url);

    public static Map<int|string, Any?> parseQuery(string query) => Url.parseQuery(query);

    public static List<string> parts(string text)
    {
        const url = Url.parse(text);

        return [url.scheme, url.host, `${url.port ?? 0}`, url.path, url.query ?? "-", url.fragment ?? "-", url.user ?? "-", url.password ?? "-"];
    }

    public static string? written(string text) => Url.tryParse(text)?.toString();

    public static Map<int|string, Any?> queryValues(string text) => Url.parse(text).queryValues();

    public static string built() => new Url("https", "example.com", path: "/search", query: Url.buildQuery(["q": "a b"])).toString();
}
