namespace App.Invokers;

// The methods a dispatcher calls by name with a list of arguments, for `Method.createInvoker`: one with the effect
// `Database` and two parameters, a static one with a default, one with the effect `Mailer`, a static one whose default
// runs code, and a property with a `get` and a `set`.
public class Billing
{
    public Billing(protected Database database, protected Mailer mailer) { }

    public string note { get => field; set => field = value; } = "none";

    public string pause(Subscription subscription, VerifiedUser user)
        => `${subscription.name} paused by ${user.name} in ${this.database.rows()} rows`;

    public static string create(string name, Plan plan = Plan.Normal) => `${name} on ${plan.name}`;

    public int notify() => this.mailer.sent();

    public static string stamp(Stamp given = new Stamp()) => given.at;
}
