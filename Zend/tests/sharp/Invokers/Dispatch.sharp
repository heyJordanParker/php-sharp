namespace App.Invokers;

// A dispatcher that finds `Billing`'s methods by name and calls each through one invoker with a list of arguments,
// keeping to the `uses Database` of `Actions`, and invokers of methods or function types that don't fit.
public class Dispatch : Actions
{
    Method method(string name) => typeof(Billing).methods().first(method => method.name == name);

    Property note() => typeof(Billing).properties().first(property => property.name == "note");

    public Any? pause(Billing billing, List<Any?> arguments)
        => this.method("pause").createInvoker<Function<Any?(Object, List<Any?>) uses Database>>()(billing, arguments);

    public Any? create(List<Any?> arguments)
        => this.method("create").createInvoker<Function<Any?(List<Any?>) uses Database>>()(arguments);

    public Any? notifier() => this.method("notify").createInvoker<Function<Any?(Object, List<Any?>) uses Database>>();

    public Any? stamped(List<Any?> arguments) => this.method("stamp").createInvoker<Function<string(List<Any?>)>>()(arguments);

    public Any? read(Billing billing, List<Any?> arguments)
        => (this.note().getter() ?? throw new ValueError("none"))
            .createInvoker<Function<string(Object, List<Any?>)>>()(billing, arguments);

    public void write(Billing billing, List<Any?> arguments)
        => (this.note().setter() ?? throw new ValueError("none"))
            .createInvoker<Function<void(Object, List<Any?>)>>()(billing, arguments);

    public Any? spread() => this.method("pause").createInvoker<Function<Any?(Object, Subscription, VerifiedUser) uses Database>>();
}
