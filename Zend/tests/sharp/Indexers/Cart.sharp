namespace Indexers;

public class Cart
{
    private List<string> lines = ["tea", "jam"];

    public string this[int index]
    {
        get => this.lines[index];
        set => this.lines[index] = value;
    }

    public static List<string> run()
    {
        const cart = new Cart();
        const first = cart[0];
        cart[1] = "honey";
        cart[0] += "!";
        const shelf = new Shelf();
        return [first, cart[0], cart[1], shelf[2] ?? "none", shelf[-1] ?? "none", Cart.first(shelf)];
    }

    public static string first(Rows rows) => rows[0] ?? "";
}
