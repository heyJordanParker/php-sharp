namespace Crossed;

public static class Unverified
{
    public static Any anything(Function<Any()> f) => f();

    public static Object object(Function<Object()> f) => f();

    public static Any read(Source source) => source.read();

    public static List<float> mapped(Function<float(int)> f)
    {
        List<int> numbers = [1, 2];
        return numbers.map(f);
    }

    public static float summed(Function<float(int)> f)
    {
        List<int> numbers = [1, 2];
        return numbers.sumOf(f);
    }

    public static Map<float, List<int>> grouped(Function<float(int)> f)
    {
        List<int> numbers = [1, 2];
        return numbers.groupBy(f);
    }

    public static Map<float, int> associated(Function<float(int)> f)
    {
        List<int> numbers = [1, 2];
        return numbers.associateBy(f);
    }

    public static List<float> lazy(Function<float(int)> f)
    {
        Iterable<int> numbers = [1, 2];
        return numbers.map(f).toList();
    }

    public static List<float>? maybeMapped(List<int>? numbers, Function<float(int)> f) => numbers?.map(f);

    public static List<Any> anyMapped(Function<Any(int)> f)
    {
        List<int> numbers = [1, 2];
        return numbers.map(f);
    }
}
