namespace LoweredAround;

// Reads each of them as PHP# code does.
public static class Uses
{
    public static string holder()
    {
        Holder<string> holder = new HolderChild("first");
        holder.value = "second";
        return holder.value;
    }

    public static int maker() => new Maker.__make(4).size;

    public static string shape()
    {
        let shape = Shape.class(3);
        return shape is Shape.class ? `class with ${shape.sides} sides` : "dot";
    }
}
