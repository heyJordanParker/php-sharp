namespace DataInOut;

import Sharp.Encoding.Json;
import Sharp.Encoding.Query;

public static class Accounts
{
    public static Account decoded(string json) => Json.decode<Account>(json);

    public static string encoded(Account account) => Json.encode(account);

    public static AccountStatus statusOf(string json) => Json.decode<Account>(json).status;

    public static Account parsed(Map<string, Any?> input) => Account.parse(input);

    public static Account queried(string query) => Query.decode<Account>(query);

    public static string statement(string json) => Json.encode(Json.decode<Statement>(json));
}
