namespace DataInOut;

import Sharp.Decimal;

public struct Money : string
{
    public Money(public Decimal amount { get; }) { }

    public string value => this.amount.value;

    public static Money zero() => new Money(Decimal.parse("0.00").unwrap());

    public static Result<Money, ParseError> parse(Any? value)
    {
        if (value is not string text) {
            return Result.Err(new ParseError(["": "expected string"]));
        }
        return Result.Ok(new Money(try Decimal.parse(text)));
    }

    public string toString() => this.amount.toString();
}
