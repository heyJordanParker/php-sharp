namespace DataInOut;

import Sharp.Decimal;

public struct Money : string
{
    public Money(public Decimal amount { get; }) { }

    public string value => this.amount.value;

    public static Money zero() => new Money(Decimal.parse("0.00"));

    public static Money parse(string text) => new Money(Decimal.parse(text));

    public string toString() => this.amount.toString();
}
