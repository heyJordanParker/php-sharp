namespace DataInOut;

import Sharp.Decimal;
import Sharp.Encoding.Json;
import Sharp.Encoding.Query;
import Sharp.Time.Instant;

public static class Ledger
{
    public static Payment payment(string? coupon)
        => new Payment("https://shop.test/done", Decimal.parse("1.50"), Instant.parse("2026-10-22T18:30:00Z"), coupon, new Card("4242"));

    public static string encoded(string? coupon) => Json.encode(Ledger.payment(coupon));

    public static bool roundTrips(string? coupon) => Json.encode(Json.decode<Payment>(Ledger.encoded(coupon))) == Ledger.encoded(coupon);

    public static string? couponOf(string json) => Json.decode<Payment>(json).coupon;

    public static int payments(string json) => Json.decode<List<Payment>>(json).count();

    public static PaymentMethod method(string json) => Json.decode<PaymentMethod>(json);

    public static PaymentMethod? methodOf(Map<string, Any?> input) => PaymentMethod.tryParse(input);

    public static string paid() => Json.encode(PaymentResult.Paid("tx_1"));

    public static PaymentResult result(string json) => Json.decode<PaymentResult>(json);

    public static string shipment(Shipment shipment) => Json.encode(shipment);

    public static Shipment shipmentOf(string json) => Json.decode<Shipment>(json);

    public static Search search(string query) => Query.decode<Search>(query);

    public static Prize prize(string json) => Json.decode<Prize>(json);

    public static ComponentProperty property(Map<string, Any?> input) => ComponentProperty.parse(input);

    public static ComponentProperty propertyOf(string json) => Json.decode<ComponentProperty>(json);

    public static ComponentProperty propertyFrom(string query) => Query.decode<ComponentProperty>(query);

    public static string encodedProperty(ComponentProperty property) => Json.encode(property);
}
