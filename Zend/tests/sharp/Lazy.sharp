namespace Lazy;

public class Plan
{
    private int id = 0;

    public lazy int doubled => this.id * 2;
    public lazy int remainder => 100 % this.id;
    public lazy int? found => this.id > 0 ? this.id : null;
    public lazy int stamp => Loads.next();

    public void setId(int id)
    {
        this.id = id;
    }
}

public class Loads
{
    private static int count = 0;

    public static int next()
    {
        Loads.count = Loads.count + 1;
        return Loads.count;
    }

    public static int seen() => Loads.count;
}
