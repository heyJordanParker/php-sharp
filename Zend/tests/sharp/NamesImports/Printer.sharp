namespace Imports;

import Acme.Clock.Events;
import Acme.Clock.SystemClock as Clock;
import Acme.Pdf;
import Imports.Return as Back;

public class Printer
{
    public static string print(string html) => Pdf.render(html);

    public static int dpi() => Pdf.DEFAULT_DPI;

    public static string clock() => Clock.label();

    public static int events() => Events.count();

    public static string stage() => Environment.stage();

    public static string keywords() => Return.label() + " " + If.label() + " " + Back.label();
}
