namespace Demo;

class Page
{
    private string name = "";
    private int views = 0;

    public Page(string name) => this.name = name;

    public string slug => this.name.lowercase();
    protected int doubled => this.views * 2;
    private string title => global.ucfirst(this.name);

    public string link() => global.sprintf("/page/%s", this.slug);
    public void visit() => this.views++;
    public int seen() => this.doubled;
    public static string home() => "/";
    public string heading() => global.sprintf("%s (%d)", this.title, this.views);
}
