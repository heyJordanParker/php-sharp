namespace Shop;

import InvalidArgumentException;

public class Receipts
{
    public void deliver(OrderPaid e) on OrderPaid
    {
        if (e.amount < 0) {
            throw new InvalidArgumentException(`order ${e.orderId} has a negative amount`);
        }
        OrderNotices.heard.add(`deliver ${e.orderId}`);
    }

    public void reissue(OrderRefunded e) on OrderRefunded
    {
        OrderNotices.heard.add(`reissue ${e.orderId}`);
        emit new OrderPaid(e.orderId + 100, 0);
    }
}
