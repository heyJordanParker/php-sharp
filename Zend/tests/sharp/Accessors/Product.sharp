namespace Store;

import InvalidArgumentException;

class Product
{
    public string sku { get; set; } = "";
    public string name { get => field; set => field = value.trim(); } = "";
    public int price
    {
        get;
        set
        {
            if (value < 0) {
                throw new InvalidArgumentException("A price is never negative.");
            }

            field = value;
        }
    } = 0;
    public int stock { get; private set => field = Math.max(0, value); } = 0;
    public List<string> tags
    {
        get => field;
        set
        {
            field = [];
            for (const tag of value) {
                field.add(tag.lowercase());
            }
        }
    } = [];
    public List<int> ratings { get; private set; } = [];
    public int rating { get; set => this.ratings.add(value); } = 0;

    public void tag(string tag)
    {
        this.tags.add(tag);
    }

    public void restock(int count)
    {
        this.stock = this.stock + count;
    }
}
