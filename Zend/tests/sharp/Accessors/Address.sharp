namespace Store;

import Lib.Words;

class Address
{
    protected string region { get => field.uppercase(); }
    public string city { get; set => field = Words.capitalized(value.trim()); }

    public Address(string city, string region)
    {
        this.city = city;
        this.region = region;
    }

    public string label()
    {
        return `${this.city}, ${this.region}`;
    }
}
