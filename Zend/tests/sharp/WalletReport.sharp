namespace Demo;

import Demo.Wallets.WalletExtensions;
import Lib.AuditedWallet;
import Lib.Wallet;

public class WalletReport
{
    public static string describe(Wallet wallet, string name)
        => name.trim().shout() + " " + (string) wallet.total(2) + " " + (string) wallet.total(extra: 3) + " "
            + (wallet.isEmpty ? "empty" : "full");

    public static string label(Wallet|string owner) => owner.label;

    public static string audited(AuditedWallet wallet) => (string) wallet.total(2) + " " + (wallet.isEmpty ? "empty" : "full");
}
