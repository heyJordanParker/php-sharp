namespace ClassKeys;

public static class Registry
{
    public static string handlers()
    {
        Map<Class<Any?>, string> handlers = [typeof(Box<int>): "ints", typeof(Box<string>): "strings"];
        handlers[typeof(Box<int>)] = "numbers";

        return `${handlers.count()} ${handlers[typeof(Box<int>)] ?? ""} ${handlers[typeof(Box<string>)] ?? ""}`;
    }

    public static int kinds()
    {
        Set<Class<Any?>> kinds = [typeof(Box<int>), typeof(Box<string>), typeof(Box<int>), typeof(Registry)];

        return kinds.count();
    }

    public static bool held<T : Equatable>(List<T> values, T value) => values.contains(value);

    public static bool found() => Registry.held([typeof(Box<int>)], typeof(Box<int>)) && !Registry.held([typeof(Box<int>)], typeof(Box<string>));
}
