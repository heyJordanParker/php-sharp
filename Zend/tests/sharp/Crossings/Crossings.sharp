namespace Demo;

import Illuminate.Container.Attributes.Config;
import Illuminate.Database.Events.MigrationsStarted;
import Illuminate.Support.Arr;
import Illuminate.Support.Collection;
import Illuminate.Support.Fluent;
import Illuminate.Support.LazyCollection;
import Illuminate.Support.ServiceProvider;
import Lib.Probe;
import Symfony.Component.EventDispatcher.EventDispatcher;

class Crossings
{
    // Arr::isAssoc declares array, Arr::query declares no type and documents array, and Arr::wrap documents mixed.
    public static List<string> outward(Map<string, int> prices, Set<string> tags)
    {
        return [`${Arr.isAssoc(prices)}`, `${Arr.isAssoc(tags)}`, Arr.query(prices), Arr.query(tags)];
    }

    public static Any? wrapped(Map<string, int> prices) => Arr.wrap(prices);

    // A value that may be one of several collections reaches an array parameter as the PHP array of the one it holds.
    public static string mapOrSet(bool pick, Map<string, int> prices, Set<string> tags) => Arr.query(pick ? prices : tags);

    public static string listOrMap(bool pick, List<int> sizes, Map<string, int> prices) => Arr.query(pick ? sizes : prices);

    // Arr::add writes into its own copy of the array.
    public static string written(Map<string, int> prices) => `${Arr.query(Arr.add(prices, "jam", 9))} / ${Arr.query(prices)}`;

    // Collection::all() documents array<TKey, TValue>, whose PHP array holds the key "5" as the int 5.
    public static Map<string, int> local(Collection<string, int> plain)
    {
        Map<string, int> prices = plain.all();
        prices["jam"] = 5;
        return prices;
    }

    public static Map<string, int> returned(Collection<string, int> plain) => plain.all();

    public static List<string> plainMapCalls(Collection<string, int> plain) => [
        `${plain.all().get("tea") ?? -1}`,
        `${plain.all().get("5") ?? -1}`,
        `${plain.all().has("5")}`,
        Probe.join(",",plain.all().keys()),
        `${plain.all().count()}`,
    ];

    public static List<string> plainLoops(Collection<string, int> plain)
    {
        List<string> seen = [];
        for (const [sku, count] of plain.all()) {
            seen.add(`${sku is string}:${sku}=${count}`);
        }
        for (const entry of plain.all()) {
            seen.add(`${entry[0] is string}:${entry[0]}=${entry[1]}`);
        }
        for (const [string, int] typed of plain.all()) {
            seen.add(`${typed[0] is string}:${typed[0]}`);
        }
        return seen;
    }

    public static string untypedLocal(Collection<string, int> plain)
    {
        let kept = plain.all();
        const removed = kept.remove("5");
        const left = kept.count();
        kept = plain.all();
        return `${removed} ${left} ${kept.has("5")} ${Probe.typeName(kept)}`;
    }

    public static Map<string, int> received(Map<string, int> counts) => counts;

    // EventDispatcher::dispatch() takes an object and returns it.
    public static string dispatched(Map<string, int> prices, Set<string> tags)
    {
        const events = new EventDispatcher();
        return `${Probe.className(events.dispatch(prices))} ${Probe.className(events.dispatch(tags))}`;
    }

    public static string applied(Function<string(Map<string, int>)> each, Map<string, int> prices) => each(prices);

    // A PHP# lambda behind a function type takes the Map itself, not a PHP array it would build a Map from again.
    public static string appliedOwn(Map<string, int> prices) =>
        Crossings.applied(values => `${Probe.id(values) == Probe.id(prices)}`, prices);

    public static List<string> named(Map<string|Level, int> counts) => [`${counts.count()}`, `${counts["5"] ?? -1}`, `${counts.has("5")}`];

    public static string joined(Iterable<string> names)
    {
        let joined = "";
        for (const name of names) {
            joined = `${joined}${name} `;
        }
        return joined;
    }

    // LazyCollection::getIterator() documents Traversable<TKey, TValue>.
    public static string lazilyReturned(LazyCollection<int, string> plain)
    {
        Iterable<string> names = plain.getIterator();
        return Crossings.joined(names);
    }

    public static Iterable<string> returnedLazy(LazyCollection<int, string> plain) => plain;

    // Until it is held as an `Iterable<T>`, a plain PHP class keeps its own methods.
    public static int lazyCount(LazyCollection<int, string> plain) => plain.count();

    public static Map<Level, int?> limits() => [Level.Low: 5, Level.High: null];

    public static Map<string, int> sizes() => ["b": 2, "a": 1];

    public static Set<string> tagged() => ["a", "b"];

    public static List<Map<string, int>> shelves() => [["a": 1]];

    public static Map<string, int> lambdaSizes() => (() => Crossings.sizes())();

    public static Function<Map<string, int>()> sizer() => () => ["s": 1];

    public static string sent(Envelope envelope) => Arr.query(envelope.headers);

    public static string pair([string name, int count] given) => `${given.name} ${given.count}`;

    public static string entries(Iterable<[string, int]> given)
    {
        let joined = "";
        for (const [name, count] of given) {
            joined = `${joined}${name}=${count} `;
        }
        return joined;
    }

    public static string unioned(Set<string>|int given) => given is Set<string> ? `${Probe.className(given)} ${Probe.join(",",given.toList())}` : `int ${given}`;

    public static string mapOrInt(Map<string, int>|int given) => given is Map<string, int> ? `${Probe.className(given)} ${given["a"] ?? -1}` : `int ${given}`;

    public static Iterable<int> doubled(Iterable<int> numbers) => numbers.map(number => number * 2);

    public static Iterable<Map<string, int>> keyed(Iterable<int> numbers) => numbers.map(number => ["n": number]);

    public static string cartonPayloadClass(Carton carton) => Probe.className(carton.payload);

    // Each write into a plain PHP object gives it what a parameter of the property's type takes: MigrationsStarted
    // declares an array $options, Config a mixed $default, and ServiceProvider a static array.
    public static void filled(MigrationsStarted started, Config config, Map<string, int> prices, Set<string> tags)
    {
        started.options = prices;
        config.default = tags;
    }

    public static void filledStatic(Map<string, string> commands) { ServiceProvider.optimizeCommands = commands; }

    public static void filledElement(MigrationsStarted started, Map<string, int> prices) { started.options["first"] = prices; }

    public static void filledNested(MigrationsStarted started, Config config, Map<string, int> prices, Set<string> tags)
    {
        started.options = ["shelf": prices];
        config.default = [prices, tags];
    }

    public static void filledFromPlain(MigrationsStarted started, MigrationsStarted other) { started.options = other.options; }

    public static MigrationsStarted copied(MigrationsStarted started, Map<string, int> prices) => started with { options: prices };

    public static void filledPlus(MigrationsStarted started, Map<string, int> prices) { started.options += prices; }

    // Fluent takes a member it declares no property for through __set.
    public static void attributed(Fluent<string, Any?> attributes, Map<string, int> prices) { attributes.meta = prices; }

    public static Fluent<string, Any?> initialized(Map<string, int> prices) => new Fluent<string, Any?> { payload: prices };

    public static SendOptin jobInitialized(Map<string, int> prices) => new SendOptin { options: prices };

    public static SendOptin jobCopied(SendOptin job, Map<string, int> prices) => job with { options: prices };

    // A write into PHP#'s own property keeps the Map.
    public static string ownWritten(Holdings holdings, Map<string, string> payload)
    {
        holdings.payload = payload;
        return Probe.className(holdings.payload);
    }

    public static string ownEntries(Map<string, int> counts)
    {
        let joined = "";
        for (const entry of counts) {
            joined = `${joined}${entry[0]}:${entry[1]} `;
        }
        return `${joined}${Crossings.entries(counts)}`;
    }
}
