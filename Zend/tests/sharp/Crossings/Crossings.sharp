namespace Demo;

import ArrayCounter;
import Attributes;
import Lib;
import Lib.Probe;
import RequestContext;

class Crossings
{
    public static List<string> outward(Map<string, int> prices, Set<string> tags)
    {
        return [
            Lib.array_keys_of(prices),
            Lib.array_keys_of(tags),
            Lib.documented_keys_of(prices),
            Lib.type_of_mixed(prices),
            Lib.type_of_untyped(prices),
            Lib.type_of_iterable(tags),
        ];
    }

    public static Map<string, int> written(Map<string, int> prices)
    {
        Lib.write_array(prices);
        Lib.write_mixed(prices);
        return prices;
    }

    public static Map<string, int> local()
    {
        Map<string, int> prices = Lib.price_list();
        prices["jam"] = 5;
        return prices;
    }

    public static Map<string, int> returned() => Lib.price_list();

    public static List<string> plainMapCalls() => [
        `${Lib.price_list().get("tea") ?? -1}`,
        `${Lib.price_list().get("5") ?? -1}`,
        `${Lib.price_list().has("5")}`,
        Probe.join(",",Lib.price_list().keys()),
        `${Lib.price_list().count()}`,
    ];

    public static List<string> plainLoops()
    {
        List<string> seen = [];
        for (const [sku, count] of Lib.price_list()) {
            seen.add(`${sku is string}:${sku}=${count}`);
        }
        for (const entry of Lib.price_list()) {
            seen.add(`${entry[0] is string}:${entry[0]}=${entry[1]}`);
        }
        for (const [string, int] typed of Lib.price_list()) {
            seen.add(`${typed[0] is string}:${typed[0]}`);
        }
        return seen;
    }

    public static string untypedLocal()
    {
        let kept = Lib.price_list();
        const removed = kept.remove("5");
        const left = kept.count();
        kept = Lib.price_list();
        return `${removed} ${left} ${kept.has("5")} ${Probe.typeName(kept)}`;
    }

    public static Map<string, int> received(Map<string, int> counts) => counts;

    public static List<string> objects(Map<string, int> prices, Set<string> tags)
    {
        return [
            Lib.count_of_countable(prices),
            Lib.count_of_traversable(tags),
            Lib.json_of(prices),
            Lib.type_of_object(tags),
            Lib.count_of_map(prices),
        ];
    }

    public static string counted(Map<string, int> prices)
    {
        const counter = Lib.array_counter();
        return counter(prices);
    }

    public static string invoked(Map<string, int> prices)
    {
        const counter = new ArrayCounter();
        return counter(prices);
    }

    public static string applied(Function<string(Map<string, int>)> each, Map<string, int> prices) => each(prices);

    // A PHP# lambda behind a function type takes the Map itself, not a PHP array it would build a Map from again.
    public static string appliedOwn(Map<string, int> prices) =>
        Crossings.applied(values => `${Probe.id(values) == Probe.id(prices)}`, prices);

    public static List<string> named(Map<string|Level, int> counts) => [`${counts.count()}`, `${counts["5"] ?? -1}`, `${counts.has("5")}`];

    public static string joined(Iterable<string> names)
    {
        let joined = "";
        for (const name of names) {
            joined = `${joined}${name} `;
        }
        return joined;
    }

    public static string lazilyReturned(Any? last)
    {
        Iterable<string> names = Lib.names_and(last);
        return Crossings.joined(names);
    }

    public static string heldGenerator(Any? last)
    {
        Iterable<string> names = Lib.names_generator(last);
        return Crossings.joined(names);
    }

    public static string heldRows(Any? last)
    {
        Iterable<string> names = Lib.name_rows(last);
        return Crossings.joined(names);
    }

    public static Iterable<string> returnedLazy(Any? last) => Lib.lazy_names(last);

    public static string passedGenerator(Any? last) => Crossings.joined(Lib.names_generator(last));

    // Until it is held as an `Iterable<T>`, a plain PHP class keeps its own methods.
    public static int lazyCount(Any? last) => Lib.lazy_names(last).count();

    public static Map<Level, int?> limits() => [Level.Low: 5, Level.High: null];

    public static Map<string, int> sizes() => ["b": 2, "a": 1];

    public static Set<string> tagged() => ["a", "b"];

    public static List<Map<string, int>> shelves() => [["a": 1]];

    public static Map<string, int> lambdaSizes() => (() => Crossings.sizes())();

    public static Function<Map<string, int>()> sizer() => () => ["s": 1];

    public static string sent(Envelope envelope) => Lib.send_headers(envelope.headers);

    public static string pair([string name, int count] given) => `${given.name} ${given.count}`;

    public static string entries(Iterable<[string, int]> given)
    {
        let joined = "";
        for (const [name, count] of given) {
            joined = `${joined}${name}=${count} `;
        }
        return joined;
    }

    public static string unioned(Set<string>|int given) => given is Set<string> ? `${Probe.className(given)} ${Probe.join(",",given.toList())}` : `int ${given}`;

    public static string mapOrInt(Map<string, int>|int given) => given is Map<string, int> ? `${Probe.className(given)} ${given["a"] ?? -1}` : `int ${given}`;

    public static Iterable<int> doubled(Iterable<int> numbers) => numbers.map(number => number * 2);

    public static Iterable<Map<string, int>> keyed(Iterable<int> numbers) => numbers.map(number => ["n": number]);

    public static string cartonPayloadClass(Carton carton) => Probe.className(carton.payload);

    // Each write into a plain PHP object gives it what a parameter of the property's type takes.
    public static void filled(RequestContext context, Map<string, int> prices, Set<string> tags)
    {
        context.payload = prices;
        context.extra = tags;
        context.untyped = prices;
        context.anything = tags;
        context.items = prices;
        context.either = prices;
        context.counted = prices;
        RequestContext.registry = tags;
        context.payloads["first"] = prices;
        context.rows[0] = tags;
        context.rows.add(prices);
    }

    public static void filledOnce(RequestContext context, Map<string, int> prices) { context.extra ??= prices; }

    public static void filledNested(RequestContext context, Map<string, int> prices, Set<string> tags)
    {
        context.payload = ["shelf": prices];
        context.items = [prices, tags];
    }

    public static void filledFromPlain(RequestContext context, RequestContext other) { context.payload = other.payload; }

    public static RequestContext initialized(Map<string, int> prices) => new RequestContext { payload: prices };

    public static RequestContext copied(RequestContext context, Map<string, int> prices) => context with { payload: prices };

    public static SendOptin jobInitialized(Map<string, int> prices) => new SendOptin { payload: prices };

    public static SendOptin jobCopied(SendOptin job, Map<string, int> prices) => job with { payload: prices };

    public static T initializedAs<T : RequestContext>(Map<string, int> prices) => new T { payload: prices };

    public static RequestContext initializedAsContext(Map<string, int> prices) => Crossings.initializedAs<RequestContext>(prices);

    public static void filledPlus(RequestContext context, Map<string, int> prices) { context.payload += prices; }

    public static void attributed(Attributes attributes, Map<string, int> prices) { attributes.meta = prices; }

    // A write into PHP#'s own property keeps the Map.
    public static string ownWritten(Holdings holdings, Map<string, string> payload)
    {
        holdings.payload = payload;
        return Probe.className(holdings.payload);
    }

    public static string ownEntries(Map<string, int> counts)
    {
        let joined = "";
        for (const entry of counts) {
            joined = `${joined}${entry[0]}:${entry[1]} `;
        }
        return `${joined}${Crossings.entries(counts)}`;
    }
}
