namespace Demo;

import ArrayCounter;

class Crossings
{
    public static List<string> outward(Map<string, int> prices, Set<string> tags)
    {
        return [
            global.array_keys_of(prices),
            global.array_keys_of(tags),
            global.documented_keys_of(prices),
            global.type_of_mixed(prices),
            global.type_of_untyped(prices),
            global.type_of_iterable(tags),
        ];
    }

    public static Map<string, int> written(Map<string, int> prices)
    {
        global.write_array(prices);
        global.write_mixed(prices);
        return prices;
    }

    public static Map<string, int> local()
    {
        Map<string, int> prices = global.price_list();
        prices["jam"] = 5;
        return prices;
    }

    public static Map<string, int> returned() => global.price_list();

    public static List<string> plainMapCalls() => [
        `${global.price_list().get("tea") ?? -1}`,
        `${global.price_list().get("5") ?? -1}`,
        `${global.price_list().has("5")}`,
        global.implode(",", global.price_list().keys()),
        `${global.price_list().count()}`,
    ];

    public static List<string> plainLoops()
    {
        List<string> seen = [];
        for (const [sku, count] of global.price_list()) {
            seen.add(`${sku is string}:${sku}=${count}`);
        }
        for (const entry of global.price_list()) {
            seen.add(`${entry[0] is string}:${entry[0]}=${entry[1]}`);
        }
        for (const [string, int] typed of global.price_list()) {
            seen.add(`${typed[0] is string}:${typed[0]}`);
        }
        return seen;
    }

    public static string untypedLocal()
    {
        let kept = global.price_list();
        const removed = kept.remove("5");
        const left = kept.count();
        kept = global.price_list();
        return `${removed} ${left} ${kept.has("5")} ${global.get_debug_type(kept)}`;
    }

    public static Map<string, int> received(Map<string, int> counts) => counts;

    public static List<string> objects(Map<string, int> prices, Set<string> tags)
    {
        return [
            global.count_of_countable(prices),
            global.count_of_traversable(tags),
            global.json_of(prices),
            global.type_of_object(tags),
            global.count_of_map(prices),
        ];
    }

    public static string counted(Map<string, int> prices)
    {
        const counter = global.array_counter();
        return counter(prices);
    }

    public static string invoked(Map<string, int> prices)
    {
        const counter = new ArrayCounter();
        return counter(prices);
    }

    public static string applied(Function<string(Map<string, int>)> each, Map<string, int> prices) => each(prices);

    public static List<string> named(Map<string|Level, int> counts) => [`${counts.count()}`, `${counts["5"] ?? -1}`, `${counts.has("5")}`];

    public static string joined(Iterable<string> names)
    {
        let joined = "";
        for (const name of names) {
            joined = `${joined}${name} `;
        }
        return joined;
    }

    public static string lazilyReturned(Any? last)
    {
        Iterable<string> names = global.names_and(last);
        return Crossings.joined(names);
    }

    public static string heldGenerator(Any? last)
    {
        Iterable<string> names = global.names_generator(last);
        return Crossings.joined(names);
    }

    public static string heldRows(Any? last)
    {
        Iterable<string> names = global.name_rows(last);
        return Crossings.joined(names);
    }

    public static Iterable<string> returnedLazy(Any? last) => global.lazy_names(last);

    public static string passedGenerator(Any? last) => Crossings.joined(global.names_generator(last));

    // Until it is held as an `Iterable<T>`, a plain PHP class keeps its own methods.
    public static int lazyCount(Any? last) => global.lazy_names(last).count();

    public static string pair([string name, int count] given) => `${given.name} ${given.count}`;

    public static string entries(Iterable<[string, int]> given)
    {
        let joined = "";
        for (const [name, count] of given) {
            joined = `${joined}${name}=${count} `;
        }
        return joined;
    }

    public static string ownEntries(Map<string, int> counts)
    {
        let joined = "";
        for (const entry of counts) {
            joined = `${joined}${entry[0]}:${entry[1]} `;
        }
        return `${joined}${Crossings.entries(counts)}`;
    }
}
