namespace Demo;

import Label;
import Lib.Probe;

// Each place PHP evaluates a constant expression reads a Map or a Set constant of another class.
[Label("copies", config: Holdings.LIMITS)]
public class Copies
{
    public const Map<string, int> COPY = Holdings.LIMITS;

    public const Map<string, Map<string, int>> NESTED = ["inner": Holdings.LIMITS];

    public Map<string, int> limits { get; set; } = Holdings.LIMITS;

    public static Set<string> codes { get; set; } = Holdings.CODES;

    public string sized(Map<string, int> given = Holdings.LIMITS) => `${Probe.className(given)} ${given.count()}`;

    public string limitsClass() => Probe.className(this.limits);

    public static string reads() =>
        `${Probe.className(Copies.COPY)} ${Copies.COPY.count()} ${Probe.className(Copies.NESTED["inner"] ?? [:])} ${Probe.className(Copies.codes)}`;
}
