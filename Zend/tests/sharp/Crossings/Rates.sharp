namespace Demo;

import Lib.Probe;

// A Map constant, which PHP# makes into its object on the first read and keeps.
public class Rates
{
    public const Map<string, int> RATES = ["a": 1, "b": 2, "c": 3];

    // The object id of two reads, both held at once, so a read that made a new Map could not reuse the first one's id.
    public static List<int> readIds()
    {
        Map<string, int> first = Rates.RATES;
        Map<string, int> again = Rates.RATES;

        return [Probe.id(first), Probe.id(again)];
    }
}
