namespace Demo;

import Lib.Probe;

public class Carton
{
    public Map<string, int> payload { get; set; } = ["b": 2, "a": 1];

    public Set<string> codes { get; set; } = ["b", "a"];

    public string payloadText() =>
        `${Probe.className(this.payload)} ${Probe.join(",", this.payload.keys())}=${Probe.join(",", this.payload.values())}`;

    public string codesText() => `${Probe.className(this.codes)} ${Probe.join(",", this.codes.toList())}`;

    public int payloadAt(string key) => this.payload[key] ?? -1;

    public bool readsOnePayload() => Probe.id(this.payload) == Probe.id(this.payload);

    public void putPayload(string key, int value)
    {
        this.payload[key] = value;
    }

    public void replacePayload()
    {
        this.payload = ["z": 26];
    }

    public Carton copied() => this with { codes: ["c"] };

    public Map<Level, int> levels { get; set; } = [Level.Low: 1];

    public int putLevel()
    {
        this.levels[Level.High] = 2;

        return this.levels.count();
    }

    public Map<int|string, string> mixedKeys { get; set; } = [:];

    public int putMixedKeys()
    {
        this.mixedKeys[5] = "a";
        this.mixedKeys["5"] = "b";

        return this.mixedKeys.count();
    }

    public Map<string, Set<string>> tags { get; set; } = [:];

    public void tagA()
    {
        this.tags["a"] = ["x"];
    }

    public List<int> counts { get; set; } = [1, 2];

    public List<List<int>> grid { get; set; } = [[1]];

    public Set<int> numbers { get; set; } = [1];

    // What PHP# reads from each Map and Set plain PHP writes into: each key and value, or element, with its type.
    public string entriesText() =>
        `${Probe.join(",", this.payload.keys())}=${Probe.join(",", this.payload.values())} ${this.levels.count()} ${this.levels[Level.High] ?? -1} ${Probe.join(",", this.numbers.toList())}`;

    public int secondDoubled() => this.counts[1] * 2;

    public int gridFirst() => this.grid[0][0];

    public string countsText() => Probe.join(",", this.counts);

    public void addCount(int count)
    {
        this.counts.add(count);
    }

    public static List<int> totals { get; set; } = [1, 2];

    public static int secondTotal() => Carton.totals[1] * 2;

    // The constructor sets it, so an object plain PHP creates without the constructor holds it uninitialized.
    public List<int> later { get; set; }

    public Carton()
    {
        this.later = [];
    }

    public string laterText() => Probe.join(",", this.later);

    public Set<string>|int picked { get; set => field = value; } = 0;

    public string pickedText()
    {
        const picked = this.picked;

        return picked is Set<string> ? `${Probe.className(picked)} ${Probe.join(",", picked.toList())}` : "int";
    }
}
