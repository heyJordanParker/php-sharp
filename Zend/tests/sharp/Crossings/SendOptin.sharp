namespace Demo;

import Illuminate.Database.Events.MigrationsStarted;

// A PHP# event whose plain PHP parent declares the array property it fills.
public class SendOptin : MigrationsStarted
{
    public required SendOptin() : super("up") { }

    public void fill(Map<string, int> prices) { this.options = prices; }

    public void fillElement(Map<string, int> prices) { this.options["first"] = prices; }

    public static SendOptin made(Map<string, int> prices) => new Self { options: prices };
}
