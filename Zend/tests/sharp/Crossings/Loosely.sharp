namespace Demo;

public class Loosely
{
    public Any? loose { get; set; } = ["k": 1];

    public Iterable<Map<string, int>> shelved { get; set; } = [["s": 1]];

    public Map<string, Any> anyValues { get; set; } = ["m": ["k": 1]];

    public string looseType() => global.get_debug_type(this.loose);

    public string shelvedType()
    {
        for (const shelf of this.shelved) {
            return global.get_class(shelf);
        }

        return "none";
    }

    public string anyValuesType() => global.get_debug_type(this.anyValues["m"] ?? null);
}
