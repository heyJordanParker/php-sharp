namespace Demo;

import Lib.Probe;

public class Loosely
{
    public Any? loose { get; set; } = ["k": 1];

    public Iterable<Map<string, int>> shelved { get; set; } = [["s": 1]];

    public Map<string, Any> anyValues { get; set; } = ["m": ["k": 1]];

    // Plain PHP takes a Map held as Any as its PHP array, spec section 12, so a Map shows through a parameter that
    // takes only objects.
    public string looseType() => this.loose is Map<string, int> loose ? Probe.className(loose) : Probe.typeName(this.loose);

    public string shelvedType()
    {
        for (const shelf of this.shelved) {
            return Probe.className(shelf);
        }

        return "none";
    }

    public string anyValuesType()
        => this.anyValues["m"] is Map<string, int> held ? Probe.className(held) : Probe.typeName(this.anyValues["m"] ?? null);
}
