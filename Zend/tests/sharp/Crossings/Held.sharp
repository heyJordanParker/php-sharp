namespace Demo;

// A Map in a type parameter's place.
public class Held<T>
{
    public T value { get; set; }

    public Held(T value)
    {
        this.value = value;
    }

    public T get() => this.value;

    public static Held<Map<string, int>> ofMap() => new Held<Map<string, int>>(["h": 1]);
}
