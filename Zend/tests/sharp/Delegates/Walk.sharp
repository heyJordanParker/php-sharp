namespace App.Delegates;

import Demo.Helper;
import RuntimeException;

extern Helper.trusted uses Database;

// Delegates of `Order`'s members and of plain PHP methods, each of the function type its member fits or of one it
// doesn't.
public static class Walk
{
    static Method method(string name) => typeof(Order).methods().first(method => method.name == name);

    static Property property(string name) => typeof(Order).properties().first(property => property.name == name);

    public static Function<int(Order) uses Database> rows()
        => Walk.method("rows").createDelegate<Function<int(Order) uses Database>>();

    public static Function<int(Order) uses Mailer> rushCount()
        => typeof(Rush).methods().first(method => method.name == "count")
            .createDelegate<Function<int(Order) uses Mailer>>();

    public static bool rowsIsItsType() => Walk.rows() is Function<int(Order) uses Database>;

    public static Function<int(Order, int)> add() => Walk.method("add").createDelegate<Function<int(Order, int)>>();

    public static Function<int()> unit() => Walk.method("unit").createDelegate<Function<int()>>();

    public static Function<int(Order)> count() => Walk.method("count").createDelegate<Function<int(Order)>>();

    public static Function<int(Order)>? doubled()
        => Walk.property("doubled").getter()?.createDelegate<Function<int(Order)>>();

    public static Function<void(Order, int)>? total()
        => Walk.property("total").setter()?.createDelegate<Function<void(Order, int)>>();

    public static Function<int()>? stock()
        => Walk.property("stock").getter()?.createDelegate<Function<int()>>();

    public static Any? wrongParameter() => Walk.method("add").createDelegate<Function<int(Order, string)>>();

    public static Any? wrongResult() => Walk.method("add").createDelegate<Function<string(Order, int)>>();

    public static Any? effectNotAllowed() => Walk.method("notify").createDelegate<Function<int(Order) uses Database>>();

    public static Any? noReceiver() => Walk.method("add").createDelegate<Function<int()>>();

    public static Any? otherReceiver() => Walk.method("add").createDelegate<Function<int(string, int)>>();

    public static Any? tooFew() => Walk.method("add").createDelegate<Function<int(Order)>>();

    public static Any? noFunction() => Walk.method("add").createDelegate<int>();

    public static Any? plainPhp()
        => typeof(Helper).methods().first(method => method.name == "take").createDelegate<Function<int(int)>>();

    public static Function<int(Object) uses Database> rowsOfAnyObject()
        => Walk.method("rows").createDelegate<Function<int(Object) uses Database>>();

    public static Function<Object(Order)> itself() => Walk.method("itself").createDelegate<Function<Object(Order)>>();

    public static Any? functionResult() => Walk.method("counter").createDelegate<Function<Function<int()>(Order)>>();

    public static bool isCounter(Any? value) => value is Function<int()>;

    public static Function<string(RuntimeException)> declaredPure()
        => typeof(RuntimeException).methods().first(method => method.name == "getMessage")
            .createDelegate<Function<string(RuntimeException)>>();

    public static Any? declaredEffect()
        => typeof(Helper).methods().first(method => method.name == "trusted").createDelegate<Function<Any?(Any?)>>();

    public static Function<Any?(Any?) uses Database> declaredEffectAllowed()
        => typeof(Helper).methods().first(method => method.name == "trusted")
            .createDelegate<Function<Any?(Any?) uses Database>>();
}
