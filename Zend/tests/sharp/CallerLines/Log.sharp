namespace CallerLines;

public static class Log
{
    public static int line(int line = Position.current().line) => line;

    public static string function(string function = Position.current().function) => function;

    public static List<string> run()
    {
        const read = Log.line;
        return [`${Log.line()}`, `${Log.line(40)}`, Log.function(), `${read()}`];
    }
}
