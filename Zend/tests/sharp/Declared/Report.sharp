namespace Declared;

import Lib.Field;

public class Report
{
    public List<string> describe()
    {
        List<string> lines = [];
        for (const stored of typeof(Product).fields()) {
            const arguments = stored.type.typeArguments().map(type => type.name());
            const marks = stored.attributes<Field>().map(mark => `Field(${mark.label ?? ""})`);
            lines.add(`${stored.name}: ${stored.type.name()} arguments=[${arguments.join(", ")}] attributes=[${marks.join(", ")}]`);
        }
        const properties = typeof(Product).properties().map(property => property.name);
        lines.add(`properties: ${properties.join(", ")}`);
        return lines;
    }

    public List<bool> compare()
    {
        const fields = typeof(Product).fields();
        return [
            fields[0].type == typeof(List<string>),
            fields[1].type == typeof(int?),
            fields[0].type.typeArguments() == [typeof(string)],
            fields[1].type.typeArguments() == [],
            typeof(Map<string, int>).typeArguments() == [typeof(string), typeof(int)],
            typeof(Product).typeArguments() == [],
            fields[1].attributes<Object>().count() == 1,
        ];
    }
}
