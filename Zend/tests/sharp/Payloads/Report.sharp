namespace Payloads;

import Sharp.Encoding.Json;
import Sharp.Encoding.JsonValue;
import Sharp.Net.Ip;

public static class Report
{
    public static List<Any?> bytes()
        => [
            "école".length(),
            "école".toBytes().length(),
            "école".toBytes().toList(),
            "école".toBytes().slice(0, 2).toText(),
            "école".toBytes().slice(2).toText(),
            Ip.toBinary("192.168.0.1").toList(),
            Ip.toBinary("::1").length(),
            "".toBytes().toList(),
            "école".toBytes().slice(1, 2).toText(),
        ];

    public static Bytes byteRange(int start, int end) => "école".toBytes().slice(start, end);

    public static List<string> trims()
        => [
            "  sku  ".trim(),
            "--sku--".trim("-"),
            "--sku--".trimStart("-"),
            "/path/".trimEnd("/"),
            "xyx-a-xyx".trim("xy"),
            "ééaéé".trim("é"),
        ];

    public static List<string> encodings()
    {
        Map<string, Any> payload = ["url": "https://example.com/a", "name": "école", "total": 1.0];

        return [
            Json.encode(payload),
            Json.encode(payload, escapeSlashes: true, escapeUnicode: true, keepZeroFraction: false),
            Json.encode(payload, keepZeroFraction: false),
            Json.encode(payload, escapeSlashes: true),
            Json.encode(Json.parse<JsonValue>("{\"a\":[1,2.5,null]}").unwrap()),
        ];
    }

    public static List<bool> comparisons()
        => [
            Json.parse<JsonValue>("{\"a\":[1,2]}").unwrap() == Json.parse<JsonValue>("{ \"a\": [1, 2] }").unwrap(),
            Json.parse<JsonValue>("{\"a\":1,\"b\":2}").unwrap() == Json.parse<JsonValue>("{\"b\":2,\"a\":1}").unwrap(),
            Json.parse<JsonValue>("{\"a\":[1,2]}").unwrap() == Json.parse<JsonValue>("{\"a\":[2,1]}").unwrap(),
            Json.parse<JsonValue>("1").unwrap() == Json.parse<JsonValue>("1.0").unwrap(),
            Json.parse<JsonValue>("\"1\"").unwrap() == Json.parse<JsonValue>("1").unwrap(),
            Json.parse<JsonValue>("null").unwrap() == Json.parse<JsonValue>("false").unwrap(),
            Json.parse<JsonValue>("{\"a\":{\"b\":[true]}}").unwrap() == Json.parse<JsonValue>("{\"a\":{\"b\":[true]}}").unwrap(),
            Json.parse<JsonValue>("{\"a\":{\"b\":[true]}}").unwrap() == Json.parse<JsonValue>("{\"a\":{\"b\":[false]}}").unwrap(),
        ];

    public static Any? value(string json) => Json.parse<JsonValue>(json).unwrap().value;

    public static string column(SortColumn column) => column.value;
}
