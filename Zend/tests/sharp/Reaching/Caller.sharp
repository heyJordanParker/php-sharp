namespace Demo.Reaching;

import Demo.InternalReach.Ledger;
import Demo.Reaching.Dispatch;

extern Dispatch uses any;

// PHP# code outside the internal members' namespace whose calls the checker can't follow: each names its member to
// plain PHP, which calls it.
public final class Caller
{
    public static Any? byName() => Dispatch.call("Demo\\InternalReach\\Ledger::doubled", 2);

    public static Any? byArray(Ledger ledger) => Dispatch.call([ledger, "total"]);
}
