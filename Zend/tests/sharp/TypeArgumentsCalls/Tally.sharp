namespace Calls;

import App.DatabaseEntity;
import Lib.Probe;

// Each type argument's statics run their initial values that run as code once, on that type argument's first use, and
// have their own accessors' storage and `static lazy` value.
public class Tally<T : DatabaseEntity>
{
    public static int count { get; set; } = 0;

    public static string made { get; } = Runs.ran(`made ${Probe.named(typeof(T))}`);

    public static string label => `label ${Probe.named(typeof(T))} ${Tally<T>.count}`;

    public static int doubled { get => field * 2; set => field = value; } = 1;

    // An initial value that reads another static runs as code, after the statics it reads.
    public static int next { get; } = Tally<T>.doubled + 1;

    public static int watched { get; set; didSet => Tally<T>.count += 1; } = 0;

    public static lazy string once => Runs.ran(`once ${Probe.named(typeof(T))}`);

    public static int bump()
    {
        Tally<T>.count += 10;
        return Tally<T>.count;
    }
}
