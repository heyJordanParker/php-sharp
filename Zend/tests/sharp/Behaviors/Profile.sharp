namespace Behaviors;

public class Profile
{
    public string name { get; set; } via Trimmed, Counted = "  start  ";
    public string code { get; set; } via Counted, Upper = "x";
    public int level { get; set; } via Kept<int> = 1;
    public static string tag { get; set; } via Trimmed, Counted = "base";

    public Profile renamed(string name) => this with { name: name };

    public static string tagged() => Profile.tag;

    public static string retag(string tag)
    {
        Profile.tag = tag;
        return Profile.tag;
    }
}
