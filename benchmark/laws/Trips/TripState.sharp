namespace App.Trips;

import Sharp.Key;
import Sharp.Tag;
import Sharp.Time.Instant;

[Tag("state")]
public machine TripState
{
    [Key("underway")]
    case Underway([Key("stop_ids")] List<int> stopIds, [Key("stalls_at")] Instant stallsAt)
    {
        public TripState.Finished finish(Instant at) => TripState.Finished(at, this.visited());

        public TripState.Dropped drop(Instant at) => TripState.Dropped(at, this.visited());

        public TripState.Stalled stall() => TripState.Stalled(this.visited());

        private List<int> visited()
            => this.stopIds.count() > 0 ? this.stopIds : throw new ValueError("An underway trip stands on the stops it visited, and this one holds none.");
    }

    [Key("stalled")]
    final case Stalled([Key("stop_ids")] List<int> stopIds);

    [Key("finished")]
    final case Finished([Key("finished_at")] Instant finishedAt, [Key("stop_ids")] List<int> stopIds);

    [Key("dropped")]
    final case Dropped([Key("dropped_at")] Instant droppedAt, [Key("stop_ids")] List<int> stopIds);

    public static TripState.Underway begun(int stopId, Instant stallsAt) => TripState.Underway([stopId], stallsAt);

    public bool stalled() => this is TripState.Stalled;

    law onlyAStalledTripIsStalled(int stopId, Instant stallsAt, Instant at)
        => TripState.begun(stopId, stallsAt).stall().stalled()
            && !TripState.begun(stopId, stallsAt).stalled()
            && !TripState.begun(stopId, stallsAt).finish(at).stalled()
            && !TripState.begun(stopId, stallsAt).drop(at).stalled();
}
