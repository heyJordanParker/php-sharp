#!/bin/sh
set -eu

# Prints the runtime image's ./configure options, one per line, in docker-library's zts order, for
# frankenphp.Dockerfile's thread-safe engine. The Dockerfile passes them after its own --build and paths, so the line
# the image ships is the one sharp/README.md tells a source build to run. The order keeps php -i's "Configure Command"
# as docker-library's images print it.

if [ $# -ne 0 ]; then
	echo "usage: sharp/docker/runtime/configure-options" >&2
	exit 2
fi

# make sure invalid --configure-flags are fatal errors instead of just warnings
echo --enable-option-checking=fatal
# a compiler warning fails the release build, as php-src's own CI builds
echo --enable-werror

# https://github.com/docker-library/php/issues/439
echo --with-mhash

# https://github.com/docker-library/php/issues/822
echo --with-pic

# --enable-mbstring is included here because otherwise there's no way to get pecl to use it properly (see https://github.com/docker-library/php/issues/195)
echo --enable-mbstring
# PHP#: the standard library's string.normalized() runs on intl's Normalizer, so every engine builds it
echo --enable-intl
# PHP#: the standard library's Decimal and BigInteger run on bcmath's BcMath\Number, so every engine builds it
echo --enable-bcmath
# PHP#: the standard library's Sharp.IO.ZipArchive runs on zip's ZipArchive, so every engine builds it
echo --with-zip
# PHP#: every extension of PHP's own source that links no outside library, which an app would otherwise build again on
# each release, and MySQL's PDO driver, which runs on mysqlnd
echo --enable-calendar
echo --enable-exif
echo --enable-ftp
echo --enable-pcntl
echo --enable-shmop
echo --enable-sockets
echo --enable-sysvmsg
echo --enable-sysvsem
echo --enable-sysvshm
echo --with-pdo-mysql
# --enable-mysqlnd is included here because it's harder to compile after the fact than extensions are (since it's a plugin for several extensions, not an extension in itself)
echo --enable-mysqlnd
# https://wiki.php.net/rfc/argon2_password_hash
echo --with-password-argon2
# https://wiki.php.net/rfc/libsodium
echo --with-sodium=shared
# always build against system sqlite3 (https://github.com/php/php-src/commit/6083a387a81dbbd66d6316a3a12a63f06d5f7109)
echo --with-pdo-sqlite=/usr
echo --with-sqlite3=/usr

echo --with-curl
echo --with-iconv
echo --with-openssl
echo --with-readline
echo --with-zlib

# https://github.com/docker-library/php/pull/1259
echo --enable-phpdbg
echo --enable-phpdbg-readline

# in PHP 7.4+, the pecl/pear installers are officially deprecated (requiring an explicit "--with-pear")
echo --with-pear

# Debian's library folder for the build's architecture. sharp/bin/build-mago builds mago's engine with these options on
# macOS too, where configure finds each library itself.
if command -v dpkg-architecture > /dev/null; then
	# An assignment of its own, so a failure stops the script.
	multiarch="$(dpkg-architecture --query DEB_BUILD_MULTIARCH)"
	echo --with-libdir="lib/$multiarch"
fi

# https://github.com/docker-library/php/pull/939#issuecomment-730501748
echo --enable-embed

echo --enable-zts
# https://externals.io/message/118859
echo --disable-zend-signals
