#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
volumes=(--volume "$root:/src")
# A git worktree's .git is a file that names its folder in the main checkout's .git by absolute path, so that .git is
# mounted at the same path, and git, sharp/bin/spec and mago compile find the repository in the container as outside it.
if [[ -f "$root/.git" ]]; then
  common="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)"
  volumes+=(--volume "$common:$common")
fi
# The image is tagged with the blob hash of its Dockerfile and the tools image's, so a run whose tag exists uses it with
# no network call. Otherwise it pulls the build base-images.yml pushes under that hash each day and on each change, and
# uses it when it is built for the Docker server's architecture. A run that can't pull one, as without a login to
# ghcr.io, builds the tools image, tagged php-sharp-tools, which the Dockerfile copies the pinned tools from, then the
# image here. Docker pulls an image of one architecture onto any server, so an amd64 image pulled on arm64 failed every
# command with "Exec format error". sharp/bin/bench runs php-sharp-linux by that name. The pull and the builds each run
# again when the network fails them, as sharp/bin/network explains, and a failed build prints its output.
hash="$(cat "$root/sharp/docker/tools/Dockerfile" "$root/sharp/docker/Dockerfile" | git -C "$root" hash-object --stdin)"
image="php-sharp-linux:$hash"
published="ghcr.io/heyjordanparker/php-sharp-linux:$hash"
if ! docker image inspect "$image" > /dev/null 2>&1; then
  if "$root/sharp/bin/network" docker pull --quiet "$published" > /dev/null \
    && [[ "$(docker image inspect --format '{{.Architecture}}' "$published")" == "$(docker version --format '{{.Server.Arch}}')" ]]; then
    docker tag "$published" "$image"
  elif ! build="$("$root/sharp/bin/network" docker build --quiet --build-arg BASE_IMAGE --tag php-sharp-tools "$root/sharp/docker/tools")" \
    || ! build="$("$root/sharp/bin/network" docker build --quiet --build-arg BASE_IMAGE --build-arg GOLANG_IMAGE --tag "$image" "$root/sharp/docker")"; then
    printf '%s\n' "$build" >&2
    exit 1
  fi
fi
docker tag "$image" php-sharp-linux
# The build record's folder mounts at its own path, with XDG_STATE_HOME naming it and SHARP_RECORD_PARENT the record
# that runs this, so a build or test in the image writes its lines to the same file, under that record, see
# sharp/bin/record.
state="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$state/php-sharp"
volumes+=(--volume "$state/php-sharp:$state/php-sharp")
exec docker run --rm --init \
  --user "$(id -u):$(id -g)" \
  --ulimit stack=8388608:-1 \
  --env XDG_STATE_HOME="$state" \
  --env SHARP_RECORD_PARENT \
  --env CARGO_HOME=/src/sharp/build/cargo \
  --env XDG_CACHE_HOME=/src/sharp/build/cache \
  --env COMPOSER_HOME=/src/sharp/build/composer-home \
  --env GOPATH=/src/sharp/build/go \
  --env CARGO_BUILD_JOBS \
  --env CC \
  --env CXX \
  "${volumes[@]}" \
  --workdir /src \
  "$image" "$@"
