#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
volumes=(--volume "$root:/src")
# A git worktree's .git is a file that names its folder in the main checkout's .git by absolute path, so that .git is
# mounted at the same path, and git, sharp/bin/spec and mago compile find the repository in the container as outside it.
if [[ -f "$root/.git" ]]; then
  common="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)"
  volumes+=(--volume "$common:$common")
fi
docker build --quiet --build-arg BASE_IMAGE --build-arg GOLANG_IMAGE --tag php-sharp-linux "$root/sharp/docker" >/dev/null
exec docker run --rm --init \
  --user "$(id -u):$(id -g)" \
  --ulimit stack=8388608:-1 \
  --env CARGO_HOME=/src/sharp/build/cargo \
  --env RUSTUP_HOME=/src/sharp/build/rustup \
  --env ELAN_HOME=/src/sharp/build/elan \
  --env XDG_CACHE_HOME=/src/sharp/build/cache \
  --env COMPOSER_HOME=/src/sharp/build/composer-home \
  --env GOPATH=/src/sharp/build/go \
  --env MAKEFLAGS \
  --env CARGO_BUILD_JOBS \
  --env CARGO_INCREMENTAL \
  "${volumes[@]}" \
  --workdir /src \
  php-sharp-linux "$@"
