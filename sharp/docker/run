#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
volumes=(--volume "$root:/src")
# A git worktree's .git is a file that names its folder in the main checkout's .git by absolute path, so that .git is
# mounted at the same path, and git, sharp/bin/spec and mago compile find the repository in the container as outside it.
if [[ -f "$root/.git" ]]; then
  common="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)"
  volumes+=(--volume "$common:$common")
fi
# The image is tagged with the Dockerfile's blob hash, so a run whose tag exists uses it with no network call. Otherwise
# it pulls the build base-images.yml pushes under that hash each day and on each change, and uses it when it is built
# for the Docker server's architecture. A run that can't pull one, as without a login to ghcr.io, builds the image
# here. Docker pulls an image of one architecture onto any server, so an amd64 image pulled on arm64 failed every
# command with "Exec format error". sharp/bin/bench runs php-sharp-linux by that name.
hash="$(git -C "$root" hash-object sharp/docker/Dockerfile)"
image="php-sharp-linux:$hash"
published="ghcr.io/heyjordanparker/php-sharp-linux:$hash"
if ! docker image inspect "$image" > /dev/null 2>&1; then
  if docker pull --quiet "$published" > /dev/null 2>&1 \
    && [[ "$(docker image inspect --format '{{.Architecture}}' "$published")" == "$(docker version --format '{{.Server.Arch}}')" ]]; then
    docker tag "$published" "$image"
  else
    docker build --quiet --build-arg BASE_IMAGE --build-arg GOLANG_IMAGE --tag "$image" "$root/sharp/docker" >/dev/null
  fi
fi
docker tag "$image" php-sharp-linux
exec docker run --rm --init \
  --user "$(id -u):$(id -g)" \
  --ulimit stack=8388608:-1 \
  --env CARGO_HOME=/src/sharp/build/cargo \
  --env RUSTUP_HOME=/src/sharp/build/rustup \
  --env ELAN_HOME=/src/sharp/build/elan \
  --env XDG_CACHE_HOME=/src/sharp/build/cache \
  --env COMPOSER_HOME=/src/sharp/build/composer-home \
  --env GOPATH=/src/sharp/build/go \
  --env CARGO_BUILD_JOBS \
  --env CC \
  --env CXX \
  "${volumes[@]}" \
  --workdir /src \
  "$image" "$@"
