namespace Sharp.Interop;

import Attribute;

// Spec section 23: on a static method, declares the global function `function` names, which calls the method, before
// any library loads, so plain PHP that calls the function, or declares its own only when none exists, finds it.
[Attribute(Attribute.TARGET_METHOD)]
public class Export
{
    public Export(public string function { get; }) { }
}
