namespace Sharp;

import ReflectionAttribute;
import ReflectionMethod;

// A method a class declares, as `Class<T>.methods()` gives it, spec section 25: the class that declares it, its name,
// whether it is static, its visibility, the class value of its result type without `?`, whether the result type is
// nullable, and its parameters, as .NET's MethodInfo and Kotlin's KFunction give them. The engine creates it.
public class Method
{
    internal Method(
        public Class<Object> declaringClass { get; },
        public string name { get; },
        public bool isStatic { get; },
        public Visibility visibility { get; },
        public Class<Any?> type { get; },
        public bool isNullable { get; },
        private List<Parameter> declared
    ) { }

    // The method's parameters, in order.
    public List<Parameter> parameters() => this.declared;

    // The result of the method called on `receiver` with `arguments`, as .NET's MethodInfo.Invoke and Kotlin's
    // KCallable.call give it. The calling code reaches the method as a direct call would, and each argument is checked
    // against its parameter's type there. A method that isn't private runs the receiver's override. The call may run
    // any code, so it may have every effect, spec section 29.
    public Any? invoke(Object receiver, List<Any?> arguments)
        => Internal.invoke(receiver, this.declaringClass, this.name, arguments);

    // The attributes of the method of the class `TAttribute` or of a class that extends or implements it, as
    // `Class<T>.attributes()` gives a class's.
    public List<TAttribute> attributes<TAttribute : Object>()
        => new ReflectionMethod(this.declaringClass, this.name)
            .getAttributes(ClassMembers.attributeName<TAttribute>(), ReflectionAttribute.IS_INSTANCEOF)
            .map(attribute => attribute.newInstance());
}
