namespace Sharp;

import ReflectionAttribute;
import ReflectionClass;
import Sharp.Internal;

extern Internal.methods;
extern Internal.properties;
extern Internal.typeArguments;

public static class ClassMembers
{
    // The engine gives a type as the text `typeof` gives it, which is its class value, spec section 25.
    private static Class<Any?> classValue(string text)
        => text as Class<Any?> ?? throw new ValueError("The engine gave a type text that names no type.");

    // The engine gives the class that declares a member by its name.
    private static Class<Object> declaringClass(string name)
        => name as Class<Object> ?? throw new ValueError("The engine gave a class name that names no class.");

    // The engine gives a member's visibility as the access modifier that declares it, spec section 5.
    private static Visibility visibility(string modifier) => match (modifier)
    {
        "public" => Visibility.Public,
        "internal" => Visibility.Internal,
        "protected" => Visibility.Protected,
        "private" => Visibility.Private,
        default => throw new ValueError("The engine gave a visibility that is no access modifier."),
    };

    // `type` when it is a `Class<Object>`, the class value of a class, an interface or an enum, spec section 25, and null
    // for the class value of a type that is no class, as the root bound `Object`, `int` or `List<int>`, which PHP declares
    // no class for. Each member that hands a class value to PHP's reflection reads it through this, so such a type has no
    // members, and filters no attributes.
    internal static Class<T>? declared<T>(Class<T> type) => type is Class<Object> ? type : null;

    // The members of the class value of any type, a class's and `int`'s alike.
    extension(Class<Any?> type)
    {
        // The type's full name as PHP# writes it, spec section 25: `App.Orders.Counted`, and `List<string>` for a type
        // that is no class. A class value holds a class's name as PHP writes it, `App\Orders\Counted`.
        public string name() => global.str_replace("\\", ".", type);

        // The type arguments of the type, as `[typeof(string), typeof(int)]` for `Map<string, int>`, and none for a
        // type that has none.
        public List<Class<Any?>> typeArguments() => Internal.typeArguments(type).map(ClassMembers.classValue);
    }

    extension<T>(Class<T> type)
    {
        // The instance properties and fields of the class, its own first and then those it inherits, in the order they
        // are declared, private ones included, as an ORM or a serializer reads them, spec section 25.
        public List<Property> properties()
            => ClassMembers.declared(type) == null ? [] : Internal.properties(type).map(
                declared => new Property(
                    ClassMembers.declaringClass(declared[0]),
                    declared[1],
                    ClassMembers.visibility(declared[4]),
                    ClassMembers.classValue(declared[2]),
                    declared[3] == "?"
                )
            );

        // The instance and static methods of the class, its own first and then those it inherits, in the order they
        // are declared, private ones included, without its constructor, spec section 25.
        public List<Method> methods()
            => ClassMembers.declared(type) == null ? [] : Internal.methods(type).map(
                rows => new Method(
                    ClassMembers.declaringClass(rows[0][0]),
                    rows[0][1],
                    rows[0][4] == "static",
                    ClassMembers.visibility(rows[0][5]),
                    ClassMembers.classValue(rows[0][2]),
                    rows[0][3] == "?",
                    rows.slice(1).map(
                        parameter => new Parameter(
                            ClassMembers.declaringClass(rows[0][0]),
                            rows[0][1],
                            parameter[0],
                            ClassMembers.classValue(parameter[1]),
                            parameter[2] == "?",
                            parameter[3] == "optional",
                            parameter[4] == "variadic"
                        )
                    )
                )
            );

        public List<TAttribute> attributes<TAttribute : Object>()
            => ClassMembers.declared(type) == null ? [] : new ReflectionClass(type)
                .getAttributes(ClassMembers.declared(typeof(TAttribute)), ReflectionAttribute.IS_INSTANCEOF)
                .map(attribute => attribute.newInstance());
    }
}
