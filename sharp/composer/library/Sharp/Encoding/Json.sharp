namespace Sharp.Encoding;

import Sharp.Internal;
import Sharp.Internal.EncodedAsJson;
import Sharp.Internal.ParsesTypeArgument;

extern Internal.jsonEncode;

public static class Json
{
    // The value JSON text holds, an object as a `Map`, which compares by structure. It throws `JsonException` on text
    // that is no JSON.
    public static JsonValue parse(string json) => new JsonValue(Json.read(json));

    // The struct or PHP# class `T` that JSON text holds, read by `T.parse`, which throws one error that lists every bad
    // field (spec section 10).
    [ParsesTypeArgument]
    public static T decode<T>(string json)
    {
        const value = Json.read(json);
        if (!global.is_array(value) && !global.is_object(value)) {
            throw new ValueError("Json.decode: the JSON text holds no object, and a struct or a class is read from one");
        }

        return T.parse(value);
    }

    // JSON text of the value. By default `/` stays `/`, each character outside ASCII stays itself and `1.0` stays
    // `1.0`. `escapeSlashes` writes `/` as `\/`, `escapeUnicode` writes each character outside ASCII as `\u` and its
    // code, and `keepZeroFraction: false` writes `1.0` as `1`, so a payload matches the bytes another system signs:
    // all three give PHP's `json_encode` default, and `keepZeroFraction: false` alone JavaScript's `JSON.stringify`.
    // The text is one line. An `indent` above 0 writes each nested value on its own line, `indent` spaces deeper than
    // its parent, with `": "` after a key and `[]` and `{}` for an empty value, as JavaScript's
    // `JSON.stringify(value, null, 2)` and Python's `json.dumps(value, indent=2)` do, so `indent: 4` writes PHP's
    // `JSON_PRETTY_PRINT`. A negative `indent` throws `ValueError`.
    public static string encode(
        [EncodedAsJson] Any? value,
        bool escapeSlashes = false,
        bool escapeUnicode = false,
        bool keepZeroFraction = true,
        int indent = 0
    )
    {
        if (indent < 0) {
            throw new ValueError(`Json.encode: indent is ${indent}, and it must be 0 or more`);
        }

        return Internal.jsonEncode(
            value,
            (escapeSlashes ? 0 : global.JSON_UNESCAPED_SLASHES)
                | (escapeUnicode ? 0 : global.JSON_UNESCAPED_UNICODE)
                | (keepZeroFraction ? global.JSON_PRESERVE_ZERO_FRACTION : 0),
            indent
        );
    }

    private static Any? read(string json) => global.json_decode(json, true, 512, global.JSON_THROW_ON_ERROR);
}
