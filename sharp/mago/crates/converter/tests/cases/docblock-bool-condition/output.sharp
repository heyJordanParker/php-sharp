namespace App;

// A `bool` condition compiles to a test of the value itself, which reads PHP's truthiness of whatever the value holds
// at runtime, so a value only PHPDoc types `bool`, which may hold `1`, converts in `if`, `!`, `&&`, `||` and `?:`
// (spec section 21).
public final class Status
{
    public string shown(Row row)
    {
        if (row.active) {
            return 'on';
        }

        return 'off';
    }

    public bool hidden(Row row)
    {
        const active = row.active;

        return !active;
    }

    public bool both(Row row, bool first)
    {
        return first && row.active || !row.active;
    }

    public bool either(Row row, bool first)
    {
        const active = row.active;

        return active ? active : first;
    }

    // A write after the test that may not hold a `bool` changes nothing, since the test reads any value.
    public int seen(List<Row> rows, bool first)
    {
        let seen = first;
        let count = 0;
        for (const row of rows) {
            if (seen) {
                count = count + 1;
            }
            seen = row.active;
        }

        return count;
    }
}
