namespace App;

// A local's first assignment declares it: `const` when nothing writes it again, `let` when something does.
public final class Ledger
{
    public int total(int base)
    {
        const @let = 2;
        let sum = base + @let;
        sum += 1;
        let count = 0;
        count++;
        if (sum > 2) {
            const step = 1;
            count = count + step;
        }
        const result = sum + count;

        return result;
    }
}
