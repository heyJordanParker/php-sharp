namespace App;

/**
 * A value the analysis types wider than a type parameter whose bound excludes null is checked as that type
 * parameter, which `as` tests while the code runs and gives null for a value that is no `T` (spec section 21).
 */
public final class Holder<T : Object>
{
    private List<T> kept = [];

    public Holder(private Object found)
    {
    }

    public T item()
    {
        return this.found as T ?? throw new TypeError("Return value must be of type T");
    }

    public void keepFound()
    {
        this.keep(this.found as T ?? throw new TypeError("Argument #1 ($item) must be of type T"));
    }

    private void keep(T item)
    {
        this.kept.add(item);
    }

    // A `T` lands in a `T` as it is.
    public T same(T item)
    {
        return item;
    }
}
