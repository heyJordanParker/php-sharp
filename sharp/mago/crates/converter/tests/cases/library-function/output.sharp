namespace App;

import Acme.Format;
import Acme.Pdf;

// A library's function and constant are reached through their namespace, and one in PHP's root namespace through
// the namespace of the library's classes beside it, so `use function` and `use const` leave no line (spec section 23).
public final class Printer
{
    public string loud(string text)
    {
        return Format.shout(text);
    }

    public string page(string html)
    {
        return Pdf.render(html);
    }

    public int size()
    {
        return Pdf.SIZE;
    }
}
