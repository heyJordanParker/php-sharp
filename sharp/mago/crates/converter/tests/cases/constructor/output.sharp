namespace App;

// `__construct` is the class's name, and a promoted parameter declares a field or a property (spec section 9).
public final class Order
{
    public Order(
        private Spec spec,
        public string reference { get; set; },
        public int quantity { get; } = 1,
        string note = '',
    ) {
    }

    public Spec current()
    {
        return this.spec;
    }
}
