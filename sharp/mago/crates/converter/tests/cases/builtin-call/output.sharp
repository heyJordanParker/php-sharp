namespace App;

import Sharp.Security.Hash;

// A PHP built-in becomes the standard library member whose body runs it with PHP's meaning: an extension member on
// its receiver, or a static member through its class (decision 4).
public final class Words
{
    private List<string> names = [];

    public int size()
    {
        return this.names.count();
    }

    public string joined()
    {
        return this.names.join(', ');
    }

    public bool prefixed(string text)
    {
        return text.startsWith('a');
    }

    public string digest(string data)
    {
        return Hash.md5(data);
    }

    public float rounded(float value)
    {
        return value.round(2);
    }

    // An argument the call leaves out is the member's parameter whose default is PHP's own.
    public float whole(float value)
    {
        return value.round();
    }

    public string trimmed(string text)
    {
        return text.trim();
    }

    public string unslashed(string text)
    {
        return text.trim('/');
    }
}
