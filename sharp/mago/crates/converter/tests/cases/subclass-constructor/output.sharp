namespace App;

// A subclass's constructor runs its parent's first, as `: super(…)` with the arguments of the `parent::__construct(…)`
// its body starts with, which leaves the body (spec section 9).
public final class Savings : Account
{
    private int rate;

    public Savings(string owner, int rate) : super(owner)
    {
        this.rate = rate;
    }

    public int interest()
    {
        return this.rate;
    }
}
