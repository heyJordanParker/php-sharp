namespace App;

// A `List` spreads into a `...` parameter and into a literal (spec sections 7 and 12).
public final class Prices
{
    public int sum(int ...amounts)
    {
        let total = 0;
        for (const amount of amounts) {
            total += amount;
        }

        return total;
    }

    public List<int> join(List<int> first, List<int> second)
    {
        const all = [...first, ...second];
        const count = this.sum(...all);

        return [...all, count];
    }
}
