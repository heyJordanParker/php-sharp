namespace App;

// PHP's `(string)`, `.` and interpolation of an object call its class's `__toString`, which PHP# calls by name on a
// plain PHP class (spec section 18).
public final class Mailer
{
    public string address(Email to)
    {
        return to.self().__toString();
    }

    public string line(Email to)
    {
        return `to ${to.__toString()}${` (${to.__toString()})`}`;
    }
}
