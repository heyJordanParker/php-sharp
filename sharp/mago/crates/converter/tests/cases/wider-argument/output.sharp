namespace App;

// An argument the analysis types wider than its parameter is checked as the parameter's type, which PHP checks where
// the argument lands and throws a `TypeError` for any other value (spec section 21).
public final class Drawing
{
    public string draw(Shape shape)
    {
        return this.square(shape as Square ?? throw new TypeError("Argument #1 ($square) must be of type App\\Square"));
    }

    public string describe(Shape shape)
    {
        return Square.describe(square: shape as Square ?? throw new TypeError("Argument #1 ($square) must be of type ?App\\Square"));
    }

    public string title()
    {
        return this.shout(this.translated('title') as string ?? throw new TypeError("Argument #1 ($text) must be of type string"));
    }

    public string|Map<string, string> translated(string key)
    {
        return key;
    }

    private string square(Square square)
    {
        return 'square';
    }

    private string shout(string text)
    {
        return text;
    }
}
