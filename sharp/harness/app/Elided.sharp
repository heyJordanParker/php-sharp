namespace App;

import LogicException;

// What an example's `…` compiles to: code the spec leaves out, which throws if it ever runs. Creating one is pure,
// because the standard library declares `LogicException` pure, so `…` fits wherever the spec leaves code out, pure code
// included.
public class Elided : LogicException
{
    public static Any value()
    {
        throw new Elided();
    }
}
