{
	auto_https off
	# The deploy sharp/bin/hosts runs restarts the PHP threads through the admin API, as sharp/README.md's deploy does.
	admin localhost:2019
	# As the README's app.ini sets it: opcache never checks a file it cached, so only the restart runs a new release.
	frankenphp {
		php_ini opcache.validate_timestamps 0
	}
}

# One worker, so each request after the first sees what the last one left.
:8080 {
	php_server {
		root public
		worker {
			file ../worker.php
			name sequential
			num 1
			match /*
		}
	}
}

# Four workers, each running an app of its own, serving requests at once in one process.
:8081 {
	php_server {
		root public
		worker {
			file ../worker.php
			name concurrent
			num 4
			match /*
		}
	}
}

# A release under SHARP_DEPLOY, served through the `current` link a deploy moves, as the README's app serves one. The
# root stays the link, so each PHP thread reads the release the link names when it starts.
:8082 {
	php_server {
		root {$SHARP_DEPLOY}/current/public
		resolve_root_symlink false
	}
}
