#!/usr/bin/env bash
set -uo pipefail

# Runs a command that fetches from a registry or a download server, and runs it again, up to 3 tries in all, when its
# output shows the network failed it, so one dropped connection never fails a CI job: HOSTS failed run 45091043799 on
# "dial tcp 4.149.173.82:443: i/o timeout" from ghcr.io, and passed on a rerun. Any other failure fails at once, with
# the command's own status. The output streams as the command prints it, its standard error on standard output, so a
# caller reads no data from it.

if [[ $# -eq 0 ]]; then
  echo "usage: sharp/bin/network <command> [arguments...]" >&2
  exit 2
fi

# An HTTP/2 stream the server reset is one too: HOSTS failed run 45465654109 on "stream error: stream ID 5; INTERNAL_ERROR;
# received from peer" from proxy.golang.org.
failures='i/o timeout|connection reset by peer|connection refused|TLS handshake timeout|unexpected EOF|Temporary failure in name resolution|no such host|net/http: request canceled|context deadline exceeded|stream error|502 Bad Gateway|503 Service Unavailable|504 Gateway Timeout'
log="$(mktemp)"
trap 'rm -f "$log"' EXIT

for try in 1 2 3; do
  "$@" 2>&1 | tee "$log"
  status="${PIPESTATUS[0]}"
  if [[ $status -eq 0 ]] || ! grep -qE "$failures" "$log"; then
    exit "$status"
  fi
  if [[ $try -lt 3 ]]; then
    echo "sharp/bin/network: $1 failed on the network, try $try of 3, so it runs again." >&2
  fi
done
echo "sharp/bin/network: $1 failed on the network 3 times." >&2
exit "$status"
