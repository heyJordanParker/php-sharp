#!/usr/bin/env bash
set -euo pipefail

# Writes a release's version into the root package, mago, of sharp/mago/Cargo.toml and sharp/mago/Cargo.lock, in the
# checkout it runs in, where the mago binary and PHP#'s engine read it. A release's version lives in its tag alone, as
# sharp/bin/check --release explains, and each job that builds a release writes it so before it builds. In the tree the
# root package stays 0.0.0, as every workspace crate does, so only what reads the version rebuilds. The Mac and both
# Linux runners build a release, so it needs only bash and awk.
if [[ $# -ne 1 || ! $1 =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  echo "usage: sharp/bin/set-version <major>.<minor>.<patch>" >&2
  exit 2
fi
version=$1
mago="$(cd "$(dirname "$0")/../mago" && pwd)"

# Runs the awk program over the file, which exits 1 unless it wrote the version once.
write() {
  local file=$1 program=$2
  if ! awk -v version="$version" "$program" "$file" > "$file.new"; then
    rm -f "$file.new"
    echo "$file holds no version of the root package, mago." >&2
    exit 1
  fi
  mv "$file.new" "$file"
}

write "$mago/Cargo.toml" '
  /^\[/ { section = $0 }
  section == "[package]" && !written && /^version = "[^"]*"$/ { $0 = "version = \"" version "\""; written = 1 }
  { print }
  END { exit !written }
'
write "$mago/Cargo.lock" '
  previous == "name = \"mago\"" && /^version = "[^"]*"$/ { $0 = "version = \"" version "\""; written++ }
  { previous = $0; print }
  END { exit written != 1 }
'
echo "The root package, mago, is version $version."
