#!/usr/bin/env bash
set -euo pipefail

# Tags a release. A release is the commit its tag v<version> names, and sharp.yml's RELEASE publishes on that tag.
# GitHub refuses a workflow's GITHUB_TOKEN any tag on a commit whose workflows differ from master's, and master moves
# while a release builds: runs 45025602373 and 45027728255 failed to create v0.6.50 so. The language owner's login may,
# so once master holds a version with no tag, this tags the merge commit on master that first holds it, which master's
# first parents lead back to. The maintainer's tick runs it with that login.
repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
api() { gh api "repos/$repo/$1" --jq "$2"; }

version_at() {
  api "contents/sharp/mago/Cargo.toml?ref=$1" '.content | @base64d' \
    | awk -F '"' '/^version = / && version == "" {version = $2} END {print version}'
}
version=$(version_at master)
if gh api "repos/$repo/git/ref/tags/v$version" --silent 2> /dev/null; then
  exit 0
fi
first=$(api commits/master .sha)
while parent=$(api "commits/$first" '.parents[0].sha // empty') && [[ -n $parent ]] \
  && [[ $(version_at "$parent") == "$version" ]]; do
  first=$parent
done
gh api --method POST "repos/$repo/git/refs" -f ref="refs/tags/v$version" -f sha="$first" --silent
echo "Tag v$version names $first, the first merge commit on master that holds version $version."
