#!/usr/bin/env bash
set -euo pipefail

# Prints how many jobs a build or a test runs at once: CARGO_BUILD_JOBS when it is set, or else 6, or the machine's
# cores when it has fewer, as GitHub's runners do. A builder's Mac has 12
# cores and 64 GiB, and runs other builders' work beside its own, so 6 keeps one run from taking the machine.
# sharp/bin/build's make, sharp/bin/build-mago's cargo, sharp/bin/test's run-tests.php workers and test threads,
# sharp/bin/spec's compiles and sharp/bin/coverage's cargo each run this many.
cores="$(getconf _NPROCESSORS_ONLN)"
echo "${CARGO_BUILD_JOBS:-$((cores < 6 ? cores : 6))}"
