#!/usr/bin/env bash
set -euo pipefail

# Prints how many jobs a build or a test runs at once: CARGO_BUILD_JOBS when it is set, as the self-hosted runners set
# it to 4, or else 2. A builder's Mac has 12 cores and runs three self-hosted runners and up to three builders at once,
# so the runners take its cores and each builder's run takes 2.
# sharp/bin/build's make, sharp/bin/build-mago's cargo, sharp/bin/test's run-tests.php workers and test threads,
# sharp/bin/spec's compiles and sharp/bin/coverage's cargo each run this many.
echo "${CARGO_BUILD_JOBS:-2}"
