#!/usr/bin/env bash
set -euo pipefail

# Builds a branch off origin/master that holds only the commits it names, so a fix ships alone however red the stack
# it was committed in is. `sharp/bin/ship <commit>…` releases them as release/<version>, with the bump the first step
# of .claude/skills/maintain/SHIP.md describes, and `sharp/bin/ship --land <commit>…` lands them as land/<first commit>,
# with no bump. It applies each commit's diff, in the order named, to a private index read from origin/master, and
# fails naming the first commit whose diff doesn't apply, before it creates anything. Every lane commits on the
# checkout's one branch, whose git refuses `git commit-tree` and a branch switch, so the branch's one commit, whose
# parent is origin/master, is created through the GitHub API, and its pull request opens with auto-merge.
# Each run leaves its line in the build record, see sharp/bin/record.
[[ ${SHARP_RECORDED:-} == sharp/bin/ship ]] || exec "$(dirname "$0")/record" sharp/bin/ship -- "$0" "$@"

usage() {
  echo "usage: sharp/bin/ship [--land] <commit>..." >&2
  exit 2
}
land=false
if [[ ${1:-} == --land ]]; then
  land=true
  shift
fi
if [[ $# -eq 0 || $1 == -* ]]; then
  usage
fi

cd "$(dirname "$0")/../.."
repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
git fetch --quiet origin master
base=$(git rev-parse origin/master)
named() { git rev-list -1 --no-commit-header --format='%h %s' "$1"; }

commits=()
for name in "$@"; do
  if ! commit=$(git rev-parse --verify --quiet "$name^{commit}"); then
    echo "$name is no commit." >&2
    exit 1
  fi
  if git merge-base --is-ancestor "$commit" "$base"; then
    echo "$(named "$commit") is already on origin/master." >&2
    exit 1
  fi
  commits+=("$commit")
done

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
export GIT_INDEX_FILE=$work/index
git read-tree "$base"
for commit in "${commits[@]}"; do
  if ! git diff --binary "$commit^" "$commit" | git apply --cached --3way > "$work/applied" 2>&1; then
    echo "$(named "$commit") doesn't apply on origin/master, $(git rev-parse --short "$base"):" >&2
    cat "$work/applied" >&2
    exit 1
  fi
done

# The content each changed path ends with: its mode, its blob's SHA, and the file that holds it, or none for a blob of
# the private index. A path the commits delete has no SHA.
declare -A mode=() sha=() file=()
while IFS=$'\t' read -r meta path; do
  read -r _ new_mode _ new_sha status <<< "$meta"
  if [[ $status == D ]]; then
    mode[$path]=${meta:1:6}
    sha[$path]=''
  else
    mode[$path]=$new_mode
    sha[$path]=$new_sha
  fi
done < <(git diff-index --cached --no-renames "$base")

if $land; then
  branch=land/$(git rev-parse --short "${commits[0]}")
else
  current=$(git show :sharp/mago/Cargo.toml | awk -F '"' '/^version = / {print $2; exit}')
  IFS=. read -r major minor patch <<< "$current"
  version=$major.$minor.$((patch + 1))
  branch=release/$version
fi
if gh api "repos/$repo/git/ref/heads/$branch" --silent 2> /dev/null; then
  echo "$branch already exists on $repo." >&2
  exit 1
fi

# The bump: set-version.php's edits to the root package's version, its line in Cargo.lock and the versioned docs, run
# on the private index's copies of the files it reads, and the CHANGELOG's heading over the notes and its links.
if ! $land; then
  bumped=(sharp/mago/Cargo.toml sharp/mago/Cargo.lock sharp/CHANGELOG.md)
  while IFS= read -r doc; do
    path=sharp/mago/$doc
    while [[ $path == */../* ]]; do
      path=$(sed -E 's#[^/]+/\.\./##' <<< "$path")
    done
    bumped+=("$path")
  done < <(git show :sharp/mago/scripts/set-version.php \
    | awk "/^const VERSIONED_DOCUMENTATION_FILES = \[/ {listed = 1; next} listed && /^\];/ {exit}
      listed && match(\$0, /^ *'[^']+',/) {sub(/^ *'/, \"\"); sub(/',.*/, \"\"); print}")
  for path in "${bumped[@]}" sharp/mago/scripts/set-version.php; do
    mkdir -p "$work/tree/${path%/*}"
    git show ":$path" > "$work/tree/$path"
  done
  php "$work/tree/sharp/mago/scripts/set-version.php" "$version" > /dev/null
  if ! awk -v version="$version" -v date="$(TZ=UTC date +%F)" '
    $0 == "## [Unreleased]" && !heading {print; print ""; print "## [" version "] - " date; heading = 1; next}
    /^\[Unreleased\]: .*\/compare\/v[0-9.]+\.\.\.HEAD$/ && !link {
      url = $2; sub(/\/compare\/.*/, "", url)
      last = $2; sub(/.*\/compare\//, "", last); sub(/\.\.\.HEAD$/, "", last)
      print "[Unreleased]: " url "/compare/v" version "...HEAD"
      print "[" version "]: " url "/compare/" last "...v" version
      link = 1; next
    }
    {print}
    END {exit !(heading && link)}
  ' "$work/tree/sharp/CHANGELOG.md" > "$work/changelog"; then
    echo "sharp/CHANGELOG.md has no ## [Unreleased] heading or no [Unreleased] compare link from a tag." >&2
    exit 1
  fi
  mv "$work/changelog" "$work/tree/sharp/CHANGELOG.md"
  for path in "${bumped[@]}"; do
    if ! git show ":$path" | cmp -s - "$work/tree/$path"; then
      mode[$path]=$(git ls-files --stage -- "$path" | cut -d ' ' -f 1)
      sha[$path]=$(git hash-object "$work/tree/$path")
      file[$path]=$work/tree/$path
    fi
  done
fi
if ((${#mode[@]} == 0)); then
  echo "The commits change nothing on origin/master." >&2
  exit 1
fi

shipped=$(for commit in "${commits[@]}"; do echo "- $(named "$commit")"; done)
on_master="on origin/master $(git rev-parse --short "$base")"
if $land; then
  if ((${#commits[@]} == 1)); then
    subject=$(git rev-list -1 --no-commit-header --format=%s "${commits[0]}")
  else
    subject="land: the ${#commits[@]} commits from $(git rev-parse --short "${commits[0]}")"
  fi
  printf 'Lands these commits %s, and nothing else:\n\n%s\n' "$on_master" "$shipped" > "$work/body"
else
  subject="chore: release $version"
  printf 'Releases %s with these commits %s, and nothing else:\n\n%s\n' "$version" "$on_master" "$shipped" \
    > "$work/body"
fi

# Each blob, the tree over origin/master's, the commit and its branch, through the API. GitHub names each blob by its
# content, so a blob whose SHA differs from the one git computes didn't arrive whole.
: > "$work/entries"
for path in "${!mode[@]}"; do
  if [[ -z ${sha[$path]} ]]; then
    jq -n --arg path "$path" --arg mode "${mode[$path]}" '{path: $path, mode: $mode, type: "blob", sha: null}'
  elif [[ ${mode[$path]} == 160000 ]]; then
    jq -n --arg path "$path" --arg sha "${sha[$path]}" '{path: $path, mode: "160000", type: "commit", sha: $sha}'
  else
    if [[ -n ${file[$path]:-} ]]; then
      base64 < "${file[$path]}"
    else
      git cat-file blob "${sha[$path]}" | base64
    fi | tr -d '\n' | jq -Rs '{content: ., encoding: "base64"}' > "$work/blob"
    uploaded=$(gh api --method POST "repos/$repo/git/blobs" --input "$work/blob" --jq .sha)
    if [[ $uploaded != "${sha[$path]}" ]]; then
      echo "GitHub stored $path as blob $uploaded, where its content is blob ${sha[$path]}." >&2
      exit 1
    fi
    jq -n --arg path "$path" --arg mode "${mode[$path]}" --arg sha "${sha[$path]}" \
      '{path: $path, mode: $mode, type: "blob", sha: $sha}'
  fi >> "$work/entries"
done
tree=$(jq -n --arg base "$(git rev-parse "$base^{tree}")" --slurpfile entries "$work/entries" \
  '{base_tree: $base, tree: $entries}' | gh api --method POST "repos/$repo/git/trees" --input - --jq .sha)
commit=$(jq -n --arg message "$subject"$'\n\n'"$(< "$work/body")" --arg tree "$tree" --arg parent "$base" \
  '{message: $message, tree: $tree, parents: [$parent]}' | gh api --method POST "repos/$repo/git/commits" --input - --jq .sha)
gh api --method POST "repos/$repo/git/refs" -f ref="refs/heads/$branch" -f sha="$commit" --silent

# The branch holds what the private index and the bump hold, and nothing else, or it goes before its pull request opens.
git fetch --quiet origin "refs/heads/$branch"
held=true
for path in "${!mode[@]}"; do
  if [[ $(git rev-parse --quiet --verify "FETCH_HEAD:$path" || true) != "${sha[$path]}" ]]; then
    held=false
  fi
done
if ! $held || (($(git diff --no-renames --name-only "$base" FETCH_HEAD | wc -l) != ${#mode[@]})); then
  gh api --method DELETE "repos/$repo/git/refs/heads/$branch" --silent
  echo "GitHub's commit $commit differs from origin/master and the commits' changes, so $branch is deleted." >&2
  exit 1
fi
gh pr create --repo "$repo" --base master --head "$branch" --title "$subject" --body-file "$work/body"
gh pr merge "$branch" --repo "$repo" --auto --merge
echo "$branch holds $commit: $subject"
