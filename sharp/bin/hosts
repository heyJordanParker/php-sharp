#!/usr/bin/env bash
set -euo pipefail

# Serves sharp/hosts from FrankenPHP's worker mode, and compares what each request prints with
# sharp/hosts/expected/frankenphp.txt. FrankenPHP is built with Go against the engine sharp/bin/build installs.
usage() {
  echo "usage: sharp/bin/hosts [--linux] [--no-build]" >&2
  exit 2
}

root="$(cd "$(dirname "$0")/../.." && pwd)"
# Each run leaves its line in the build record, with each step's under it, see sharp/bin/record.
[[ ${SHARP_RECORDED:-} == sharp/bin/hosts ]] || exec "$root/sharp/bin/record" sharp/bin/hosts -- "$0" "$@"
record="$root/sharp/bin/record"
linux=false
# --no-build serves the fixture with the mago an earlier sharp/bin/build-mago made, as sharp/bin/test --no-build runs.
build=true
container_command=(sharp/bin/hosts)
for arg in "$@"; do
  case "$arg" in
    --linux) linux=true ;;
    --no-build) build=false; container_command+=("$arg") ;;
    *) usage ;;
  esac
done

if $linux; then
  exec "$root/sharp/docker/run" "${container_command[@]}"
fi
if [[ "$(uname -s)" != Linux ]]; then
  echo "sharp/bin/hosts runs on Linux. Run sharp/bin/hosts --linux." >&2
  exit 2
fi

build_dir="$root/sharp/build/linux-$(uname -m)"
install="$build_dir/install"
if [[ ! -x "$install/bin/php-config" ]]; then
  echo "$install/bin/php-config is missing. Run sharp/bin/build first." >&2
  exit 1
fi

if $build; then
  "$root/sharp/bin/build-mago" --quiet
fi
mago="$build_dir/mago/debug/mago"
if [[ ! -x $mago ]]; then
  echo "$mago is missing. Run sharp/bin/build-mago first." >&2
  exit 1
fi

fixture="$root/sharp/hosts"
# Composer keeps the copy of sharp/composer an earlier run installed while composer.lock is unchanged, so the install
# starts from nothing installed and the fixture compiles against the standard library the tree holds.
rm -rf "$fixture/vendor"
"$record" "composer install" -- composer install --no-interaction --no-progress --quiet --working-dir="$fixture"
"$record" "mago compile" -- "$mago" --no-version-check --colors never --workspace "$fixture" compile

# FrankenPHP's own build, as its go.sh runs it, without the modules that need C libraries the fixture doesn't use. It is
# the release sharp/docker/runtime/frankenphp.Dockerfile builds, so the fixture is served by the server teams ship, and
# each release builds in a folder of its own, so a new one never reuses an older one's source.
frankenphp_release=v1.13.5
frankenphp="$build_dir/frankenphp/$frankenphp_release/frankenphp"
if [[ ! -x "$frankenphp" || "$install/lib/libphp.so" -nt "$frankenphp" ]]; then
  source="$build_dir/frankenphp/$frankenphp_release/source"
  if [[ ! -d "$source" ]]; then
    git clone --quiet --depth 1 --branch "$frankenphp_release" https://github.com/php/frankenphp.git "$source"
  fi
  php_config="$install/bin/php-config"
  # php-config names libphp's folder in neither flag, so the link and the binary's run-time search path name it. Go's
  # build cache never reads the PHP headers a C file includes, so it lives in the build's folder and goes with it.
  (cd "$source/caddy/frankenphp" \
    && GOCACHE="$build_dir/frankenphp/go-build" \
      CGO_CFLAGS="$("$php_config" --includes)" \
      CGO_LDFLAGS="-L$install/lib -Wl,-rpath,$install/lib $("$php_config" --ldflags) $("$php_config" --libs)" \
      "$record" "go build" -- go build -p "$("$root/sharp/bin/jobs")" -tags nobadger,nomysql,nopgx,nowatcher,nobrotli \
        -buildvcs=false -o "$frankenphp")
fi

# Each request prints its path and what the fixture answers. /types runs 1,000 times, and its memory line becomes
# whether the memory after the 1,000th request is what it was after the 2nd.
requests() {
  local get="$1" path first second last
  for path in / /; do
    echo "GET $path"
    "$get" "$path"
  done
  echo "GET /types, 1,000 times"
  first="$("$get" /types)"
  echo "${first%%$'\n'memory:*}"
  second="$("$get" /types)"
  for ((request = 3; request <= 1000; request++)); do
    last="$("$get" /types)"
  done
  if [[ "${second##*memory: }" == "${last##*memory: }" ]]; then
    echo "memory: the same after the 1,000th request as after the 2nd"
  else
    echo "memory: ${second##*memory: } after the 2nd request, ${last##*memory: } after the 1,000th"
  fi
  echo "GET /flood"
  "$get" /flood
  echo "GET /words"
  "$get" /words
  echo "GET /types"
  last="$("$get" /types)"
  echo "${last%%$'\n'memory:*}"
  echo "GET /"
  "$get" /
}

frankenphp_get() {
  curl --silent --show-error --fail "http://127.0.0.1:8080$1"
}

# Waits for the host to listen, or fails when it exits or after 30 seconds. It asks for /types, which changes no line
# the fixture prints.
wait_for() {
  for ((tenth = 0; tenth < 300; tenth++)); do
    if "$@" > /dev/null 2>&1; then
      return 0
    fi
    if ! kill -0 "$host_pid" 2> /dev/null; then
      break
    fi
    sleep 0.1
  done
  echo "The host did not answer: $*" >&2
  return 1
}

failed=()
host_pid=
deploy=
trap '[[ -z "$host_pid" ]] || kill "$host_pid" 2> /dev/null || true; [[ -z "$deploy" ]] || rm -rf "$deploy"' EXIT

compare() {
  local host="$1" output="$2"
  if diff -u "$fixture/expected/$host.txt" <(echo "$output"); then
    echo "== $host: every request printed what sharp/hosts/expected/$host.txt holds"
  else
    failed+=("$host")
  fi
}

# The deploy root the Caddyfile's third site serves, laid out as sharp/README.md's: each release is a copy of the
# fixture in releases/, compiled there, with public/release.php, which prints the release's name, and `current` names
# the one served. It lives on the host's own file system, as a server's releases do: on a folder Docker Desktop shares
# from macOS, a path read through `current` while `mv` replaces it fails for an instant, and that request gets a 404.
deploy="$(mktemp -d)"
mkdir -p "$deploy/releases"
release() {
  local folder="$deploy/releases/$1"
  cp -a "$fixture" "$folder"
  printf '<?php\n\necho basename(dirname(__DIR__)), "\\n";\n' > "$folder/public/release.php"
  "$mago" --no-version-check --colors never --workspace "$folder" compile
}
release one
ln -s "$deploy/releases/one" "$deploy/current"

echo "== FrankenPHP, in worker mode"
# Caddy keeps its state under these folders, which the build's folder holds.
(cd "$fixture" \
  && XDG_CONFIG_HOME="$build_dir/frankenphp/config" XDG_DATA_HOME="$build_dir/frankenphp/data" \
    SHARP_DEPLOY="$deploy" exec "$frankenphp" run --config Caddyfile) &
host_pid=$!
wait_for frankenphp_get /types
compare frankenphp "$(requests frankenphp_get)"

# The Caddyfile's second site runs four workers in one process, which share the engine's process-wide type tables.
echo "== FrankenPHP, 400 requests over four workers, 32 at once"
urls=()
for ((request = 0; request < 400; request++)); do
  urls+=(http://127.0.0.1:8081/types)
done
same="$(curl --silent --show-error --fail --parallel --parallel-max 32 "${urls[@]}" \
  | grep -c '^types: the same after unserialize$' || true)"
if [[ "$same" == 400 ]]; then
  echo "== FrankenPHP's four workers: all 400 requests printed \"types: the same after unserialize\""
else
  echo "FrankenPHP's four workers: $same of 400 requests printed \"types: the same after unserialize\"" >&2
  failed+=("FrankenPHP's four workers")
fi

# The README's deploy, while requests keep arriving 8 at a time, in batches of 100: release two compiles in its own
# folder, `current` moves to it, and FrankenPHP restarts its PHP threads through the admin API. Every request succeeds,
# and the requests after the restart run release two. `current` moves between the releases 51 times, as 51 deploys do,
# ending on release two, so a file system that shows the link missing while `mv` replaces it fails a request in every
# run.
echo "== FrankenPHP, requests during a deploy"
release two
urls=()
for ((request = 0; request < 100; request++)); do
  urls+=(http://127.0.0.1:8082/types)
done
before="$(curl --silent --show-error --fail http://127.0.0.1:8082/release.php)"
(
  while [[ ! -e "$deploy/stop" ]]; do
    echo batch
    curl --silent --show-error --parallel --parallel-max 8 --write-out 'status %{http_code}\n' "${urls[@]}" 2>&1 || true
  done
) > "$deploy/served.txt" &
requests_pid=$!
sleep 0.5
for ((move = 1; move <= 51; move++)); do
  moved_to=one
  if ((move % 2)); then
    moved_to=two
  fi
  ln -sfn "$deploy/releases/$moved_to" "$deploy/current.next"
  mv -T "$deploy/current.next" "$deploy/current"
done
curl --silent --show-error --fail -X POST http://localhost:2019/frankenphp/workers/restart > /dev/null
sleep 0.5
touch "$deploy/stop"
wait "$requests_pid"
after="$(curl --silent --show-error --fail http://127.0.0.1:8082/release.php)"
sent=$(($(grep -c '^batch$' "$deploy/served.txt") * 100))
served="$(grep -c '^types: the same after unserialize$' "$deploy/served.txt" || true)"
if [[ "$served" == "$sent" && "$before" == one && "$after" == two ]]; then
  echo "== FrankenPHP's deploy: all $sent requests succeeded, and the restart moved them from release $before to release $after"
else
  echo "FrankenPHP's deploy: $served of $sent requests succeeded, release $before before the restart, release $after after it" >&2
  grep -v -e '^batch$' -e '^types: the same after unserialize$' -e '^memory: [0-9]*$' -e '^status 200$' "$deploy/served.txt" \
    | head -20 >&2 || true
  failed+=("FrankenPHP's deploy")
fi

if [[ ${#failed[@]} -gt 0 ]]; then
  printf 'Failed: %s\n' "${failed[@]}" >&2
  exit 1
fi
