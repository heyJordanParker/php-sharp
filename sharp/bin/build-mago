#!/usr/bin/env bash
set -euo pipefail

# Builds mago from sharp/mago into sharp/build/<os>-<arch>/mago, with the toolchain ext/sharp/rust-toolchain.toml pins
# and in the test-run profile sharp/mago/Cargo.toml explains, so the binary is sharp/build/<os>-<arch>/mago/test-run/mago.
# sharp/bin/test, sharp/bin/hosts, sharp/bin/bench and CI build it here alone. Every argument goes to cargo build, such
# as --quiet, --jobs 2 or --message-format=json.
root="$(cd "$(dirname "$0")/../.." && pwd)"
cargo="$(cd "$root/ext/sharp" && rustup which cargo)"
PATH="$(dirname "$cargo"):$PATH" exec "$cargo" build --locked --profile test-run \
  --manifest-path "$root/sharp/mago/Cargo.toml" \
  --target-dir "$root/sharp/build/$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m)/mago" --bin mago "$@"
