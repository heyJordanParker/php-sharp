#!/usr/bin/env bash
set -euo pipefail

# Builds sharp/mago as `cargo test --workspace` builds it, mago and every test binary in the dev profile, into
# sharp/build/<os>-<arch>/mago, with the toolchain ext/sharp/rust-toolchain.toml pins. So a worktree keeps one build of
# Mago, and the binary is the mago the tests run, sharp/build/<os>-<arch>/mago/debug/mago. A build of mago alone would
# resolve its dependencies' features without the tests' dev-dependencies and compile most crates a second time.
# sharp/bin/test, sharp/bin/hosts and sharp/bin/bench build it here alone, with the jobs sharp/bin/jobs prints. Every
# argument goes to cargo test, such as --quiet. It builds the PHP# engine mago links first. `--engine` builds the engine
# alone, which a CI job that links mago with cargo itself runs first, and a cargo check or clippy never needs.
root="$(cd "$(dirname "$0")/../.." && pwd)"
engine_only=false
if [[ ${1:-} == --engine ]]; then
  engine_only=true
  shift
fi
cargo="$(cd "$root/ext/sharp" && rustup which cargo)"
target="$root/sharp/build/$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m)/mago"

# The PHP# engine mago links, which runs the extension hosts inside mago, one interpreter per analysis thread. It builds
# with the options sharp/docker/runtime/configure-options prints, the runtime image's, so a host runs inside mago with
# the extensions an app runs with. Four options change: the embed SAPI builds as a static library, which mago links
# into its own binary, each shared extension links in too, since a static engine loads no shared extension, readline
# runs on libedit, since GNU readline is GPL, which mago can't link, and the Argon2 password hashes come from sodium,
# whose archive holds Argon2's own functions under the names libargon2's archive gives them, so one link can't hold both.
# MAGO_ENGINE names an engine built elsewhere, as a CI job restores one from its cache, which mago links as it is.
build_engine() {
  platform="$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m)"
  engine="$root/sharp/build/$platform-engine"
  options=(--prefix="$engine/install")
  while IFS= read -r option; do
    case "$option" in
      --enable-embed) options+=(--enable-embed=static) ;;
      --with-readline) options+=(--with-libedit) ;;
      --with-password-argon2) ;;
      *=shared) options+=("${option%=shared}") ;;
      *) options+=("$option") ;;
    esac
  done < <("$root/sharp/docker/runtime/configure-options")

  if [[ "$(uname -s)" == Darwin ]]; then
    brew_opt="$(brew --prefix)/opt"
    export PATH="$brew_opt/bison/bin:$PATH"
    export PKG_CONFIG_PATH="$brew_opt/icu4c/lib/pkgconfig:$brew_opt/openssl@3/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    sdk="$(xcrun --show-sdk-path)"
    # The readline extension runs on the system's libedit, which every Mac has. It ships no pkg-config file, so its
    # flags go to configure directly.
    export EDIT_CFLAGS="-I$sdk/usr/include" EDIT_LIBS=-ledit
    # The system's iconv, which every Mac has, so mago depends on no Homebrew iconv.
    options=("${options[@]/#--with-iconv/--with-iconv=$sdk/usr}")
  fi

  # mago links every library the engine's extensions need from a static archive, so it runs on a machine that has only
  # the system's own libraries. The engine finds each through pkg-config's static flags, which name what each archive
  # needs in turn. Curl and libzip build here from their releases on every platform: a packaged curl's archive needs
  # HTTP/2, IDN, SSH, LDAP and Kerberos archives besides, and no package ships libzip's archive on both. Curl takes
  # OpenSSL alone, and libzip zlib and OpenSSL alone. Oniguruma builds here on Linux, where Debian ships no archive of it,
  # at 6.9.10, whose callbacks state their parameters, so it compiles as C23, as GCC 15 compiles by default.
  deps="$root/sharp/build/$platform-engine-deps"
  export PKG_CONFIG="pkg-config --static" PKG_CONFIG_PATH="$deps/install/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
  # Builds the library `name` at `version` from the release at `url`, whose SHA-256 is `sha256`, into $deps/install, with
  # the commands after them, run in its source folder. A finished build leaves $deps/<name>-<version>.built, so each
  # version builds once, and a build of a new version builds the engine again from nothing.
  static_library() {
    local name=$1 version=$2 url=$3 sha256=$4
    shift 4
    if [[ -f "$deps/$name-$version.built" ]]; then
      return
    fi
    local archive="$deps/source/${url##*/}" folder="$deps/source/$name-$version"
    mkdir -p "$deps/source"
    curl --fail --silent --show-error --location --output "$archive" "$url"
    if [[ "$(shasum -a 256 "$archive" | cut -d' ' -f1)" != "$sha256" ]]; then
      echo "$url's SHA-256 is not $sha256, so it isn't the release build-mago names" >&2
      exit 1
    fi
    rm -rf "$folder"
    mkdir -p "$folder"
    tar -xf "$archive" -C "$folder" --strip-components 1
    (cd "$folder" && "$@") </dev/null >/dev/null
    rm -rf "$folder" "$archive" "$engine"
    touch "$deps/$name-$version.built"
  }
  static_library curl 8.11.1 https://curl.se/download/curl-8.11.1.tar.xz \
    c7ca7db48b0909743eaef34250da02c19bc61d4f1dcedd6603f109409536ab56 \
    sh -c "./configure --prefix='$deps/install' --disable-shared --enable-static --with-pic --with-openssl \
      --without-libpsl --without-brotli --without-zstd --without-nghttp2 --without-nghttp3 --without-ngtcp2 \
      --without-libidn2 --without-libssh --without-libssh2 --without-librtmp --without-libgsasl --without-gssapi \
      --disable-ldap --disable-ldaps --disable-docs --disable-manual && make -j$("$root/sharp/bin/jobs") && make install"
  static_library libzip 1.11.2 https://libzip.org/download/libzip-1.11.2.tar.xz \
    5d471308cef4c4752bbcf973d9cd37ba4cb53739116c30349d4764ba1410dfc1 \
    sh -c "cmake -S . -B build -DCMAKE_INSTALL_PREFIX='$deps/install' -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_SHARED_LIBS=OFF \
      -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DENABLE_BZIP2=OFF -DENABLE_LZMA=OFF -DENABLE_ZSTD=OFF -DENABLE_GNUTLS=OFF \
      -DENABLE_MBEDTLS=OFF -DBUILD_TOOLS=OFF -DBUILD_REGRESS=OFF -DBUILD_OSSFUZZ=OFF -DBUILD_EXAMPLES=OFF -DBUILD_DOC=OFF \
      && cmake --build build -j$("$root/sharp/bin/jobs") && cmake --install build"
  if [[ "$(uname -s)" == Linux ]]; then
    static_library oniguruma 6.9.10 https://github.com/kkos/oniguruma/releases/download/v6.9.10/onig-6.9.10.tar.gz \
      2a5cfc5ae259e4e97f86b68dfffc152cdaffe94e2060b770cb827238d769fc05 \
      sh -c "./configure --prefix='$deps/install' --disable-shared --enable-static --with-pic \
        && make -j$("$root/sharp/bin/jobs") && make install"
  fi

  if [[ "$(uname -s)" == Darwin ]]; then
    # PHP's configure keeps only the -l and -L flags of a library's pkg-config flags, so the frameworks curl's archive
    # needs reach the engine through LIBS, which php-config --libs names too.
    export LIBS="$($PKG_CONFIG --libs-only-other libcurl)"
  fi

  # A build configured with other options builds from nothing, for the reasons sharp/bin/build gives.
  status="$engine/config.status"
  if [[ -f "$status" && " $("$status" --config) " != " ${options[*]} "* ]]; then
    rm -rf "$engine"
  fi
  if [[ ! -f "$root/configure" ]]; then
    (cd "$root" && ./buildconf --force)
  fi
  # A change to an input configure reads configures again, as in sharp/bin/build: an extension's Makefile.frag is copied
  # into the Makefile only when configure runs.
  if [[ ! -f "$status" || "$root/configure" -nt "$status" || "$root/sharp/docker/runtime/configure-options" -nt "$status" || -n "$(find "$root" \( -path "$root/.git" -o -path "$root/sharp" \) -prune -o \( -name configure.ac -o -name '*.m4' -o -name '*.in' -o -name Makefile.frag -o -name Makefile.global \) -newer "$status" -print -quit)" ]]; then
    (cd "$root" && ./buildconf --force)
    mkdir -p "$engine"
    (cd "$engine" && "$root/configure" "${options[@]}")
  fi

  # The cargo build of ext/sharp's Rust library, which make runs, reads CARGO_BUILD_JOBS as its jobs.
  CARGO_BUILD_JOBS="$("$root/sharp/bin/jobs")" make -C "$engine" -j"$("$root/sharp/bin/jobs")" >/dev/null
  make -C "$engine" install-headers install-programs >/dev/null

  # libtool's static libphp.a holds no object: it takes ext/sharp's libsharp.a for one and drops the rest. So the archive
  # mago links holds the objects the libphp link names, each .lo's .o, and the static archive of each library the link
  # names, so the linker finds every symbol in one archive whatever order they need each other in. libsharp.a goes beside
  # it. system-libs names the libraries left to the system, one rustc link-lib per line, which the engine crate links.
  library="$engine/install/lib"
  if [[ ! -f "$library/libphp.a" || "$engine/libs/libphp.a" -nt "$library/libphp.a" ]]; then
    mkdir -p "$library"
    objects=()
    for object in $(make -s -C "$engine" -f Makefile -f - print-objects <<< 'print-objects: ; @echo $(PHP_GLOBAL_OBJS) $(PHP_SAPI_OBJS)'); do
      case "$object" in
        *.lo) objects+=("$engine/${object%.lo}.o") ;;
        */libsharp.a) cp "$engine/$object" "$library/libsharp.a.part" && mv "$library/libsharp.a.part" "$library/libsharp.a" ;;
        *) echo "the libphp link names $object, which is neither an object nor ext/sharp's library" >&2; exit 1 ;;
      esac
    done

    # The C library, the C++ runtime and the rest of what every machine of the platform has stay the system's. A
    # library outside that list links from its archive, found where the engine's link looks, then in the system's own
    # library folder, which on Debian is the multiarch one.
    folders=("$deps/install/lib")
    read -r -a ldflags <<< "$("$engine/install/bin/php-config" --ldflags)"
    for flag in "${ldflags[@]}"; do
      [[ $flag == -L* ]] && folders+=("${flag#-L}")
    done
    if [[ "$(uname -s)" == Linux ]]; then
      system=(c m pthread rt dl util stdc++ gcc_s)
      folders+=("/usr/lib/$(gcc -print-multiarch)" /usr/lib)
    else
      system=(c m pthread stdc++ c++ resolv z iconv xml2 icucore sqlite3 edit ncurses)
    fi
    archives=()
    : > "$library/system-libs.part"
    read -r -a libs <<< "$("$engine/install/bin/php-config" --libs)"
    for ((index = 0; index < ${#libs[@]}; index++)); do
      flag=${libs[index]}
      case "$flag" in
        -framework) echo "framework=${libs[++index]}" >> "$library/system-libs.part"; continue ;;
        # -l:<file> names the archive's own file, as OpenSSL 3.5's libcrypto names jitterentropy's.
        -l:*) name= file=${flag#-l:} ;;
        -l*) name=${flag#-l} file=lib${flag#-l}.a ;;
        *) continue ;;
      esac
      if [[ -n $name && " ${system[*]} " == *" $name "* ]]; then
        # macOS ships libc++ alone. Its clang links it for -lstdc++, which intl's link names, but rustc links with
        # -nodefaultlibs, which keeps clang from doing so.
        [[ "$(uname -s)" == Darwin && $name == stdc++ ]] && name=c++
        echo "$name" >> "$library/system-libs.part"
        continue
      fi
      archive=
      for folder in "${folders[@]}"; do
        if [[ -f "$folder/$file" ]]; then
          archive="$folder/$file"
          break
        fi
      done
      if [[ -z $archive ]]; then
        echo "the engine links $flag, and no folder holds $file: ${folders[*]}" >&2
        exit 1
      fi
      [[ " ${archives[*]} " == *" $archive "* ]] || archives+=("$archive")
    done
    sort -u -o "$library/system-libs.part" "$library/system-libs.part"

    rm -f "$library/libphp.a.part"
    if [[ "$(uname -s)" == Darwin ]]; then
      libtool -static -no_warning_for_no_symbols -o "$library/libphp.a.part" "${objects[@]}" "${archives[@]}"
    else
      ar crs "$library/libphp.a.part" "${objects[@]}"
      { echo "OPEN $library/libphp.a.part"; printf 'ADDLIB %s\n' "${archives[@]}"; echo SAVE; echo END; } | ar -M
    fi
    mv "$library/system-libs.part" "$library/system-libs"
    mv "$library/libphp.a.part" "$library/libphp.a"
  fi
}
if $engine_only || [[ -z ${MAGO_ENGINE:-} ]]; then
  build_engine
fi
if $engine_only; then
  exit 0
fi

# $target/build.json holds cargo's messages about the build, one JSON object per line, among them every test binary it
# made and the folder each build script wrote, while the diagnostics print as cargo prints them. sharp/bin/test runs the
# test binaries it names, as does a CI job that runs them on another job's build with sharp/bin/test --no-build. A
# failed build leaves no build.json, so no run takes a build that failed for one that passed.
messages="$target/build.json"
rm -f "$messages"
mkdir -p "$target"
PATH="$(dirname "$cargo"):$PATH" "$cargo" test --workspace --locked --no-run \
  --manifest-path "$root/sharp/mago/Cargo.toml" \
  --target-dir "$target" --jobs "$("$root/sharp/bin/jobs")" --message-format=json-render-diagnostics "$@" \
  > "$messages.part"
mv "$messages.part" "$messages"

# Cargo never deletes a copy of a crate it no longer uses. Each distinct `cargo test -p` or `cargo clippy -p` list
# compiles its own copy of the shared crates, and so does each version bump or Cargo.lock change. A fresh build holds
# 5.9 GiB, 7 lists took one slot from 5.85 to 7.37 GiB, and live slots reached 16 GiB. So in a builder's slot, a
# profile folder above 10 GiB keeps only the crates this build used. Cargo names each file and folder of a crate's
# compile, and of a build script's run, with that unit's metadata hash, and build.json names the files of every unit
# the build used, built or fresh. So an entry of deps, build, examples or .fingerprint whose hash build.json doesn't
# name goes. The prune runs once the build has passed, so a failed build, even on a bad argument, leaves every file.
# In CI the folder is a cache that CI keeps itself. clean-kept-build bounds it on the self-hosted Macs. On GitHub-hosted
# runners mago-cache restores it with a manifest, $target/sources, which a delete would lose, so a later restore would
# rebuild every crate. sharp/docker/run doesn't pass GITHUB_ACTIONS into the container, so a hosted Linux job shows by that manifest.
# A profile folder in use stays. Cargo holds the flock on the folder's .cargo-lock while it builds there, and releases
# it before it runs the test binaries, which run from the folder, as each mago the tests start does. So the prune
# skips the folder while it can't take that flock without waiting, or while a process runs from the build. Each
# sharp/docker/run is its own container with its own processes, so a prune there can't see a test binary another
# container runs from the same folder: run one sharp/docker/run at a time per slot.
if [[ -z ${GITHUB_ACTIONS:-} && ! -e $target/sources ]]; then
  # Runs the rest of the line while it holds the flock on the lock file, or exits 75 at once when another process
  # holds it: util-linux's flock on Linux, and BSD's lockf on macOS, which has no flock command.
  holding() {
    local lock=$1
    shift
    if command -v flock > /dev/null; then
      flock --nonblock --conflict-exit-code 75 "$lock" "$@"
    else
      /usr/bin/lockf -s -k -t 0 "$lock" "$@"
    fi
  }

  tab=$'\t'
  shopt -s nullglob
  # Each profile folder: debug, and one a tool builds below the folder, as cargo-llvm-cov's llvm-cov-target/debug.
  for lock in "$target"/*/.cargo-lock "$target"/*/*/.cargo-lock; do
    profile=$(dirname "$lock")
    size=$(du -sk "$profile" | cut -f1)
    if (( size <= 10 * 1024 * 1024 )); then
      continue
    fi
    held="$profile held $((size / 1024)) MiB, above the 10 GiB bound, but"
    status=0
    holding "$lock" true || status=$?
    if (( status == 75 )); then
      echo "$held a cargo holds $lock, so it is building there, and the folder stays." >&2
      continue
    fi
    if ! command -v pgrep > /dev/null; then
      echo "$held pgrep is missing, so no check sees a process running from $target, and the folder stays." >&2
      continue
    fi
    running=$(pgrep -d, -f "$target/" || true)
    if [[ -n $running ]]; then
      echo "$held these processes run from $target, so the folder stays:" >&2
      ps -o pid=,command= -p "$running" >&2
      continue
    fi
    used=$({ grep -oE '/(deps|build|examples)/[^/"]+-[0-9a-f]{16}' "$messages" || true; } \
      | sed -E 's/.*-([0-9a-f]{16})$/\1/')
    # Cargo copies a bin up out of deps, and an example out of its hashed name in examples, and names only the copy. So
    # each one's unit is the hashed file its copy matches byte for byte.
    while IFS= read -r copy; do
      if [[ $copy != "$profile"/* || $copy =~ -[0-9a-f]{16}$ ]]; then
        continue
      fi
      folder=$(dirname "$copy")
      if [[ $folder == "$profile" ]]; then
        folder="$profile/deps"
      fi
      for file in "$folder/$(basename "$copy")"-*; do
        if [[ $file =~ -([0-9a-f]{16})$ ]] && cmp -s "$file" "$copy"; then
          used+=$'\n'"${BASH_REMATCH[1]}"
        fi
      done
    done < <(sed -nE 's/.*"executable":"([^"]+)".*/\1/p' "$messages")
    used=$(LC_ALL=C sort -u <<< "$used" | sed '/^$/d')
    if [[ -z $used ]]; then
      echo "$held $messages names no crate's hash, so no prune can tell the crates this build used." >&2
      exit 1
    fi
    stale=$(printf '%s\n' "$profile"/{deps,build,examples,.fingerprint}/* \
      | sed -nE "s|^(.*-([0-9a-f]{16})([.][^/]*)?)\$|\\2$tab\\1|p" | LC_ALL=C sort -t "$tab" -k 1,1 \
      | LC_ALL=C join -t "$tab" -v 1 - <(printf '%s\n' "$used") | cut -f 2-)
    if [[ -z $stale ]]; then
      echo "$held each crate in it is one this build used, so the folder stays." >&2
      continue
    fi
    status=0
    printf '%s\n' "$stale" | tr '\n' '\0' | holding "$lock" xargs -0 rm -rf -- || status=$?
    if (( status == 75 )); then
      echo "$held a cargo holds $lock, so it is building there, and the folder stays." >&2
      continue
    fi
    if (( status != 0 )); then
      exit "$status"
    fi
    echo "$profile held $((size / 1024)) MiB, above the 10 GiB bound, so the $(grep -c '' <<< "$stale") entries of" \
      "crates this build didn't use went, and it holds $(($(du -sk "$profile" | cut -f1) / 1024)) MiB." >&2
  done
  shopt -u nullglob
fi
