#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
# Each run leaves its line in the build record, with each step's under it, see sharp/bin/record.
[[ ${SHARP_RECORDED:-} == sharp/bin/build ]] || exec "$root/sharp/bin/record" sharp/bin/build -- "$0" "$@"
record="$root/sharp/bin/record"
linux=false
clean=false
release=false
# --enable-werror, as php-src's own CI builds, so a warning fails the build here and in CI before it fails an upstream
# merge or a packager's build.
werror=--enable-werror
container_command=(sharp/bin/build)
for arg in "$@"; do
  case "$arg" in
    --linux) linux=true ;;
    --clean) clean=true; container_command+=("$arg") ;;
    --release) release=true; container_command+=("$arg") ;;
    *) echo "usage: sharp/bin/build [--clean] [--linux] [--release]" >&2; exit 2 ;;
  esac
done

if $linux; then
  exec "$root/sharp/docker/run" "${container_command[@]}"
fi

build_dir="$root/sharp/build/$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m)"
# The release build sharp/bin/bench --release measures, at -O2 without debug, as Users run the engine, sits beside it.
if $release; then
  build_dir+=-release
  export CFLAGS=-O2
fi

# PHP# runs on FrankenPHP alone, so the engine is thread-safe, with the embed SAPI's libphp, which sharp/bin/hosts links
# FrankenPHP against from Linux's installed build, and without Zend signals, which FrankenPHP refuses, as docker-library's
# zts images and sharp/docker/runtime/configure-options build it.
flags=(
  --prefix="$build_dir/install"
  --enable-option-checking=fatal
  "$werror"
  --enable-zts
  --enable-embed
  --disable-zend-signals
  --disable-cgi
  --without-pear
  --enable-zend-test
  --enable-mbstring
  --enable-intl
  --enable-bcmath
  --enable-pcntl
  --with-sodium
  --with-zip
  --with-zlib
  --with-curl
)

if [[ "$(uname -s)" == Darwin ]]; then
  brew_opt="$(brew --prefix)/opt"
  export PATH="$brew_opt/bison/bin:$PATH"
  export PKG_CONFIG_PATH="$brew_opt/icu4c/lib/pkgconfig:$brew_opt/curl/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
  flags+=(
    --with-pgsql="$brew_opt/libpq"
    --with-pdo-pgsql="$brew_opt/libpq"
    --with-iconv="$brew_opt/libiconv"
  )
else
  flags+=(--with-pgsql --with-pdo-pgsql)
fi

if ! $release; then
  flags+=(--enable-debug)
fi

status="$build_dir/config.status"
# php-src's build writes its parsers, scanners and configure into the source tree, and a configured build's dependency
# files name them. make has no rule that makes some of them again, such as Zend/zend_ini_scanner_defs.h (CI run
# 41504845687), so a configured build in a tree without configure, as git clean -x leaves it, builds from nothing. It
# keeps mago, which sharp/bin/build-mago builds there from sharp/mago alone, and which CI restores into a new checkout.
# php-src's Makefile tracks no header either, so a build configured with other flags, such as one without
# --enable-zts, would link the objects it compiled into this one: it builds from nothing too. config.status prints the
# flags it was configured with, then the variables configure keeps, such as PKG_CONFIG_PATH.
if $clean; then
  rm -rf "$build_dir"
elif [[ -f "$status" && ( ! -f "$root/configure" || " $("$status" --config) " != " ${flags[*]} "* ) ]]; then
  find "$build_dir" -mindepth 1 -maxdepth 1 ! -name mago -exec rm -rf {} +
fi

# The build configures again when what configure reads changed: its flags, the compilers in CC and CXX, which
# configure writes into the Makefile, so ccache's wrapper joins a build only through it, and the content of each
# tracked file configure reads, such as a *.in file it writes a file from. On Linux the build runs in the sharp/docker
# image, so the image's Dockerfile is one of them. The content counts, not the time: a checkout of another branch gives
# every file it rewrites a new time, which says nothing of what the build was configured from, and on the self-hosted
# Mac, whose jobs of every branch share one build, a configure took 12 of the Mac build's 50.5 minutes on release pull
# request #395's run.
inputs=(configure.ac '*.m4' '*.in' '*Makefile.frag' '*Makefile.global' Zend/zend_modules.h ':(exclude)sharp')
if [[ "$(uname -s)" == Linux ]]; then
  inputs+=(sharp/docker/Dockerfile)
fi
configured="$(
  printf '%s\n' "${flags[@]}" "CC=${CC:-}" "CXX=${CXX:-}"
  cd "$root"
  git ls-files -- "${inputs[@]}"
  git ls-files -z -- "${inputs[@]}" | xargs -0 git hash-object --
)"
stamp="$build_dir/configured-from"
if [[ ! -f "$status" || ! -f "$stamp" || "$(< "$stamp")" != "$configured" ]]; then
  (cd "$root" && "$record" buildconf -- ./buildconf --force)
  mkdir -p "$build_dir"
  (cd "$build_dir" && "$record" configure -- "$root/configure" "${flags[@]}")
  printf '%s\n' "$configured" > "$stamp"
fi

# The cargo build of ext/sharp's Rust library, which make runs, reads CARGO_BUILD_JOBS as its jobs.
CARGO_BUILD_JOBS="$("$root/sharp/bin/jobs")"
export CARGO_BUILD_JOBS
# sharp/bin/hosts runs on Linux alone and links FrankenPHP against the libphp the build installs, so only Linux builds
# every target and installs. Elsewhere make builds the two binaries the suites run and nothing else reads: sharp_build_id.h
# holds the commit, so every commit relinks what holds ext/sharp, and on MACOS run 45051337556 libphp.so's link took 84
# s, libphp.dylib's 169 s and the install 123 s of the step's 392 s. configure takes the same flags everywhere, since
# other flags would rebuild a Mac's engine from nothing.
if [[ "$(uname -s)" == Linux ]]; then
  "$record" make -- make -C "$build_dir" -j"$CARGO_BUILD_JOBS" >/dev/null
  "$record" "make install" -- make -C "$build_dir" install >/dev/null
else
  "$record" make -- make -C "$build_dir" -j"$CARGO_BUILD_JOBS" sapi/cli/php sapi/phpdbg/phpdbg >/dev/null
fi
"$build_dir/sapi/cli/php" -v
