#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
linux=false
clean=false
zts=false
# --enable-werror, as php-src's own CI builds, so a warning fails the build here and in CI before it fails an upstream
# merge or a packager's build. --no-werror builds past a warning a compiler newer than CI's finds in upstream code, as
# php-src's own --disable-werror does. CI never passes it.
werror=--enable-werror
container_command=(sharp/bin/build)
for arg in "$@"; do
  case "$arg" in
    --linux) linux=true ;;
    --clean) clean=true; container_command+=("$arg") ;;
    --zts) zts=true; container_command+=("$arg") ;;
    --no-werror) werror=--disable-werror; container_command+=("$arg") ;;
    *) echo "usage: sharp/bin/build [--clean] [--linux] [--zts] [--no-werror]" >&2; exit 2 ;;
  esac
done

if $linux; then
  exec "$root/sharp/docker/run" "${container_command[@]}"
fi

build_dir="$root/sharp/build/$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m)"
# The thread-safe build, which FrankenPHP and other threaded hosts run, sits beside the other one.
if $zts; then
  build_dir+=-zts
fi

flags=(
  --prefix="$build_dir/install"
  --enable-option-checking=fatal
  "$werror"
  --enable-debug
  --enable-fpm
  --disable-cgi
  --without-pear
  --enable-zend-test
  --enable-mbstring
  --enable-intl
  --enable-bcmath
  --enable-pcntl
  --with-sodium
  --with-zip
  --with-zlib
  --with-curl
)

if [[ "$(uname -s)" == Darwin ]]; then
  brew_opt="$(brew --prefix)/opt"
  export PATH="$brew_opt/bison/bin:$PATH"
  export PKG_CONFIG_PATH="$brew_opt/icu4c/lib/pkgconfig:$brew_opt/curl/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
  flags+=(
    --with-pgsql="$brew_opt/libpq"
    --with-pdo-pgsql="$brew_opt/libpq"
    --with-iconv="$brew_opt/libiconv"
  )
else
  flags+=(--with-pgsql --with-pdo-pgsql)
fi

# FrankenPHP links the embed SAPI's libphp, which sharp/bin/hosts builds it against from the installed build, and
# refuses an engine with Zend signals, as docker-library's zts images build without them.
if $zts; then
  flags+=(--enable-zts --enable-embed --disable-zend-signals)
fi

if $clean; then
  rm -rf "$build_dir"
fi

status="$build_dir/config.status"
# A build configured with the other werror setting configures again, so the setting this run asks for holds.
if [[ ! -f "$status" || " $("$status" --config) " != *" $werror "* || "$0" -nt "$status" || "$root/sharp/docker/Dockerfile" -nt "$status" || "$root/Zend/zend_modules.h" -nt "$status" || -n "$(find "$root" \( -path "$root/.git" -o -path "$root/sharp" \) -prune -o \( -name configure.ac -o -name '*.m4' -o -name Makefile.frag -o -name Makefile.global \) -newer "$status" -print -quit)" ]]; then
  (cd "$root" && ./buildconf --force)
  mkdir -p "$build_dir"
  (cd "$build_dir" && "$root/configure" "${flags[@]}")
fi

jobs="${CARGO_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"
if [[ " ${MAKEFLAGS:-}" =~ [[:space:]](-j[[:space:]]*|--jobs=)([0-9]+) ]]; then
  jobs="${BASH_REMATCH[2]}"
fi
make -C "$build_dir" -j"$jobs" >/dev/null
if $zts; then
  make -C "$build_dir" install >/dev/null
fi
"$build_dir/sapi/cli/php" -v
