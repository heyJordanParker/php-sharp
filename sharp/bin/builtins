const MISSING = 'no rule';

function fail(string $message): never
{
    fwrite(STDERR, "sharp/bin/builtins: $message\n");
    exit(1);
}

/** @param list<array{string, string, ?string}> $rules */
function effect(array $rules, string $extension, string $function): ?string
{
    foreach ($rules as [$ruleExtension, $pattern, $effect]) {
        if ($ruleExtension === $extension && preg_match($pattern, $function)) {
            return $effect;
        }
    }

    return MISSING;
}

function label(?string $effect): string
{
    return $effect ?? 'pure';
}

function selfTest(): never
{
    $problems = [];
    foreach (ROWS as [$extension, $function, $expected]) {
        $effect = effect(RULES, $extension, $function);
        if ($effect !== $expected) {
            $problems[] = "$extension $function gives " . label($effect) . ', not ' . label($expected) . '.';
        }
    }
    foreach (RULES as $index => [$extension, $pattern]) {
        $without = RULES;
        unset($without[$index]);
        $changed = array_filter(ROWS, static fn (array $row): bool => effect($without, $row[0], $row[1]) !== $row[2]);
        if ($changed === []) {
            $problems[] = "No row fails without the rule $extension $pattern.";
        }
    }
    if ($problems !== []) {
        fail(implode("\n", $problems));
    }
    echo 'Checked ', count(RULES), ' rules with ', count(ROWS), " rows.\n";
    exit(0);
}

/**
 * @return array{array<string, true>, array<string, true>} the lowercase names of the functions in PHP's root namespace,
 * and the lowercase full names of the classes, that Mago's prelude declares. Mago reports `global.name` as missing for
 * any other function, such as oci8's and imap's, and an import of any other class, so those get no line.
 */
function checkerNames(string $root): array
{
    [$names, $classes] = [[], []];
    foreach (glob("$root/sharp/mago/crates/prelude/assets/extensions/*.php") as $path) {
        $tokens = array_values(array_filter(
            PhpToken::tokenize(file_get_contents($path)),
            static fn (PhpToken $token): bool => !$token->is([T_WHITESPACE, T_COMMENT, T_DOC_COMMENT]),
        ));
        [$namespace, $namespaceDepth, $depth] = ['', 0, 0];
        foreach ($tokens as $index => $token) {
            if ($token->is(T_NAMESPACE)) {
                $name = $tokens[$index + 1]->is([T_STRING, T_NAME_QUALIFIED]) ? $tokens[$index + 1]->text : '';
                $braced = $tokens[$index + ($name === '' ? 1 : 2)]->text === '{';
                [$namespace, $namespaceDepth] = [$name, $braced ? $depth + 1 : 0];
            } elseif ($token->text === '{') {
                $depth++;
            } elseif ($token->text === '}') {
                $depth--;
            } elseif ($token->is(T_FUNCTION) && $depth === $namespaceDepth && $namespace === '') {
                // A keyword names a function too, as `exit` and `clone` do, so the name is any word, not only T_STRING.
                $name = $tokens[$index + ($tokens[$index + 1]->text === '&' ? 2 : 1)]->text;
                if (preg_match('~^\w+$~', $name)) {
                    $names[strtolower($name)] = true;
                }
            } elseif ($token->is(T_CLASS) && $depth === $namespaceDepth && !$tokens[$index - 1]->is([T_DOUBLE_COLON, T_NEW])) {
                $class = $tokens[$index + 1]->text;
                $classes[strtolower($namespace === '' ? $class : "$namespace\\$class")] = true;
            }
        }
    }
    if ($names === [] || $classes === []) {
        fail('sharp/mago/crates/prelude/assets/extensions declares no function or no class.');
    }

    return [$names, $classes];
}

/**
 * @return list<string> the full names of the exception classes PHP builds in that the prelude declares: `Exception`,
 * `Error` and every class whose parents reach one of them, in name order.
 */
function exceptionClasses(PHPStan\Php8StubsMap $map, string $stubs, array $checker): array
{
    // Each class's full name and the lowercase full name of its parent. A stub names its parent in full, as `\Error`.
    $declared = [];
    foreach ($map->classes as $lowercase => $path) {
        $stub = file_get_contents("$stubs/$path");
        // An interface, an enum or a trait is not a class.
        if (!preg_match('~^(?:\w+ )*class (\w+)(?: extends \\\\([\w\\\\]+))?~m', $stub, $class)) {
            continue;
        }
        $namespace = preg_match('~^namespace ([\w\\\\]+);~m', $stub, $match) ? "$match[1]\\" : '';
        $declared[$lowercase] = [$namespace . $class[1], isset($class[2]) ? strtolower($class[2]) : null];
    }

    $classes = [];
    foreach ($declared as $lowercase => [$name]) {
        $current = $lowercase;
        while ($current !== null && $current !== 'exception' && $current !== 'error') {
            $current = $declared[$current][1] ?? null;
        }
        if ($current !== null && isset($checker[$lowercase])) {
            $classes[] = $name;
        }
    }
    sort($classes, SORT_STRING);

    return $classes;
}

/** Downloads the pinned php-8-stubs into sharp/build, once, and returns its folder. */
function stubs(string $root): string
{
    $folder = "$root/sharp/build/php-8-stubs-" . STUBS_VERSION;
    if (is_dir($folder)) {
        return $folder;
    }
    // A fresh checkout has no sharp/build, and curl cannot write the archive without it.
    if (!is_dir(dirname($folder)) && !mkdir(dirname($folder), 0777, true)) {
        fail('cannot create ' . dirname($folder) . '.');
    }
    $archive = "$folder.tar.gz";
    $url ='https://codeload.github.com/phpstan/php-8-stubs/tar.gz/refs/tags/' . STUBS_VERSION;
    foreach ([['curl', '-sSfL', '-o', $archive, $url], ['tar', '-xzf', $archive, '-C', dirname($folder)]] as $command) {
        if ($command[0] === 'tar' && hash_file('sha256', $archive) !== STUBS_SHA256) {
            fail("$url does not have the SHA-256 " . STUBS_SHA256 . '.');
        }
        $process = proc_open($command, [STDIN, STDOUT, STDERR], $pipes);
        if (proc_close($process) !== 0) {
            fail(implode(' ', $command) . ' failed.');
        }
    }
    unlink($archive);

    return $folder;
}

if (($argv[1] ?? null) === '--self-test') {
    selfTest();
}

$root = dirname(__DIR__, 2);
$stubs = stubs($root);
require "$stubs/Php8StubsMap.php";

[$checker, $checkerClasses] = checkerNames($root);
$map = new PHPStan\Php8StubsMap(PHP_VERSION_ID_TARGET);
$lines = [];
$unclassified = [];
foreach ($map->functions as $lowercase => $path) {
    if (!isset($checker[$lowercase])) {
        continue;
    }
    $stub = file_get_contents("$stubs/$path");
    // A function in a namespace, such as Dom\import_simplexml, is not in PHP's root namespace.
    if (preg_match('~^namespace ~m', $stub)) {
        continue;
    }
    if (!preg_match('~^function &?(\w+)\(~m', $stub, $match)) {
        fail("$path declares no function.");
    }
    $function = $match[1];
    $parts = explode('/', $path);
    $extension = $parts[1] === 'ext' ? $parts[2] : $parts[1];
    $effect = effect(RULES, $extension, $function);
    if ($effect === MISSING) {
        $unclassified[] = "$extension $function";
        continue;
    }
    $lines[$function] = "extern global.$function" . ($effect === null ? '' : " uses $effect") . ';';
}
if ($unclassified !== []) {
    fail("no rule classifies these functions. Add a rule and its row:\n" . implode("\n", $unclassified));
}
ksort($lines, SORT_STRING);

// A class in a namespace whose short name another class has, as FFI\Exception shares Exception's, is imported under its
// full name with each part capitalized, as the checker's help names an aliased import.
$exceptions = exceptionClasses($map, $stubs, $checkerClasses);
$shortNames = array_count_values(array_map(static fn (string $class): string => basename(str_replace('\\', '/', $class)), $exceptions));
[$imports, $externs] = [[], []];
foreach ($exceptions as $class) {
    $short = basename(str_replace('\\', '/', $class));
    $alias = str_contains($class, '\\') && $shortNames[$short] > 1 ? implode('', array_map(ucfirst(...), explode('\\', $class))) : null;
    $imports[] = 'import ' . str_replace('\\', '.', $class) . ($alias === null ? '' : " as $alias") . ';';
    $externs[] = 'extern ' . ($alias ?? $short) . ';';
}

$license = file_get_contents("$stubs/LICENSE");
$notice = implode("\n", array_map(static fn (string $line): string => rtrim("// $line"), explode("\n", trim($license))));
file_put_contents(
    "$root/sharp/composer/library/Sharp/Builtins.sharp",
    '// Generated by sharp/bin/builtins from PHPStan\'s php-8-stubs ' . STUBS_VERSION . " for PHP 8.5. Do not edit.\n"
    . "// The list of functions and classes comes from php-8-stubs, under this license:\n//\n$notice\n\nnamespace Sharp;\n\n"
    . implode("\n", $imports) . "\n\n" . implode("\n", $lines) . "\n\n" . implode("\n", $externs) . "\n",
);
