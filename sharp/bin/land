#!/usr/bin/env bash
set -euo pipefail

# Lands next on master. next's own pull request merges only on the runs of its newest push, and next takes pushes faster
# than a run ends, so it waits: #536 held 43 commits of next on 2026-11-20. So this takes the newest commit of next whose
# PHP# and Mago runs both passed and that master lacks, and lands it through a pull request from branch land/<sha> at
# it, with auto-merge and --match-head-commit. That commit holds every older one. The pull request's own runs skip every
# check, the Mac's among them, because next's run passed the same tree, as .github/actions/passed-tree explains, so it
# merges in about a minute, and the repository deletes its branch. The maintainer's tick runs it with the language
# owner's gh login, whose pull request starts the required runs, where one GITHUB_TOKEN opened would start none.
repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
api() { gh api "repos/$repo/$1" --jq "$2"; }

# next's own pull request into master starts every run of next: a push to next with no such pull request open starts
# none, and nothing lands. It closed when a merge took it, as #536 closed at 8b2454ab1ff, so a tick that finds next
# ahead of master with none open opens it again, and nothing else opens it.
if [[ $(api "compare/master...next" .ahead_by) -gt 0 \
  && -z $(api "pulls?base=master&head=${repo%%/*}:next&state=open" '.[0].html_url // empty') ]]; then
  url=$(gh pr create --repo "$repo" --base master --head next --title "PHP# next" \
    --body "The one integration branch. Every lane pushes here, and this pull request's runs test each push. sharp/bin/land lands each commit whose runs passed through a land/<sha> pull request, so this one stays open.")
  echo "$url is next's own pull request again, so a push to next starts its runs."
fi

# The runs list's status filter finds a run minutes after it ends, so a run counts by its own conclusion.
passed() {
  api "actions/workflows/$1/runs?head_sha=$2&event=pull_request&per_page=100" \
    "[.workflow_runs[] | select(.conclusion == \"success\" and .head_branch == \"next\" and .head_repository.full_name == \"$repo\")][0].html_url // empty"
}

# The newest commit of next that master lacks and whose PHP# and Mago runs both passed, newest first, as GitHub lists
# runs, or none, with the reason it lands nothing.
newest=
reason="No commit of next that master lacks has passed both PHP# and Mago yet."
shas=$(api "actions/workflows/sharp.yml/runs?branch=next&event=pull_request&per_page=100" \
  ".workflow_runs[] | select(.conclusion == \"success\" and .head_repository.full_name == \"$repo\") | .head_sha")
for sha in $shas; do
  next=$(api "compare/$sha...next" .status)
  if [[ $next != ahead && $next != identical ]]; then
    continue
  fi
  master=$(api "compare/master...$sha" .status)
  if [[ $master == behind || $master == identical ]]; then
    reason="master holds next up to $sha, the newest commit whose PHP# run passed, so nothing lands."
    break
  fi
  php_sharp=$(passed sharp.yml "$sha")
  mago=$(passed mago.yml "$sha")
  if [[ -z $mago ]]; then
    echo "$sha passed PHP# in $php_sharp, and Mago has passed no run of it yet."
    continue
  fi
  newest=$sha
  break
done

# Every open land/ pull request but the newest commit's closes with its branch: that commit holds each older one, and
# master holds the commit of one that merged elsewhere. When each run opened one for a newer commit and left the older
# ones open, none ever had its auto-merge on: #616, #617 and #619 on 2026-11-22. Only a land/ branch's pull request
# counts: next's own one has the same head when next's newest commit passed.
if [[ -n $newest ]]; then
  superseded="$newest of next lands in its place, and it holds this commit."
else
  superseded="master holds this commit."
fi
landing=$(api "pulls?base=master&state=open&per_page=100" \
  '.[] | select(.head.ref | startswith("land/")) | [.html_url, .head.sha] | @tsv')
open=
while IFS=$'\t' read -r url head; do
  if [[ -z $url ]]; then
    continue
  fi
  if [[ $head == "$newest" ]]; then
    open=$url
    continue
  fi
  gh pr close "$url" --repo "$repo" --delete-branch --comment "$superseded"
  echo "$url closed: $superseded"
done <<< "$landing"
if [[ -z $newest ]]; then
  echo "$reason"
  exit 0
fi

# The ruleset turns auto-merge off when it goes on before the pull request's Spec guard run reports: #551's went off a
# second after it went on, "Repository rule violations found", and stayed on once Spec guard had passed. So a pull
# request opens without it, and the first run that finds its Spec guard run ended turns it on. Spec guard runs on
# pull_request_target, so its run of this pull request is the one of branch land/<sha>, never next's of the same commit.
if [[ -n $open ]]; then
  if [[ $(gh pr view "$open" --repo "$repo" --json autoMergeRequest --jq '.autoMergeRequest != null') == true ]]; then
    echo "$open already lands $newest."
    exit 0
  fi
  guard=$(api "actions/workflows/completes.yml/runs?head_sha=$newest&event=pull_request_target&per_page=100" \
    "[.workflow_runs[] | select(.head_branch == \"land/$newest\" and .status == \"completed\")][0].html_url // empty")
  if [[ -z $guard ]]; then
    echo "$open lands $newest once its Spec guard run has reported, which a later run finds."
    exit 0
  fi
  gh pr merge "$open" --repo "$repo" --auto --merge --match-head-commit "$newest"
  echo "$open lands $newest: its Spec guard run $guard reported, so its auto-merge is on."
  exit 0
fi
branch=land/$newest
# A run that stopped after it created the branch left it, so a second run takes it.
if ! gh api "repos/$repo/git/ref/heads/$branch" --silent 2> /dev/null; then
  gh api --method POST "repos/$repo/git/refs" -f ref="refs/heads/$branch" -f sha="$newest" --silent
fi
url=$(gh pr create --repo "$repo" --base master --head "$branch" --title "Land next at ${newest:0:11}" \
  --body "Lands $newest of next, whose PHP# run $php_sharp and Mago run $mago passed.")
echo "$url lands $newest once its Spec guard run has reported, which a later run finds."
