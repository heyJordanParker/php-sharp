#!/usr/bin/env bash
set -euo pipefail

# Lands next on master. next's own pull request merges only on the runs of its newest push, and next takes pushes faster
# than a run ends, so it waits: #536 held 43 commits of next on 2026-11-20. So this takes the newest commit of next whose
# PHP# and Mago runs both passed and that master lacks, and lands it through a pull request from branch land/<sha> at
# it, with auto-merge and --match-head-commit. That commit holds every older one. The pull request's own runs skip every
# check, the Mac's among them, because next's run passed the same tree, as .github/actions/passed-tree explains, so it
# merges in about a minute, and the repository deletes its branch. The maintainer's tick runs it with the language
# owner's gh login, whose pull request starts the required runs, where one GITHUB_TOKEN opened would start none.
repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
api() { gh api "repos/$repo/$1" --jq "$2"; }

# next's own pull request into master starts every run of next: a push to next with no such pull request open starts
# none, and nothing lands. It closed when a merge took it, as #536 closed at 8b2454ab1ff, so a tick that finds next
# ahead of master with none open opens it again, and nothing else opens it.
if [[ $(api "compare/master...next" .ahead_by) -gt 0 \
  && -z $(api "pulls?base=master&head=${repo%%/*}:next&state=open" '.[0].html_url // empty') ]]; then
  url=$(gh pr create --repo "$repo" --base master --head next --title "PHP# next" \
    --body "The one integration branch. Every lane pushes here, and this pull request's runs test each push. sharp/bin/land lands each commit whose runs passed through a land/<sha> pull request, so this one stays open.")
  echo "$url is next's own pull request again, so a push to next starts its runs."
fi

# A release is the commit its tag v<version> names, and sharp.yml's RELEASE publishes on that tag. GitHub refuses a
# workflow's GITHUB_TOKEN any tag on a commit whose workflows differ from master's, and master moves while a release
# builds: runs 45025602373 and 45027728255 failed to create v0.6.50 so. The language owner's login may, so once master
# holds a version with no tag, this tags the merge commit on master that first holds it, which master's first parents
# lead back to.
version_at() {
  api "contents/sharp/mago/Cargo.toml?ref=$1" '.content | @base64d' \
    | awk -F '"' '/^version = / && version == "" {version = $2} END {print version}'
}
version=$(version_at master)
if ! gh api "repos/$repo/git/ref/tags/v$version" --silent 2> /dev/null; then
  first=$(api commits/master .sha)
  while parent=$(api "commits/$first" '.parents[0].sha // empty') && [[ -n $parent ]] \
    && [[ $(version_at "$parent") == "$version" ]]; do
    first=$parent
  done
  gh api --method POST "repos/$repo/git/refs" -f ref="refs/tags/v$version" -f sha="$first" --silent
  echo "Tag v$version names $first, the first merge commit on master that holds version $version."
fi

# A release's bump lands on master in a pull request from branch release/<version>, and its changelog lists what master
# holds then. A landing that merged first would put commits of next inside the release with their changelog lines still
# under Unreleased, as landing #676 would have put 1280982ae31 inside 0.6.51, whose release #675 was open beside it. So
# no landing opens or arms while a release's pull request is open, and the first call after it merges tags the version
# above and lands again.
release=$(api "pulls?base=master&state=open&per_page=100" \
  '[.[] | select(.head.ref | startswith("release/"))][0] | if . then "\(.html_url) \(.head.ref)" else "" end')
if [[ -n $release ]]; then
  echo "${release% *} releases ${release##*/}, so nothing lands until it merges."
  exit 0
fi

# The runs list's status filter finds a run minutes after it ends, so a run counts by its own conclusion.
passed() {
  api "actions/workflows/$1/runs?head_sha=$2&event=pull_request&per_page=100" \
    "[.workflow_runs[] | select(.conclusion == \"success\" and .head_branch == \"next\" and .head_repository.full_name == \"$repo\")][0].html_url // empty"
}

# A commit's merge into master, as git merge-tree writes it without a working tree, which merges as GitHub does: it
# prints the files that conflict and fails when any does. Landing #680 waited 3 hours on 251bc152c52, which predated
# next's merge of the 0.6.51 bump, 19e34833038: GitHub reported it CONFLICTING in sharp/CHANGELOG.md, it had no merge
# ref, so SPEC_GUARD and COMPLETES failed on checkout, and each later call found it already landing and waited.
root="$(cd "$(dirname "$0")/../.." && pwd)"
git -C "$root" fetch --quiet origin master next
# Succeeds, with the files in $files, when the commit conflicts with master.
conflicts() {
  local status=0 output
  output=$(git -C "$root" merge-tree --write-tree --name-only --no-messages origin/master "$1") || status=$?
  case "$status" in
    0) return 1 ;;
    1) files=$(sed 1d <<< "$output" | paste -sd ' ' -) ;;
    *) echo "git merge-tree couldn't merge $1 into master: it exited $status." >&2; exit 1 ;;
  esac
}

# The newest commit of next that master lacks, whose PHP# and Mago runs both passed and which merges into master
# cleanly, newest first, as GitHub lists runs, or none, with the reason it lands nothing.
newest=
conflicting=false
reason="No commit of next that master lacks has passed both PHP# and Mago yet."
shas=$(api "actions/workflows/sharp.yml/runs?branch=next&event=pull_request&per_page=100" \
  ".workflow_runs[] | select(.conclusion == \"success\" and .head_repository.full_name == \"$repo\") | .head_sha")
for sha in $shas; do
  next=$(api "compare/$sha...next" .status)
  if [[ $next != ahead && $next != identical ]]; then
    continue
  fi
  master=$(api "compare/master...$sha" .status)
  if [[ $master == behind || $master == identical ]]; then
    if ! $conflicting; then
      reason="master holds next up to $sha, the newest commit whose PHP# run passed, so nothing lands."
    fi
    break
  fi
  php_sharp=$(passed sharp.yml "$sha")
  mago=$(passed mago.yml "$sha")
  if [[ -z $mago ]]; then
    echo "$sha passed PHP# in $php_sharp, and Mago has passed no run of it yet."
    continue
  fi
  if conflicts "$sha"; then
    echo "$sha passed PHP# and Mago, and conflicts with master in $files."
    conflicting=true
    reason="No commit of next that passed both PHP# and Mago merges into master cleanly yet."
    continue
  fi
  newest=$sha
  break
done

# Every open land/ pull request but the newest commit's closes with its branch: that commit holds each older one, and
# master holds the commit of one that merged elsewhere. When each run opened one for a newer commit and left the older
# ones open, none ever had its auto-merge on: #616, #617 and #619 on 2026-11-22. Only a land/ branch's pull request
# counts: next's own one has the same head when next's newest commit passed.
if [[ -n $newest ]]; then
  superseded="$newest of next lands in its place, and it holds this commit."
else
  superseded="master holds this commit."
fi
landing=$(api "pulls?base=master&state=open&per_page=100" \
  '.[] | select(.head.ref | startswith("land/")) | [.html_url, .head.sha] | @tsv')
open=
while IFS=$'\t' read -r url head; do
  if [[ -z $url ]]; then
    continue
  fi
  if [[ $head == "$newest" ]]; then
    open=$url
    continue
  fi
  comment=$superseded
  if conflicts "$head"; then
    comment="GitHub reports it CONFLICTING: $head conflicts with master in $files.${newest:+ $newest of next lands in its place.}"
  fi
  gh pr close "$url" --repo "$repo" --delete-branch --comment "$comment"
  echo "$url closed: $comment"
done <<< "$landing"
if [[ -z $newest ]]; then
  echo "$reason"
  exit 0
fi

# The ruleset turns auto-merge off when it goes on before the pull request's Spec guard run reports: #551's went off a
# second after it went on, "Repository rule violations found", and stayed on once Spec guard had passed. So a pull
# request opens without it, and the first run that finds its SPEC_GUARD check ended turns it on. The commit carries two
# SPEC_GUARD checks, since next's own pull request ran Spec guard on it first, and the ruleset reads the newest. So it
# waits while either runs, and takes the one that started after the pull request opened. It reads the commit's check
# runs, which show a check the moment it ends, where the workflow runs list showed no ended run for #624 a minute after
# it opened at 01:52:06 on 2026-11-22, though its Spec guard run had ended at 01:52:33.
if [[ -n $open ]]; then
  read -r armed opened < <(gh pr view "$open" --repo "$repo" --json autoMergeRequest,createdAt \
    --jq '"\(.autoMergeRequest != null) \(.createdAt)"')
  if [[ $armed == true ]]; then
    echo "$open already lands $newest."
    exit 0
  fi
  guard=$(api "commits/$newest/check-runs?check_name=SPEC_GUARD&per_page=100" \
    "if any(.check_runs[]; .status != \"completed\") then \"\" else
      ([.check_runs[] | select(.started_at >= \"$opened\")][0] | if . then \"\(.html_url) \(.conclusion)\" else \"\" end)
    end")
  if [[ -z $guard ]]; then
    echo "$open lands $newest once its SPEC_GUARD check has ended, which a later run finds."
    exit 0
  fi
  gh pr merge "$open" --repo "$repo" --auto --merge --match-head-commit "$newest"
  echo "$open lands $newest: its SPEC_GUARD check ${guard% *} ended with ${guard##* }, so its auto-merge is on."
  exit 0
fi
branch=land/$newest
# A run that stopped after it created the branch left it, so a second run takes it.
if ! gh api "repos/$repo/git/ref/heads/$branch" --silent 2> /dev/null; then
  gh api --method POST "repos/$repo/git/refs" -f ref="refs/heads/$branch" -f sha="$newest" --silent
fi
url=$(gh pr create --repo "$repo" --base master --head "$branch" --title "Land next at ${newest:0:11}" \
  --body "Lands $newest of next, whose PHP# run $php_sharp and Mago run $mago passed.")
echo "$url lands $newest once its Spec guard run has reported, which a later run finds."
