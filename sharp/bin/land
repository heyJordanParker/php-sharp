#!/usr/bin/env bash
set -euo pipefail

# Lands next on master. next's own pull request merges only on the runs of its newest push, and next takes pushes faster
# than a run ends, so it waits: #536 held 43 commits of next on 2026-11-20. So this takes the newest commit of next whose
# PHP# and Mago runs both passed and that master lacks, and opens a pull request from branch land/<sha> at it, which
# the next tick merges with auto-merge and --match-head-commit. That commit holds every older one. The pull request's own runs skip every check,
# the Mac's among them, because next's run passed the same tree, as .github/actions/passed-tree explains, so it merges
# in about a minute, and the repository deletes its branch. The maintainer's tick runs it with the language owner's gh
# login, whose pull request starts the required runs, where one GITHUB_TOKEN opened would start none.
repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
api() { gh api "repos/$repo/$1" --jq "$2"; }

# The runs list's status filter finds a run minutes after it ends, so a run counts by its own conclusion.
passed() {
  api "actions/workflows/$1/runs?head_sha=$2&event=pull_request&per_page=100" \
    "[.workflow_runs[] | select(.conclusion == \"success\" and .head_branch == \"next\" and .head_repository.full_name == \"$repo\")][0].html_url // empty"
}

# Newest first, as GitHub lists runs.
shas=$(api "actions/workflows/sharp.yml/runs?branch=next&event=pull_request&per_page=100" \
  ".workflow_runs[] | select(.conclusion == \"success\" and .head_repository.full_name == \"$repo\") | .head_sha")
for sha in $shas; do
  next=$(api "compare/$sha...next" .status)
  if [[ $next != ahead && $next != identical ]]; then
    continue
  fi
  master=$(api "compare/master...$sha" .status)
  if [[ $master == behind || $master == identical ]]; then
    echo "master holds next up to $sha, the newest commit whose PHP# run passed, so nothing lands."
    exit 0
  fi
  php_sharp=$(passed sharp.yml "$sha")
  mago=$(passed mago.yml "$sha")
  if [[ -z $mago ]]; then
    echo "$sha passed PHP# in $php_sharp, and Mago has passed no run of it yet."
    continue
  fi
  open=$(api "pulls?base=master&state=open&per_page=100" ".[] | select(.head.sha == \"$sha\") | .html_url")
  # The ruleset turns auto-merge off when it goes on before the pull request's Spec guard run reports: #551's went off a
  # second after it went on, "Repository rule violations found", and stayed on once Spec guard had passed. So a
  # pull request opens without it, and the next tick, which finds it open, turns it on.
  if [[ -n $open ]]; then
    if [[ $(gh pr view "$open" --repo "$repo" --json autoMergeRequest --jq '.autoMergeRequest != null') != true ]]; then
      gh pr merge "$open" --repo "$repo" --auto --merge --match-head-commit "$sha"
      echo "$open lands $sha, and its auto-merge is on again."
      exit 0
    fi
    echo "$open already lands $sha."
    exit 0
  fi
  branch=land/$sha
  # A run that stopped after it created the branch left it, so a second run takes it.
  if ! gh api "repos/$repo/git/ref/heads/$branch" --silent 2> /dev/null; then
    gh api --method POST "repos/$repo/git/refs" -f ref="refs/heads/$branch" -f sha="$sha" --silent
  fi
  url=$(gh pr create --repo "$repo" --base master --head "$branch" --title "Land next at ${sha:0:11}" \
    --body "Lands $sha of next, whose PHP# run $php_sharp and Mago run $mago passed.")
  echo "$url lands $sha. The next tick turns its auto-merge on, once its Spec guard run has reported."
  exit 0
done
echo "No commit of next that master lacks has passed both PHP# and Mago yet."
