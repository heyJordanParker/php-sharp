#!/usr/bin/env bash
set -euo pipefail

# The checks a pull request's required jobs run, on this machine. With no gate, it runs every gate, as every CI run
# runs every job, fastest first, and prints each gate's time. Every build and test runs the jobs sharp/bin/jobs prints.
# A gate CI runs in the sharp/docker image runs there, and one CI runs on the runner itself runs on this machine, so
# each check meets the platform it meets in CI. CI's jobs run the gates no other script holds through this script:
# BUILD_LINUX the generated files, WORKFLOWS the workflows, and mago.yml's checks and plain-php theirs.
#
# With --release, it prints what CI's CHANGES jobs write to $GITHUB_OUTPUT about the release the checked-out commit
# publishes: the version; tagged, the commit when tag v<version> already names it, empty until PUBLISH creates it;
# pulls, the pull requests whose head the commit holds since the newest tag, whose ## Changelog sections are the
# release's notes; missing, each part of the release not published yet; and bump, whether any is. A pull request title
# after --release counts as one more pull request, which is a dry run of the version.
#
# With --speed-baseline, it downloads the speed.json the SPEED gate compares with into the folder it names.
usage() {
  echo "usage: sharp/bin/check [seconds | workflows | spec-guard | mago-checks | linux | upstream | hosts | generated | mago-tests | plain-php | speed]..." >&2
  echo "       sharp/bin/check --release [<pull request title>]" >&2
  echo "       sharp/bin/check --speed-baseline <folder>" >&2
  exit 2
}

root="$(cd "$(dirname "$0")/../.." && pwd)"
# Each run leaves its line in the build record, with each gate's under it, see sharp/bin/record.
[[ ${SHARP_RECORDED:-} == sharp/bin/check ]] || exec "$root/sharp/bin/record" sharp/bin/check -- "$0" "$@"
os="$(uname -s | tr '[:upper:]' '[:lower:]')"
target="${CARGO_TARGET_DIR:-$root/sharp/build/$os-$(uname -m)/mago}"
rust="$(sed -n 's/^rust-version = "\(.*\)"$/\1/p' "$root/sharp/mago/Cargo.toml")"
CARGO_BUILD_JOBS="$("$root/sharp/bin/jobs")"
export CARGO_BUILD_JOBS

# A release publishes three parts, each once, and a published one stays: assets, the GitHub release v<version> with
# mago's files, images, the runtime image ghcr.io/heyjordanparker/php-sharp:<version> and its <version>-dev, and
# composer, tag v<version> of heyJordanParker/php-sharp-composer and heyJordanParker/mago-sharp. A rerun of the push run
# whose commit the tag names publishes what an earlier attempt left missing, since only that run built its assets and
# images. Run 45033462105 published a GitHub release and failed before its images and its Composer tags, which a check
# of the tag alone then counted as released. So RELEASE fills an untagged draft, PUBLISH makes it public, which creates
# the tag, and then tags the images, and COMPOSER pushes the mirrors' tags last, and assets is missing until the
# release is public. The image and the mirrors are public, so their checks need no login. git
# ls-remote --exit-code exits 2 when a remote has no such ref, and with another code when it can't ask.
#
# A version lives in its tag alone. A commit a tag already names publishes that tag's version, so a rerun finishes the
# release it started. Any other commit publishes the newest tag's version plus one patch, or one minor when the title of
# a pull request the commit holds since that tag has `!` before its colon, as range_pulls finds them. PUBLISH creates
# the tag as it makes the release public, and staging's runs run one at a time, so a run that fails before that leaves
# at most an untagged draft, the next run takes the same version, and two runs never take one version (#854). A
# release's notes are every pull request it holds since the newest published release, so a release
# after a tag whose release never published carries that tag's pull requests too, as run 45434990708 tagged a release
# that stayed a draft. CI's checkout holds one commit, so the release fetches the commits since that release, without
# their trees, in 3.5 s on a test.
# Prints each pull request into master whose head commit the range holds: its number, a tab, and its title. A staging
# run's pull requests aren't merged yet when its CHANGES runs, so no merge commit GitHub recorded names them, and
# queue.yml merges each one's head onto master. The merge of a stack's top pull request holds every pull request below
# it too: run 45434990708's commit landed 19 pull requests, and its merge commit's subject names one.
range_pulls() {
  local commits
  commits="$(git -C "$root" rev-list "$@")"
  if [[ -z $commits ]]; then
    return
  fi
  (cd "$root" && gh api --paginate 'repos/{owner}/{repo}/pulls?state=all&base=master&per_page=100' \
    --jq '.[] | [.head.sha, .number, .title] | @tsv') \
    | awk -F '\t' 'NR == FNR { held[$1] = 1; next } $1 in held { print $2 "\t" $3 }' <(echo "$commits") -
}
release() {
  local title=${1:-} head refs newest commit major minor patch version='' tagged='' pulls=() titles=() range
  local release since missing=() published token tag code mirror status
  head="$(git -C "$root" rev-parse HEAD)"
  if ! refs="$(git -C "$root" ls-remote --tags origin 'refs/tags/v*')"; then
    echo "git ls-remote couldn't list origin's tags." >&2
    exit 1
  fi
  # An annotated tag lists its commit on a second line, the tag's name with ^{}, which sorts after the tag's own.
  version="$(awk -v head="$head" '$1 == head {sub(/^refs\/tags\/v/, "", $2); sub(/\^\{\}$/, "", $2); print $2; exit}' \
    <<< "$refs")"
  if ! release="$(cd "$root" && gh api 'repos/{owner}/{repo}/releases/latest' --jq .tag_name)"; then
    echo "gh couldn't read origin's newest published release." >&2
    exit 1
  fi
  since="$(awk -v tag="refs/tags/$release" '$2 == tag || $2 == tag "^{}" {commit = $1} END {print commit}' <<< "$refs")"
  if [[ $since != "$head" ]]; then
    range=("$head" "^$since")
    if [[ $(git -C "$root" rev-parse --is-shallow-repository) == true ]]; then
      git -C "$root" fetch --quiet --filter=tree:0 --shallow-exclude="refs/tags/$release" origin "$head"
      range=("$head")
    fi
    mapfile -t pulls < <(range_pulls "${range[@]}" | cut -f 1)
  fi
  if [[ -n $version ]]; then
    tagged=$head
  else
    newest="$(sed -n 's#.*refs/tags/v\([0-9]*\.[0-9]*\.[0-9]*\)$#\1#p' <<< "$refs" \
      | sort -t . -k 1,1n -k 2,2n -k 3,3n | tail -n 1)"
    if [[ -z $newest ]]; then
      echo "origin has no tag v<major>.<minor>.<patch>, so there is no version to add one to." >&2
      exit 1
    fi
    commit="$(awk -v tag="refs/tags/v$newest" '$2 == tag || $2 == tag "^{}" {commit = $1} END {print commit}' <<< "$refs")"
    mapfile -t titles < <(range_pulls "$head" "^$commit" | cut -f 2)
    if [[ -n $title ]]; then
      titles+=("$title")
    fi
    IFS=. read -r major minor patch <<< "$newest"
    version="$major.$minor.$((patch + 1))"
    for title in "${titles[@]}"; do
      if [[ $title == *:* && ${title%%:*} == *'!'* ]]; then
        version="$major.$((minor + 1)).0"
      fi
    done
  fi
  if ! published="$(cd "$root" && gh release view "v$version" --json isDraft --jq '.isDraft | not' 2>&1)"; then
    if [[ $published != *"release not found"* ]]; then
      echo "gh couldn't read release v$version: $published" >&2
      exit 1
    fi
    published=false
  fi
  if [[ $published != true ]]; then
    missing+=(assets)
  fi
  token="$(curl -fsS 'https://ghcr.io/token?scope=repository:heyjordanparker/php-sharp:pull' | jq -r .token)"
  for tag in "$version" "$version-dev"; do
    code="$(curl -sS -o /dev/null -w '%{http_code}' --head -H "Authorization: Bearer $token" \
      -H 'Accept: application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json' \
      "https://ghcr.io/v2/heyjordanparker/php-sharp/manifests/$tag")"
    case "$code" in
      200) ;;
      404)
        missing+=(images)
        break
        ;;
      *)
        echo "ghcr.io answered $code for image ghcr.io/heyjordanparker/php-sharp:$tag." >&2
        exit 1
        ;;
    esac
  done
  for mirror in php-sharp-composer mago-sharp; do
    status=0
    git ls-remote --exit-code --tags "https://github.com/heyJordanParker/$mirror" "refs/tags/v$version" > /dev/null \
      || status=$?
    case "$status" in
      0) ;;
      2)
        missing+=(composer)
        break
        ;;
      *)
        echo "git ls-remote couldn't ask heyJordanParker/$mirror for tag v$version: it exited $status." >&2
        exit 1
        ;;
    esac
  done
  echo "version=$version"
  echo "tagged=$tagged"
  echo "pulls=${pulls[*]}"
  echo "missing=${missing[*]}"
  if ((${#missing[@]} > 0)); then
    echo "bump=true"
  else
    echo "bump=false"
  fi
}

# The SPEED gate's baseline is what the newest green Mago CI push run of a commit master holds counted, its speed
# artifact, so a change is compared with the master it lands on, and no file in the tree holds a count. LAND moves
# master only to a staging commit whose Mago run passed, so that run is usually the tip's own. A commit no push ran on,
# as the merge that brought the queue in (#843), counts its newest ancestor's, and a staging batch that never landed
# counts none: run 45671195524's SPEED failed when only master's tip counted, while the tip's own run hadn't ended.
speed_baseline() {
  local run
  run="$(cd "$root" && gh api 'repos/{owner}/{repo}/commits?sha=master&per_page=100' --jq '.[].sha' \
    | awk 'NR == FNR { if (!($1 in green)) green[$1] = $2; next } $1 in green { print green[$1]; exit }' \
      <(gh run list --workflow mago.yml --event push --status success --limit 100 --json headSha,databaseId \
        --jq '.[] | "\(.headSha) \(.databaseId)"') -)"
  if [[ -z $run ]]; then
    echo "No green Mago CI push run is on one of master's newest 100 commits, so there is no speed baseline." >&2
    exit 1
  fi
  (cd "$root" && gh run download "$run" --name speed --dir "$1")
  echo "The speed baseline is run $run's."
}

case "${1:-}" in
  --release)
    if [[ $# -gt 2 ]]; then
      usage
    fi
    release "${2:-}"
    exit 0
    ;;
  --speed-baseline)
    if [[ $# -ne 2 ]]; then
      usage
    fi
    speed_baseline "$2"
    exit 0
    ;;
esac

all=(seconds workflows spec-guard mago-checks linux upstream hosts generated mago-tests plain-php speed)
for gate in "$@"; do
  if [[ " ${all[*]} " != *" $gate "* ]]; then
    usage
  fi
done

TMPDIR="$(mktemp -d)"
export TMPDIR
trap 'rm -rf "$TMPDIR"' EXIT

# The merge base with origin/master, as CI compares a pull request with its base, fetched once.
merge_base=
base() {
  if [[ -z $merge_base ]]; then
    git -C "$root" fetch --quiet origin master
    merge_base="$(git -C "$root" merge-base HEAD origin/master)"
  fi
  echo "$merge_base"
}

gates=("$@")
if [[ ${#gates[@]} -eq 0 ]]; then
  gates=("${all[@]}")
fi

# Runs a step of the gate, and marks the gate failed when it fails, so the gate's other steps still run. The step runs
# in a subshell outside any condition, where errexit holds, so a step that is a function stops at the first command
# that fails, and what it changes, such as its folder, stays in it.
gate_passed=true
step() {
  local status
  set +e
  (set -e; "$@")
  status=$?
  set -e
  if ((status != 0)); then
    gate_passed=false
  fi
}

# Each file that differs from HEAD, the untracked ones included, with its content's hash, so a step that writes a
# generated file shows in the files it changed, even in a working tree that holds other changes.
tree_state() {
  local file
  (cd "$root" && { git diff --name-only HEAD && git ls-files --others --exclude-standard; } | LC_ALL=C sort -u \
    | while read -r file; do echo "$(git hash-object "$file" 2> /dev/null || echo deleted) $file"; done)
}

# Runs the generators, and fails when one changed a file.
unchanged_by() {
  local before after
  before="$(tree_state)"
  "$@"
  after="$(tree_state)"
  if [[ $before != "$after" ]]; then
    echo "These files differ from what their generator writes, which is now in the working tree:" >&2
    diff <(echo "$before") <(echo "$after") | sed -n 's/^> [^ ]* /  /p' >&2
    return 1
  fi
}

# The workflows: every action that is not ours runs at a full commit SHA, no Dockerfile under sharp/docker names a
# syntax frontend, and actionlint, at the version sharp/docker/tools/Dockerfile pins, passes over every workflow.
unpinned() {
  if git -C "$root" grep -nE '^[[:space:]]*(-[[:space:]]+)?uses:' -- .github/workflows .github/actions \
    | grep -vE 'uses:[[:space:]]+(\./|[^@[:space:]]+@[0-9a-f]{40}([[:space:]]|$)|docker://[^@[:space:]]+@sha256:[0-9a-f]{64}([[:space:]]|$))'; then
    echo "Pin each action above to the full commit SHA its release tag names, with the release as a comment: uses: actions/checkout@<40-character SHA> # v7.0.1." >&2
    return 1
  fi
}
syntax_frontend() {
  if git -C "$root" grep -nE '^#[[:space:]]*syntax[[:space:]]*=' -- sharp/docker; then
    echo "Remove each # syntax= line above. BuildKit pulls the frontend it names from Docker Hub with no login (#86), and builds with its own Dockerfile frontend without one." >&2
    return 1
  fi
}
lint_workflows() {
  local version
  version="$(sed -n 's/^ARG ACTIONLINT_VERSION=//p' "$root/sharp/docker/tools/Dockerfile")"
  if [[ "$(actionlint -version | head -n 1)" != "$version" ]]; then
    echo "sharp/docker/tools/Dockerfile pins actionlint $version. Install that version: https://github.com/rhysd/actionlint/releases/tag/v$version" >&2
    return 1
  fi
  (cd "$root" && actionlint)
}
# The queue's lost-runner decision, on runs cut from GitHub's API: each folder under sharp/bin/fixtures/queue-lost-runner
# is named after what sharp/bin/queue-lost-runner prints for its jobs.json and annotations.
queue_lost_runner() {
  local case expected printed
  for case in "$root"/sharp/bin/fixtures/queue-lost-runner/*/; do
    expected="$(basename "$case")"
    printed="$("$root/sharp/bin/queue-lost-runner" "$case/jobs.json" "$case/annotations")"
    if [[ $printed != "$expected" ]]; then
      echo "sharp/bin/queue-lost-runner printed $printed for ${case#"$root"/}, which is named $expected." >&2
      return 1
    fi
  done
}
gate_workflows() {
  step unpinned
  step syntax_frontend
  step lint_workflows
  step queue_lost_runner
}

# Every test sharp/baseline/seconds lists exists, since a renamed test's new name weighs 1 s in sharp/bin/test's slices
# where its old one held its seconds: MAGO (1/5) took 394 s on run 45127191998 against 293 s for MAGO (5/5), because the
# list held 162.9 s of laws.rs under no name of a test and 1 s under its new one. CHANGES runs it, before any build or
# Mac job starts, where MAGO's slices found 3 such lists of 11-24 and 11-25 only after BUILD_LINUX (#834). It reads the
# tree, so it needs no build: a .phpt key and the convert proof name their file, and a Mago key, <its binary's
# source>::<module path>::<name>, a name that a .rs file under its source's folder holds, as a fn's or as a macro's
# argument, such as the analyzer's test_case!(array_type_combination_threshold).
stale_seconds() {
  local key source folder words stale=()
  local -A listed=()
  while IFS=$'\t' read -r _ key; do
    case $key in
      *::*)
        source=${key%%::*}
        folder=${source%/*}
        words="$TMPDIR/words-${#listed[@]}"
        if [[ -z ${listed[$folder]:-} ]]; then
          grep -rhoE '[A-Za-z_][A-Za-z0-9_]*' --include='*.rs' "$root/$folder" | LC_ALL=C sort -u > "$words"
          listed[$folder]=$words
        fi
        if [[ ! -f $root/$source ]] || ! grep -qxF -- "${key##*::}" "${listed[$folder]}"; then
          stale+=("$key")
        fi
        ;;
      *.phpt | *.sh)
        if [[ ! -f $root/$key ]]; then
          stale+=("$key")
        fi
        ;;
    esac
  done < "$root/sharp/baseline/seconds"
  if ((${#stale[@]})); then
    printf 'sharp/baseline/seconds lists %s, which no test is. Measure it under its new name, or drop it.\n' "${stale[@]}" >&2
    return 1
  fi
}
gate_seconds() {
  step stale_seconds
}

# SPEC_GUARD and COMPLETES, with the merge base's sharp/bin/spec, as completes.yml runs them. COMPLETES reads the pull
# request's body on its standard input, so it runs when BODY holds it.
gate_spec_guard() {
  local base
  base="$(base)"
  if ! git -C "$root" cat-file -e "$base:sharp/bin/spec"; then
    echo "sharp/bin/spec does not exist at $base, so there is nothing to compare."
    return
  fi
  git -C "$root" show "$base:sharp/bin/spec" > "$TMPDIR/spec"
  step php "$TMPDIR/spec" --base "$base"
  if [[ -n ${BODY:-} ]]; then
    step php "$TMPDIR/spec" --completes <<< "$BODY"
  else
    echo "COMPLETES checks the pull request body's Completes: line. Set BODY to the body to check it."
  fi
}

# mago.yml's checks, on this machine with the toolchain sharp/mago/Cargo.toml's rust-version names, as CI runs them on
# the runner, then the Linux or macOS mago in the test-run profile, which plain-php runs.
no_notify() {
  local output
  if output=$(rustup run "$rust" cargo tree -p mago-sharp-bridge -e normal -i notify --locked 2>&1); then
    echo "$output"
    echo "mago-sharp-bridge depends on notify, so php would link a file watcher." >&2
    return 1
  fi
  grep -q "did not match any packages" <<< "$output"
}
# Every workspace crate keeps version 0.0.0, which a release never changes, so a release's checkout rebuilds only the
# root package, whose version it writes, and mago-build-id, which only the root package reads. A crate's own
# CARGO_PKG_VERSION is that 0.0.0, so a crate takes the release version from the mago binary instead.
no_crate_version() {
  if grep -rn --include='*.rs' CARGO_PKG_VERSION crates docs; then
    echo "A workspace crate reads its own version, always 0.0.0. Pass it the binary's version, crate::consts::VERSION." >&2
    return 1
  fi
}
# mago-build-id's ID changes with every crate's source, so each crate that depends on it compiles again after any edit.
# Only the root package reads it, and the crates below get it as a value, so an edit compiles only what it reaches.
no_build_id_below_root() {
  if grep -rn --include='*.rs' --include=Cargo.toml --exclude-dir=build-id -e mago_build_id -e mago-build-id crates; then
    echo "A crate below the root package names mago-build-id, so every edit compiles it again. Pass it the binary's build ID, crate::consts::BUILD_ID." >&2
    return 1
  fi
}
# cargo install puts typos in the folder cargo keeps installed tools in, which cargo finds its own subcommands in, but
# which a Mac with Homebrew's rustup leaves off PATH. That folder can hold an older rustup's rustc, so it never joins
# PATH.
misspellings() {
  local typos
  typos="$(command -v typos || echo "${CARGO_HOME:-$HOME/.cargo}/bin/typos")"
  if [[ ! -x $typos ]]; then
    echo "mago.yml's checks searches for misspellings with typos. Install it with: cargo install --locked typos-cli" >&2
    return 1
  fi
  "$typos"
}
# No crate either Cargo.lock pins has a RustSec vulnerability, unsound or yanked advisory: cargo deny checks each against
# the advisory database, by the deny.toml beside it, which allows no advisory by its id. mago's downloads and
# self-update ran over rustls 0.23.44, which had five, among them a TLS 1.3 handshake bug (#786). An unmaintained
# advisory names no defect and no fixed version, so it prints as a warning and passes. cargo deny finds the folder cargo
# keeps installed tools in as typos does.
advisories() {
  local deny lock
  deny="$(command -v cargo-deny || echo "${CARGO_HOME:-$HOME/.cargo}/bin/cargo-deny")"
  if [[ ! -x $deny ]]; then
    echo "mago.yml's checks checks the lockfiles for advisories with cargo-deny 0.20.2. Install its release binary, or: cargo install --locked cargo-deny@0.20.2" >&2
    return 1
  fi
  for lock in sharp/mago ext/sharp; do
    "$deny" deny --manifest-path "$root/$lock/Cargo.toml" --log-level warn check --warn unmaintained advisories
  done
}
gate_mago_checks() {
  local mago
  mago="$root/sharp/build/$os-$(uname -m)/mago/test-run/mago"
  local -x CARGO_TARGET_DIR="$target"
  cd "$root/sharp/mago"
  step misspellings
  step advisories
  step composer install --no-interaction --no-progress --quiet
  step vendor/bin/phpunit --configuration composer/phpunit.xml
  # heyjordanparker/php-sharp-composer installs mago's binary, so the tests of its download, SHA-256 check and extract
  # run here too, from the vendor folder its composer.json keeps in sharp/build.
  step composer install --no-interaction --no-progress --quiet --working-dir="$root/sharp/composer"
  step "$root/sharp/build/php-sharp-composer/vendor/bin/phpunit" --configuration "$root/sharp/composer/phpunit.xml"
  step rustup run "$rust" cargo check --workspace --locked
  # Workspace builds merge features, so only a build of the bridge alone shows what php links.
  step rustup run "$rust" cargo check -p mago-sharp-bridge --locked
  # The fuzz crate is a workspace of its own, which fuzz.yml builds only in its nightly run.
  step rustup run "$rust" cargo metadata --locked --format-version 1 --manifest-path crates/syntax/fuzz/Cargo.toml > /dev/null
  step no_notify
  step no_crate_version
  step no_build_id_below_root
  step unchanged_by php scripts/regen-sdk-node-kinds.php
  step rustup run "$rust" cargo fmt --all -- --check
  step rustup run "$rust" cargo clippy --workspace --all-targets --all-features -- -D warnings
  # The test-run binary, which behaves as release's without its fat LTO, where the dev mago logs at DEBUG and reports a
  # missing code that release never prints, as sharp/mago/Cargo.toml explains. sharp/bin/build-mago --test-run builds
  # it into the checkout's one build folder.
  if "$root/sharp/bin/build-mago" --test-run; then
    # The PHP# standard library, with the sharp/harness interfaces its mago.toml includes, analyzes with no note. mago
    # writes what it compiles into the workspace's .sharp folder, and sharp/bin/test reinstalls Zend/tests/sharp's copy of
    # the library when it differs from sharp/composer, so the analysis runs on a copy in the run's folder, beside a copy
    # of the harness its includes name, and leaves the source tree as it found it.
    tar -C "$root/sharp" --exclude=.sharp -cf - composer harness | tar -C "$TMPDIR" -xf -
    step "$mago" --colors never --workspace "$TMPDIR/composer" analyze --minimum-fail-level note
    step "$mago" format --dry-run
    step "$mago" lint
    step "$mago" analyze
  else
    gate_passed=false
  fi
}

# The PHP# suite on the thread-safe engine, in the sharp/docker image, in the four modes, with the census, the
# differential, PHPUnit, the whole-project proof of mago convert, and every rule and example of sharp/bin/spec, which
# CI's LINUX and SPEC jobs share.
gate_linux() {
  step sharp/bin/build --linux
  step sharp/bin/test --linux --census --differential --phpunit --spec
}
gate_upstream() {
  step sharp/bin/build --linux
  step sharp/bin/test --linux --upstream
}
gate_hosts() {
  step sharp/bin/build --linux
  step sharp/bin/hosts --linux
}

# The files the tree generates: php-src's, the native interface from the standard library's extern declarations, the
# built-in function declarations from php-8-stubs by rules whose every row passes, and ext/sharp/sharp_unit.h with its
# sharp_kind, SHARP_T_ tokens and SHARP_UNIT_ABI, which sharp/mago generates from Zend/zend_ast.h and
# Zend/zend_language_parser.h. No committed Cargo.lock names a local source.
php_src_generated() {
  sharp/docker/run scripts/dev/credits
  sharp/docker/run scripts/dev/genfiles
  sharp/docker/run scripts/gdb/debug_gdb_scripts_gen.php
  sharp/docker/run Zend/zend_vm_gen.php
  sharp/docker/run ext/tokenizer/tokenizer_data_gen.php
  gen_stub
}
# gen_stub.php reads PHP-Parser from build/PHP-Parser-<version>, the version it pins, and downloads it when that folder
# is missing, so this links the copy the sharp/docker image carries there, as sharp/docker/Dockerfile explains. A
# folder already there is a copy of the same version an earlier run left.
gen_stub() {
  local version
  version=$(sed -n 's/^ *[$]version = "\(.*\)";$/\1/p' "$root/build/gen_stub.php")
  # shellcheck disable=SC2016 # The container's shell expands them.
  sharp/docker/run sh -c '
    if [ ! -d "/opt/PHP-Parser-$1" ]; then
      echo "The sharp/docker image carries no PHP-Parser $1, which build/gen_stub.php pins. Pin it in sharp/docker/tools/Dockerfile." >&2
      exit 1
    fi
    [ -e "build/PHP-Parser-$1" ] || ln -s "/opt/PHP-Parser-$1" "build/PHP-Parser-$1"
    exec build/gen_stub.php -f --generate-optimizer-info --verify' sh "$version"
}
builtins() {
  sharp/docker/run sharp/bin/builtins --self-test
  sharp/docker/run sharp/bin/builtins
}
sharp_kinds() {
  sharp/docker/run php sharp/mago/scripts/regen-sharp-kinds.php Zend/zend_ast.h Zend/zend_language_parser.h \
    | diff -u sharp/mago/crates/sharp-bridge/src/kind.rs -
}
# The build reuses every unit of the mago sharp/bin/test built, and its build.json names the out_dir of the bridge it links.
# `-p mago-sharp-bridge` resolves other features, so it built a second bridge and its dependencies beside it. A
# MAGO_ENGINE in the environment names the engine that build linked, as BUILD_LINUX builds it first with --engine, so
# build-mago links that one, where it would build the engine from nothing in a job that holds only its install.
sharp_unit_header() {
  local line
  sharp/docker/run env ${MAGO_ENGINE:+"MAGO_ENGINE=$MAGO_ENGINE"} sharp/bin/build-mago --quiet
  while read -r line; do
    if [[ $line == *'"reason":"build-script-executed"'* && $line == *mago-sharp-bridge* && $line =~ \"out_dir\":\"/src/([^\"]+)\" ]]; then
      diff -u ext/sharp/sharp_unit.h "${BASH_REMATCH[1]}/sharp_unit.h"
      return
    fi
  done < "sharp/build/linux-$(sharp/docker/run uname -m)/mago/build.json"
  echo "cargo reported no out_dir for mago-sharp-bridge." >&2
  return 1
}
local_sources() {
  if git grep -nE '(path|git)\+file://' -- '*Cargo.lock'; then
    echo "A committed Cargo.lock names a local source. Keep a [patch] in an untracked .cargo/config.toml." >&2
    return 1
  fi
}
gate_generated() {
  step local_sources
  step unchanged_by php_src_generated
  # sharp/bin/native is PHP, which can't hand itself to the recorder, so its run is recorded here.
  step unchanged_by sharp/bin/record sharp/bin/native -- sharp/docker/run sharp/bin/native
  step unchanged_by builtins
  step sharp_kinds
  step sharp_unit_header
}

# sharp/mago's workspace tests, in the sharp/docker image, as sharp.yml's MAGO jobs and BUILD_LINUX run them in five slices.
gate_mago_tests() {
  step sharp/bin/test --linux --mago
}

# mago.yml's plain-php on this machine's own PHP, with the test-run mago mago-checks built, or that CI's plain-php
# downloads there. It installs heyjordanparker/mago-sharp from what git archive ships, the way Packagist ships it, and
# heyjordanparker/php-sharp-composer from sharp/composer. A package that requires upstream's carthage-software/mago at
# the release this checker left from, as an extension host does, installs no second checker, and one that requires a
# later release installs nothing. Then mago runs on a one-class .sharp project, and sharp/phpunit's tests stop before a
# .sharp test file's source prints.
composer_install() {
  local mago="$target/test-run/mago" version tree triple package="$TMPDIR/mago-sharp-package" project="$TMPDIR/project"
  local output
  if [[ ! -f $mago ]]; then
    echo "$mago is missing. Run sharp/bin/check mago-checks first." >&2
    return 1
  fi
  php -v
  version="$(awk -F '"' '/^version = /{ print $2; exit }' "$root/sharp/mago/Cargo.toml")"
  mkdir -p "$package" "$project/src/App"
  # git stash create writes the working tree's changes to tracked files as a commit and changes nothing, so the package
  # holds them, as a commit of them would ship them. It prints nothing for a working tree with no change.
  tree="$(git -C "$root" stash create)"
  git -C "$root" archive "${tree:-HEAD}" sharp/mago | tar -x -C "$package" --strip-components 2
  # The tree's version has no release to download, so the package carries the test-run mago at
  # composer/bin/<triple>/mago, where php-sharp-composer's plugin installs a release's binary for this platform, and the
  # plugin finds it in place.
  triple="$(php -r 'require $argv[1]; echo PhpSharp\Composer\MagoBinary::triple();' "$root/sharp/composer/src/MagoBinary.php")"
  mkdir -p "$package/composer/bin/$triple"
  install -m 755 "$mago" "$package/composer/bin/$triple/mago"
  cd "$project"
  cat > composer.json << JSON
{
    "type": "library",
    "repositories": [
        { "type": "path", "url": "$root/sharp/composer" },
        {
            "type": "path",
            "url": "$package",
            "options": {"symlink": false, "versions": {"heyjordanparker/mago-sharp": "$version"}}
        }
    ],
    "autoload": { "psr-4": { "App\\\\": "src/App/" } },
    "config": { "allow-plugins": { "heyjordanparker/php-sharp-composer": true } }
}
JSON
  cat > mago.toml << 'TOML'
[source]
paths = ["src"]
extensions = ["sharp"]
TOML
  cat > src/App/Counter.sharp << 'SHARP'
namespace App;

class Counter
{
    private int count = 0;

    public int add(int amount)
    {
        this.count += amount;
        return this.count;
    }
}
SHARP
  composer require --no-interaction heyjordanparker/php-sharp-composer:@dev
  composer require --no-interaction --dev "heyjordanparker/mago-sharp:$version"
  mkdir -p "$TMPDIR/upstream-host"
  cat > "$TMPDIR/upstream-host/composer.json" << 'JSON'
{
    "name": "probe/upstream-host",
    "version": "0.1.0",
    "require": { "carthage-software/mago": "^1.50" }
}
JSON
  composer config repositories.upstream-host path "$TMPDIR/upstream-host"
  composer require --no-interaction --dev probe/upstream-host:0.1.0
  if [[ -e vendor/carthage-software/mago ]]; then
    echo "A host that requires carthage-software/mago ^1.50 installed upstream's mago beside mago-sharp." >&2
    return 1
  fi
  # A host that needs a later upstream release than the one this checker left from gets no install.
  mkdir -p "$TMPDIR/later-host"
  cat > "$TMPDIR/later-host/composer.json" << 'JSON'
{
    "name": "probe/later-host",
    "version": "0.1.0",
    "require": { "carthage-software/mago": "^1.57" }
}
JSON
  composer config repositories.later-host path "$TMPDIR/later-host"
  if composer require --no-interaction --dev probe/later-host:0.1.0; then
    echo "A host that requires carthage-software/mago ^1.57 installed beside mago-sharp." >&2
    return 1
  fi
  output=$(vendor/bin/mago --version 2>&1)
  echo "$output"
  if [[ $output != "mago $version" ]]; then
    echo "vendor/bin/mago --version printed \"$output\", not \"mago $version\"." >&2
    return 1
  fi
  vendor/bin/mago analyze && vendor/bin/mago compile
}
# Plain PHP prints a .sharp file's source, and PHPUnit includes the fixture's .sharp test file itself, past the
# plugin's loader. The fixture's bootstrap, sharp/composer/require-engine.php, stops the run before it does.
plain_phpunit() {
  local output
  cd "$root/sharp/phpunit"
  composer install --no-interaction --no-progress
  if output=$(vendor/bin/phpunit 2>&1); then
    echo "$output"
    echo "PHPUnit passed on plain PHP." >&2
    return 1
  fi
  echo "$output"
  if ! grep -q 'This project needs the PHP# engine' <<< "$output"; then
    echo "PHPUnit stopped on plain PHP without the engine's error." >&2
    return 1
  fi
  if grep -q 'singleton Mailer = LogMailer' <<< "$output"; then
    echo "PHPUnit printed tests/Shop/CheckoutTest.sharp's source." >&2
    return 1
  fi
}
gate_plain_php() {
  step composer_install
  step plain_phpunit
}

# SPEED: what proving and compiling cost, in counts no load changes, against master's newest green Mago CI push run's,
# as speed_baseline finds it: each law's Lean heartbeats, the law corpus's, and the instructions of a one-file edit, as
# benchmark/speed.php explains. It measures the test-run mago that mago-checks builds, or that mago.yml's SPEED
# downloads from its checks there, as plain-php does, which behaves as the release users run without its fat LTO, as
# sharp/mago/Cargo.toml explains. A debug build's counts would move with code the optimizer removes. SPEED_BASELINE
# names the folder of a baseline already downloaded, as mago.yml's SPEED downloads it outside the sharp/docker image,
# which has no gh. With SPEED_WRITE, it also writes what it measured there, the run's speed artifact.
speed() {
  local mago="$target/test-run/mago" baseline="${SPEED_BASELINE:-}"
  if [[ ! -f $mago ]]; then
    echo "$mago is missing. Run sharp/bin/check mago-checks first." >&2
    return 1
  fi
  if [[ -z $baseline ]]; then
    baseline="$TMPDIR/speed-baseline"
    speed_baseline "$baseline"
  fi
  php "$root/benchmark/speed.php" "$mago" --baseline "$baseline/speed.json" ${SPEED_WRITE:+--write "$SPEED_WRITE"}
}
gate_speed() {
  step speed
}

# Sets clock_now to the epoch seconds now and clock_cpu to the CPU milliseconds this shell and the processes it waited
# for have used, as bash's times counts them, so each gate's line in the build record holds its own.
clock() {
  local time
  clock_now=$EPOCHREALTIME
  clock_cpu=0
  times > "${TMPDIR:-/tmp}/sharp-bin-check-times.$$"
  for time in $(< "${TMPDIR:-/tmp}/sharp-bin-check-times.$$"); do
    [[ $time =~ ^([0-9]+)m([0-9]+)[.,]([0-9]{3})s$ ]]
    clock_cpu=$((clock_cpu + (BASH_REMATCH[1] * 60 + BASH_REMATCH[2]) * 1000 + 10#${BASH_REMATCH[3]}))
  done
  rm -f "${TMPDIR:-/tmp}/sharp-bin-check-times.$$"
}

cd "$root"
failed=()
times=()
for gate in "${gates[@]}"; do
  echo
  echo "=== $gate"
  gate_passed=true
  start=$SECONDS
  clock
  gate_started=$clock_now
  gate_cpu=$clock_cpu
  "gate_${gate//-/_}"
  cd "$root"
  clock
  gate_exit=0
  if $gate_passed; then
    result=passed
  else
    result=FAILED
    gate_exit=1
    failed+=("$gate")
  fi
  printf -v gate_cpu_s '%d.%03d' $(((clock_cpu - gate_cpu) / 1000)) $(((clock_cpu - gate_cpu) % 1000))
  "$root/sharp/bin/record" "$gate" --measured "$gate_started" "$gate_cpu_s" '' "$gate_exit"
  times+=("$(printf '%-15s %5ss  %s' "$gate" "$((SECONDS - start))" "$result")")
done

echo
printf '%s\n' "${times[@]}"
printf '%-15s %5ss\n' total "$SECONDS"
if [[ ${#failed[@]} -gt 0 ]]; then
  printf 'Failed: %s\n' "${failed[@]}" >&2
  exit 1
fi
