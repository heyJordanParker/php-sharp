#!/usr/bin/env bash
set -euo pipefail

# The build record: one JSON line for each run of a build, compile, test or benchmark, and one for each step it runs,
# appended to ${XDG_STATE_HOME:-$HOME/.local/state}/php-sharp/builds.jsonl, so a regression's start is read from it
# instead of guessed. It is the one writer of that file. The checkout, every worktree and the sharp/docker image write the
# same file, which sharp/docker/run mounts, and a CI job's lives under $RUNNER_TEMP, which the job uploads as its
# build-log artifact. The file is only appended to, and nothing reads it to decide what to build or run.
#
# `record <name> -- <command…>` runs the command and appends its line when it ends, with the command's exit status,
# which it exits with. The command's own records name this one as their parent through SHARP_RECORD_PARENT, so a run is
# a record with its steps under it, and SHARP_RECORDED holds this record's name, so a script that runs itself through
# the recorder under its own name, as sharp/bin/build, doesn't do it twice. `record <name> --measured <start> <cpu_s>
# <peak_mib> <exit>` appends the line of work its caller measured, as sharp/bin/test's parts and a CI job's usage, which
# started at the epoch seconds <start> and ends now, and exits 0. An empty <peak_mib> is unknown.
#
# A line holds the record's id, its parent's, its name and argv, the checkout, branch and commit it ran on, how dirty
# the tree was (the count of changed paths and the SHA-256 of `git diff HEAD`), the host, its processor model, cores and
# load, the start and end in UTC, the wall seconds, the CPU-seconds the command and every process it waited for used,
# its peak memory, which is the most the command and its descendants held at once, sampled each second, so a command
# that ends within a second has none, its exit status, and the CI run and job when one runs it. A container
# sharp/docker/run starts under it adds the CPU-seconds and the peak memory its cgroup counted, page cache included.
#
# A record under another starts no process of its own but the command and the sampler, since a step's own overhead adds
# to every run: it takes the tree its top-level record read from git, and the machine its first record on that host
# read, and writes its numbers with the shell's own arithmetic.

usage() {
  echo "usage: sharp/bin/record <name> -- <command...>" >&2
  echo "       sharp/bin/record <name> --measured <start> <cpu_s> <peak_mib> <exit>" >&2
  exit 2
}

if [[ $# -lt 3 ]]; then
  usage
fi
name=$1
mode=$2
shift 2
case "$mode" in
  --) ;;
  --measured) [[ $# -eq 4 && $1 =~ ^[0-9]+([.,][0-9]+)?$ && $2 =~ ^[0-9]+([.][0-9]+)?$ && $3 =~ ^[0-9]*$ && $4 =~ ^[0-9]+$ ]] || usage ;;
  *) usage ;;
esac

invoked=$EPOCHREALTIME
here=${0%/*}
if [[ $here == "$0" ]]; then
  here=.
fi
root="$(cd "$here/../.." && pwd)"
state="${XDG_STATE_HOME:-$HOME/.local/state}/php-sharp"
id="${EPOCHREALTIME/[^0-9]/}-$$-$RANDOM"
parent="${SHARP_RECORD_PARENT:-}"

# Sets REPLY to `text` as a JSON string.
quoted() {
  local text=$1 escaped='' char i
  text=${text//\\/\\\\}
  text=${text//\"/\\\"}
  text=${text//$'\n'/\\n}
  text=${text//$'\r'/\\r}
  text=${text//$'\t'/\\t}
  if [[ $text == *[$'\x01'-$'\x1f']* ]]; then
    for ((i = 0; i < ${#text}; i++)); do
      char=${text:i:1}
      if [[ $char == [$'\x01'-$'\x1f'] ]]; then
        printf -v char '\\u%04x' "'$char"
      fi
      escaped+=$char
    done
    text=$escaped
  fi
  printf -v REPLY '"%s"' "$text"
}

# Sets REPLY to `text` as a JSON string, or to null when it is empty.
quoted_or_null() {
  if [[ -n $1 ]]; then
    quoted "$1"
  else
    REPLY=null
  fi
}

# Sets REPLY to `seconds`, epoch seconds with a fraction, as UTC ISO 8601.
iso_time() {
  TZ=UTC printf -v REPLY '%(%Y-%m-%dT%H:%M:%SZ)T' "${1%.*}"
}

# Sets REPLY to `seconds`, a decimal such as 12.3 or 1795458321.584734, in microseconds.
micros() {
  local whole=${1%%.*} fraction=000000
  if [[ $1 == *.* ]]; then
    fraction="${1#*.}000000"
  fi
  REPLY=$((10#$whole * 1000000 + 10#${fraction:0:6}))
}

# Sets REPLY to `micros`, microseconds, as seconds with three decimals.
seconds() {
  printf -v REPLY '%d.%03d' "$(($1 / 1000000))" "$(($1 % 1000000 / 1000))"
}

# Sets children_ms to `times`'s user and system CPU of the processes this shell waited for, in milliseconds. It runs in
# this shell, never in a subshell, which has waited for none of them.
children_cpu() {
  local line last='' time total=0
  times > "$times_file"
  while read -r line; do
    last=$line
  done < "$times_file"
  for time in $last; do
    [[ $time =~ ^([0-9]+)m([0-9]+)[.,]([0-9]{3})s$ ]]
    total=$((total + (BASH_REMATCH[1] * 60 + BASH_REMATCH[2]) * 1000 + 10#${BASH_REMATCH[3]}))
  done
  children_ms=$total
}

# What the run ran on, read before it starts: each fact a failed read leaves unknown, as git in a container whose user
# doesn't own the checkout leaves the tree's. SHARP_RECORD_TREE carries the tree the top-level record read as
# `branch:commit:changed:diff_sha256`, since git refuses `:` in a branch's name, and SHARP_RECORD_MACHINE the processor,
# cores and load the host's first record read. sharp/docker/run passes the tree into a container, which mounts the same
# checkout, and not the machine, which is another host.
if [[ -n ${SHARP_RECORD_TREE:-} ]]; then
  IFS=: read -r branch commit changed diff_sha256 <<< "$SHARP_RECORD_TREE"
else
  branch="$(git -C "$root" branch --show-current 2>/dev/null || true)"
  commit="$(git -C "$root" rev-parse HEAD 2>/dev/null || true)"
  changed=''
  diff_sha256=''
  if porcelain="$(git -C "$root" status --porcelain 2>/dev/null)" && diff="$(git -C "$root" diff HEAD 2>/dev/null)"; then
    changed=0
    if [[ -n $porcelain ]]; then
      changed="$(wc -l <<< "$porcelain" | tr -d ' ')"
    fi
    if command -v sha256sum > /dev/null; then
      diff_sha256="$(printf '%s' "$diff" | sha256sum | cut -d' ' -f1)"
    else
      diff_sha256="$(printf '%s' "$diff" | shasum -a 256 | cut -d' ' -f1)"
    fi
  fi
fi
host=${HOSTNAME:-}
separator=$'\x1f'
if [[ -n ${SHARP_RECORD_MACHINE:-} ]]; then
  IFS=$separator read -r cpu_model cores load <<< "$SHARP_RECORD_MACHINE"
else
  if [[ $OSTYPE == darwin* ]]; then
    cpu_model="$(sysctl -n machdep.cpu.brand_string 2>/dev/null || true)"
    load="$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}' || true)"
  else
    # lscpu, since an arm64 machine's /proc/cpuinfo names no model.
    cpu_model="$(lscpu 2>/dev/null | awk -F ': *' '/^Model name:/ && model == "" {model = $2} END {print model}' || true)"
    load="$(cut -d' ' -f1 /proc/loadavg 2>/dev/null || true)"
  fi
  cores="$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)"
fi

if [[ ! -d $state ]]; then
  mkdir -p "$state"
fi
peak_mib=''
if [[ $mode == --measured ]]; then
  start=${1/,/.}
  end=$invoked
  micros "$2"
  cpu_us=$REPLY
  peak_mib=$3
  status=$4
  argv=()
else
  [[ $# -gt 0 ]] || usage
  argv=("$@")
  times_file="$state/times.$id"
  peak_file="$state/peak.$id"
  usage_file="$state/usage.$id"
  start=$EPOCHREALTIME
  children_cpu
  cpu_before=$children_ms
  # The peak memory: the most the resident sets of this shell's descendants, the command and every process under it, held
  # at once, sampled each second, leaving out the sampler itself.
  : > "$peak_file"
  (
    sampler=$BASHPID
    peak=0
    while :; do
      sleep 1
      used="$(ps -A -o pid=,ppid=,rss= | awk -v root="$$" -v sampler="$sampler" '
        {parent[$1] = $2; rss[$1] = $3}
        END {
          for (p in parent) {
            q = p
            while (q in parent && q != root && q != sampler) q = parent[q]
            if (q == root && p != root) sum += rss[p]
          }
          print sum + 0
        }')"
      if ((used > peak)); then
        peak=$used
        echo "$peak" > "$peak_file"
      fi
    done
  ) &
  sampler=$!
  interrupted=''
  trap 'interrupted=130' INT
  trap 'interrupted=143' TERM
  # A container's processes are no children of this shell, so `times` and the sampler miss them. sharp/docker/run
  # appends each container's CPU microseconds and peak bytes, read from its cgroup as it ends, to the file
  # SHARP_RECORD_USAGE names, in the record's folder it mounts, and this record adds them to its own and passes them on to
  # the record that runs it.
  outer_usage=${SHARP_RECORD_USAGE:-}
  export SHARP_RECORD_PARENT="$id" SHARP_RECORDED="$name" SHARP_RECORD_USAGE="$usage_file"
  export SHARP_RECORD_TREE="$branch:$commit:$changed:$diff_sha256"
  export SHARP_RECORD_MACHINE="$cpu_model$separator$cores$separator$load"
  if "$@"; then
    status=0
  else
    status=$?
  fi
  status=${interrupted:-$status}
  end=$EPOCHREALTIME
  children_cpu
  kill "$sampler" 2>/dev/null || true
  wait "$sampler" 2>/dev/null || true
  peak_kib=''
  read -r peak_kib < "$peak_file" || true
  # The containers run one after another, so the most one held adds to what this shell's descendants held.
  container_us=0
  container_peak=0
  if [[ -f $usage_file ]]; then
    while read -r used held; do
      if [[ $used =~ ^[0-9]+$ && $held =~ ^[0-9]+$ ]]; then
        container_us=$((container_us + used))
        if ((held > container_peak)); then
          container_peak=$held
        fi
      fi
    done < "$usage_file"
    if [[ -n $outer_usage ]]; then
      echo "$container_us $container_peak" >> "$outer_usage"
    fi
  fi
  rm -f "$peak_file" "$times_file" "$usage_file"
  cpu_us=$(((children_ms - cpu_before) * 1000 + container_us))
  if [[ -n $peak_kib ]] || ((container_peak > 0)); then
    peak_mib=$(((${peak_kib:-0} + container_peak / 1024) / 1024))
  fi
fi
micros "$start"
start_us=$REPLY
micros "$end"
end_us=$REPLY

argv_json='['
for ((i = 0; i < ${#argv[@]}; i++)); do
  ((i == 0)) || argv_json+=','
  quoted "${argv[i]}"
  argv_json+=$REPLY
done
argv_json+=']'
ci=null
if [[ -n ${GITHUB_RUN_ID:-} ]]; then
  quoted "$GITHUB_RUN_ID"
  ci="{\"run_id\":$REPLY"
  quoted_or_null "${GITHUB_JOB:-}"
  ci+=",\"job\":$REPLY}"
fi

quoted "$id"
line="{\"id\":$REPLY"
quoted_or_null "$parent"
line+=",\"parent\":$REPLY"
quoted "$name"
line+=",\"name\":$REPLY"
line+=",\"argv\":$argv_json"
quoted "$root"
line+=",\"checkout\":$REPLY"
quoted_or_null "$branch"
line+=",\"branch\":$REPLY"
quoted_or_null "$commit"
line+=",\"commit\":$REPLY"
quoted_or_null "$diff_sha256"
line+=",\"dirty\":{\"paths\":${changed:-null},\"diff_sha256\":$REPLY}"
quoted "$host"
line+=",\"host\":$REPLY"
quoted_or_null "$cpu_model"
line+=",\"cpu\":$REPLY"
line+=",\"cores\":${cores:-null}"
line+=",\"load\":${load:-null}"
iso_time "$start"
line+=",\"start\":\"$REPLY\""
iso_time "$end"
line+=",\"end\":\"$REPLY\""
seconds "$((end_us - start_us))"
line+=",\"wall_s\":$REPLY"
seconds "$cpu_us"
line+=",\"cpu_s\":$REPLY"
line+=",\"peak_mib\":${peak_mib:-null}"
line+=",\"exit\":$status"
line+=",\"ci\":$ci}"
printf '%s\n' "$line" >> "$state/builds.jsonl"
if [[ $mode == --measured ]]; then
  exit 0
fi
exit "$status"
