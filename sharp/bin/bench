#!/usr/bin/env bash
set -euo pipefail

# Prints the callgrind instruction count of each loop of sharp/bench/Loops.sharp, in no JIT, the function JIT and the
# tracing JIT: the count of a run of 1M turns less the count of a run of none, so startup and the code a row runs
# before its loop count for nothing. It runs in the php-sharp-linux image with the tree mounted, on the Linux build
# sharp/bin/build --linux made, or with --release on the release build sharp/bin/build --linux --release made, which
# the speed gate measures, with valgrind installed in the throwaway container.

usage() {
  echo "usage: sharp/bin/bench [--release] [rows...]" >&2
  exit 2
}

root="$(cd "$(dirname "$0")/../.." && pwd)"
rows=(listAdd listAddOnProperty listIndexRead listIndexWrite mapGetAndPut setAdd setInsert mapHas mapRemove
  tableChangeWhileShared filterWithLambda plainMethodCall)
release=false
chosen=()
for arg in "$@"; do
  case "$arg" in
    --release) release=true ;;
    -*) usage ;;
    *) chosen+=("$arg") ;;
  esac
done
if [[ ${#chosen[@]} -gt 0 ]]; then
  rows=("${chosen[@]}")
fi

if [[ ! -f /.dockerenv ]]; then
  # valgrind is installed as root, and the rows run as the caller, so every file they write is the caller's.
  exec docker run --rm --init \
    --ulimit stack=8388608:-1 \
    --env BENCH_UID="$(id -u)" \
    --env BENCH_GID="$(id -g)" \
    --volume "$root:/src" \
    --workdir /src \
    php-sharp-linux bash -c '
      apt-get -qq update >/dev/null && apt-get -qq install -y valgrind >/dev/null
      exec setpriv --reuid="$BENCH_UID" --regid="$BENCH_GID" --clear-groups \
        env HOME=/tmp CARGO_HOME=/src/sharp/build/cargo RUSTUP_HOME=/src/sharp/build/rustup \
        XDG_CACHE_HOME=/src/sharp/build/cache sharp/bin/bench "$@"' bench "$@"
fi

build_dir="$root/sharp/build/linux-$(uname -m)"
# mago doesn't depend on the engine's build, so both builds' rows compile with the one in the debug build's folder.
mago_dir="$build_dir/mago"
built="sharp/bin/build --linux"
if $release; then
  build_dir+=-release
  built+=" --release"
fi
php="$build_dir/sapi/cli/php"
if [[ ! -x "$php" ]]; then
  echo "$php is missing. Run $built first." >&2
  exit 1
fi

# callgrind counts the engine's instructions alone, so the rows compile with the mago sharp/bin/test builds, in the
# test-run profile of sharp/mago/Cargo.toml.
cargo="$(cd "$root/ext/sharp" && rustup which cargo)"
PATH="$(dirname "$cargo"):$PATH" "$cargo" build --quiet --locked --profile test-run --jobs "${CARGO_BUILD_JOBS:-2}" \
  --manifest-path "$root/sharp/mago/Cargo.toml" --target-dir "$mago_dir" --bin mago
# mago compile keeps a workspace's .sharp folder to the files of its own project, so a compile of the rows in the tree
# would delete the compiled fixtures a sharp/bin/test run there reads. The rows compile in a copy of sharp/bench and
# sharp/composer in the throwaway container's /tmp instead, with a .sharp folder of their own. /tmp is as long as the
# tree's /src, and a row's count changes with the length of the path it runs from, so each row counts what it counted
# when it ran in the tree.
workspace=/tmp
mkdir "$workspace/sharp"
cp -R "$root/sharp/bench" "$root/sharp/composer" "$workspace/sharp/"
"$mago_dir/test-run/mago" --no-version-check --colors never --workspace "$workspace" \
  --config "$workspace/sharp/bench/mago.toml" compile >/dev/null

modes=("no JIT" "function JIT" "tracing JIT")
flags_of() {
  case "$1" in
    "no JIT") echo "-d opcache.enable_cli=1 -d opcache.jit=disable" ;;
    "function JIT") echo "-d opcache.enable_cli=1 -d opcache.jit=function -d opcache.jit_buffer_size=32M" ;;
    "tracing JIT") echo "-d opcache.enable_cli=1 -d opcache.jit=tracing -d opcache.jit_buffer_size=32M" ;;
  esac
}

# The instructions callgrind counts for one run, which must print what the row returns.
instructions() {
  local mode="$1" row="$2" n="$3" out
  # shellcheck disable=SC2046
  out="$(valgrind --tool=callgrind --smc-check=all --callgrind-out-file=/dev/null \
    "$php" -n $(flags_of "$mode") "$workspace/sharp/bench/run.php" "$row" "$n" 2>&1)"
  sed -n 's/^==[0-9]*== Collected : \([0-9]*\)$/\1/p' <<< "$out" | grep . || {
    echo "callgrind counted nothing for $row in $mode:" >&2
    echo "$out" >&2
    exit 1
  }
}

printf '%-20s %-14s %15s\n' row mode instructions
for row in "${rows[@]}"; do
  for mode in "${modes[@]}"; do
    loop=$(($(instructions "$mode" "$row" 1000000) - $(instructions "$mode" "$row" 0)))
    printf '%-20s %-14s %15d\n' "$row" "$mode" "$loop"
  done
done
