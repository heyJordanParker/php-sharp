#!/usr/bin/env bash
set -euo pipefail

# Runs cargo-nextest, the test runner sharp/bin/build-mago lists Mago's test binaries with and sharp/bin/test --mago runs
# them with: each test in a process of its own, the binaries at once, with each test's time. Every argument goes to
# `cargo nextest`. It runs the pinned release, fetched once into sharp/build/tools/ and checked against its SHA-256, so
# a builder's machine, a CI job and the sharp/docker image run the same one, as the build pins and fetches its other
# tools into sharp/build/. The Linux releases are static, so the image runs them as they are.
root="$(cd "$(dirname "$0")/../.." && pwd)"
version=0.9.151
case "$(uname -s)-$(uname -m)" in
  Darwin-*) target=universal-apple-darwin sha256=d1d7d025d4bfc9fb154cd76aea3949bd78534829a0589abefa6e5dd4edb135dd ;;
  Linux-x86_64) target=x86_64-unknown-linux-musl sha256=6b284d6fde9670dfb6ee10ea9d9abbc85f95643d3f592472d420d82e257b3a6c ;;
  Linux-aarch64) target=aarch64-unknown-linux-musl sha256=a9ee2d53cf0711d879f068c0ff814b6fe3af3f9be8799f8ab484e47571087160 ;;
  *)
    echo "cargo-nextest $version has no release for $(uname -s) $(uname -m)." >&2
    exit 1
    ;;
esac
folder="$root/sharp/build/tools/cargo-nextest-$version-$target"
if [[ ! -x $folder/cargo-nextest ]]; then
  mkdir -p "$root/sharp/build/tools"
  # A folder of its own, moved into place once checked, so two runs that fetch at once never run a half-written binary.
  fetch="$(mktemp -d "$root/sharp/build/tools/fetch.XXXXXX")"
  trap 'rm -rf "$fetch"' EXIT
  url="https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-$version/cargo-nextest-$version-$target.tar.gz"
  curl --fail --silent --show-error --location --output "$fetch/archive.tar.gz" "$url"
  if [[ "$(shasum -a 256 "$fetch/archive.tar.gz" | cut -d' ' -f1)" != "$sha256" ]]; then
    echo "$url's SHA-256 is not $sha256, so it isn't the cargo-nextest release sharp/bin/nextest names." >&2
    exit 1
  fi
  mkdir "$fetch/bin"
  tar -xzf "$fetch/archive.tar.gz" -C "$fetch/bin"
  if [[ ! -e $folder ]]; then
    mv "$fetch/bin" "$folder"
  fi
  rm -rf "$fetch"
  if [[ ! -x $folder/cargo-nextest ]]; then
    echo "$url holds no cargo-nextest binary." >&2
    exit 1
  fi
fi
exec "$folder/cargo-nextest" nextest "$@"
