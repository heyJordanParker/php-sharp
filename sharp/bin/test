#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: sharp/bin/test [--linux] [--no-build] [--census] [--spec] [--differential] [--phpunit] [--upstream | --mago | --shard <i>/<n> | paths...]" >&2
  echo "       sharp/bin/test [--linux] [--no-build] --mago [--shard <i>/<n>]" >&2
  exit 2
}

root="$(cd "$(dirname "$0")/../.." && pwd)"
linux=false
# --no-build runs on the mago and the test binaries an earlier sharp/bin/build-mago made, as CI's suites run on their
# build job's, and builds nothing.
build=true
census=false
spec=false
differential=false
phpunit=false
upstream=false
mago=false
shard=
tests=()
container_command=(sharp/bin/test)
args=("$@")
for ((a = 0; a < ${#args[@]}; a++)); do
  arg="${args[a]}"
  case "$arg" in
    --linux) linux=true; continue ;;
    --no-build) build=false ;;
    --shard) a=$((a + 1)); shard="${args[a]:-}"; container_command+=(--shard "$shard"); continue ;;
    --census) census=true ;;
    --spec) spec=true ;;
    --differential) differential=true ;;
    --phpunit) phpunit=true ;;
    --upstream) upstream=true ;;
    --mago) mago=true ;;
    -*) usage ;;
    *) tests+=("$arg") ;;
  esac
  container_command+=("$arg")
done

if { $upstream || $mago; } && [[ ${#tests[@]} -gt 0 ]] || { $upstream && $mago; }; then
  usage
fi
if $mago && { $census || $spec || $differential || $phpunit; }; then
  usage
fi
# --shard <i>/<n> runs the i-th of n slices, so n jobs that run the same modes together run each test once.
if [[ -n $shard ]]; then
  if $upstream || [[ ${#tests[@]} -gt 0 || ! $shard =~ ^([1-9][0-9]*)/([1-9][0-9]*)$ ]] || (( BASH_REMATCH[1] > BASH_REMATCH[2] )); then
    usage
  fi
  shard_index=${BASH_REMATCH[1]}
  shard_count=${BASH_REMATCH[2]}
fi

if $linux; then
  exec "$root/sharp/docker/run" "${container_command[@]}"
fi

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
build_dir="$root/sharp/build/$os-$(uname -m)"
jobs="$("$root/sharp/bin/jobs")"

# Each run keeps its own files in a temporary folder of its own and removes it when it ends, so no run reads what
# another run wrote. A test command runs in a process group of its own, so a run that ends early, as on SIGTERM, first
# stops it, its workers and their tests, which would go on writing in the folder.
TMPDIR="$(mktemp -d)"
export TMPDIR
# Each `mago` a test starts runs on one thread, so a run's load is its test threads. A test about threads passes
# --threads, which wins over MAGO_THREADS.
export MAGO_THREADS=1
tests_groups=()
trap 'if ((${#tests_groups[@]})); then kill -KILL -- "${tests_groups[@]/#/-}" || true; wait "${tests_groups[@]}" || true; fi; rm -rf "$TMPDIR"' EXIT

# Every step runs, and the script fails at the end if any step failed.
failed=()

# Runs the command from the folder, in a process group of its own, and records the step as failed when it fails.
run_step() {
  local step="$1" folder="$2"
  shift 2
  set -m
  (cd "$folder" && exec "$@") &
  tests_groups=("$!")
  set +m
  if ! wait "${tests_groups[0]}"; then
    failed+=("$step")
  fi
  tests_groups=()
}

# Ends the part of the run under way with its wall seconds and the CPU-seconds the shell and the processes it waited
# for used in it, as bash's times counts them, so a change to one part is judged by that part whatever else the machine
# runs. Then it starts the part its heading names, if any.
part_heading=''
part_started=0
part_cpu=0
part() {
  local now="${EPOCHREALTIME/[^0-9]/}" cpu=0 time wall used
  times > "$TMPDIR/sharp-bin-test-times"
  for time in $(< "$TMPDIR/sharp-bin-test-times"); do
    [[ $time =~ ^([0-9]+)m([0-9]+)[.,]([0-9]{3})s$ ]]
    cpu=$((cpu + (BASH_REMATCH[1] * 60 + BASH_REMATCH[2]) * 1000 + 10#${BASH_REMATCH[3]}))
  done
  if [[ -n $part_heading ]]; then
    wall=$(((now - part_started) / 100000))
    used=$(((cpu - part_cpu) / 100))
    printf '%s took %d.%d s and %d.%d CPU-seconds.\n' "$part_heading" $((wall / 10)) $((wall % 10)) $((used / 10)) $((used % 10))
  fi
  part_heading="${1:-}"
  part_started=$now
  part_cpu=$cpu
  if [[ -n $part_heading ]]; then
    echo "== $part_heading"
  fi
}

finish() {
  part
  if [[ ${#failed[@]} -gt 0 ]]; then
    printf 'Failed: %s\n' "${failed[@]}" >&2
    exit 1
  fi
  exit 0
}

# sharp/mago's workspace tests: every test binary the build.json of sharp/bin/build-mago names, all at once, each run
# from its package's folder as cargo test runs it, then the doc tests and the property tests of mago-codex, which builds with a
# feature of its own. With --shard, every n-th test of all the binaries' tests, in binary and name order, from the i-th,
# so a set of slow tests, such as the compile:: tests of tests/main.rs, spreads over the slices, and the last slice also
# runs the doc and the property tests. A test binary runs the tests of its slice by skipping the others by exact name,
# which both libtest and libtest-mimic's harnesses take as often as needed. With --no-build, cargo runs nothing, so the
# doc and the property tests, which cargo builds, are left to a run that builds.
if $mago; then
  # The tests run a PHP SDK worker from sharp/mago's vendor folder, and lake, which mago compile proves laws with:
  # installing the pinned Lean first keeps the tests that run lake at once from each installing it.
  part "composer install in sharp/mago, and the pinned Lean"
  composer install --no-interaction --no-progress --quiet --working-dir="$root/sharp/mago"
  elan toolchain install "$(cat "$root/sharp/mago/crates/sharp-lean/lean/lean-toolchain")"
  if $build; then
    part "sharp/bin/build-mago"
    "$root/sharp/bin/build-mago" --quiet
  fi
  part
  messages="$build_dir/mago/build.json"
  if [[ ! -f $messages ]]; then
    echo "$messages is missing. Run sharp/bin/build-mago first." >&2
    exit 1
  fi
  binaries=()
  while read -r line; do
    if [[ $line == *'"reason":"compiler-artifact"'* && $line =~ \"profile\":\{[^}]*\"test\":true &&
      $line =~ \"executable\":\"([^\"]+)\" ]]; then
      executable="${BASH_REMATCH[1]}"
      [[ $line =~ \"manifest_path\":\"([^\"]+)\" ]]
      binaries+=("$executable"$'\t'"$(dirname "${BASH_REMATCH[1]}")")
    fi
  done < "$messages"
  mapfile -t binaries < <(printf '%s\n' "${binaries[@]}" | LC_ALL=C sort -u)
  # The tests write below the folder cargo names CARGO_TARGET_TMPDIR, which a build makes and a copy of the binaries
  # alone leaves out.
  mkdir -p "$build_dir/mago/tmp"

  # Every test binary starts at once, each in a process group of its own, so the cores a binary leaves while its last
  # long tests run go to the others: one after another they took 656 s of MACOS job 137183706579, 348 s of them
  # sharp/mago's main, whose law proofs held about 4 of the Mac's 12 cores for 1,437.5 CPU-seconds. Only that binary
  # writes below CARGO_TARGET_TMPDIR. Each binary's output and its wall and CPU-seconds print once it ends, in binary
  # order, so the logs don't mix.
  part "the workspace's test binaries, all at once"
  started=()
  index=0
  for binary in "${binaries[@]}"; do
    executable="${binary%%$'\t'*}"
    folder="${binary#*$'\t'}"
    skips=()
    selected=0
    while IFS= read -r name; do
      if [[ -z $shard ]] || (( index % shard_count == shard_index - 1 )); then
        selected=$((selected + 1))
      else
        skips+=(--skip "$name")
      fi
      index=$((index + 1))
    done < <(cd "$folder" && "$executable" --list --format terse | sed -n 's/: test$//p')
    if (( selected > 0 )); then
      # libtest prints each test's own wall time after its result with --report-time, which stable Rust's libtest
      # takes only under RUSTC_BOOTSTRAP. libtest-mimic's harness, which the binaries with harness = false use, has no
      # such option, and its --help doesn't name it.
      command=("$executable")
      if [[ $("$executable" --help) == *--report-time* ]]; then
        command=(env RUSTC_BOOTSTRAP=1 "$executable" -Z unstable-options --report-time)
      fi
      log="$TMPDIR/test-binary-${#started[@]}"
      set -m
      # Without errexit, time reports on a binary that fails too, and the subshell exits with the binary's status. time
      # reports nothing on a subshell that execs its command, so the binary runs as the subshell's child.
      (
        set +e
        TIMEFORMAT='%3R %3U %3S'
        { time (cd "$folder" && "${command[@]}" --exact --test-threads "$jobs" "${skips[@]}" > "$log.out" 2>&1); } \
          2> "$log.time"
      ) &
      tests_groups+=("$!")
      set +m
      started+=("$!"$'\t'"${executable##*/}"$'\t'"$selected tests of ${executable##*/}, from ${folder#"$root"/}"$'\t'"$log")
    fi
  done
  for entry in "${started[@]}"; do
    IFS=$'\t' read -r pid step heading log <<< "$entry"
    if ! wait "$pid"; then
      failed+=("$step")
    fi
    echo "== $heading"
    cat "$log.out"
    read -r wall user_seconds system_seconds < "$log.time"
    # mawk, the awk of the sharp/docker image, refuses a variable named system, its builtin.
    awk -v heading="$heading" -v wall="$wall" -v user_seconds="$user_seconds" -v system_seconds="$system_seconds" \
      'BEGIN { printf "%s took %.1f s and %.1f CPU-seconds.\n", heading, wall, user_seconds + system_seconds }'
  done
  tests_groups=()
  part
  if $build && { [[ -z $shard ]] || (( shard_index == shard_count )); }; then
    cargo="$(cd "$root/ext/sharp" && rustup which cargo)"
    part "the doc tests"
    run_step "the doc tests" "$root" env PATH="$(dirname "$cargo"):$PATH" "$cargo" test --workspace --locked --doc \
      --manifest-path "$root/sharp/mago/Cargo.toml" --target-dir "$build_dir/mago" --jobs "$jobs" -- --test-threads "$jobs"
    part "mago-codex's property tests"
    run_step "mago-codex's property tests" "$root" env PATH="$(dirname "$cargo"):$PATH" "$cargo" test -p mago-codex \
      --features property-tests --locked --manifest-path "$root/sharp/mago/Cargo.toml" --target-dir "$build_dir/mago" \
      --jobs "$jobs" -- --test-threads "$jobs"
  fi
  finish
fi

# sharp/baseline/linux holds the upstream results of the Linux engine CI's UPSTREAM runs.
if $upstream && [[ $os != linux ]]; then
  echo "The upstream tests run on Linux, as CI's UPSTREAM runs them. Run sharp/bin/test --linux --upstream." >&2
  exit 2
fi

# The whole-project proof of mago convert runs after the PHP# suite, on this build's engine, with the fixture's
# refinement worker on the php the PATH holds: in the run of the whole suite, and in the one slice the slices give it.
proof=sharp/mago/crates/converter/tests/project.sh
run_proof=false
if $upstream; then
  tests=(Zend/tests ext/reflection ext/tokenizer ext/opcache)
elif [[ -n $shard ]]; then
  # The slices balance by the seconds sharp/baseline/seconds lists, from CI's slow-test summaries: a test's seconds
  # summed over the modes, and the proof's own, which hold the whole slice while it runs, so it weighs them times
  # the workers. A test the file doesn't list ran under a second in each mode, so it weighs 1. Each item, heaviest
  # first, goes to the slice that weighs least so far, so every slice computes the same split.
  declare -A seconds=()
  while IFS=$'\t' read -r weight path; do
    seconds[$path]=$weight
  done < "$root/sharp/baseline/seconds"
  items=()
  while read -r test; do
    items+=("${seconds[$test]:-1} $test")
  done < <(cd "$root" && find Zend/tests/sharp -name '*.phpt')
  items+=("$((${seconds[$proof]} * jobs)) $proof")
  mapfile -t items < <(printf '%s\n' "${items[@]}" | LC_ALL=C sort -k1,1nr -k2,2)
  loads=()
  for ((slice = 0; slice < shard_count; slice++)); do
    loads[slice]=0
  done
  for item in "${items[@]}"; do
    lightest=0
    for ((slice = 1; slice < shard_count; slice++)); do
      if ((loads[slice] < loads[lightest])); then
        lightest=$slice
      fi
    done
    loads[lightest]=$((loads[lightest] + ${item%% *}))
    if ((lightest == shard_index - 1)); then
      if [[ ${item#* } == "$proof" ]]; then
        run_proof=true
      else
        tests+=("${item#* }")
      fi
    fi
  done
elif [[ ${#tests[@]} -eq 0 ]]; then
  tests=(Zend/tests/sharp)
  run_proof=true
fi

php="$build_dir/sapi/cli/php"
if [[ ! -x "$php" ]]; then
  echo "$php is missing. Run sharp/bin/build first." >&2
  exit 1
fi

# A build folder an older sharp/bin/build configured can hold an engine without thread safety, which PHP# no longer
# runs, at the tree's version, the root package's in sharp/mago/Cargo.toml.
version="$(sed -n '/^version = /{s/^version = "\(.*\)"$/\1/p;q;}' "$root/sharp/mago/Cargo.toml")"
engine_version="$("$php" -n --ri sharp | sed -n 's/^Version => //p')"
if [[ "$engine_version" != "$version" || "$("$php" -n -r 'echo PHP_ZTS;')" != 1 ]]; then
  echo "The engine $php is $engine_version$("$php" -n -r 'echo PHP_ZTS ? "" : " without thread safety";'), but the tree is the thread-safe $version. Run sharp/bin/build." >&2
  exit 1
fi

if $build; then
  part "sharp/bin/build-mago"
  "$root/sharp/bin/build-mago" --quiet
fi
mago="$build_dir/mago/debug/mago"
if [[ ! -x $mago ]]; then
  echo "$mago is missing. Run sharp/bin/build-mago first." >&2
  exit 1
fi

# Zend/tests/sharp is a project shaped like an application: the tests load their PHP# fixtures through Composer's
# autoloader and the PHP# package's, from the packages its composer.lock pins, and mago compile checks the project with
# its vendor folder. The PHP# package is a copy of sharp/composer, as an application installs it, since a compile
# refuses a link outside the project. Composer keeps the copy an earlier run installed while the lock is unchanged, so
# a copy that differs from sharp/composer is reinstalled first, and the install then dumps the autoloader, which runs
# the package's plugin: composer reinstall runs no plugin.
part "composer install in Zend/tests/sharp"
package="$root/Zend/tests/sharp/vendor/heyjordanparker/php-sharp-composer"
if [[ -d $package ]] && ! diff -rq "$root/sharp/composer" "$package" > /dev/null \
  && ! composer reinstall --no-interaction --no-progress --quiet --no-autoloader \
    --working-dir="$root/Zend/tests/sharp" heyjordanparker/php-sharp-composer; then
  echo "composer reinstall of heyjordanparker/php-sharp-composer failed in Zend/tests/sharp." >&2
  exit 1
fi
if ! composer install --no-interaction --no-progress --quiet --working-dir="$root/Zend/tests/sharp"; then
  echo "composer install failed in Zend/tests/sharp, and the tests load their fixtures through its autoloader." >&2
  exit 1
fi

part "mago compile, built from sharp/mago"
if ! "$mago" --no-version-check --colors never --workspace "$root/Zend/tests/sharp" compile; then
  echo "mago compile refused a PHP# test fixture, and the engine runs only compiled files." >&2
  exit 1
fi

export TEST_MAGO_EXECUTABLE="$mago"

export SKIP_IO_CAPTURE_TESTS=1
export STACK_LIMIT_DEFAULTS_CHECK=1
export RUN_RESOURCE_HEAVY_TESTS=1

run_tests() {
  local mode="$1"
  shift
  part "$mode"
  run_step "$mode" "$root" "$php" run-tests.php -P -q \
    -d opcache.jit=disable \
    -d opcache.protect_memory=1 \
    -j"$jobs" \
    -g FAIL,BORK,LEAK,XLEAK \
    --no-progress \
    --offline \
    --show-diff \
    --show-slow 1000 \
    --set-timeout 120 \
    "$@" "${tests[@]}"
}

if $upstream; then
  baseline=sharp/baseline/linux
  results="$build_dir/upstream-results"
  run_tests "without opcache, compared with $baseline" -W "$results"
  awk -F '\t' -v OFS='\t' -v prefix="$root/" '
    $1 != "PASSED" {
      if (index($2, prefix) == 1) $2 = substr($2, length(prefix) + 1)
      print
    }' "$results" | LC_ALL=C sort -o "$results"
  if ! diff -u "$root/$baseline" "$results"; then
    echo "The upstream results differ from $baseline. Only the Architect accepts a new baseline, with: cp ${results#"$root"/} $baseline" >&2
    failed+=("the comparison with $baseline")
  fi
else
  # The PHP# suite runs in the four ways production runs the engine: without opcache, in opcache shared memory with
  # each test twice in one process, under the function JIT, which compiles each function of a file as the file loads,
  # and under the tracing JIT, with every hot counter at 1, so it compiles the code the tests run as soon as it runs.
  # Each expects the output of the run without opcache. Apple silicon has no thread-safe JIT, as ext/opcache/config.m4
  # warns, so macOS runs the first two.
  run_tests "without opcache"
  run_tests "with opcache shared memory, running each test twice in one process" -d opcache.enable_cli=1 --repeat 2
  if [[ $os == linux ]]; then
    run_tests "with the function JIT" -d opcache.enable_cli=1 -d opcache.jit=function -d opcache.jit_buffer_size=32M
    run_tests "with the tracing JIT" -d opcache.enable_cli=1 -d opcache.jit=tracing -d opcache.jit_buffer_size=32M \
      -d opcache.jit_hot_func=1 -d opcache.jit_hot_loop=1 -d opcache.jit_hot_return=1 -d opcache.jit_hot_side_exit=1
  fi
fi

if $census; then
  part "every write and comparison of a field that holds a PHP# mark"
  run_step "the census of PHP# marks" "$root" "$php" sharp/bin/census
fi

if $spec; then
  part "every rule of sharp/bin/spec, on the examples of sharp/spec-self-test.md"
  run_step "the self-test of sharp/bin/spec" "$root" "$php" sharp/bin/spec --self-test
  part "every code example in docs/spec.md and README.md, compared with sharp/baseline/spec"
  run_step "the code examples of docs/spec.md and README.md" "$root" "$php" sharp/bin/spec
fi

# One php -l lints every fixture, each file in a request of its own, and ends each file's output with the line that
# says whether it compiled. A file passes when that line is all it printed, as when a php -l of its own linted it, where
# a process per fixture took 44 s on the Mac.
check_differential() {
  part "every file mago compile accepted against php -l, through its .sharpc file"
  local files=("$root"/Zend/tests/sharp/*/*.sharp) output line file linted='' index=0 mismatch=false
  output="$("$php" -l "${files[@]}" 2>&1)" || true
  while IFS= read -r line; do
    linted+="$line"$'\n'
    if ((index == ${#files[@]})); then
      continue
    fi
    file="${files[index]}"
    if [[ $line == "No syntax errors detected in $file" || $line == "Errors parsing $file" ]]; then
      if [[ $linted == "No syntax errors detected in $file"$'\n' ]]; then
        echo "COMPILES ${file#"$root"/}"
      else
        printf 'FAIL %s: mago compile accepts it and php -l does not.\n%s' "${file#"$root"/}" "$linted"
        mismatch=true
      fi
      linted=''
      index=$((index + 1))
    fi
  done <<< "$output"
  if [[ -n $linted ]] || ((index < ${#files[@]})); then
    printf 'FAIL php -l reported on %d of the %d files, then printed this.\n%s' "$index" "${#files[@]}" "$linted"
    mismatch=true
  fi
  if $mismatch; then
    failed+=("every file mago compile accepted against php -l")
  fi
}

if $differential; then
  check_differential
fi

# A PHP# test class runs with its file's test module under real PHPUnit, at the version sharp/phpunit/composer.lock
# pins: in PHPUnit's own process, in the child process of #[RunInSeparateProcess], and with every test in a child. The
# install starts from nothing installed, because Composer keeps the copy of sharp/composer an earlier run installed while
# the lock is unchanged, and the compile starts from nothing compiled, with the fixture's extension host, which loads
# vendor/autoload.php on the engine. composer run-script runs post-autoload-dump with no flags.
check_phpunit() {
  local project="$root/sharp/phpunit" isolation
  part "a PHP# test class under PHPUnit, in sharp/phpunit"
  rm -rf "$project/vendor" "$project/.sharp"
  if ! composer install --no-interaction --no-progress --quiet --working-dir="$project" \
    || ! composer run-script --no-interaction post-autoload-dump --working-dir="$project" \
    || ! PATH="$(dirname "$php"):$PATH" "$mago" --no-version-check --colors never --workspace "$project" compile; then
    failed+=("the PHPUnit fixture's install, post-autoload-dump and compile")
    return
  fi
  for isolation in "" --process-isolation; do
    if ! "$php" -d opcache.jit=disable "$project/vendor/bin/phpunit" --configuration "$project/phpunit.xml" \
      --testdox $isolation; then
      failed+=("PHPUnit ${isolation:-in one process}")
    fi
  done
}

if $phpunit; then
  check_phpunit
fi

if $run_proof; then
  part "mago convert on sharp/mago/crates/converter/tests/project"
  mkdir "$TMPDIR/convert" "$TMPDIR/convert/project"
  run_step "the whole-project proof of mago convert" "$root" "$proof" "$TMPDIR/convert/project"
fi

finish
