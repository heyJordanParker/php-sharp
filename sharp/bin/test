#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: sharp/bin/test [--linux] [--opcache] [--repeat] [--passes] [--census] [--differential] [--upstream | paths...]" >&2
  exit 2
}

root="$(cd "$(dirname "$0")/../.." && pwd)"
linux=false
opcache=false
repeat=false
passes=false
census=false
differential=false
upstream=false
tests=()
container_command=(sharp/bin/test)
for arg in "$@"; do
  case "$arg" in
    --linux) linux=true; continue ;;
    --opcache) opcache=true ;;
    --repeat) repeat=true ;;
    --passes) passes=true ;;
    --census) census=true ;;
    --differential) differential=true ;;
    --upstream) upstream=true ;;
    -*) usage ;;
    *) tests+=("$arg") ;;
  esac
  container_command+=("$arg")
done

if $upstream && [[ ${#tests[@]} -gt 0 ]]; then
  usage
fi

if $linux; then
  exec "$root/sharp/docker/run" "${container_command[@]}"
fi

if $upstream; then
  tests=(Zend/tests ext/reflection ext/tokenizer ext/opcache)
elif [[ ${#tests[@]} -eq 0 ]]; then
  tests=(Zend/tests/sharp)
fi

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
build_dir="$root/sharp/build/$os-$(uname -m)"
php="$build_dir/sapi/cli/php"
if [[ ! -x "$php" ]]; then
  echo "$php is missing. Run sharp/bin/build first." >&2
  exit 1
fi

mago_commit="$(sed -n 's/^#define SHARP_MAGO_COMMIT "\([0-9a-f]\{40\}\)"$/\1/p' "$root/ext/sharp/sharp_unit.h")"
if [[ -z "$mago_commit" ]]; then
  echo "ext/sharp/sharp_unit.h defines no SHARP_MAGO_COMMIT." >&2
  exit 1
fi
cargo="$(cd "$root/ext/sharp" && rustup which cargo)"
PATH="$(dirname "$cargo"):$PATH" "$cargo" install --quiet --locked --git https://github.com/heyJordanParker/mago-sharp --rev "$mago_commit" --root "$build_dir/mago" mago
mago="$build_dir/mago/bin/mago"

echo "== mago compile, at the Mago commit in ext/sharp/sharp_unit.h"
if ! "$mago" --no-version-check --colors never --workspace "$root/Zend/tests/sharp" compile; then
  echo "mago compile refused a PHP# test fixture, and the engine runs only compiled files." >&2
  exit 1
fi

export TEST_MAGO_EXECUTABLE="$mago"
export SKIP_IO_CAPTURE_TESTS=1
export STACK_LIMIT_DEFAULTS_CHECK=1
export RUN_RESOURCE_HEAVY_TESTS=1

# Every mode runs, and the script fails at the end if any mode failed.
failed=()

run_tests() {
  local mode="$1"
  shift
  echo "== $mode"
  if ! (cd "$root" && "$php" run-tests.php -P -q \
    -d opcache.jit=disable \
    -d opcache.protect_memory=1 \
    -j"$(getconf _NPROCESSORS_ONLN)" \
    -g FAIL,BORK,LEAK,XLEAK \
    --no-progress \
    --offline \
    --show-diff \
    --show-slow 1000 \
    --set-timeout 120 \
    "$@" "${tests[@]}"); then
    failed+=("$mode")
  fi
}

if $upstream; then
  baseline="sharp/baseline/$os"
  results="$build_dir/upstream-results"
  run_tests "without opcache, compared with $baseline" -W "$results"
  awk -F '\t' -v OFS='\t' -v prefix="$root/" '
    $1 != "PASSED" {
      if (index($2, prefix) == 1) $2 = substr($2, length(prefix) + 1)
      print
    }' "$results" | LC_ALL=C sort -o "$results"
  if ! diff -u "$root/$baseline" "$results"; then
    echo "The upstream results differ from $baseline. Only the Architect accepts a new baseline, with: cp ${results#"$root"/} $baseline" >&2
    failed+=("the comparison with $baseline")
  fi
else
  run_tests "without opcache"
fi

if $opcache; then
  run_tests "with the opcache file cache, priming it" -d opcache.enable_cli=1 --file-cache-prime
  run_tests "with the opcache file cache, using it" -d opcache.enable_cli=1 --file-cache-use
fi

if $repeat; then
  run_tests "with opcache shared memory, running each test twice in one process" -d opcache.enable_cli=1 --repeat 2
fi

# Every optimizer pass runs alone, and then each JIT, so a pass that drops a PHP# mark cannot hide
# behind another pass. Each run expects the same output as the run without opcache.
if $passes; then
  for ((pass = 0; pass < 16; pass++)); do
    run_tests "with optimizer pass $((pass + 1)) alone" -d opcache.enable_cli=1 -d "opcache.optimization_level=$((1 << pass))"
  done
  for jit in tracing function; do
    run_tests "with the $jit JIT" -d opcache.enable_cli=1 -d opcache.jit="$jit" -d opcache.jit_buffer_size=32M \
      -d opcache.jit_hot_func=1 -d opcache.jit_hot_loop=1 -d opcache.jit_hot_return=1 -d opcache.jit_hot_side_exit=1
  done
fi

if $census; then
  echo "== every write and comparison of a field that holds a PHP# mark"
  if ! "$php" "$root/sharp/bin/census"; then
    failed+=("the census of PHP# marks")
  fi
fi

check_differential() {
  echo "== every file mago compile accepted against php -l, through its .sharpc file"
  local file name linted mismatch=false
  for file in "$root"/Zend/tests/sharp/*.sharp; do
    name="${file#"$root"/}"
    linted="$("$php" -l "$file" 2>&1)" || true
    if [[ "$linted" == "No syntax errors detected in $file" ]]; then
      echo "COMPILES $name"
    else
      printf 'FAIL %s: mago compile accepts it and php -l does not.\n%s\n' "$name" "$linted"
      mismatch=true
    fi
  done
  if $mismatch; then
    failed+=("every file mago compile accepted against php -l")
  fi
}

if $differential; then
  check_differential
fi

if [[ ${#failed[@]} -gt 0 ]]; then
  printf 'Failed: %s\n' "${failed[@]}" >&2
  exit 1
fi
