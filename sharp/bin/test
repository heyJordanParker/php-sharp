#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: sharp/bin/test [--linux] [--zts | --installed] [--opcache] [--repeat] [--passes] [--census] [--spec] [--differential] [--phpunit] [--upstream | paths...]" >&2
  exit 2
}

root="$(cd "$(dirname "$0")/../.." && pwd)"
linux=false
zts=false
installed=false
opcache=false
repeat=false
passes=false
census=false
spec=false
differential=false
phpunit=false
upstream=false
tests=()
container_command=(sharp/bin/test)
for arg in "$@"; do
  case "$arg" in
    --linux) linux=true; continue ;;
    --zts) zts=true ;;
    --installed) installed=true ;;
    --opcache) opcache=true ;;
    --repeat) repeat=true ;;
    --passes) passes=true ;;
    --census) census=true ;;
    --spec) spec=true ;;
    --differential) differential=true ;;
    --phpunit) phpunit=true ;;
    --upstream) upstream=true ;;
    -*) usage ;;
    *) tests+=("$arg") ;;
  esac
  container_command+=("$arg")
done

if $upstream && [[ ${#tests[@]} -gt 0 ]]; then
  usage
fi
if $installed && { $linux || $zts; }; then
  usage
fi

if $linux; then
  exec "$root/sharp/docker/run" "${container_command[@]}"
fi

if $upstream; then
  tests=(Zend/tests ext/reflection ext/tokenizer ext/opcache)
elif [[ ${#tests[@]} -eq 0 ]]; then
  tests=(Zend/tests/sharp)
fi

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
build_dir="$root/sharp/build/$os-$(uname -m)"
# mago doesn't depend on thread safety, so both builds' tests use the one in the other build's folder.
mago_dir="$build_dir/mago"
rebuild="Run sharp/bin/build"
if $zts; then
  build_dir+=-zts
  rebuild+=" --zts"
fi
php="$build_dir/sapi/cli/php"
# The engine a runtime image installs runs with the php.ini and conf.d it ships, so the extensions they enable load.
if $installed; then
  php="$(command -v php)" || { echo "--installed tests the php on the PATH, and there is none." >&2; exit 1; }
  rebuild="Install this tree's engine"
fi
if [[ ! -x "$php" ]]; then
  echo "$php is missing. $rebuild first." >&2
  exit 1
fi

version="$(sed -n 's/^#define PHP_SHARP_VERSION "\(.*\)"$/\1/p' "$root/ext/sharp/php_sharp.h")"
engine_version="$("$php" -n --ri sharp | sed -n 's/^Version => //p')"
if [[ "$engine_version" != "$version" ]]; then
  echo "The engine $php is $engine_version, but the tree is $version. $rebuild." >&2
  exit 1
fi

jobs="${CARGO_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"
if [[ " ${MAKEFLAGS:-}" =~ [[:space:]](-j[[:space:]]*|--jobs=)([0-9]+) ]]; then
  jobs="${BASH_REMATCH[2]}"
fi

# mago builds in the test-run profile, which sharp/mago/Cargo.toml explains.
cargo="$(cd "$root/ext/sharp" && rustup which cargo)"
PATH="$(dirname "$cargo"):$PATH" "$cargo" build --quiet --locked --profile test-run --jobs "$jobs" \
  --manifest-path "$root/sharp/mago/Cargo.toml" --target-dir "$mago_dir" --bin mago
mago="$mago_dir/test-run/mago"

# run-tests.php writes each test's script beside it as <test>.php, and mago compile writes each PHP# class's companion
# beside its source as <Class>.php. A disk that ignores case, as macOS's does, keeps one file for both when the two
# names differ only in case, so each run would overwrite and delete the companion, and a stopped run would leave a
# script mago compile refuses. So no test shares the name of a PHP# file beside it.
clashed=false
shopt -s nocasematch
for test in "$root"/Zend/tests/sharp/*.phpt; do
  for fixture in "${test%/*}"/*.sharp; do
    if [[ "${fixture%.sharp}" == "${test%.phpt}" ]]; then
      script="${test%.phpt}.php"
      companion="${fixture%.sharp}.php"
      echo "${test#"$root"/} and ${fixture#"$root"/} differ only in case, so run-tests.php writes ${script##*/} where mago compile writes ${companion##*/}. Rename the test." >&2
      clashed=true
    fi
  done
done
shopt -u nocasematch
if $clashed; then
  exit 1
fi

echo "== mago compile, built from sharp/mago"
if ! "$mago" --no-version-check --colors never --workspace "$root" --config "$root/Zend/tests/sharp/mago.toml" compile; then
  echo "mago compile refused a PHP# test fixture, and the engine runs only compiled files." >&2
  exit 1
fi

export TEST_MAGO_EXECUTABLE="$mago"

export SKIP_IO_CAPTURE_TESTS=1
export STACK_LIMIT_DEFAULTS_CHECK=1
export RUN_RESOURCE_HEAVY_TESTS=1

# run-tests.php keeps the opcache file cache of --opcache in the temporary folder, as each test keeps its own files, and
# loads a file from it whose source looks unchanged. So each run takes a temporary folder of its own and removes it when
# it ends, and no run loads bytecode another run cached. run-tests.php runs in a process group of its own, so a run that
# ends early, as on SIGTERM, first stops it, its workers and their tests, which would go on writing in the folder.
TMPDIR="$(mktemp -d)"
export TMPDIR
tests_group=
trap 'if [[ -n $tests_group ]]; then kill -KILL -- "-$tests_group" || true; wait "$tests_group" || true; fi; rm -rf "$TMPDIR"' EXIT

# Every mode runs, and the script fails at the end if any mode failed.
failed=()

run_tests() {
  local mode="$1"
  shift
  echo "== $mode"
  set -m
  (cd "$root" && exec "$php" run-tests.php -P -q \
    -d opcache.jit=disable \
    -d opcache.protect_memory=1 \
    -j"$jobs" \
    -g FAIL,BORK,LEAK,XLEAK \
    --no-progress \
    --offline \
    --show-diff \
    --show-slow 1000 \
    --set-timeout 120 \
    "$@" "${tests[@]}") &
  tests_group=$!
  set +m
  if ! wait "$tests_group"; then
    failed+=("$mode")
  fi
  tests_group=
}

if $upstream; then
  baseline="sharp/baseline/$os"
  results="$build_dir/upstream-results"
  run_tests "without opcache, compared with $baseline" -W "$results"
  awk -F '\t' -v OFS='\t' -v prefix="$root/" '
    $1 != "PASSED" {
      if (index($2, prefix) == 1) $2 = substr($2, length(prefix) + 1)
      print
    }' "$results" | LC_ALL=C sort -o "$results"
  if ! diff -u "$root/$baseline" "$results"; then
    echo "The upstream results differ from $baseline. Only the Architect accepts a new baseline, with: cp ${results#"$root"/} $baseline" >&2
    failed+=("the comparison with $baseline")
  fi
else
  run_tests "without opcache"
fi

if $opcache; then
  run_tests "with the opcache file cache, priming it" -d opcache.enable_cli=1 --file-cache-prime
  run_tests "with the opcache file cache, using it" -d opcache.enable_cli=1 --file-cache-use
fi

if $repeat; then
  run_tests "with opcache shared memory, running each test twice in one process" -d opcache.enable_cli=1 --repeat 2
fi

# Every optimizer pass runs alone, and then each JIT, so a pass that drops a PHP# mark cannot hide
# behind another pass. Each run expects the same output as the run without opcache.
if $passes; then
  for ((pass = 0; pass < 16; pass++)); do
    run_tests "with optimizer pass $((pass + 1)) alone" -d opcache.enable_cli=1 -d "opcache.optimization_level=$((1 << pass))"
  done
  for jit in tracing function; do
    run_tests "with the $jit JIT" -d opcache.enable_cli=1 -d opcache.jit="$jit" -d opcache.jit_buffer_size=32M \
      -d opcache.jit_hot_func=1 -d opcache.jit_hot_loop=1 -d opcache.jit_hot_return=1 -d opcache.jit_hot_side_exit=1
  done
fi

if $census; then
  echo "== every write and comparison of a field that holds a PHP# mark"
  if ! "$php" "$root/sharp/bin/census"; then
    failed+=("the census of PHP# marks")
  fi
fi

if $spec; then
  echo "== every rule of sharp/bin/spec, on the examples of sharp/spec-self-test.md"
  if ! "$php" "$root/sharp/bin/spec" --self-test; then
    failed+=("the self-test of sharp/bin/spec")
  fi
  echo "== every code example in docs/spec.md and README.md, compared with sharp/baseline/spec"
  if ! "$php" "$root/sharp/bin/spec"; then
    failed+=("the code examples of docs/spec.md and README.md")
  fi
fi

check_differential() {
  echo "== every file mago compile accepted against php -l, through its .sharpc file"
  local file name linted mismatch=false
  for file in "$root"/Zend/tests/sharp/*.sharp "$root"/Zend/tests/sharp/*/*.sharp; do
    name="${file#"$root"/}"
    linted="$("$php" -l "$file" 2>&1)" || true
    if [[ "$linted" == "No syntax errors detected in $file" ]]; then
      echo "COMPILES $name"
    else
      printf 'FAIL %s: mago compile accepts it and php -l does not.\n%s\n' "$name" "$linted"
      mismatch=true
    fi
  done
  if $mismatch; then
    failed+=("every file mago compile accepted against php -l")
  fi
}

if $differential; then
  check_differential
fi

# A PHP# test class runs with its file's test module under real PHPUnit, at the version sharp/phpunit/composer.lock
# pins: in PHPUnit's own process, in the child process of #[RunInSeparateProcess], and with every test in a child. The
# install starts from nothing installed, because Composer keeps the copy of sharp/composer an earlier run installed while
# the lock is unchanged, and the compile starts from nothing compiled, with the fixture's extension host, which loads
# vendor/autoload.php on the engine. composer run-script runs post-autoload-dump with no flags.
check_phpunit() {
  local project="$root/sharp/phpunit" isolation
  echo "== a PHP# test class under PHPUnit, in sharp/phpunit"
  rm -rf "$project/vendor" "$project/.sharp"
  if ! composer install --no-interaction --no-progress --quiet --working-dir="$project" \
    || ! composer run-script --no-interaction post-autoload-dump --working-dir="$project" \
    || ! PATH="$(dirname "$php"):$PATH" "$mago" --no-version-check --colors never --workspace "$project" compile; then
    failed+=("the PHPUnit fixture's install, post-autoload-dump and compile")
    return
  fi
  for isolation in "" --process-isolation; do
    if ! "$php" -d opcache.jit=disable "$project/vendor/bin/phpunit" --configuration "$project/phpunit.xml" \
      --testdox $isolation; then
      failed+=("PHPUnit ${isolation:-in one process}")
    fi
  done
}

if $phpunit; then
  check_phpunit
fi

if [[ ${#failed[@]} -gt 0 ]]; then
  printf 'Failed: %s\n' "${failed[@]}" >&2
  exit 1
fi
