#!/usr/bin/env bash
# shellcheck disable=SC2329 # The pool runs run_step and each unit's function by eval.
set -euo pipefail

usage() {
  echo "usage: sharp/bin/test [--linux] [--no-build] [--census] [--spec] [--differential] [--phpunit] [--shard <i>/<n> | paths...]" >&2
  echo "       sharp/bin/test [--linux] [--no-build] --upstream" >&2
  echo "       sharp/bin/test [--linux] [--no-build] --mago [--shard <i>/<n>]" >&2
  echo "       sharp/bin/test [--linux] [--no-build] --mago [--census] [--spec] [--differential] [--phpunit]" >&2
  echo "       sharp/bin/test [--linux] --mago --cargo-built" >&2
  echo "       sharp/bin/test [--linux] [--no-build] --examples [--shard <i>/<n>]" >&2
  exit 2
}

root="$(cd "$(dirname "$0")/../.." && pwd)"
# Each run leaves its line in the build record, with each part's under it, see sharp/bin/record.
[[ ${SHARP_RECORDED:-} == sharp/bin/test ]] || exec "$root/sharp/bin/record" sharp/bin/test -- "$0" "$@"
linux=false
# --no-build runs on the mago and the test binaries an earlier sharp/bin/build-mago made, as CI's suites run on their
# build job's, and builds nothing.
build=true
census=false
spec=false
differential=false
phpunit=false
upstream=false
mago=false
cargo_built=false
examples=false
shard=
tests=()
container_command=(sharp/bin/test)
args=("$@")
for ((a = 0; a < ${#args[@]}; a++)); do
  arg="${args[a]}"
  case "$arg" in
    --linux) linux=true; continue ;;
    --no-build) build=false ;;
    --shard) a=$((a + 1)); shard="${args[a]:-}"; container_command+=(--shard "$shard"); continue ;;
    --census) census=true ;;
    --spec) spec=true ;;
    --differential) differential=true ;;
    --phpunit) phpunit=true ;;
    --upstream) upstream=true ;;
    --mago) mago=true ;;
    --cargo-built) cargo_built=true ;;
    --examples) examples=true ;;
    -*) usage ;;
    *) tests+=("$arg") ;;
  esac
  container_command+=("$arg")
done

if { $upstream || $mago; } && [[ ${#tests[@]} -gt 0 ]] || { $upstream && $mago; }; then
  usage
fi
if $upstream && { $census || $spec || $differential || $phpunit; }; then
  usage
fi
# --mago with any of the suite's options runs mago's workspace tests and the PHP# suite in one pool, as the Mac's job
# runs them.
suite=true
if $mago && ! $census && ! $spec && ! $differential && ! $phpunit; then
  suite=false
fi
if $mago && $suite && [[ -n $shard ]]; then
  usage
fi
if $cargo_built && { ! $mago || $suite || ! $build || [[ -n $shard ]]; }; then
  usage
fi
# --examples runs the code examples alone, the part of the run --spec adds, and --shard slices them.
if $examples && { $mago || $upstream || $census || $spec || $differential || $phpunit || ((${#tests[@]})); }; then
  usage
fi
named=("${tests[@]}")
# A run of every test is six parts, each of which a run of its own runs alone, on the same units: the doc tests and
# the property tests, mago's workspace tests in part_slices slices, the PHP# suite with its checks and the proof of
# mago convert, and the code examples in part_slices slices. On the Mac each ran within 5 minutes when #816 replayed
# the pools of four runs: 199 to 240 s for a slice of the workspace tests, 182 to 250 s for the suite, and 155 to 212 s
# for a slice of the examples.
part_slices=2
# --shard <i>/<n> runs the i-th of n slices, so n jobs that run the same modes together run each test once.
if [[ -n $shard ]]; then
  if $upstream || [[ ${#tests[@]} -gt 0 || ! $shard =~ ^([1-9][0-9]*)/([1-9][0-9]*)$ ]] || (( BASH_REMATCH[1] > BASH_REMATCH[2] )); then
    usage
  fi
  shard_index=${BASH_REMATCH[1]}
  shard_count=${BASH_REMATCH[2]}
fi

if $linux; then
  exec "$root/sharp/docker/run" "${container_command[@]}"
fi

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
build_dir="$root/sharp/build/$os-$(uname -m)"
jobs="$("$root/sharp/bin/jobs")"

# Each run keeps its own files in a temporary folder of its own and removes it when it ends, so no run reads what
# another run wrote. Each unit of the pool runs in a process group of its own, so a run that ends early, as on SIGTERM,
# first stops every unit still running, with its tests, which would go on writing in the folder.
TMPDIR="$(mktemp -d)"
export TMPDIR
# Each `mago` a test starts runs on one thread, so a run's load is its test threads. A test about threads passes
# --threads, which wins over MAGO_THREADS.
export MAGO_THREADS=1
declare -A running=()
trap 'for group in "${!running[@]}"; do kill -KILL -- "-$group" 2> /dev/null || true; done; wait || true; rm -rf "$TMPDIR"' EXIT

# Every step runs, and the script fails at the end if any step failed.
failed=()

# The seconds sharp/baseline/seconds lists for each slow test, by its path, which the slices of --shard balance by:
# a .phpt test's path, the whole-project proof of mago convert, and a Mago test's binary source file and name.
declare -A seconds=()
proof=sharp/mago/crates/converter/tests/project.sh
read_seconds() {
  local weight path
  while IFS=$'\t' read -r weight path; do
    seconds[$path]=$weight
  done < "$root/sharp/baseline/seconds"
}

# Runs the command from the folder, in the process group of the unit that runs it, and records the step as failed when
# it fails.
run_step() {
  local step="$1" folder="$2"
  shift 2
  if ! (cd "$folder" && exec "$@"); then
    failed+=("$step")
  fi
}

# Ends the part of the run under way with its wall seconds and the CPU-seconds the shell and the processes it waited
# for used in it, as bash's times counts them, so a change to one part is judged by that part whatever else the machine
# runs, and writes its line to the build record, as failed when a step of it failed. Then it starts the part its heading
# names, if any, from after that write, so the recorder's own time counts in neither part. Each unit of the pool runs
# in a shell of its own, whose times count only what that unit ran. A unit names the file part_times, where the part
# writes its start and end, in microseconds, and its CPU milliseconds, which the run's report reads.
part_times=''
part_heading=''
part_started=0
part_cpu=0
part_failed=0
reported_units=0
part_clock() {
  local time
  now="${EPOCHREALTIME/[^0-9]/}"
  cpu=0
  times > "$TMPDIR/sharp-bin-test-times.$BASHPID"
  for time in $(< "$TMPDIR/sharp-bin-test-times.$BASHPID"); do
    [[ $time =~ ^([0-9]+)m([0-9]+)[.,]([0-9]{3})s$ ]]
    cpu=$((cpu + (BASH_REMATCH[1] * 60 + BASH_REMATCH[2]) * 1000 + 10#${BASH_REMATCH[3]}))
  done
}
part() {
  local now cpu wall used
  part_clock
  if [[ -n $part_heading ]]; then
    wall=$(((now - part_started) / 100000))
    used=$(((cpu - part_cpu) / 100))
    printf '%s took %d.%d s and %d.%d CPU-seconds.\n' "$part_heading" $((wall / 10)) $((wall % 10)) $((used / 10)) $((used % 10))
    if [[ -n $part_times ]]; then
      printf '%s\t%s\t%s\n' "$part_started" "$now" "$((cpu - part_cpu))" > "$part_times"
    else
      report_part "$((cpu - part_cpu))"
    fi
    "$root/sharp/bin/record" "$part_heading" --measured "${part_started:0:${#part_started}-6}.${part_started: -6}" \
      "$((used / 10)).$((used % 10))" '' "$((${#failed[@]} > part_failed))"
    part_clock
  fi
  part_heading="${1:-}"
  part_started=$now
  part_cpu=$cpu
  part_failed=${#failed[@]}
  if [[ -n $part_heading ]]; then
    echo "== $part_heading"
  fi
}

# On macOS a run builds one engine, the debug one CI's Mac job builds, runs every suite on and links mago with, in
# sharp/build/<os>-<arch> beside its php and phpdbg, so no other engine build empties that folder (#851). The sharp/docker
# image's run tests the engine sharp/bin/build built there.
if [[ $os == darwin ]]; then
  export MAGO_ENGINE="${MAGO_ENGINE:-$build_dir/install}"
  if $build; then
    part "sharp/bin/build-mago --engine --debug"
    "$root/sharp/bin/build-mago" --engine --debug
  fi
fi

# One pool of the run's jobs runs every test of the run, both lanes of the Mac's job among them, as cargo-nextest runs a
# workspace: a slot runs one process on one thread with a list of tests, and the heaviest unit waiting starts the
# moment a slot frees, so the run holds at most its jobs threads and no slot idles while a unit waits. A test
# sharp/baseline/seconds lists runs alone, and the tests it doesn't list run in lists of 100: a process sets up what
# its tests share once, and one process per test cost the analyzer's integration tests 0.513 CPU-seconds a test, about
# 2,057 over their 4,012, where they used 493 (#736). A unit weighs its tests' seconds, 1 for each test the file
# doesn't list, as --shard weighs them, and units that weigh the same start in the order they were added. When every
# part of a run started at once on all of the Mac's 12 cores, a test ran past run-tests' 120 s timeout on run
# 45315093503, and one part after another the Mac's test step took 1,251 to 1,442 s while each part's last tests ran.
batch=100
unit_count=0
unit_weight=()
unit_heading=()
unit_step=()
unit_folder=()
unit_command=()
unit_then=()
unit_keys=()
unit_part=()
unit_junit=()
unit_results=()
unit_mode=()
queued=()
sorted=true
# The part of the run the units added next belong to: its name, a tab, and the command that runs it alone.
adding=''
# Sets the part the units added next belong to: its name, and the options of the command that runs it alone, which
# builds nothing when this run builds nothing.
adding_part() {
  local name=$1 options=''
  shift
  if ! $build; then
    options=' --no-build'
  fi
  if (($#)); then
    options+=$(printf ' %q' "$@")
  fi
  adding="$name"$'\t'"sharp/bin/test$options"
}
# Adds a unit of the part adding_part set: its weight, its heading, the step its failure names, the folder it runs in
# and its command, or, with no step, a function of this script and its arguments. It waits until ready_unit queues it,
# or the unit then_unit names ends. Sets unit to its index.
add_unit() {
  unit=$unit_count
  unit_weight[unit]=$1
  unit_heading[unit]=$2
  unit_step[unit]=$3
  unit_folder[unit]=$4
  shift 4
  unit_command[unit]="$(printf '%q ' "$@")"
  unit_then[unit]=''
  unit_keys[unit]=''
  unit_part[unit]=$adding
  unit_junit[unit]=''
  unit_results[unit]=''
  unit_mode[unit]=''
  unit_count=$((unit_count + 1))
}
# A failed step of the unit, with the part the unit belongs to and the command that runs that part alone.
in_part() {
  printf '%s, in %s, which %s runs alone' "$1" "${unit_part[$2]%%$'\t'*}" "${unit_part[$2]#*$'\t'}"
}
# Gives the unit the conflict keys its tests hold, as run-tests.php reads them: while a unit holds a key, no unit that
# holds it starts, and a unit that holds all runs alone. Each unit runs run-tests.php on one thread, which runs its own
# tests one at a time, so the keys need holding only across units. Without them two units ran tests that each serve
# PHP's built-in server on port 8964, and ext/opcache/tests/bug78106.phpt printed "Server is not running" on run
# 45412167180, where run-tests.php -j<jobs> had kept them apart.
hold_keys() {
  unit_keys[$1]=$2
}
# Whether no running unit holds a key the unit holds, and no running unit holds all, or nothing runs.
unit_free() {
  local r key held=' '
  for r in "${running[@]}"; do
    held+="${unit_keys[r]} "
  done
  if [[ $held == *" all "* ]]; then
    return 1
  fi
  if [[ " ${unit_keys[$1]} " == *" all "* ]]; then
    ((${#running[@]} == 0))
    return
  fi
  for key in ${unit_keys[$1]}; do
    if [[ $held == *" $key "* ]]; then
      return 1
    fi
  done
}
ready_unit() {
  queued+=("$1")
  sorted=false
}
# Queues the second unit when the first ends.
then_unit() {
  unit_then[$1]+=" $2"
}
start_unit() {
  local u=$1 output="$TMPDIR/unit-$1" step=${unit_step[$1]} folder=${unit_folder[$1]}
  set -m
  (
    # shellcheck disable=SC2030 # The unit's own failed steps, which run_pool reads from its file.
    failed=()
    # Every git a test starts reads no system or global git config, as Git's own test suite runs it, so a developer's
    # config, such as signed commits, changes no test, and each test that commits names its own author (#1067).
    export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
    part_times="$output.time"
    part "${unit_heading[u]}"
    if [[ -n $step ]]; then
      eval "run_step \"\$step\" \"\$folder\" ${unit_command[u]}"
    else
      eval "${unit_command[u]}"
    fi
    part
    if ((${#failed[@]})); then
      printf '%s\n' "${failed[@]}"
    fi > "$output.failed"
  ) > "$output" 2>&1 &
  set +m
  running[$!]=$u
}
# Runs every queued unit, and each one a unit that ends queues, and prints each one's output whole as it ends, so two
# units' lines never mix. A unit's failed steps join the run's, and a unit that stops before it ends fails as its
# heading.
run_pool() {
  local pid u q status next reported step peak=0
  part
  if ((unit_count == 0)); then
    return
  fi
  echo "== $unit_count units on $jobs slots"
  while ((${#queued[@]} || ${#running[@]})); do
    if ((${#queued[@]} && ${#running[@]} < jobs)); then
      if ! $sorted; then
        mapfile -t queued < <(for u in "${queued[@]}"; do printf '%s %s\n' "${unit_weight[u]}" "$u"; done \
          | LC_ALL=C sort -k1,1nr -k2,2n | cut -d ' ' -f 2)
        sorted=true
      fi
      # The heaviest queued unit that no running unit's keys hold back starts.
      while ((${#queued[@]} && ${#running[@]} < jobs)); do
        for ((q = 0; q < ${#queued[@]}; q++)); do
          if unit_free "${queued[q]}"; then
            break
          fi
        done
        if ((q == ${#queued[@]})); then
          break
        fi
        start_unit "${queued[q]}"
        queued=("${queued[@]:0:q}" "${queued[@]:q+1}")
      done
    fi
    if ((${#running[@]} > peak)); then
      peak=${#running[@]}
    fi
    status=0
    wait -n -p pid "${!running[@]}" || status=$?
    u=${running[$pid]}
    unset "running[$pid]"
    cat "$TMPDIR/unit-$u"
    reported=()
    if [[ -f $TMPDIR/unit-$u.failed ]]; then
      mapfile -t reported < "$TMPDIR/unit-$u.failed"
    fi
    # A failed run-tests batch names each test that failed in it, from the results run-tests.php wrote, where its heading
    # names only the batch's first file: run 45817904815 printed "55 tests from …plain_declared_class_closures.phpt" for
    # a failed type_arguments_entry_collection.phpt (#943). A batch that failed with no test failing keeps its heading.
    if ((status != 0 || ${#reported[@]})) && [[ -n ${unit_results[u]} && -f ${unit_results[u]} ]]; then
      mapfile -t tests < <(awk -F '\t' -v mode="${unit_mode[u]}" \
        '$1 == "FAILED" || $1 == "BORKED" || $1 == "LEAKED" { print mode ": " $2 }' "${unit_results[u]}")
      if ((${#tests[@]})); then
        reported=("${tests[@]}")
      fi
    fi
    if ((status != 0 && ${#reported[@]} == 0)); then
      reported=("${unit_heading[u]}")
    fi
    for step in "${reported[@]}"; do
      # shellcheck disable=SC2031 # The run's own failed steps, which the unit's join.
      failed+=("$(in_part "$step" "$u")")
    done
    report_unit "$u" "${reported[@]}"
    for next in ${unit_then[u]}; do
      ready_unit "$next"
    done
  done
  echo "The pool ran $unit_count units, at most $peak at once, on $jobs slots."
  unit_count=0
  unit_weight=()
  unit_heading=()
  unit_step=()
  unit_folder=()
  unit_command=()
  unit_then=()
  unit_keys=()
  unit_part=()
  unit_junit=()
  unit_results=()
  unit_mode=()
}

# The run's report, sharp/build/test-report.xml in the JUnit XML format, which CI's test jobs upload, so each suite's and
# each test's time can be read on its own where the timeline shows one step for all of them (#855): one testsuite for
# each part of the run, with its wall time from its first unit's start to its last unit's end in the pool and its
# CPU-seconds, and one testcase for each test, with its own time, from run-tests.php's JUnit file for a .phpt test and
# from libtest's --report-time for a Rust test. A unit whose runner gives no time for each test it runs, as libtest-mimic's
# harness gives none, and a unit that runs one check are one testcase each, with the unit's time. A unit's files move
# under the run's count of units, since each pool numbers its units from 0. A part the main shell runs outside the pool,
# as a composer install or the compile of the fixtures, is a unit of one check too, so the report's suites cover the
# whole run (#905).
report_unit() {
  local u=$1 kept="$TMPDIR/report-$reported_units"
  shift
  mv "$TMPDIR/unit-$u" "$kept.out"
  rm -f "$TMPDIR/unit-$u.failed"
  if [[ -f $TMPDIR/unit-$u.time ]]; then
    mv "$TMPDIR/unit-$u.time" "$kept.time"
  fi
  if [[ -n ${unit_junit[u]} && -f ${unit_junit[u]} ]]; then
    mv "${unit_junit[u]}" "$kept.junit"
  fi
  if (($#)); then
    printf '%s\n' "$@" > "$kept.failed"
  fi
  printf '%s\t%s\t%s\t%s\n' "$reported_units" "${unit_part[u]%%$'\t'*}" "${unit_part[u]#*$'\t'}" "${unit_heading[u]}" \
    >> "$TMPDIR/report"
  reported_units=$((reported_units + 1))
}
# Reports the part part() ends outside the pool, with its CPU milliseconds: the times a unit's part_times holds, its
# failed steps, and the run's own command, the one that runs it.
report_part() {
  local kept="$TMPDIR/report-$reported_units"
  printf '%s\t%s\t%s\n' "$part_started" "$now" "$1" > "$kept.time"
  : > "$kept.out"
  if ((${#failed[@]} > part_failed)); then
    printf '%s\n' "${failed[@]:part_failed}" > "$kept.failed"
  fi
  printf '%s\t%s\t%s\t%s\n' "$reported_units" "$part_heading" \
    "sharp/bin/test${args[*]:+$(printf ' %q' "${args[@]}")}" "$part_heading" >> "$TMPDIR/report"
  reported_units=$((reported_units + 1))
}
# Writes the report with the PATH's php, which every run has, since Composer runs on it, and its DOM: the build's engine
# is missing where a job runs only Mago's test binaries, as MAGO's slices do, and the sharp/docker image's Debian php-cli
# loads DOM from php-xml's ini, so it runs with its ini.
write_report() {
  local report="$root/sharp/build/test-report.xml"
  if [[ ! -s $TMPDIR/report ]]; then
    return
  fi
  if ! php -d memory_limit=-1 -- "$TMPDIR" "$report" <<'PHP'
<?php
declare(strict_types=1);

[, $folder, $report] = $argv;
$xml = new DOMDocument('1.0', 'UTF-8');
$xml->formatOutput = true;
$root = $xml->appendChild($xml->createElement('testsuites'));

// Each part's units, in the order their first unit ended.
$parts = [];
foreach (file("$folder/report", FILE_IGNORE_NEW_LINES) as $line) {
    [$index, $part, $command, $heading] = explode("\t", $line, 4);
    $kept = "$folder/report-$index";
    $times = is_file("$kept.time") ? array_map('intval', explode("\t", trim(file_get_contents("$kept.time")))) : null;
    $failed = is_file("$kept.failed") ? file("$kept.failed", FILE_IGNORE_NEW_LINES) : [];
    $name = $part === '' ? $heading : $part;
    $parts[$name] ??= ['command' => $command, 'began' => null, 'ended' => null, 'cpu' => 0, 'cases' => []];
    if ($times !== null) {
        [$began, $ended, $cpu] = $times;
        $parts[$name]['began'] = min($parts[$name]['began'] ?? $began, $began);
        $parts[$name]['ended'] = max($parts[$name]['ended'] ?? $ended, $ended);
        $parts[$name]['cpu'] += $cpu;
    }
    $wall = $times === null ? 0.0 : ($times[1] - $times[0]) / 1e6;
    $cases = unit_cases($kept, $heading, $name, $wall);
    if ($failed !== [] && array_filter($cases, fn (array $case): bool => in_array($case['result'], ['failure', 'error'], true)) === []) {
        // A unit that failed with no test it names failing, as one that stopped early, fails as itself.
        if (count($cases) === 1) {
            $cases[0]['result'] = 'failure';
            $cases[0]['message'] = implode('; ', $failed);
        } else {
            $cases[] = ['name' => $heading, 'classname' => $name, 'time' => 0.0, 'result' => 'failure', 'message' => implode('; ', $failed), 'details' => ''];
        }
    }
    array_push($parts[$name]['cases'], ...$cases);
}

/**
 * The unit's tests: run-tests.php's JUnit file's, libtest's lines with --report-time's times, or else the unit as one
 * test, with its own time. A .phpt test runs once in each mode, which its unit's heading names before its first colon,
 * so its classname names the mode, as two runs of one test are two testcases.
 *
 * @return list<array{name: string, classname: string, time: float, result: string, message: string, details: string}>
 */
function unit_cases(string $kept, string $heading, string $part, float $wall): array
{
    $cases = [];
    if (is_file("$kept.junit")) {
        $junit = new DOMDocument();
        if (!$junit->load("$kept.junit")) {
            throw new RuntimeException("$kept.junit isn't JUnit XML that run-tests.php wrote.");
        }
        foreach ($junit->getElementsByTagName('testcase') as $case) {
            $mode = str_contains($heading, ': ') ? strstr($heading, ': ', true) . ', ' : '';
            $result = ['name' => $case->getAttribute('name'), 'classname' => $mode . ($case->parentNode->getAttribute('name') ?: $part),
                'time' => (float) $case->getAttribute('time'), 'result' => 'pass', 'message' => '', 'details' => ''];
            foreach ($case->childNodes as $child) {
                if ($child instanceof DOMElement && in_array($child->tagName, ['failure', 'error', 'skipped'], true)) {
                    $result['result'] = $child->tagName;
                    $result['message'] = $child->tagName === 'skipped' ? $child->textContent : $child->getAttribute('message');
                    $result['details'] = $child->tagName === 'skipped' ? '' : $child->textContent;
                }
            }
            $cases[] = $result;
        }

        return $cases;
    }

    $binary = preg_match('/ of (\S+?),? from \S+$/', $heading, $match) === 1 ? $match[1] : $part;
    preg_match_all('/^test (.+?) \.\.\. (ok|FAILED|ignored)(?:,[^<\n]*)?(?: <(\d+(?:\.\d+)?)s>)?$/m', file_get_contents("$kept.out"), $lines, PREG_SET_ORDER);
    $timed = array_filter($lines, fn (array $line): bool => $line[2] === 'ignored' || isset($line[3]));
    if ($lines !== [] && (count($timed) === count($lines) || count($lines) === 1)) {
        foreach ($lines as $line) {
            $cases[] = ['name' => $line[1], 'classname' => $binary, 'time' => isset($line[3]) ? (float) $line[3] : ($line[2] === 'ignored' ? 0.0 : $wall),
                'result' => ['ok' => 'pass', 'FAILED' => 'failure', 'ignored' => 'skipped'][$line[2]], 'message' => $line[2] === 'FAILED' ? 'FAILED' : '', 'details' => ''];
        }

        return $cases;
    }

    $failing = array_filter($lines, fn (array $line): bool => $line[2] === 'FAILED');

    return [['name' => $heading, 'classname' => $binary, 'time' => $wall, 'result' => $failing === [] ? 'pass' : 'failure',
        'message' => implode('; ', array_map(fn (array $line): string => "{$line[1]} FAILED", $failing)), 'details' => '']];
}

$id = 0;
foreach ($parts as $name => $part) {
    $counts = array_count_values(array_column($part['cases'], 'result'));
    $suite = $root->appendChild($xml->createElement('testsuite'));
    $suite->setAttribute('package', 'sharp/bin/test');
    $suite->setAttribute('id', (string) $id++);
    $suite->setAttribute('name', $name);
    $suite->setAttribute('timestamp', gmdate('Y-m-d\TH:i:s', intdiv($part['began'] ?? (int) (microtime(true) * 1e6), 1000000)));
    $suite->setAttribute('hostname', gethostname() ?: 'localhost');
    $suite->setAttribute('tests', (string) count($part['cases']));
    $suite->setAttribute('failures', (string) ($counts['failure'] ?? 0));
    $suite->setAttribute('errors', (string) ($counts['error'] ?? 0));
    $suite->setAttribute('skipped', (string) ($counts['skipped'] ?? 0));
    $suite->setAttribute('time', sprintf('%.3f', (($part['ended'] ?? 0) - ($part['began'] ?? 0)) / 1e6));
    $properties = $suite->appendChild($xml->createElement('properties'));
    foreach (['cpu' => sprintf('%.3f', $part['cpu'] / 1000), 'command' => $part['command']] as $key => $value) {
        $property = $properties->appendChild($xml->createElement('property'));
        $property->setAttribute('name', $key);
        $property->setAttribute('value', $value);
    }
    foreach ($part['cases'] as $case) {
        $test = $suite->appendChild($xml->createElement('testcase'));
        $test->setAttribute('name', $case['name']);
        $test->setAttribute('classname', $case['classname']);
        $test->setAttribute('time', sprintf('%.3f', $case['time']));
        if ($case['result'] !== 'pass') {
            $result = $test->appendChild($xml->createElement($case['result']));
            if ($case['result'] === 'skipped') {
                $result->setAttribute('message', $case['message']);
            } else {
                $result->setAttribute('type', $case['result']);
                $result->setAttribute('message', $case['message']);
                $result->appendChild($xml->createTextNode($case['details']));
            }
        }
    }
    $suite->appendChild($xml->createElement('system-out'));
    $suite->appendChild($xml->createElement('system-err'));
}

if ($xml->save("$report.part") === false || !rename("$report.part", $report)) {
    throw new RuntimeException("$report couldn't be written.");
}
$tests = array_sum(array_map(fn (array $part): int => count($part['cases']), $parts));
echo "The report, " . substr($report, strlen(dirname($report, 3)) + 1) . ", holds " . count($parts) . " suites and $tests tests.\n";
PHP
  then
    failed+=("the report")
  fi
}

finish() {
  part
  write_report
  if [[ ${#failed[@]} -gt 0 ]]; then
    printf 'Failed: %s\n' "${failed[@]}" >&2
    exit 1
  fi
  exit 0
}

# sharp/mago's workspace tests: every test binary the build.json of sharp/bin/build-mago names, run from its package's
# folder, as cargo's test runner runs it, then sharp/bin/build-mago --cargo-tests, which builds and runs the tests
# that compile only as they run: the doc tests, and the property tests of mago-codex, which build with a feature of
# their own. With --shard, the i-th of n slices of all the binaries' tests,
# which balance by the seconds sharp/baseline/seconds lists, as the split below explains. A test binary runs the tests
# of its slice by skipping the others by exact name, which both libtest and libtest-mimic's harnesses take as often as
# needed. --cargo-built runs only those that compile as they run, which need neither the test binaries nor the Composer packages
# and the Lean they run, so CI's build job runs them on its own target while other jobs run the binaries' slices. With
# --no-build or --shard, cargo runs nothing, so those tests are left to a run with --cargo-built, or with neither.
if $mago && ! $cargo_built; then
  # The tests run a PHP SDK worker from sharp/mago's vendor folder, and lake, which mago compile proves laws with:
  # installing the pinned Lean first keeps the tests that run lake at once from each installing it. On Linux the tests
  # run in the sharp/docker image, which carries it in its ELAN_HOME, as sharp/docker/Dockerfile explains, so no run
  # downloads it.
  part "composer install in sharp/mago, and the pinned Lean"
  composer install --no-interaction --no-progress --quiet --working-dir="$root/sharp/mago"
  toolchain="$(cat "$root/sharp/mago/crates/sharp-lean/lean/lean-toolchain")"
  if [[ $os == linux ]]; then
    folder=${toolchain//\//--}
    if [[ ! -x ${ELAN_HOME:-}/toolchains/${folder//:/---}/bin/lake ]]; then
      echo "The sharp/docker image carries no Lean $toolchain, which lean-toolchain pins. Pin it in sharp/docker/tools/Dockerfile." >&2
      exit 1
    fi
  else
    elan toolchain install "$toolchain"
  fi
  if $build; then
    part "sharp/bin/build-mago"
    "$root/sharp/bin/build-mago" --quiet
  fi
  part
  messages="$build_dir/mago/build.json"
  if [[ ! -f $messages ]]; then
    echo "$messages is missing. Run sharp/bin/build-mago first." >&2
    exit 1
  fi
  binaries=()
  while read -r line; do
    if [[ $line == *'"reason":"compiler-artifact"'* && $line =~ \"profile\":\{[^}]*\"test\":true &&
      $line =~ \"executable\":\"([^\"]+)\" ]]; then
      executable="${BASH_REMATCH[1]}"
      [[ $line =~ \"manifest_path\":\"([^\"]+)\" ]]
      folder="$(dirname "${BASH_REMATCH[1]}")"
      [[ $line =~ \"src_path\":\"([^\"]+)\" ]]
      source="${BASH_REMATCH[1]#"$root"/}"
      binaries+=("$executable"$'\t'"$folder"$'\t'"$source")
    fi
  done < "$messages"
  mapfile -t binaries < <(printf '%s\n' "${binaries[@]}" | LC_ALL=C sort -u)
  # The tests write below the folder cargo names CARGO_TARGET_TMPDIR, which a build makes and a copy of the binaries
  # alone leaves out.
  mkdir -p "$build_dir/mago/tmp"

  # Each binary's tests, as its --list prints them, by the binary's index. A binary that can't list them fails the run:
  # its --list ran in a pipe whose failure nothing read, so its empty list read as a binary with no tests, and the run
  # ran none of them and passed. libtest prints each test's own wall time after its result with --report-time, which
  # stable Rust's libtest takes only under RUSTC_BOOTSTRAP. libtest-mimic's harness has no such option. One launch tells
  # them apart: libtest's --list ends with a count, as "948 tests, 0 benchmarks", and libtest-mimic's prints only its
  # tests. Its own part times the launches, which took about 50 s at no CPU on run 45830629343's Mac job (#953).
  part "the list of each test binary's tests"
  declare -A listed=() libtests=()
  for ((b = 0; b < ${#binaries[@]}; b++)); do
    IFS=$'\t' read -r executable folder source <<< "${binaries[b]}"
    if ! names="$(cd "$folder" && "$executable" --list)"; then
      echo "${executable##*/}, from ${folder#"$root"/}, couldn't list its tests, so none of them runs." >&2
      failed+=("the list of ${executable##*/}'s tests")
      continue
    fi
    listed[$b]="$(sed -n 's/: test$//p' <<< "$names")"
    libtests[$b]=false
    if [[ ${names##*$'\n'} =~ ^[0-9]+\ tests?,\ [0-9]+\ benchmarks?$ ]]; then
      libtests[$b]=true
    fi
  done
  part

  # Each test weighs the seconds sharp/baseline/seconds lists under its binary's source file and its name, as
  # sharp/mago/tests/main.rs::compile::<name>, and a test the file doesn't list ran under 1.5 s, so it weighs 1. A
  # slice's binaries share the run's jobs, so a binary takes at least the longer of its longest test and its tests'
  # seconds over the jobs, and a slice about the sum of its binaries'. Each test, heaviest first, goes to the slice
  # whose time that grows least, so every slice computes the same split. Every fifth test in binary and name order gave
  # MAGO (2/5)'s test step 413 s on run 45016081891, against 177 to 350 s for the other slices, since the two law proofs
  # of 189 and 158 s fell in it with a fifth of everything else.
  declare -A weighs=()
  read_seconds
  for b in "${!listed[@]}"; do
    IFS=$'\t' read -r executable folder source <<< "${binaries[b]}"
    weighs[$b]=0
    while IFS= read -r name; do
      if [[ -n $name ]]; then
        weighs[$b]=$((weighs[$b] + ${seconds[$source::$name]:-1}))
        printf '%s\t%s\t%s\n' "${seconds[$source::$name]:-1}" "$b" "$name"
      fi
    done <<< "${listed[$b]}"
  done > "$TMPDIR/mago-tests"

  # Adds a unit of the binary that runs the names it's given on one thread. libtest takes each name as a filter that
  # --exact matches whole. libtest-mimic's harness, which the binaries with harness = false use, takes one filter, so
  # it skips every other test of the binary instead, by exact name, as often as needed.
  add_tests_unit() {
    local weight=$1 heading=$2 name selection=()
    shift 2
    if ${libtests[$b]}; then
      selection=("$@")
    else
      declare -A wanted=()
      for name in "$@"; do
        wanted[$name]=1
      done
      while IFS= read -r name; do
        if [[ -n $name && -z ${wanted[$name]:-} ]]; then
          selection+=(--skip "$name")
        fi
      done <<< "${listed[$b]}"
    fi
    add_unit "$weight" "$heading" "$heading" "$folder" "${command[@]}" --exact --test-threads 1 "${selection[@]}"
    ready_unit "$unit"
  }

  # Adds the units of the slice'th of count slices of the tests, each binary's tests the binaries that weigh most
  # first, as the part that runs that slice alone.
  add_workspace_slice() {
    local slice=$1 count=$2 test
    local -A chosen=()
    while IFS= read -r test; do
      chosen[$test]=1
    done < <(LC_ALL=C sort -t $'\t' -k1,1nr -k2,2n -k3,3 "$TMPDIR/mago-tests" | awk -F '\t' -v slices="$count" \
      -v slice="$slice" -v threads="$jobs" '
        # In units of a second over the threads, so a time stays a whole number.
        function spent(at, binary, key) {
          key = at SUBSEP binary
          return longest[key] * threads > summed[key] ? longest[key] * threads : summed[key]
        }
        {
          best = 0
          for (at = 1; at <= slices; at++) {
            key = at SUBSEP $2
            top = $1 > longest[key] ? $1 : longest[key]
            after = top * threads > summed[key] + $1 ? top * threads : summed[key] + $1
            grown = load[at] - spent(at, $2) + after
            if (best == 0 || grown < least) {
              best = at
              least = grown
            }
          }
          key = best SUBSEP $2
          if ($1 > longest[key]) {
            longest[key] = $1
          }
          summed[key] += $1
          load[best] = least
          if (best == slice) {
            print $2 "\t" $3
          }
        }')
    adding_part "mago's workspace tests, slice $slice of $count" --mago --shard "$slice/$count"
    while read -r _ b; do
      IFS=$'\t' read -r executable folder source <<< "${binaries[b]}"
      selected=()
      while IFS= read -r name; do
        if [[ -n $name && -n ${chosen[$b$'\t'$name]:-} ]]; then
          selected+=("$name")
        fi
      done <<< "${listed[$b]}"
      if ((${#selected[@]} == 0)); then
        continue
      fi
      started=$((started + ${#selected[@]}))
      command=("$executable")
      if ${libtests[$b]}; then
        command=(env RUSTC_BOOTSTRAP=1 "$executable" -Z unstable-options --report-time)
      fi
      names=()
      for name in "${selected[@]}"; do
        if [[ -n ${seconds[$source::$name]:-} ]]; then
          add_tests_unit "${seconds[$source::$name]}" "$name, of ${executable##*/} from ${folder#"$root"/}" "$name"
        else
          names+=("$name")
        fi
        if ((${#names[@]} == batch)); then
          add_tests_unit "$batch" "$batch tests of ${executable##*/}, from ${folder#"$root"/}" "${names[@]}"
          names=()
        fi
      done
      if ((${#names[@]})); then
        add_tests_unit "${#names[@]}" "${#names[@]} tests of ${executable##*/}, from ${folder#"$root"/}" "${names[@]}"
      fi
    done < <(for b in "${!weighs[@]}"; do echo "${weighs[$b]} $b"; done | LC_ALL=C sort -k1,1nr -k2,2n)
  }

  # The binaries' tests join the pool, a run without --shard the part_slices slices one after another, so each slice
  # adds the units a run of that slice alone adds. A lane that runs no test, as when build.json names no test binary or
  # a slice the balance gives none, fails, since it tested nothing.
  started=0
  if [[ -n $shard ]]; then
    add_workspace_slice "$shard_index" "$shard_count"
  else
    for ((slice = 1; slice <= part_slices; slice++)); do
      add_workspace_slice "$slice" "$part_slices"
    done
  fi
  if ((started == 0)); then
    echo "mago's workspace tests ran no test: no binary lists a test this run selects." >&2
    failed+=("mago's workspace tests")
  fi
fi
# The doc tests and the property tests build with cargo as they run, on the run's jobs, so they run alone, after the
# pool.
run_cargo_tests() {
  if $mago && $build && [[ -z $shard ]]; then
    adding_part "the doc tests and mago-codex's property tests" --mago --cargo-built
    add_unit 1 "the doc tests and mago-codex's property tests" "the doc tests and mago-codex's property tests" "$root" \
      "$root/sharp/bin/build-mago" --cargo-tests
    ready_unit "$unit"
    run_pool
  fi
}
if $mago && ! $suite; then
  run_pool
  run_cargo_tests
  finish
fi

# sharp/baseline/linux holds the upstream results of the Linux engine CI's UPSTREAM runs.
if $upstream && [[ $os != linux ]]; then
  echo "The upstream tests run on Linux, as CI's UPSTREAM runs them. Run sharp/bin/test --linux --upstream." >&2
  exit 2
fi

# The whole-project proof of mago convert runs after the PHP# suite, on this build's engine, with the fixture's
# refinement worker on the php the PATH holds: in the run of the whole suite, and in the one slice the slices give it.
run_proof=false
if $upstream; then
  # php-src's own tests, without Zend/tests/sharp, the PHP# suite, which the slices run in every mode: in the upstream
  # run it was 506 of 7,436 tests, every one of the slowest, and the compile of its 939 fixtures took 51 s more.
  mapfile -t tests < <(cd "$root" && find Zend/tests ext/reflection ext/tokenizer ext/opcache -path Zend/tests/sharp -prune \
    -o -name '*.phpt' -print | LC_ALL=C sort)
elif $examples; then
  # The code examples alone run no test of the PHP# suite.
  tests=()
elif [[ -n $shard ]]; then
  # The slices balance by the seconds sharp/baseline/seconds lists, from CI's slow-test summaries: a test's seconds
  # summed over the modes, and the proof's own, which hold the whole slice while it runs, so it weighs them times
  # the workers. A test the file doesn't list ran under a second in each mode, so it weighs 1. Each item, heaviest
  # first, goes to the slice that weighs least so far, so every slice computes the same split. The list is remeasured
  # from one run, whose slices ran on 4 processor models, since a hosted runner can be 1.7 times slower than another:
  # the tests' from run 45127191998's slow-test summaries, and the proof's 108 s, its mean over runs 45127191998,
  # 45122643706, 45117789577 and 45114738831, which took 97 to 128 s.
  read_seconds
  items=()
  while read -r test; do
    items+=("${seconds[$test]:-1} $test")
  done < <(cd "$root" && find Zend/tests/sharp -name '*.phpt')
  items+=("$((${seconds[$proof]} * jobs)) $proof")
  mapfile -t items < <(printf '%s\n' "${items[@]}" | LC_ALL=C sort -k1,1nr -k2,2)
  loads=()
  for ((slice = 0; slice < shard_count; slice++)); do
    loads[slice]=0
  done
  for item in "${items[@]}"; do
    lightest=0
    for ((slice = 1; slice < shard_count; slice++)); do
      if ((loads[slice] < loads[lightest])); then
        lightest=$slice
      fi
    done
    loads[lightest]=$((loads[lightest] + ${item%% *}))
    if ((lightest == shard_index - 1)); then
      if [[ ${item#* } == "$proof" ]]; then
        run_proof=true
      else
        tests+=("${item#* }")
      fi
    fi
  done
elif [[ ${#tests[@]} -eq 0 ]]; then
  tests=(Zend/tests/sharp)
  run_proof=true
fi
# A path the run is given that holds no test fails the run, where run-tests exits 0 on a path it can't find: #760's run
# of a missing path passed. A folder's tests are its .phpt files.
for path in "${tests[@]}"; do
  if ! (cd "$root" && test -e "$path"); then
    echo "$path is no test: no such file or folder." >&2
    failed+=("$path")
  fi
done
mapfile -t tests < <(cd "$root" && for path in "${tests[@]}"; do
  if [[ -d $path ]]; then
    find "$path" -name '*.phpt'
  elif [[ -e $path ]]; then
    echo "$path"
  fi
done | LC_ALL=C sort -u)

php="$build_dir/sapi/cli/php"
if [[ ! -x "$php" ]]; then
  echo "$php is missing. Run sharp/bin/build-mago --engine --debug first." >&2
  exit 1
fi

# A build folder an older build configured can hold an engine without thread safety, which PHP# no longer
# runs, at the tree's version: MAGO_RELEASE, or else the root package's in sharp/mago/Cargo.toml, as
# ext/sharp/Makefile.frag writes it.
version="${MAGO_RELEASE:-$(sed -n '/^version = /{s/^version = "\(.*\)"$/\1/p;q;}' "$root/sharp/mago/Cargo.toml")}"
engine_version="$("$php" -n --ri sharp | sed -n 's/^Version => //p')"
if [[ "$engine_version" != "$version" || "$("$php" -n -r 'echo PHP_ZTS;')" != 1 ]]; then
  echo "The engine $php is $engine_version$("$php" -n -r 'echo PHP_ZTS ? "" : " without thread safety";'), but the tree is the thread-safe $version. Run sharp/bin/build-mago --engine --debug." >&2
  exit 1
fi

export SKIP_IO_CAPTURE_TESTS=1
export STACK_LIMIT_DEFAULTS_CHECK=1
export RUN_RESOURCE_HEAVY_TESTS=1

# The modes the tests run in, each a name and run-tests' options for it.
modes=()
mode_options=()
add_mode() {
  modes+=("$1")
  shift
  mode_options+=("$*")
}
# Prints each test's conflict keys, as run-tests.php reads them, after its path and a tab, sorted and joined by spaces:
# the lines of its --CONFLICTS-- section, or with none, of the CONFLICTS file of its folder, each without its comment.
# xargs passes the paths in as many runs of awk as the system's argument limit needs: a run holds about 22,800 tests.
conflict_keys() {
  # shellcheck disable=SC2016 # The program is awk's, whose $0 the shell must not expand.
  printf '%s\0' "$@" | xargs -0 awk '
    function keys_of(line) {
      sub(/#.*/, "", line)
      gsub(/^[ \t]+|[ \t]+$/, "", line)
      return line
    }
    function folder_keys(file,   folder, line, keys) {
      folder = file
      sub(/\/[^\/]*$/, "", folder)
      if (!(folder in folders)) {
        keys = ""
        while ((getline line < (folder "/CONFLICTS")) > 0) {
          if ((line = keys_of(line)) != "") {
            keys = keys " " line
          }
        }
        close(folder "/CONFLICTS")
        folders[folder] = keys
      }
      return folders[folder]
    }
    function finish(   count, words, sorted, i, j, word) {
      if (file == "") {
        return
      }
      count = split(found ? keys : folder_keys(file), words, " ")
      sorted = 0
      for (i = 1; i <= count; i++) {
        for (j = 1; j <= sorted && order[j] != words[i]; j++) {
        }
        if (j > sorted) {
          order[++sorted] = words[i]
          for (j = sorted; j > 1 && order[j - 1] > order[j]; j--) {
            word = order[j]; order[j] = order[j - 1]; order[j - 1] = word
          }
        }
      }
      line = ""
      for (i = 1; i <= sorted; i++) {
        line = line (i > 1 ? " " : "") order[i]
      }
      print file "\t" line
    }
    FNR == 1 { finish(); file = FILENAME; keys = ""; found = 0; on = 0 }
    on && /^--/ { on = 0 }
    on && (line = keys_of($0)) != "" { keys = keys " " line }
    $0 == "--CONFLICTS--" { on = 1; found = 1 }
    END { finish() }
  '
}
# Adds the units of the tests in every mode. A test sharp/baseline/seconds lists runs alone, and the others in lists of
# 100 that hold the same conflict keys, which the list's units hold, and a list runs in a mode once it ran in the mode
# before: run-tests.php writes the .php file of each test in the test's own folder, and deletes it before and after the
# test runs, so one test in two modes at once would delete its other run's. Each unit writes its results, one
# `RESULT<TAB>path` line for each test it ran, to a file of its mode's, and its tests' times to a JUnit file of its own,
# which the run's report reads.
add_test_units() {
  local test keys slot m l previous heading lists=() weights=() list_keys=() group=() options=()
  local -A held_by=() grouped=() counted=()
  read_seconds
  while IFS=$'\t' read -r test keys; do
    held_by[$test]=$keys
  done < <(conflict_keys "${tests[@]}")
  for test in "${tests[@]}"; do
    keys=${held_by[$test]:-}
    if [[ -n ${seconds[$test]:-} ]]; then
      lists+=("$test")
      weights+=("${seconds[$test]}")
      list_keys+=("$keys")
      continue
    fi
    # A list's slot is its keys, or - for none, since an associative array has no empty key.
    slot=${keys:--}
    grouped[$slot]+="$test "
    counted[$slot]=$((${counted[$slot]:-0} + 1))
    if ((counted[$slot] == batch)); then
      lists+=("${grouped[$slot]% }")
      weights+=("$batch")
      list_keys+=("$keys")
      unset "grouped[$slot]" "counted[$slot]"
    fi
  done
  for slot in "${!grouped[@]}"; do
    lists+=("${grouped[$slot]% }")
    weights+=("${counted[$slot]}")
    if [[ $slot == - ]]; then
      list_keys+=('')
    else
      list_keys+=("$slot")
    fi
  done
  for ((l = 0; l < ${#lists[@]}; l++)); do
    read -r -a group <<< "${lists[l]}"
    heading="${#group[@]} tests from ${group[0]}"
    if ((${#group[@]} == 1)); then
      heading="${group[0]}"
    fi
    previous=
    for ((m = 0; m < ${#modes[@]}; m++)); do
      read -r -a options <<< "${mode_options[m]}"
      add_unit "${weights[l]}" "${modes[m]}: $heading" "${modes[m]}: $heading" "$root" \
        env TEST_PHP_JUNIT="$TMPDIR/junit-$m-$l" "$php" run-tests.php -P -q -W "$TMPDIR/results-$m-$l" \
        -d opcache.jit=disable \
        -d opcache.protect_memory=1 \
        -j1 \
        -g FAIL,BORK,LEAK,XLEAK \
        --no-progress \
        --offline \
        --show-diff \
        --show-slow 1000 \
        --set-timeout 120 \
        "${options[@]}" "${group[@]}"
      unit_junit[unit]="$TMPDIR/junit-$m-$l"
      unit_results[unit]="$TMPDIR/results-$m-$l"
      unit_mode[unit]=${modes[m]}
      hold_keys "$unit" "${list_keys[l]}"
      if [[ -z $previous ]]; then
        ready_unit "$unit"
      else
        then_unit "$previous" "$unit"
      fi
      previous=$unit
    done
  done
}
# The results of a mode's units, in one file. run-tests exits 0 on a selection that holds no test and on a run whose
# every test skipped, so a mode whose results hold no test that ran fails.
mode_results() {
  local m=$1
  cat "$TMPDIR/results-$m-"* 2> /dev/null > "$TMPDIR/results-$m" || true
  if ! awk -F '\t' '$1 != "SKIPPED" { ran = 1 } END { exit !ran }' "$TMPDIR/results-$m"; then
    echo "${modes[m]} ran no test." >&2
    failed+=("${modes[m]}")
  fi
}

# The upstream tests run on the engine alone, so they need no mago and no PHP# fixtures.
if $upstream; then
  baseline=sharp/baseline/linux
  results="$build_dir/upstream-results"
  add_mode "without opcache, compared with $baseline"
  adding_part "the upstream tests" --upstream
  add_test_units
  run_pool
  mode_results 0
  awk -F '\t' -v OFS='\t' -v prefix="$root/" '
    $1 != "PASSED" {
      if (index($2, prefix) == 1) $2 = substr($2, length(prefix) + 1)
      print
    }' "$TMPDIR/results-0" | LC_ALL=C sort -o "$results"
  if ! diff -u "$root/$baseline" "$results"; then
    echo "The upstream results differ from $baseline. Only the Architect accepts a new baseline, with: cp ${results#"$root"/} $baseline" >&2
    failed+=("the comparison with $baseline")
  fi
  finish
fi

# The PHP# suite, its checks and the examples run mago alone, which a run of the workspace's tests built with them. A run
# of 4 .phpt files built every test binary for 2h31m on 11-25, and held the build folder's lock from another lane's
# cargo test for 61 minutes (#847).
if $build && ! $mago; then
  part "sharp/bin/build-mago --bin"
  "$root/sharp/bin/build-mago" --bin --quiet
fi
mago="$build_dir/mago/debug/mago"
if [[ ! -x $mago ]]; then
  echo "$mago is missing. Run sharp/bin/build-mago first." >&2
  exit 1
fi

# sharp/bin/spec's examples, one for each id its markers name, as its blocks() reads them, run in slices of 10, each on
# one slot: sharp/bin/spec runs as many compiles at once as sharp/bin/jobs prints, which CARGO_BUILD_JOBS=1 makes 1.
# Each example is its own mago compile of 7.8 s on the Mac, run 45389050052, so slices of 100 ran 694 to 766 s each
# and the Mac's test step ended minutes after every other unit had (#784). A slice weighs the seconds
# sharp/baseline/seconds lists under its `sharp/bin/spec --shard <i>/<n>`, from that run's record of each example, or,
# once an added example changes the slices, 8 s for each example it holds. The first slice also compares the list's
# entries that name no example.
spec_batch=10
count_examples() {
  grep -h '^<!-- example ' "$@" | sed 's/^<!-- example \([a-z0-9-]*\).*/\1/' | LC_ALL=C sort -u | wc -l
}
# Adds the self-test of sharp/bin/spec and the slices of the examples, in part_slices parts, or the n of
# --examples --shard <i>/<n>, which adds only its i-th. Each, heaviest first, goes to the part that weighs least so far,
# so every run computes the same parts, and a part adds the units a run of it alone adds.
add_examples() {
  local held slices slice count=$part_slices part lightest weight item self_test items=() loads=() owner=()
  if $examples && [[ -n $shard ]]; then
    count=$shard_count
  fi
  self_test="$(count_examples "$root/sharp/spec-self-test.md")"
  held=$(count_examples "$root/README.md" "$root/docs/spec.md")
  slices=$(((held + spec_batch - 1) / spec_batch))
  read_seconds
  items=("$((self_test)) 0")
  for ((slice = 1; slice <= slices; slice++)); do
    items+=("${seconds["sharp/bin/spec --shard $slice/$slices"]:-$((((held - slice) / slices + 1) * 8))} $slice")
  done
  for ((part = 1; part <= count; part++)); do
    loads[part]=0
  done
  while read -r weight item; do
    lightest=1
    for ((part = 2; part <= count; part++)); do
      if ((loads[part] < loads[lightest])); then
        lightest=$part
      fi
    done
    loads[lightest]=$((loads[lightest] + weight))
    owner[item]=$lightest
  done < <(printf '%s\n' "${items[@]}" | LC_ALL=C sort -k1,1nr -k2,2n)
  for ((part = 1; part <= count; part++)); do
    if $examples && [[ -n $shard ]] && ((part != shard_index)); then
      continue
    fi
    adding_part "the code examples, slice $part of $count" --examples --shard "$part/$count"
    if ((owner[0] == part)); then
      add_unit "$self_test" \
        "every rule of sharp/bin/spec, on the examples of sharp/spec-self-test.md" "the self-test of sharp/bin/spec" \
        "$root" env CARGO_BUILD_JOBS=1 "$php" sharp/bin/spec --self-test
      ready_unit "$unit"
    fi
    for ((slice = 1; slice <= slices; slice++)); do
      if ((owner[slice] == part)); then
        add_unit "${items[slice]% *}" \
          "slice $slice of $slices of the code examples in docs/spec.md and README.md, compared with sharp/baseline/spec" \
          "slice $slice of $slices of the code examples of docs/spec.md and README.md" "$root" \
          env CARGO_BUILD_JOBS=1 "$php" sharp/bin/spec --shard "$slice/$slices"
        ready_unit "$unit"
      fi
    done
  done
}

# The code examples alone need neither the PHP# suite's Composer packages nor its compiled fixtures.
if $examples; then
  export TEST_MAGO_EXECUTABLE="$mago"
  add_examples
  run_pool
  finish
fi

# Zend/tests/sharp is a project shaped like an application: the tests load their PHP# fixtures through Composer's
# autoloader and the PHP# package's, from the packages its composer.lock pins, and mago compile checks the project with
# its vendor folder. The PHP# package is a copy of sharp/composer, as an application installs it, since a compile
# refuses a link outside the project. Composer keeps the copy an earlier run installed while the lock is unchanged, so
# a copy that differs from sharp/composer in a file git tracks there, or in a compiled file or the codex of the
# library's .sharp folder, which sharp/bin/build-mago compiles the library into and the project's compile reads the
# library from, is reinstalled first, and the install then dumps the autoloader, which runs the package's plugin:
# composer reinstall runs no plugin. The rest of that folder, the record and locks of the library's compile, never
# counts.
part "composer install in Zend/tests/sharp"
package="$root/Zend/tests/sharp/vendor/heyjordanparker/php-sharp-composer"
differs_from_library() {
  local files file
  if ! files="$(git -C "$root/sharp/composer" ls-files)"; then
    echo "git couldn't list the files it tracks in sharp/composer." >&2
    exit 1
  fi
  if [[ ! -d $root/sharp/composer/.sharp ]]; then
    echo "sharp/composer/.sharp is missing: sharp/bin/build-mago compiles the standard library into it." >&2
    exit 1
  fi
  files+=$'\n'"$(cd "$root/sharp/composer" && find .sharp -type f \( -name '*.sharpc' -o -name library.codex \))"
  while IFS= read -r file; do
    if ! cmp -s "$root/sharp/composer/$file" "$package/$file"; then
      return 0
    fi
  done <<< "$files"
  return 1
}
if [[ -d $package ]] && differs_from_library \
  && ! composer reinstall --no-interaction --no-progress --quiet --no-autoloader \
    --working-dir="$root/Zend/tests/sharp" heyjordanparker/php-sharp-composer; then
  echo "composer reinstall of heyjordanparker/php-sharp-composer failed in Zend/tests/sharp." >&2
  exit 1
fi
if ! composer install --no-interaction --no-progress --quiet --working-dir="$root/Zend/tests/sharp"; then
  echo "composer install failed in Zend/tests/sharp, and the tests load their fixtures through its autoloader." >&2
  exit 1
fi

# The compile runs alone, before the pool, so it takes every slot of the run: on one thread, as MAGO_THREADS gives each
# test's mago, 11 of the Mac's 12 slots waited for it.
part "mago compile, built from sharp/mago"
if ! "$mago" --no-version-check --colors never --threads "$jobs" --workspace "$root/Zend/tests/sharp" compile; then
  echo "mago compile refused a PHP# test fixture, and the engine runs only compiled files." >&2
  exit 1
fi

export TEST_MAGO_EXECUTABLE="$mago"

# The PHP# suite runs in the four ways production runs the engine: without opcache, in opcache shared memory with each
# test twice in one process, under the function JIT, which compiles each function of a file as the file loads, and
# under the tracing JIT, with every hot counter at 1, so it compiles the code the tests run as soon as it runs. Each
# expects the output of the run without opcache. macOS runs the first two, since Apple silicon has no thread-safe JIT,
# as ext/opcache/config.m4 warns.
add_mode "without opcache"
add_mode "with opcache shared memory, running each test twice in one process" -d opcache.enable_cli=1 --repeat 2
if [[ $os == linux ]]; then
  add_mode "with the function JIT" -d opcache.enable_cli=1 -d opcache.jit=function -d opcache.jit_buffer_size=32M
  add_mode "with the tracing JIT" -d opcache.enable_cli=1 -d opcache.jit=tracing -d opcache.jit_buffer_size=32M \
    -d opcache.jit_hot_func=1 -d opcache.jit_hot_loop=1 -d opcache.jit_hot_return=1 -d opcache.jit_hot_side_exit=1
fi
# The PHP# suite's part: its tests in each mode, the checks this run adds to them, and the proof of mago convert.
suite_options=()
for check in census differential phpunit; do
  if ${!check}; then
    suite_options+=("--$check")
  fi
done
if [[ -n $shard ]]; then
  adding_part "the PHP# suite, slice $shard_index of $shard_count" "${suite_options[@]}" --shard "$shard"
elif ((${#named[@]})); then
  adding_part "the PHP# suite's tests this run names" "${suite_options[@]}" "${named[@]}"
else
  adding_part "the PHP# suite" "${suite_options[@]}"
fi
add_test_units

if $census; then
  add_unit 1 "every write and comparison of a field that holds a PHP# mark" "the census of PHP# marks" "$root" \
    "$php" sharp/bin/census
  ready_unit "$unit"
fi

# One php -l lints every fixture, each file in a request of its own, and ends each file's output with the line that
# says whether it compiled. A file passes when that line is all it printed, as when a php -l of its own linted it, where
# a process per fixture took 44 s on the Mac.
check_differential() {
  local files=("$root"/Zend/tests/sharp/*/*.sharp) output line file linted='' index=0 mismatch=false
  output="$("$php" -l "${files[@]}" 2>&1)" || true
  while IFS= read -r line; do
    linted+="$line"$'\n'
    if ((index == ${#files[@]})); then
      continue
    fi
    file="${files[index]}"
    if [[ $line == "No syntax errors detected in $file" || $line == "Errors parsing $file" ]]; then
      if [[ $linted == "No syntax errors detected in $file"$'\n' ]]; then
        echo "COMPILES ${file#"$root"/}"
      else
        printf 'FAIL %s: mago compile accepts it and php -l does not.\n%s' "${file#"$root"/}" "$linted"
        mismatch=true
      fi
      linted=''
      index=$((index + 1))
    fi
  done <<< "$output"
  if [[ -n $linted ]] || ((index < ${#files[@]})); then
    printf 'FAIL php -l reported on %d of the %d files, then printed this.\n%s' "$index" "${#files[@]}" "$linted"
    mismatch=true
  fi
  if $mismatch; then
    failed+=("every file mago compile accepted against php -l")
  fi
}

if $differential; then
  add_unit 1 "every file mago compile accepted against php -l, through its .sharpc file" '' "$root" check_differential
  ready_unit "$unit"
fi

# A PHP# test class runs with its file's test module under real PHPUnit, at the version sharp/phpunit/composer.lock
# pins: in PHPUnit's own process, in the child process of #[RunInSeparateProcess], and with every test in a child. The
# install starts from nothing installed, because Composer keeps the copy of sharp/composer an earlier run installed while
# the lock is unchanged, and the compile starts from nothing compiled, with the fixture's extension host, which loads
# vendor/autoload.php on the engine. composer run-script runs post-autoload-dump with no flags.
check_phpunit() {
  local project="$root/sharp/phpunit" isolation
  rm -rf "$project/vendor" "$project/.sharp"
  if ! composer install --no-interaction --no-progress --quiet --working-dir="$project" \
    || ! composer run-script --no-interaction post-autoload-dump --working-dir="$project" \
    || ! PATH="$(dirname "$php"):$PATH" "$mago" --no-version-check --colors never --workspace "$project" compile; then
    failed+=("the PHPUnit fixture's install, post-autoload-dump and compile")
    return
  fi
  for isolation in "" --process-isolation; do
    if ! "$php" -d opcache.jit=disable "$project/vendor/bin/phpunit" --configuration "$project/phpunit.xml" \
      --testdox ${isolation:+"$isolation"}; then
      failed+=("PHPUnit ${isolation:-in one process}")
    fi
  done
}

if $phpunit; then
  add_unit 1 "a PHP# test class under PHPUnit, in sharp/phpunit" '' "$root" check_phpunit
  ready_unit "$unit"
fi

if $run_proof; then
  mkdir "$TMPDIR/convert" "$TMPDIR/convert/project"
  add_unit "${seconds[$proof]:-1}" "mago convert on sharp/mago/crates/converter/tests/project" \
    "the whole-project proof of mago convert" "$root" "$proof" "$TMPDIR/convert/project"
  ready_unit "$unit"
fi

if $spec; then
  add_examples
fi

run_pool
for ((m = 0; m < ${#modes[@]}; m++)); do
  mode_results "$m"
done
run_cargo_tests
finish
