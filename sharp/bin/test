#!/usr/bin/env bash
# shellcheck disable=SC2329 # start_part runs each part's function by its name.
set -euo pipefail

usage() {
  echo "usage: sharp/bin/test [--linux] [--no-build] [--census] [--spec] [--differential] [--phpunit] [--shard <i>/<n> | paths...]" >&2
  echo "       sharp/bin/test [--linux] [--no-build] --upstream" >&2
  echo "       sharp/bin/test [--linux] [--no-build] --mago [--shard <i>/<n>]" >&2
  echo "       sharp/bin/test [--linux] --mago --cargo-built" >&2
  exit 2
}

root="$(cd "$(dirname "$0")/../.." && pwd)"
# Each run leaves its line in the build record, with each part's under it, see sharp/bin/record.
[[ ${SHARP_RECORDED:-} == sharp/bin/test ]] || exec "$root/sharp/bin/record" sharp/bin/test -- "$0" "$@"
linux=false
# --no-build runs on the mago and the test binaries an earlier sharp/bin/build-mago made, as CI's suites run on their
# build job's, and builds nothing.
build=true
census=false
spec=false
differential=false
phpunit=false
upstream=false
mago=false
cargo_built=false
shard=
tests=()
container_command=(sharp/bin/test)
args=("$@")
for ((a = 0; a < ${#args[@]}; a++)); do
  arg="${args[a]}"
  case "$arg" in
    --linux) linux=true; continue ;;
    --no-build) build=false ;;
    --shard) a=$((a + 1)); shard="${args[a]:-}"; container_command+=(--shard "$shard"); continue ;;
    --census) census=true ;;
    --spec) spec=true ;;
    --differential) differential=true ;;
    --phpunit) phpunit=true ;;
    --upstream) upstream=true ;;
    --mago) mago=true ;;
    --cargo-built) cargo_built=true ;;
    -*) usage ;;
    *) tests+=("$arg") ;;
  esac
  container_command+=("$arg")
done

if { $upstream || $mago; } && [[ ${#tests[@]} -gt 0 ]] || { $upstream && $mago; }; then
  usage
fi
if { $mago || $upstream; } && { $census || $spec || $differential || $phpunit; }; then
  usage
fi
if $cargo_built && { ! $mago || ! $build || [[ -n $shard ]]; }; then
  usage
fi
# --shard <i>/<n> runs the i-th of n slices, so n jobs that run the same modes together run each test once.
if [[ -n $shard ]]; then
  if $upstream || [[ ${#tests[@]} -gt 0 || ! $shard =~ ^([1-9][0-9]*)/([1-9][0-9]*)$ ]] || (( BASH_REMATCH[1] > BASH_REMATCH[2] )); then
    usage
  fi
  shard_index=${BASH_REMATCH[1]}
  shard_count=${BASH_REMATCH[2]}
fi

if $linux; then
  exec "$root/sharp/docker/run" "${container_command[@]}"
fi

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
build_dir="$root/sharp/build/$os-$(uname -m)"
jobs="$("$root/sharp/bin/jobs")"

# Each run keeps its own files in a temporary folder of its own and removes it when it ends, so no run reads what
# another run wrote. Each part of a run runs in a process group of its own, so a run that ends early, as on SIGTERM,
# first stops every part still running, with its workers and their tests, which would go on writing in the folder.
TMPDIR="$(mktemp -d)"
export TMPDIR
# Each `mago` a test starts runs on one thread, so a run's load is its test threads. A test about threads passes
# --threads, which wins over MAGO_THREADS.
export MAGO_THREADS=1
declare -A parts=() part_names=()
part_count=0
trap 'for group in "${!parts[@]}"; do kill -KILL -- "-$group" 2> /dev/null || true; done; wait || true; rm -rf "$TMPDIR"' EXIT

# Every step runs, and the script fails at the end if any step failed.
failed=()

# The seconds sharp/baseline/seconds lists for each slow test, by its path, which the slices of --shard balance by:
# a .phpt test's path, the whole-project proof of mago convert, and a Mago test's binary source file and name.
declare -A seconds=()
proof=sharp/mago/crates/converter/tests/project.sh
read_seconds() {
  local weight path
  while IFS=$'\t' read -r weight path; do
    seconds[$path]=$weight
  done < "$root/sharp/baseline/seconds"
}
# Fails the run when sharp/baseline/seconds lists a test that isn't there, since a renamed test's new name weighs 1 s
# where its old one held its seconds: MAGO (1/5) took 394 s on run 45127191998 against 293 s for MAGO (5/5), because
# the list held 162.9 s of laws.rs under no name of a test and 1 s under its new one. It checks the keys the pattern
# matches against the map of every such test there is.
stale_seconds() {
  local -n known_tests=$1
  local pattern=$2 key stale=()
  for key in "${!seconds[@]}"; do
    # shellcheck disable=SC2053 # The pattern is a glob.
    if [[ $key == $pattern && -z ${known_tests[$key]:-} ]]; then
      stale+=("$key")
    fi
  done
  if ((${#stale[@]})); then
    printf 'sharp/baseline/seconds lists %s, which no test is. Measure it under its new name, or drop it.\n' "${stale[@]}" >&2
    exit 2
  fi
}

# Runs the command from the folder, in the process group of the part that runs it, and records the step as failed when
# it fails.
run_step() {
  local step="$1" folder="$2"
  shift 2
  if ! (cd "$folder" && exec "$@"); then
    failed+=("$step")
  fi
}

# Ends the part of the run under way with its wall seconds and the CPU-seconds the shell and the processes it waited
# for used in it, as bash's times counts them, so a change to one part is judged by that part whatever else the machine
# runs, and writes its line to the build record, as failed when a step of it failed. Then it starts the part its heading
# names, if any, from after that write, so the recorder's own time counts in neither part. Each part of a run runs in a
# shell of its own, whose times count only what that part ran, so the parts that run at once each count their own.
part_heading=''
part_started=0
part_cpu=0
part_failed=0
part_clock() {
  local time
  now="${EPOCHREALTIME/[^0-9]/}"
  cpu=0
  times > "$TMPDIR/sharp-bin-test-times.$BASHPID"
  for time in $(< "$TMPDIR/sharp-bin-test-times.$BASHPID"); do
    [[ $time =~ ^([0-9]+)m([0-9]+)[.,]([0-9]{3})s$ ]]
    cpu=$((cpu + (BASH_REMATCH[1] * 60 + BASH_REMATCH[2]) * 1000 + 10#${BASH_REMATCH[3]}))
  done
}
part() {
  local now cpu wall used
  part_clock
  if [[ -n $part_heading ]]; then
    wall=$(((now - part_started) / 100000))
    used=$(((cpu - part_cpu) / 100))
    printf '%s took %d.%d s and %d.%d CPU-seconds.\n' "$part_heading" $((wall / 10)) $((wall % 10)) $((used / 10)) $((used % 10))
    "$root/sharp/bin/record" "$part_heading" --measured "${part_started:0:${#part_started}-6}.${part_started: -6}" \
      "$((used / 10)).$((used % 10))" '' "$((${#failed[@]} > part_failed))"
    part_clock
  fi
  part_heading="${1:-}"
  part_started=$now
  part_cpu=$cpu
  part_failed=${#failed[@]}
  if [[ -n $part_heading ]]; then
    echo "== $part_heading"
  fi
}

# Starts the command, a function of this script or a program, as a part of the run that runs at once beside the others:
# in a shell of its own, in a process group of its own, with its output in a file that wait_parts prints whole when the
# part ends, so two parts' lines never mix. The part's failed steps join the run's when it ends, and a part that stops
# before it ends fails as `name`. As GNU make -j and cargo-nextest start each item, so the run ends with its longest
# part, where one after another it took the sum of them: the Mac's test step took 1,251 to 1,442 s on runs 45199121625,
# 45192466849 and 45199338468, while each part kept 1.1 to 3.5 of its 12 cores busy.
start_part() {
  local name="$1" output="$TMPDIR/part-$part_count"
  shift
  part_count=$((part_count + 1))
  set -m
  (
    # shellcheck disable=SC2030 # The part's own failed steps, which wait_parts reads from its file.
    failed=()
    "$@"
    part
    if ((${#failed[@]})); then
      printf '%s\n' "${failed[@]}"
    fi > "$output.failed"
  ) > "$output" 2>&1 &
  set +m
  parts[$!]=$output
  part_names[$!]=$name
}

# A part of one step, under its heading: the step's name and folder, then its command.
step_part() {
  part "$1"
  shift
  run_step "$@"
}

# Waits for every part started, and prints each one's output whole as it ends.
wait_parts() {
  local group status output reported
  while ((${#parts[@]})); do
    status=0
    wait -n -p group "${!parts[@]}" || status=$?
    output=${parts[$group]}
    unset "parts[$group]"
    cat "$output"
    reported=()
    if [[ -f $output.failed ]]; then
      mapfile -t reported < "$output.failed"
    fi
    if ((${#reported[@]})); then
      # shellcheck disable=SC2031 # The run's own failed steps, which the part's join.
      failed+=("${reported[@]}")
    elif ((status != 0)); then
      failed+=("${part_names[$group]}")
    fi
  done
}

finish() {
  wait_parts
  if [[ ${#failed[@]} -gt 0 ]]; then
    printf 'Failed: %s\n' "${failed[@]}" >&2
    exit 1
  fi
  exit 0
}

# sharp/mago's workspace tests: every test binary the build.json of sharp/bin/build-mago names, run from its package's
# folder, as cargo's test runner runs it, then sharp/bin/build-mago --cargo-tests, which builds and runs the tests
# that compile only as they run: the doc tests, and the property tests of mago-codex, which build with a feature of
# their own. With --shard, the i-th of n slices of all the binaries' tests,
# which balance by the seconds sharp/baseline/seconds lists, as the split below explains. A test binary runs the tests
# of its slice by skipping the others by exact name, which both libtest and libtest-mimic's harnesses take as often as
# needed. --cargo-built runs only those that compile as they run, which need neither the test binaries nor the Composer packages
# and the Lean they run, so CI's build job runs them on its own target while other jobs run the binaries' slices. With
# --no-build or --shard, cargo runs nothing, so those tests are left to a run with --cargo-built, or with neither.
if $mago && ! $cargo_built; then
  # The tests run a PHP SDK worker from sharp/mago's vendor folder, and lake, which mago compile proves laws with:
  # installing the pinned Lean first keeps the tests that run lake at once from each installing it. On Linux the tests
  # run in the sharp/docker image, which carries it in its ELAN_HOME, as sharp/docker/Dockerfile explains, so no run
  # downloads it.
  prepare_workspace() {
    local toolchain folder
    part "composer install in sharp/mago, and the pinned Lean"
    composer install --no-interaction --no-progress --quiet --working-dir="$root/sharp/mago"
    toolchain="$(cat "$root/sharp/mago/crates/sharp-lean/lean/lean-toolchain")"
    if [[ $os == linux ]]; then
      folder=${toolchain//\//--}
      if [[ ! -x ${ELAN_HOME:-}/toolchains/${folder//:/---}/bin/lake ]]; then
        echo "The sharp/docker image carries no Lean $toolchain, which lean-toolchain pins. Pin it in sharp/docker/tools/Dockerfile." >&2
        exit 1
      fi
    else
      elan toolchain install "$toolchain"
    fi
    if $build; then
      part "sharp/bin/build-mago"
      "$root/sharp/bin/build-mago" --quiet
    fi
  }
  start_part "composer install in sharp/mago, the pinned Lean and sharp/bin/build-mago" prepare_workspace
  wait_parts
  if ((${#failed[@]})); then
    finish
  fi
  messages="$build_dir/mago/build.json"
  if [[ ! -f $messages ]]; then
    echo "$messages is missing. Run sharp/bin/build-mago first." >&2
    exit 1
  fi
  binaries=()
  while read -r line; do
    if [[ $line == *'"reason":"compiler-artifact"'* && $line =~ \"profile\":\{[^}]*\"test\":true &&
      $line =~ \"executable\":\"([^\"]+)\" ]]; then
      executable="${BASH_REMATCH[1]}"
      [[ $line =~ \"manifest_path\":\"([^\"]+)\" ]]
      folder="$(dirname "${BASH_REMATCH[1]}")"
      [[ $line =~ \"src_path\":\"([^\"]+)\" ]]
      source="${BASH_REMATCH[1]#"$root"/}"
      binaries+=("$executable"$'\t'"$folder"$'\t'"$source")
    fi
  done < "$messages"
  mapfile -t binaries < <(printf '%s\n' "${binaries[@]}" | LC_ALL=C sort -u)
  # The tests write below the folder cargo names CARGO_TARGET_TMPDIR, which a build makes and a copy of the binaries
  # alone leaves out.
  mkdir -p "$build_dir/mago/tmp"

  # Each binary's tests, as its --list prints them, by the binary's index. A binary that can't list them fails the run:
  # its --list ran in a pipe whose failure nothing read, so its empty list read as a binary with no tests, and the run
  # ran none of them and passed.
  declare -A listed=()
  for ((b = 0; b < ${#binaries[@]}; b++)); do
    IFS=$'\t' read -r executable folder source <<< "${binaries[b]}"
    if ! names="$(cd "$folder" && "$executable" --list --format terse)"; then
      echo "${executable##*/}, from ${folder#"$root"/}, couldn't list its tests, so none of them runs." >&2
      failed+=("the list of ${executable##*/}'s tests")
      continue
    fi
    listed[$b]="$(sed -n 's/: test$//p' <<< "$names")"
  done

  # With --shard, each test weighs the seconds sharp/baseline/seconds lists under its binary's source file and its
  # name, as sharp/mago/tests/main.rs::compile::<name>, and a test the file doesn't list ran under 1.5 s, so it weighs
  # 1. A binary runs its tests on as many threads as the run's jobs, so it takes the longer of its longest test and its
  # tests' seconds over the threads, and a slice the sum of its binaries'. Each test, heaviest first, goes to the slice
  # whose time that grows least, so every slice computes the same split. Every fifth test in binary and name order gave
  # MAGO (2/5)'s test step 413 s on run 45016081891, against 177 to 350 s for the other slices, since the two law proofs
  # of 189 and 158 s fell in it with a fifth of everything else.
  declare -A chosen=() known=()
  if [[ -n $shard ]]; then
    read_seconds
    for b in "${!listed[@]}"; do
      IFS=$'\t' read -r executable folder source <<< "${binaries[b]}"
      while IFS= read -r name; do
        if [[ -n $name ]]; then
          known[$source::$name]=1
          printf '%s\t%s\t%s\n' "${seconds[$source::$name]:-1}" "$b" "$name"
        fi
      done <<< "${listed[$b]}"
    done > "$TMPDIR/mago-tests"
    stale_seconds known '*::*'
    while IFS= read -r test; do
      chosen[$test]=1
    done < <(LC_ALL=C sort -t $'\t' -k1,1nr -k2,2n -k3,3 "$TMPDIR/mago-tests" | awk -F '\t' -v slices="$shard_count" \
      -v slice="$shard_index" -v threads="$jobs" '
        # In units of a second over the threads, so a time stays a whole number.
        function spent(at, binary, key) {
          key = at SUBSEP binary
          return longest[key] * threads > summed[key] ? longest[key] * threads : summed[key]
        }
        {
          best = 0
          for (at = 1; at <= slices; at++) {
            key = at SUBSEP $2
            top = $1 > longest[key] ? $1 : longest[key]
            after = top * threads > summed[key] + $1 ? top * threads : summed[key] + $1
            grown = load[at] - spent(at, $2) + after
            if (best == 0 || grown < least) {
              best = at
              least = grown
            }
          }
          key = best SUBSEP $2
          if ($1 > longest[key]) {
            longest[key] = $1
          }
          summed[key] += $1
          load[best] = least
          if (best == slice) {
            print $2 "\t" $3
          }
        }')
  fi

  # Every binary starts at once, each on as many test threads as the run's jobs, so a binary's slowest tests run beside
  # the other binaries' tests, where one binary after another left the Mac's cores idle while each one's last tests
  # ran: the workspace lane kept 2.7 to 3.1 of 12 busy on the three runs start_part names.
  for ((b = 0; b < ${#binaries[@]}; b++)); do
    if [[ -z ${listed[$b]+listed} ]]; then
      continue
    fi
    IFS=$'\t' read -r executable folder source <<< "${binaries[b]}"
    skips=()
    selected=0
    while IFS= read -r name; do
      if [[ -z $name ]]; then
        continue
      fi
      if [[ -z $shard || -n ${chosen[$b$'\t'$name]:-} ]]; then
        selected=$((selected + 1))
      else
        skips+=(--skip "$name")
      fi
    done <<< "${listed[$b]}"
    if (( selected > 0 )); then
      # libtest prints each test's own wall time after its result with --report-time, which stable Rust's libtest
      # takes only under RUSTC_BOOTSTRAP. libtest-mimic's harness, which the binaries with harness = false use, has no
      # such option, and its --help doesn't name it.
      command=("$executable")
      if [[ $("$executable" --help) == *--report-time* ]]; then
        command=(env RUSTC_BOOTSTRAP=1 "$executable" -Z unstable-options --report-time)
      fi
      start_part "${executable##*/}" step_part "$selected tests of ${executable##*/}, from ${folder#"$root"/}" \
        "${executable##*/}" "$folder" "${command[@]}" --exact --test-threads "$jobs" "${skips[@]}"
    fi
  done
  wait_parts
fi
if $mago; then
  if $build && [[ -z $shard ]]; then
    start_part "the doc tests and mago-codex's property tests" step_part \
      "the doc tests and mago-codex's property tests" "the doc tests and mago-codex's property tests" "$root" \
      "$root/sharp/bin/build-mago" --cargo-tests
  fi
  finish
fi

# sharp/baseline/linux holds the upstream results of the Linux engine CI's UPSTREAM runs.
if $upstream && [[ $os != linux ]]; then
  echo "The upstream tests run on Linux, as CI's UPSTREAM runs them. Run sharp/bin/test --linux --upstream." >&2
  exit 2
fi

# The whole-project proof of mago convert runs beside the PHP# suite, on this build's engine, with the fixture's
# refinement worker on the php the PATH holds: in the run of the whole suite, and in the one slice the slices give it.
run_proof=false
if $upstream; then
  # php-src's own tests, without Zend/tests/sharp, the PHP# suite, which the slices run in every mode: in the upstream
  # run it was 506 of 7,436 tests, every one of the slowest, and the compile of its 939 fixtures took 51 s more.
  mapfile -t tests < <(cd "$root" && find Zend/tests ext/reflection ext/tokenizer ext/opcache -path Zend/tests/sharp -prune \
    -o -name '*.phpt' -print | LC_ALL=C sort)
elif [[ -n $shard ]]; then
  # The slices balance by the seconds sharp/baseline/seconds lists, from CI's slow-test summaries: a test's seconds
  # summed over the modes, and the proof's own, which hold the whole slice while it runs, so it weighs them times
  # the workers. A test the file doesn't list ran under a second in each mode, so it weighs 1. Each item, heaviest
  # first, goes to the slice that weighs least so far, so every slice computes the same split. The list is remeasured
  # from one run, whose slices ran on 4 processor models, since a hosted runner can be 1.7 times slower than another:
  # the tests' from run 45127191998's slow-test summaries, and the proof's 108 s, its mean over runs 45127191998,
  # 45122643706, 45117789577 and 45114738831, which took 97 to 128 s.
  read_seconds
  items=()
  declare -A known=()
  while read -r test; do
    # shellcheck disable=SC2034 # stale_seconds reads known by its name.
    known[$test]=1
    items+=("${seconds[$test]:-1} $test")
  done < <(cd "$root" && find Zend/tests/sharp -name '*.phpt')
  stale_seconds known '*.phpt'
  items+=("$((${seconds[$proof]} * jobs)) $proof")
  mapfile -t items < <(printf '%s\n' "${items[@]}" | LC_ALL=C sort -k1,1nr -k2,2)
  loads=()
  for ((slice = 0; slice < shard_count; slice++)); do
    loads[slice]=0
  done
  for item in "${items[@]}"; do
    lightest=0
    for ((slice = 1; slice < shard_count; slice++)); do
      if ((loads[slice] < loads[lightest])); then
        lightest=$slice
      fi
    done
    loads[lightest]=$((loads[lightest] + ${item%% *}))
    if ((lightest == shard_index - 1)); then
      if [[ ${item#* } == "$proof" ]]; then
        run_proof=true
      else
        tests+=("${item#* }")
      fi
    fi
  done
elif [[ ${#tests[@]} -eq 0 ]]; then
  tests=(Zend/tests/sharp)
  run_proof=true
fi

php="$build_dir/sapi/cli/php"
if [[ ! -x "$php" ]]; then
  echo "$php is missing. Run sharp/bin/build first." >&2
  exit 1
fi

# A build folder an older sharp/bin/build configured can hold an engine without thread safety, which PHP# no longer
# runs, at the tree's version, the root package's in sharp/mago/Cargo.toml.
version="$(sed -n '/^version = /{s/^version = "\(.*\)"$/\1/p;q;}' "$root/sharp/mago/Cargo.toml")"
engine_version="$("$php" -n --ri sharp | sed -n 's/^Version => //p')"
if [[ "$engine_version" != "$version" || "$("$php" -n -r 'echo PHP_ZTS;')" != 1 ]]; then
  echo "The engine $php is $engine_version$("$php" -n -r 'echo PHP_ZTS ? "" : " without thread safety";'), but the tree is the thread-safe $version. Run sharp/bin/build." >&2
  exit 1
fi

export SKIP_IO_CAPTURE_TESTS=1
export STACK_LIMIT_DEFAULTS_CHECK=1
export RUN_RESOURCE_HEAVY_TESTS=1

run_tests() {
  local mode="$1"
  shift
  part "$mode"
  run_step "$mode" "$root" "$php" run-tests.php -P -q \
    -d opcache.jit=disable \
    -d opcache.protect_memory=1 \
    -j"$jobs" \
    -g FAIL,BORK,LEAK,XLEAK \
    --no-progress \
    --offline \
    --show-diff \
    --show-slow 1000 \
    --set-timeout 120 \
    "$@" "${tests[@]}"
}

# The upstream tests run on the engine alone, so they need no mago and no PHP# fixtures.
if $upstream; then
  baseline=sharp/baseline/linux
  results="$build_dir/upstream-results"
  start_part "without opcache, compared with $baseline" run_tests "without opcache, compared with $baseline" -W "$results"
  wait_parts
  awk -F '\t' -v OFS='\t' -v prefix="$root/" '
    $1 != "PASSED" {
      if (index($2, prefix) == 1) $2 = substr($2, length(prefix) + 1)
      print
    }' "$results" | LC_ALL=C sort -o "$results"
  if ! diff -u "$root/$baseline" "$results"; then
    echo "The upstream results differ from $baseline. Only the Architect accepts a new baseline, with: cp ${results#"$root"/} $baseline" >&2
    failed+=("the comparison with $baseline")
  fi
  finish
fi

if $build; then
  start_part "sharp/bin/build-mago" step_part "sharp/bin/build-mago" "sharp/bin/build-mago" "$root" "$root/sharp/bin/build-mago" --quiet
  wait_parts
  if ((${#failed[@]})); then
    finish
  fi
fi
mago="$build_dir/mago/debug/mago"
if [[ ! -x $mago ]]; then
  echo "$mago is missing. Run sharp/bin/build-mago first." >&2
  exit 1
fi

# Zend/tests/sharp is a project shaped like an application: the tests load their PHP# fixtures through Composer's
# autoloader and the PHP# package's, from the packages its composer.lock pins, and mago compile checks the project with
# its vendor folder. The PHP# package is a copy of sharp/composer, as an application installs it, since a compile
# refuses a link outside the project. Composer keeps the copy an earlier run installed while the lock is unchanged, so
# a copy that differs from sharp/composer in a file git tracks there is reinstalled first, and the install then dumps
# the autoloader, which runs the package's plugin: composer reinstall runs no plugin. Build output in either folder,
# such as the .sharp folder a compile writes, never counts: a local check that left sharp/composer/.sharp made every
# later run in every lane reinstall the copy with it, and the tests then refused their fixtures. Every other part reads
# the fixtures the install and the compile write, so they run first, and a failed one ends the run.
package="$root/Zend/tests/sharp/vendor/heyjordanparker/php-sharp-composer"
differs_from_library() {
  local files file
  if ! files="$(git -C "$root/sharp/composer" ls-files)"; then
    echo "git couldn't list the files it tracks in sharp/composer." >&2
    exit 1
  fi
  while IFS= read -r file; do
    if ! cmp -s "$root/sharp/composer/$file" "$package/$file"; then
      return 0
    fi
  done <<< "$files"
  return 1
}
prepare_suite() {
  part "composer install in Zend/tests/sharp"
  if [[ -d $package ]] && differs_from_library \
    && ! composer reinstall --no-interaction --no-progress --quiet --no-autoloader \
      --working-dir="$root/Zend/tests/sharp" heyjordanparker/php-sharp-composer; then
    echo "composer reinstall of heyjordanparker/php-sharp-composer failed in Zend/tests/sharp." >&2
    exit 1
  fi
  if ! composer install --no-interaction --no-progress --quiet --working-dir="$root/Zend/tests/sharp"; then
    echo "composer install failed in Zend/tests/sharp, and the tests load their fixtures through its autoloader." >&2
    exit 1
  fi
  part "mago compile, built from sharp/mago"
  if ! "$mago" --no-version-check --colors never --workspace "$root/Zend/tests/sharp" compile; then
    echo "mago compile refused a PHP# test fixture, and the engine runs only compiled files." >&2
    exit 1
  fi
}
start_part "composer install and mago compile in Zend/tests/sharp" prepare_suite
wait_parts
if ((${#failed[@]})); then
  finish
fi

export TEST_MAGO_EXECUTABLE="$mago"

# The PHP# suite runs in the four ways production runs the engine: without opcache, in opcache shared memory with each
# test twice in one process, under the function JIT, which compiles each function of a file as the file loads, and
# under the tracing JIT, with every hot counter at 1, so it compiles the code the tests run as soon as it runs. Each
# expects the output of the run without opcache. macOS runs the first two, since Apple silicon has no thread-safe JIT,
# as ext/opcache/config.m4 warns. The modes run one after another, as one part beside the others: run-tests.php writes
# the .php file of each test in the test's own folder, and deletes it before and after the test runs, so two modes at
# once would delete each other's.
run_modes() {
  run_tests "without opcache"
  run_tests "with opcache shared memory, running each test twice in one process" -d opcache.enable_cli=1 --repeat 2
  if [[ $os == linux ]]; then
    run_tests "with the function JIT" -d opcache.enable_cli=1 -d opcache.jit=function -d opcache.jit_buffer_size=32M
    run_tests "with the tracing JIT" -d opcache.enable_cli=1 -d opcache.jit=tracing -d opcache.jit_buffer_size=32M \
      -d opcache.jit_hot_func=1 -d opcache.jit_hot_loop=1 -d opcache.jit_hot_return=1 -d opcache.jit_hot_side_exit=1
  fi
}
start_part "the PHP# suite's modes" run_modes

if $census; then
  start_part "the census of PHP# marks" step_part "every write and comparison of a field that holds a PHP# mark" \
    "the census of PHP# marks" "$root" "$php" sharp/bin/census
fi

if $spec; then
  start_part "the self-test of sharp/bin/spec" step_part \
    "every rule of sharp/bin/spec, on the examples of sharp/spec-self-test.md" \
    "the self-test of sharp/bin/spec" "$root" "$php" sharp/bin/spec --self-test
  start_part "the code examples of docs/spec.md and README.md" step_part \
    "every code example in docs/spec.md and README.md, compared with sharp/baseline/spec" \
    "the code examples of docs/spec.md and README.md" "$root" "$php" sharp/bin/spec
fi

# One php -l lints every fixture, each file in a request of its own, and ends each file's output with the line that
# says whether it compiled. A file passes when that line is all it printed, as when a php -l of its own linted it, where
# a process per fixture took 44 s on the Mac.
check_differential() {
  part "every file mago compile accepted against php -l, through its .sharpc file"
  local files=("$root"/Zend/tests/sharp/*/*.sharp) output line file linted='' index=0 mismatch=false
  output="$("$php" -l "${files[@]}" 2>&1)" || true
  while IFS= read -r line; do
    linted+="$line"$'\n'
    if ((index == ${#files[@]})); then
      continue
    fi
    file="${files[index]}"
    if [[ $line == "No syntax errors detected in $file" || $line == "Errors parsing $file" ]]; then
      if [[ $linted == "No syntax errors detected in $file"$'\n' ]]; then
        echo "COMPILES ${file#"$root"/}"
      else
        printf 'FAIL %s: mago compile accepts it and php -l does not.\n%s' "${file#"$root"/}" "$linted"
        mismatch=true
      fi
      linted=''
      index=$((index + 1))
    fi
  done <<< "$output"
  if [[ -n $linted ]] || ((index < ${#files[@]})); then
    printf 'FAIL php -l reported on %d of the %d files, then printed this.\n%s' "$index" "${#files[@]}" "$linted"
    mismatch=true
  fi
  if $mismatch; then
    failed+=("every file mago compile accepted against php -l")
  fi
}

if $differential; then
  start_part "every file mago compile accepted against php -l" check_differential
fi

# A PHP# test class runs with its file's test module under real PHPUnit, at the version sharp/phpunit/composer.lock
# pins: in PHPUnit's own process, in the child process of #[RunInSeparateProcess], and with every test in a child. The
# install starts from nothing installed, because Composer keeps the copy of sharp/composer an earlier run installed while
# the lock is unchanged, and the compile starts from nothing compiled, with the fixture's extension host, which loads
# vendor/autoload.php on the engine. composer run-script runs post-autoload-dump with no flags.
check_phpunit() {
  local project="$root/sharp/phpunit" isolation
  part "a PHP# test class under PHPUnit, in sharp/phpunit"
  rm -rf "$project/vendor" "$project/.sharp"
  if ! composer install --no-interaction --no-progress --quiet --working-dir="$project" \
    || ! composer run-script --no-interaction post-autoload-dump --working-dir="$project" \
    || ! PATH="$(dirname "$php"):$PATH" "$mago" --no-version-check --colors never --workspace "$project" compile; then
    failed+=("the PHPUnit fixture's install, post-autoload-dump and compile")
    return
  fi
  for isolation in "" --process-isolation; do
    if ! "$php" -d opcache.jit=disable "$project/vendor/bin/phpunit" --configuration "$project/phpunit.xml" \
      --testdox ${isolation:+"$isolation"}; then
      failed+=("PHPUnit ${isolation:-in one process}")
    fi
  done
}

if $phpunit; then
  start_part "the PHPUnit fixture" check_phpunit
fi

if $run_proof; then
  mkdir "$TMPDIR/convert" "$TMPDIR/convert/project"
  start_part "the whole-project proof of mago convert" step_part \
    "mago convert on sharp/mago/crates/converter/tests/project" \
    "the whole-project proof of mago convert" "$root" "$proof" "$TMPDIR/convert/project"
fi

finish
