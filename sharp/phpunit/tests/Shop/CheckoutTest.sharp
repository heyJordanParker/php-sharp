namespace App.Shop;

import App.Mail.Mailer;
import App.Mail.LogMailer;
import PHPUnit.Framework.TestCase;
import PHPUnit.Framework.Attributes.Before;
import PHPUnit.Framework.Attributes.RunInSeparateProcess;
import PHPUnit.Framework.Attributes.Test;

// The base module binds SmtpMailer. While a test of this file runs, its module binds LogMailer, in PHPUnit's own
// process and in a child one, and before the test's own Before method, whatever that method's priority. The container
// fills the test's `Checkout` from that module at the start of each test.
module : App.Shop
{
    singleton Mailer = LogMailer;
}

public class CheckoutTest : TestCase
{
    private string before = "";

    public CheckoutTest(private Checkout checkout) { }

    [Before(priority: 10)]
    public void prepare()
    {
        this.before = this.checkout.usedMailer().name();
    }

    [Test]
    public void testUsesTheTestModule()
    {
        TestCase.assertSame("log", this.before);
        TestCase.assertSame("log", this.checkout.usedMailer().name());
    }

    [Test]
    [RunInSeparateProcess]
    public void testUsesTheTestModuleInASeparateProcess()
    {
        TestCase.assertSame("log", this.before);
        TestCase.assertSame("log", this.checkout.usedMailer().name());
    }
}
