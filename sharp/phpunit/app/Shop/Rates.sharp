namespace App.Shop;

import Sharp.Net.Http;

// An exchange rate from the rates service, through the `Http` it holds: `SystemHttp`, which the standard library's
// module binds, or a test's fake.
public class Rates
{
    public Rates(private Http http) { }

    // The rate of `currency`, as the service writes it.
    public string rate(string currency) => this.http.get(`https://rates.example/${currency}`).body.toText();
}
